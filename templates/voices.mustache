{{!
    @template local_oksigeniaayvurenda/voices

    Voices waiting for approval, with the family's permission for each minor; for managers, the centre's settings as
    cards with their gestures in sight (settingcard).

    Example context (json):
    {
        "heading": "Voces", "intro": "Las que esperan.", "notice": "", "action": "#", "sesskey": "abc", "haspending": true,
        "pending": [{"id": 1, "book": "El faro dormido", "title": "Capítulo 1", "who": "Ana Montes (4º B)", "url": "#",
            "share": false, "minor": true, "permission": false,
            "licences": [{"value": "rights", "label": "Con derechos de otros", "selected": true}],
            "audiences": [{"value": "students", "label": "Alumnos"}], "privatehint": "Sin permiso, solo su docente",
            "signature": "La mamá de Ana"}],
        "manage": true, "infourl": "https://example.com/voicesinfo.php", "savedword": "Guardado",
        "settings": [{"id": "ayv-nr-oyen", "set": "hear", "title": "Quién puede oírlas", "says": "Lo que eligen las familias.",
            "justsaved": false, "notes": [], "dates": null, "presets": null, "currency": null, "link": null, "help": null,
            "text": null, "groups": [{"label": "", "steps": [], "chips": [], "haslights": true, "haschips": false,
                "whole": false, "lights": [{"form": "ayv-nr-oyen-f", "name": "option[class]", "value": 0, "pressed": true,
                "label": "Su clase"}]}]}],
        "voicesignaturereview": "Firma", "voicesignaturereviewhint": "se ve al aprobarla", "voicesfamilyoptions": "Qué eligen las familias",
        "voicesnone": "Ninguna", "voiceapprove": "Aprobar", "voicereject": "Rechazar", "voicelicence": "Licencia",
        "voiceaudience": "Quién más la oye", "voiceprivatehint": "Sin permiso, solo su docente",
        "voicepermissiongive": "Anotar el permiso", "voicepermissiontake": "Retirar el permiso",
        "voicepermissionhas": "Su familia dio permiso", "voicepermissionnot": "Sin permiso de su familia",
        "voicestext": "Texto del centro",
        "voicestexthint": "Se añade a la página", "voicessave": "Guardar", "voiceinfo": "Cómo se tratan las voces"
    }
}}
<div class="ayv-cf ayv-nr">
<header class="ayv-cf-cabeza">
    <div class="ayv-cf-cabeza-texto"><h1 class="ayv-cf-titulo">{{heading}}</h1>
        <p class="ayv-cf-entrada">{{intro}} <a class="ayv-cf-enlace" href="{{infourl}}">{{voiceinfo}}</a></p>
    </div>
</header>
{{#notice}}<p class="ayv-notice" role="status">{{notice}}</p>{{/notice}}
{{^haspending}}{{#quiet}}<div class="ayv-holds-quiet">{{> local_oksigeniaayvurenda/bubble}}</div>{{/quiet}}{{^quiet}}<p class="ayv-empty">{{voicesnone}}</p>{{/quiet}}{{/haspending}}
{{#pending}}
<section class="ayv-book">
    <h2 class="ayv-section-title">{{book}}{{#title}} · {{title}}{{/title}}</h2>
    <p>{{who}}</p>
    <audio class="ayv-media" controls preload="none" src="{{url}}"></audio>
    {{#minor}}
    <form method="post" action="{{action}}" class="ayv-book-actions"><input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="item" value="{{id}}">
        <span class="ayv-field-hint">{{#permission}}{{voicepermissionhas}}{{/permission}}{{^permission}}{{voicepermissionnot}}{{/permission}}</span>
        {{#permission}}<input type="hidden" name="given" value="0"><button type="submit" class="ayv-button ayv-button-quiet" name="do" value="permission">{{voicepermissiontake}}</button>{{/permission}}
        {{^permission}}<input type="hidden" name="given" value="1"><button type="submit" class="ayv-button ayv-button-quiet" name="do" value="permission">{{voicepermissiongive}}</button>{{/permission}}
    </form>
    {{/minor}}
    <form method="post" action="{{action}}"><input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="item" value="{{id}}">
        <label class="ayv-field">{{voicelicence}} <select name="licence">{{#licences}}<option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>{{/licences}}</select></label>
        {{#share}}<fieldset class="ayv-fieldset"><legend>{{voiceaudience}}</legend><div class="ayv-choices">
            {{#audiences}}<label class="ayv-field ayv-field-check"><input type="checkbox" name="audience[]" value="{{value}}"> {{label}}</label>{{/audiences}}</div></fieldset>{{/share}}
        {{^share}}<p class="ayv-field-hint">{{privatehint}}</p>{{/share}}
        <label class="ayv-field ayv-field-wide">{{voicesignaturereview}} <span class="ayv-field-hint">{{voicesignaturereviewhint}}</span>
            <input type="text" name="signature" maxlength="60" value="{{signature}}"></label>
        <p class="ayv-book-actions"><button type="submit" class="ayv-button" name="do" value="approve">{{voiceapprove}}</button>
            <button type="submit" class="ayv-button ayv-button-quiet" name="do" value="reject">{{voicereject}}</button></p>
    </form>
</section>
{{/pending}}
{{#manage}}
<ul class="ayv-nr-ajustes">
    {{#settings}}
    <li>{{> local_oksigeniaayvurenda/settingcard}}</li>
    {{/settings}}
</ul>
{{/manage}}
</div>
