{{!
    @template local_oksigeniaayvurenda/activity

    Who did what in a centre: the days, each with what was done, on whom and by whom.

    Context variables required for this template:
    * heading, intro, empty
    * tabs - label, url, current
    * days - day, lines (time, name, about, detail, who)
    * pager - prev, next, line, prevlabel, nextlabel

    Example context (json):
    {
        "heading": "Quién hizo qué", "intro": "Lo delicado que se ha hecho en este centro.", "empty": "",
        "tabs": [{"label": "Todo", "url": "#", "current": true}, {"label": "Personas", "url": "#", "current": false}],
        "days": [{"day": "lunes, 2 de noviembre de 2026", "lines": [{"time": "10:32", "name": "Lectores juntados",
            "about": "Ana Inventada", "detail": "", "who": "Irene Tutora"}]}],
        "pager": null
    }
}}
<section class="ayv-trail">
<h1 class="ayv-results-title">{{heading}}</h1>
<p>{{intro}}</p>
<nav class="ayv-tabs" aria-label="{{heading}}">{{#tabs}}<a class="ayv-tab" href="{{url}}"{{#current}} aria-current="page"{{/current}}>{{label}}</a>{{/tabs}}</nav>
{{#empty}}<p class="ayv-field-hint">{{empty}}</p>{{/empty}}
{{#days}}
<h2 class="ayv-section-title">{{day}}</h2>
<ul class="ayv-trail-day">
{{#lines}}
    <li class="ayv-trail-line">
        <span class="ayv-trail-time">{{time}}</span>
        <span class="ayv-trail-what">
            <strong>{{name}}</strong>
            {{#about}}<span class="ayv-trail-about">{{about}}</span>{{/about}}
            {{#detail}}<span class="ayv-trail-detail">{{detail}}</span>{{/detail}}
        </span>
        <span class="ayv-trail-who">{{who}}</span>
    </li>
{{/lines}}
</ul>
{{/days}}
{{#pager}}{{> local_oksigeniaayvurenda/readers_pager}}{{/pager}}
</section>
