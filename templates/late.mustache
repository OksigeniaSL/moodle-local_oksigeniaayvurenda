{{!
    @template local_oksigeniaayvurenda/late

    Books out of the library: the late ones by span and by group (folded, in the order of the stages), or all of them;
    each reader to their record; for each group, its list to print and its tutor told now. With few readers out, each one
    in a card with their face, without groups to open.

    Example context (json):
    {
        "heading": "Libros con retraso", "notice": "", "action": "#", "sesskey": "abc", "only": false, "allurl": "#",
        "tabs": [{"label": "Con retraso", "url": "#", "current": true}, {"label": "Prestados", "url": "#", "current": false}],
        "spans": [{"key": "old", "count": "4", "label": "Más de 30 días", "url": "#", "current": false}],
        "hasgroups": true, "hascards": false, "cards": [], "orders": [], "orderlabel": "Ordenar por",
        "groups": [{"heading": "3º Primaria A", "group": "3º Primaria A", "summary": "2 lectores · el más antiguo, 31 días",
            "tone": "late", "open": false, "tell": "Avisar a Irene López", "remind": "", "settutor": "", "readerid": 0,
            "readerurl": "", "printurl": "#",
            "lines": [{"bybook": false, "bookurl": "", "wasdue": "", "name": "Ana Montes", "url": "#", "title": "El faro dormido", "when": "31 días de retraso",
                "tone": "late", "cover": null, "colour": 2, "canlose": true, "loanid": 7}]}],
        "empty": "No hay libros con retraso.", "latesettutor": "Poner tutor", "lateseerecord": "Su ficha", "lateprint": "La lista de la clase",
        "lateallgroups": "Todos los grupos", "printnow": "Imprimir", "lostlabel": "Perdido", "lostsure": "Sí, se ha perdido"
    }
}}
<h1 class="ayv-results-title">{{heading}}</h1>
{{#notice}}<p class="ayv-notice" role="status">{{notice}}</p>{{/notice}}
{{^only}}<nav class="ayv-tabs" aria-label="{{heading}}">{{#tabs}}<a class="ayv-tab" href="{{url}}"{{#current}} aria-current="page"{{/current}}>{{label}}</a>{{/tabs}}</nav>
<ul class="ayv-weed-reasons ayv-late-spans">
    {{#spans}}<li><a class="ayv-weed-reason ayv-late-span-{{key}}{{#alarm}} ayv-late-span-old{{/alarm}}" href="{{url}}"{{#current}} aria-current="true"{{/current}}><span class="ayv-weed-count">{{count}}</span> <span class="ayv-weed-label">{{label}}</span></a></li>{{/spans}}
</ul>{{/only}}
{{#only}}<p class="ayv-print-head"><a class="ayv-button ayv-button-quiet" href="{{allurl}}">{{lateallgroups}}</a> <button type="button" class="ayv-button" onclick="window.print()">{{printnow}}</button></p>{{/only}}
{{#hascards}}
<p class="ayv-late-orders">{{orderlabel}} {{#orders}}<a class="ayv-chip{{#current}} ayv-chip-on{{/current}}" href="{{url}}"{{#current}} aria-current="true"{{/current}}>{{label}}</a> {{/orders}}</p>
<ul class="ayv-late-cards">
{{#cards}}
    <li class="ayv-late-card">
        <span class="ayv-person-face ayv-late-card-face" aria-hidden="true">{{#photo}}<img src="{{photo}}" alt="" loading="lazy">{{/photo}}{{^photo}}{{initial}}{{/photo}}</span>
        <div class="ayv-late-card-text">
            <a class="ayv-late-who" href="{{url}}">{{name}}</a>
            {{#group}}<span class="ayv-weed-detail">{{group}}</span>{{/group}}
            <ul class="ayv-late-card-books">
            {{#books}}<li><a href="{{url}}">«{{title}}»</a> <span class="ayv-late-when ayv-late-{{tone}}">{{when}}</span></li>{{/books}}
            </ul>
        </div>
    </li>
{{/cards}}
</ul>
{{/hascards}}
{{#hasgroups}}
{{! A name or a title, typed, leaves only its lines and opens their groups: thirty folded groups are no way to find one. }}
<p class="ayv-late-find"><label class="ayv-field ayv-field-wide">{{latefind}}
    <input type="search" data-ayv-filter=".ayv-late-row" data-ayv-filter-groups=".ayv-late-group" autocomplete="off"></label></p>
{{#groups}}
<details class="ayv-late-group"{{#open}} open{{/open}}>
    <summary><span class="ayv-late-name">{{heading}}</span> <span class="ayv-late-summary ayv-late-summary-{{tone}}">{{summary}}</span></summary>
    <ul class="ayv-weed-list">
    {{#lines}}
        <li class="ayv-late-row">
            {{#bybook}}<span class="ayv-weed-cover ayv-cover ayv-cover-{{colour}}" aria-hidden="true">{{#cover}}<img src="{{cover}}" alt="" loading="lazy">{{/cover}}</span>{{/bybook}}
            {{^bybook}}<span class="ayv-person-face" aria-hidden="true">{{#photo}}<img src="{{photo}}" alt="" loading="lazy">{{/photo}}{{^photo}}{{initial}}{{/photo}}</span>{{/bybook}}
            {{#bybook}}<span class="ayv-weed-words"><a class="ayv-late-who" href="{{bookurl}}">{{title}}</a> <span class="ayv-weed-detail">{{wasdue}}</span></span>{{/bybook}}
            {{^bybook}}<span class="ayv-weed-words"><a class="ayv-late-who" href="{{url}}">{{name}}</a> <span class="ayv-weed-detail">«{{title}}»</span></span>{{/bybook}}
            <span class="ayv-late-when ayv-late-{{tone}}">{{when}}</span>
            {{#canlose}}<details class="ayv-profile-lost ayv-late-lost"><summary>{{lostlabel}}</summary>
                <form method="post" action="{{action}}"><input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="do" value="lost">
                    <input type="hidden" name="loan" value="{{loanid}}"><button type="submit" class="ayv-button ayv-button-quiet">{{lostsure}}</button></form>
            </details>{{/canlose}}
        </li>
    {{/lines}}
    </ul>
    <div class="ayv-late-actions">{{^open}}{{#printurl}}<a class="ayv-button ayv-button-quiet" href="{{printurl}}">{{lateprint}}</a>{{/printurl}}{{/open}}
        {{#readerurl}}<a class="ayv-button ayv-button-quiet" href="{{readerurl}}">{{lateseerecord}}</a>{{/readerurl}}
        {{#tell}}<form method="post" action="{{action}}"><input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="group" value="{{group}}">
            <button type="submit" class="ayv-button ayv-button-quiet" name="do" value="tell">{{tell}}</button></form>{{/tell}}
        {{#remind}}<form method="post" action="{{action}}"><input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="reader" value="{{readerid}}">
            <button type="submit" class="ayv-button ayv-button-quiet" name="do" value="remind">{{remind}}</button></form>{{/remind}}
        {{#settutor}}<a class="ayv-button ayv-button-quiet" href="{{settutor}}">{{latesettutor}}</a>{{/settutor}}</div>
</details>
{{/groups}}
{{/hasgroups}}
{{^hasgroups}}<p class="ayv-empty">{{empty}}</p>{{/hasgroups}}
