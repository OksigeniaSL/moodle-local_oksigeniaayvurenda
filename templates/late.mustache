{{!
    @template local_oksigeniaayvurenda/late

    Books out of the library by group: the late ones, or all of them.

    Context variables required for this template:
    * heading, empty - texts
    * groups - list of heading and lines (name, title, when, islate)
    * switch - url and label to see the others

    Example context (json):
    {
        "heading": "Libros con retraso",
        "hasgroups": true,
        "groups": [{"heading": "3º Primaria A", "lines": [{"name": "Ana Montes", "title": "El faro dormido",
                    "when": "5 días de retraso", "islate": true}]}],
        "empty": "No hay libros con retraso.",
        "switch": {"url": "#", "label": "Ver todos los prestados"}
    }
}}
<div class="ayv-results-head">
    <h1 class="ayv-results-title">{{heading}}</h1>
    {{#switch}}<a class="ayv-toggle" href="{{url}}">{{label}}</a>{{/switch}}
</div>
{{#hasgroups}}
{{#groups}}
<section class="ayv-section">
    <h2 class="ayv-section-title">{{heading}}</h2>
    <ul class="ayv-people">
    {{#lines}}
        <li class="ayv-person"><span class="ayv-person-name">{{name}}</span>
            <span>«{{title}}»</span>
            <span class="ayv-person-card {{#islate}}ayv-is-late{{/islate}}">{{when}}</span></li>
    {{/lines}}
    </ul>
</section>
{{/groups}}
{{/hasgroups}}
{{^hasgroups}}<p class="ayv-empty">{{empty}}</p>{{/hasgroups}}
