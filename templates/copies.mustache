{{!
    @template local_oksigeniaayvurenda/copies

    The daily copies of the library, to download.

    Context variables required for this template:
    * heading, intro, notice, empty, download - texts
    * files - list of url, label and size
    * make - action, sesskey and label to make one now, for those who may

    Example context (json):
    {
        "heading": "Copias de la biblioteca",
        "intro": "Cada noche, una copia completa.",
        "notice": "",
        "hasfiles": true,
        "files": [{"url": "#", "label": "25 de octubre de 2026, 02:47", "size": "1.2 MB"}],
        "empty": "",
        "download": "Descargar",
        "make": {"action": "#", "sesskey": "abc", "label": "Hacer una copia ahora"}
    }
}}
<h1 class="ayv-results-title">{{heading}}</h1>
<p>{{intro}}</p>
{{#notice}}<p class="ayv-notice" role="status">{{notice}}</p>{{/notice}}
{{#hasfiles}}
<ul class="ayv-people">
{{#files}}
    <li class="ayv-person"><span class="ayv-person-name">{{label}}</span> <span>{{size}}</span>
        <a class="ayv-button" href="{{url}}">{{download}}</a></li>
{{/files}}
</ul>
{{/hasfiles}}
{{^hasfiles}}<p class="ayv-empty">{{empty}}</p>{{/hasfiles}}
{{#make}}
<form method="post" action="{{action}}"><input type="hidden" name="sesskey" value="{{sesskey}}">
    <p class="ayv-more"><button type="submit" class="ayv-button ayv-button-quiet">{{label}}</button></p>
</form>
{{/make}}
