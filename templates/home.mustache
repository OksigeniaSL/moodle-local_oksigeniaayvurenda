{{!
    @template local_oksigeniaayvurenda/home

    The home of a library: its corners and what came in last.

    Context variables required for this template:
    * heading - title of the screen
    * corners - list of corners with code, label, countlabel, colour and url
    * cards - cards of what came in last (see local_oksigeniaayvurenda/cards)

    Example context (json):
    {
        "shelf": null, "voices": null, "window": null, "spring": null,
        "desk": {"url": "#", "label": "Abrir el mostrador"},
        "addbooks": {"url": "#", "label": "Dar de alta libros", "freeurl": "#", "freelabel": "Traer obras libres"},
        "mycard": {"url": "#", "label": "Mi carné"},
        "heading": "La biblioteca",
        "cornersheading": "Rincones",
        "hascorners": true,
        "corners": [{"code": "8", "label": "Lengua y literatura", "countlabel": "120 libros", "colour": 2, "url": "#"}],
        "recentheading": "Acaban de llegar",
        "herald": {"initial": "M", "role": "memory", "name": "Mainumby", "text": "¡Los he traído volando!"},
        "hasrecent": true,
        "cards": [{"id": 1, "title": "El faro dormido", "authors": "Ana Montes", "colour": 2, "url": "#",
                   "statelabel": "Libre", "stateclass": "free", "location": null}],
        "empty": ""
    }
}}
<h1 class="ayv-sr">{{heading}}</h1>
{{#spring}}<p class="ayv-staff"><a class="ayv-button ayv-button-quiet" href="{{url}}">{{> local_oksigeniaayvurenda/icon_mic}} {{label}}</a></p>{{/spring}}
{{#window}}<p class="ayv-staff"><a class="ayv-button ayv-button-quiet" href="{{url}}">{{label}}</a></p>{{/window}}
{{#voices}}<p class="ayv-staff"><a class="ayv-button ayv-button-quiet" href="{{url}}">{{label}}</a></p>{{/voices}}
{{#shelf}}<p class="ayv-staff"><a class="ayv-button" href="{{url}}">{{label}}</a></p>{{/shelf}}
{{#mycard}}<p class="ayv-staff"><a class="ayv-button" href="{{url}}">{{label}}</a></p>{{/mycard}}
{{#desk}}<p class="ayv-staff"><a class="ayv-button" href="{{url}}">{{label}}</a>
    {{#addbooks}}<a class="ayv-button ayv-button-quiet" href="{{url}}">{{label}}</a>
    <a class="ayv-button ayv-button-quiet" href="{{freeurl}}">{{freelabel}}</a>{{/addbooks}}</p>{{/desk}}
{{^desk}}{{#addbooks}}<p class="ayv-staff"><a class="ayv-button ayv-button-quiet" href="{{url}}">{{label}}</a>
    <a class="ayv-button ayv-button-quiet" href="{{freeurl}}">{{freelabel}}</a></p>{{/addbooks}}{{/desk}}
{{#hascorners}}
<section class="ayv-section" aria-labelledby="ayv-corners">
    <h2 id="ayv-corners" class="ayv-section-title">{{cornersheading}}</h2>
    <ul class="ayv-corners">
    {{#corners}}
        <li><a class="ayv-corner ayv-cover-{{colour}}" href="{{url}}">
            <span class="ayv-corner-label">{{label}}</span>
            <span class="ayv-corner-count">{{countlabel}}</span>
        </a></li>
    {{/corners}}
    </ul>
</section>
{{/hascorners}}
{{#hasrecent}}
<section class="ayv-section" aria-labelledby="ayv-recent">
    <h2 id="ayv-recent" class="ayv-section-title">{{recentheading}}</h2>
    {{#herald}}{{> local_oksigeniaayvurenda/bubble}}{{/herald}}
    {{> local_oksigeniaayvurenda/cards}}
</section>
{{/hasrecent}}
{{#empty}}<p class="ayv-empty">{{empty}}</p>{{/empty}}
