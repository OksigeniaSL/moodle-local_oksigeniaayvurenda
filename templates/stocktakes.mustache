{{!
    @template local_oksigeniaayvurenda/stocktakes

    Stocktakes: each place of the library a piece of furniture, touched to start there (or the whole library, wider), and
    the ones done before as minutes, the open one first.

    Context variables required for this template:
    * heading, intro, crier, action, sesskey - the head and where a start goes
    * whole (label, says, spines), furniture (id, label, says, spines) - what can be stocktaken
    * before, minutes (name, url, open, state, line), hasminutes - the ones done before

    Example context (json):
    {
        "heading": "Inventario", "intro": "Toca la estantería.", "crier": null, "action": "https://example.com/stocktake.php",
        "sesskey": "abc", "whole": {"label": "Toda la biblioteca", "says": "<b>120</b> libros en 2 estanterías",
            "spines": [{"on": false}]},
        "furniture": [{"id": 3, "label": "Ciencias", "says": "<b>60</b> libros", "spines": [{"on": false}]}],
        "before": "Los de antes", "hasminutes": true,
        "minutes": [{"name": "Inventario del 3 de noviembre", "url": "https://example.com/stocktake.php?id=1", "open": true,
            "state": "Toda la biblioteca · abierto", "line": "Seguir pasando libros"}]
    }
}}
<div class="ayv-cf ayv-st">
<header class="ayv-cf-cabeza">
    <div class="ayv-cf-cabeza-texto"><h1 class="ayv-cf-titulo">{{heading}}</h1>
        <p class="ayv-cf-entrada">{{intro}}</p>
        </div>
    {{#crier}}<span class="ayv-cf-pregonera"><span class="ayv-figure"><img src="{{figure}}" alt="" width="512" height="512"{{#puppet}} data-puppet="{{puppet}}"{{/puppet}}></span></span>{{/crier}}
</header>
<form id="ayv-st-empezar" method="post" action="{{action}}"><input type="hidden" name="sesskey" value="{{sesskey}}"></form>
<ul class="ayv-st-plano">
    {{#whole}}<li class="ayv-st-todo"><button class="ayv-st-mueble" type="submit" form="ayv-st-empezar" name="location" value="0"><span class="ayv-st-placa">{{label}}</span>{{> local_oksigeniaayvurenda/stocktake_shelf}}{{> local_oksigeniaayvurenda/stocktake_shelf}}<span class="ayv-st-cuenta">{{{says}}}</span></button></li>{{/whole}}
    {{#furniture}}<li><button class="ayv-st-mueble" type="submit" form="ayv-st-empezar" name="location" value="{{id}}"><span class="ayv-st-placa">{{label}}</span>{{> local_oksigeniaayvurenda/stocktake_shelf}}<span class="ayv-st-cuenta">{{{says}}}</span></button></li>{{/furniture}}
</ul>
{{#hasminutes}}
<section aria-labelledby="ayv-st-antes">
    <h2 id="ayv-st-antes" class="ayv-cf-estante-t">{{before}}</h2>
    <ul class="ayv-st-actas">
        {{#minutes}}<li><a class="ayv-st-acta{{#open}} ayv-st-acta-abierta{{/open}}" href="{{url}}"><b>{{name}}</b><span>{{state}}</span><span>{{line}}</span></a></li>{{/minutes}}
    </ul>
</section>
{{/hasminutes}}
</div>
