{{!
    @template local_oksigeniaayvurenda/stocktakes

    The stocktakes of a library, and starting one.

    Example context (json):
    {
        "heading": "Inventario", "intro": "Recorre las estanterías.", "haslist": true,
        "list": [{"name": "Inventario de junio", "url": "#", "state": "Abierto", "progress": "Leídos: 10 de 600"}],
        "action": "#", "sesskey": "abc", "defaultname": "Inventario del 24 de octubre de 2026",
        "places": [{"id": 1, "label": "Narrativa (120)"}],
        "stocktakenew": "Empezar un inventario", "stocktakename": "Nombre", "stocktakewhere": "Qué recorre",
        "stocktakeall": "Toda la biblioteca", "stocktakestart": "Empezar", "stocktakelist": "Inventarios"
    }
}}
<h1 class="ayv-results-title">{{heading}}</h1>
<p>{{intro}}</p>
{{#haslist}}
<h2 class="ayv-section-title">{{stocktakelist}}</h2>
<ul class="ayv-holds">
{{#list}}
    <li class="ayv-holds-row"><a class="ayv-holds-title" href="{{url}}">{{name}}</a>
        <span class="ayv-holds-who">{{state}}</span> <span class="ayv-holds-when">{{progress}}</span></li>
{{/list}}
</ul>
{{/haslist}}
<form method="post" action="{{action}}" class="ayv-book">
    <input type="hidden" name="sesskey" value="{{sesskey}}">
    <h2 class="ayv-section-title">{{stocktakenew}}</h2>
    <label class="ayv-field ayv-field-wide">{{stocktakename}} <input type="text" name="name" value="{{defaultname}}" maxlength="100"></label>
    <label class="ayv-field">{{stocktakewhere}}
        <select name="location"><option value="0">{{stocktakeall}}</option>{{#places}}<option value="{{id}}">{{label}}</option>{{/places}}</select>
    </label>
    <p class="ayv-book-actions"><button type="submit" class="ayv-button">{{stocktakestart}}</button></p>
</form>
