{{!
    @template local_oksigeniaayvurenda/lti_course
    A teacher coming from a course of a learning platform brings its students to the library, with their group.
    Context variables required for this template:
    * heading, intro, notice, error, grouplabel, grouphint, nogrouplabel, bringlabel, nightnote, homelabel - texts
    * ask - whether to offer bringing them
    * action, sesskey, group, homeurl - the form and the way on
    Example context (json):
    {
        "heading": "Tu curso «Lengua 3.º B» y la biblioteca",
        "intro": "Tiene 24 alumnos.",
        "notice": "",
        "error": "",
        "ask": true,
        "action": "https://example.org/c",
        "sesskey": "abc",
        "grouplabel": "Su grupo en la biblioteca",
        "grouphint": "El de clase.",
        "group": "3.º B",
        "nogrouplabel": "Sin grupo",
        "bringlabel": "Traerlos",
        "nightnote": "A partir de ahora se ponen al día cada noche.",
        "homeurl": "https://example.org/h",
        "homelabel": "Ahora no: ir a la biblioteca"
    }
}}
<h1 class="ayv-results-title">{{heading}}</h1>
{{#intro}}<p>{{intro}}</p>{{/intro}}
{{#notice}}<p class="ayv-notice" role="status">{{notice}}</p>{{/notice}}
{{#error}}<p class="ayv-notice ayv-notice-error" role="alert">{{error}}</p>{{/error}}
{{#ask}}
<form method="post" action="{{action}}" class="ayv-book">
    <input type="hidden" name="sesskey" value="{{sesskey}}">
    <label class="ayv-field ayv-field-wide">{{grouplabel}} <span class="ayv-field-hint">{{grouphint}}</span>
        <input type="text" name="group" value="{{group}}" maxlength="255"></label>
    <label class="ayv-field ayv-field-check"><input type="checkbox" name="nogroup" value="1"> {{nogrouplabel}}</label>
    <p class="ayv-field-hint">{{nightnote}}</p>
    <p class="ayv-book-actions"><button type="submit" class="ayv-button">{{bringlabel}}</button></p>
</form>
{{/ask}}
<p class="ayv-more"><a class="ayv-button ayv-button-quiet" href="{{homeurl}}">{{homelabel}}</a></p>
