{{!
    @template local_oksigeniaayvurenda/purchase_fields

    The fields of what is bought: how many, at what price and from whom.

    Example context (json):
    {
        "copies": 1, "pricevalue": "", "vendor": "", "vendors": [{"name": "Librería Sur"}],
        "purchasefieldcopies": "Ejemplares", "purchasefieldprice": "Precio", "purchasefieldpricehint": "Si lo sabes",
        "purchasefieldvendor": "A quién"
    }
}}
<div class="ayv-mat-grid">
    <label class="ayv-field ayv-dig-field">{{purchasefieldcopies}} <input type="number" name="copies" min="1" max="500" value="{{copies}}"></label>
    <label class="ayv-field ayv-dig-field">{{purchasefieldprice}} <span class="ayv-field-hint">{{purchasefieldpricehint}}</span> <input type="text" name="price" inputmode="decimal" maxlength="12" value="{{pricevalue}}"></label>
    <label class="ayv-field ayv-dig-field ayv-mat-name">{{purchasefieldvendor}} <input type="text" name="vendor" maxlength="100" value="{{vendor}}" list="ayv-purchase-vendors"></label>
</div>
