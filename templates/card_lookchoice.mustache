{{!
    @template local_oksigeniaayvurenda/card_lookchoice

    How a reader past the flower sees their card: with the sky, classic or without a game. Above the card, a heading of
    the page; below it, one of «For you».

    Context variables required for this template:
    * action, sesskey, lookheading, choosefirst
    * choices - value, title, hint, art, isclassic, isnone, checked

    Example context (json):
    {
        "action": "https://example.org/card.php", "sesskey": "x", "lookheading": "Cómo ves tu carné", "choosefirst": true,
        "choices": [{"value": "classic", "title": "Clásico", "hint": "Una lista, sin juego", "art": "https://example.org/luna.webp", "isclassic": true,
            "isnone": false, "checked": true}]
    }
}}
            <form method="post" action="{{action}}#ayv-mine" class="ayv-mine-box ayv-mine-look">
                <input type="hidden" name="sesskey" value="{{sesskey}}">
                {{#choosefirst}}<h2 class="ayv-mine-title">{{lookheading}}</h2>{{/choosefirst}}
                {{^choosefirst}}<h3 class="ayv-mine-title">{{lookheading}}</h3>{{/choosefirst}}
                <div class="ayv-mine-tiles">
                {{#choices}}
                    <button type="submit" name="look" value="{{value}}" class="ayv-mine-tile" aria-pressed="{{#checked}}true{{/checked}}{{^checked}}false{{/checked}}">
                        <span class="ayv-mine-tile-art">{{#art}}<img src="{{art}}" alt="">{{/art}}{{#isclassic}}{{> local_oksigeniaayvurenda/icon_list}}{{/isclassic}}{{#isnone}}{{> local_oksigeniaayvurenda/icon_id_card}}{{/isnone}}</span>
                        <span class="ayv-mine-tile-words"><b>{{title}}</b><span>{{hint}}</span></span>
                        {{#checked}}<span class="ayv-mine-tile-on">{{> local_oksigeniaayvurenda/icon_check}}</span>{{/checked}}
                    </button>
                {{/choices}}
                </div>
            </form>
