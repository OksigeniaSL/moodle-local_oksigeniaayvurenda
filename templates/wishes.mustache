{{!
    @template local_oksigeniaayvurenda/wishes

    What classes ask for: the book each class chose, why, and two touches: here it is, or it could not be.

    Example context (json):
    {
        "heading": "Lo que piden las clases", "intro": "Los libros que eligen.", "notice": "", "empty": "Ninguna.",
        "action": "#", "sesskey": "abc", "got": "Ya está", "declined": "No ha podido ser", "searchlabel": "Buscarlo",
        "hasitems": true,
        "items": [{"id": 1, "title": "Los pájaros del faro", "note": "Por los dibujos", "from": "3.º A · 25/10/26",
            "search": "#"}]
    }
}}
<h1 class="ayv-results-title">{{heading}}</h1>
<p>{{intro}}</p>
{{#notice}}<p class="ayv-notice" role="status">{{notice}}</p>{{/notice}}
{{#hasitems}}
<ul class="ayv-review-queue">
    {{#items}}
    <li class="ayv-review-card">
        <p class="ayv-review-text">«{{title}}»</p>
        {{#note}}<p>{{note}}</p>{{/note}}
        <p class="ayv-review-who">{{from}}</p>
        <p><a href="{{search}}">{{searchlabel}}</a></p>
        <form method="post" action="{{action}}" class="ayv-book-actions">
            <input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="wish" value="{{id}}">
            <button type="submit" class="ayv-button" name="do" value="got">{{got}}</button>
            <button type="submit" class="ayv-button ayv-button-quiet" name="do" value="declined">{{declined}}</button>
        </form>
    </li>
    {{/items}}
</ul>
{{/hasitems}}
{{^hasitems}}<p class="ayv-empty">{{empty}}</p>{{/hasitems}}
