{{!
    @template local_oksigeniaayvurenda/agenda

    The library's agenda as the sheet of the month (the course sheet's, one month large): each day with its activities
    marked; a day touched opens as a card beside it, with its activities, each changed in place with the gestures of «How
    your library works» (chips, «−» and «+», lines that keep themselves), and a new one written on it. Under the sheet,
    what is coming. Each gesture is a submit button of its own form: no JavaScript needed.

    Example context (json):
    {
        "heading": "Agenda",
        "intro": "Lo que viene.",
        "notice": "",
        "problem": "",
        "action": "https://example.org/agenda.php",
        "sesskey": "abc",
        "manage": true,
        "monthname": "Noviembre",
        "monthyear": "2026",
        "prevurl": "https://example.org/agenda.php?month=2026-10",
        "nexturl": "https://example.org/agenda.php?month=2026-12",
        "prevlabel": "Mes anterior",
        "nextlabel": "Mes siguiente",
        "letters": [
            {
                "letter": "L",
                "rest": false
            },
            {
                "letter": "S",
                "rest": true
            }
        ],
        "cells": [
            {
                "blank": true
            },
            {
                "blank": false,
                "n": 14,
                "url": "https://example.org/agenda.php?day=2026-11-14",
                "aria": "sábado 14 de noviembre",
                "rest": true,
                "past": false,
                "today": false,
                "touched": true,
                "acts": [
                    {
                        "short": "Cuentacuentos",
                        "colour": "coral"
                    }
                ]
            }
        ],
        "day": {
            "long": "sábado, 14 de noviembre",
            "monthshort": "NOV",
            "n": 14,
            "dayvalue": "2026-11-14",
            "agendanewon": "Otra actividad el sábado 14…",
            "release": "https://example.org/agenda.php",
            "acts": [
                {
                    "id": 1,
                    "colour": "coral",
                    "open": false,
                    "title": "Cuentacuentos",
                    "when": "sábado, 14 de noviembre, 11:00",
                    "place": "Sala infantil",
                    "audience": "De 4 a 8 años",
                    "text": "Con Mainumby.",
                    "seats": "20 plazas",
                    "canedit": true,
                    "timevalue": "11:00",
                    "timeless": "10:45",
                    "timemore": "11:15",
                    "allday": false,
                    "lasts": [
                        {
                            "value": 60,
                            "label": "Una hora",
                            "pressed": true
                        }
                    ],
                    "places": [
                        {
                            "label": "Sala infantil",
                            "pressed": true
                        }
                    ],
                    "audiences": [
                        {
                            "label": "De 4 a 8 años",
                            "pressed": true
                        }
                    ],
                    "seatsvalue": 20,
                    "seatsless": 15,
                    "seatsmore": 25,
                    "unlimited": false
                }
            ]
        },
        "releaselabel": "Cerrar el día",
        "nothing": "Nada este día todavía.",
        "activities": [
            {
                "title": "Cuentacuentos",
                "when": "sábado, 14 de noviembre, 11:00",
                "day": 14,
                "month": "NOV",
                "place": "Sala infantil",
                "audience": "",
                "seats": "",
                "dayurl": "https://example.org/agenda.php?day=2026-11-14"
            }
        ],
        "hasactivities": true,
        "agendanone": "Nada en la agenda.",
        "agendaactivity": "Actividad",
        "agendatime": "Hora",
        "agendaplace": "Dónde",
        "agendaaudience": "Para quién",
        "agendatext": "Una frase",
        "agendatexthint": "Una frase para quien la lea",
        "agendaseatslabel": "Plazas",
        "agendasave": "Guardar",
        "agendaedit": "Cambiar",
        "agendaremove": "Quitar",
        "agendaremovesure": "Sí, quitarla",
        "agendaallday": "Todo el día",
        "agendalasts": "Cuánto dura",
        "agendanoseats": "Sin contar",
        "agendaotherplace": "Otro sitio…",
        "agendaput": "Ponerla",
        "comingheading": "Lo que viene",
        "savedword": "Guardado",
        "earlier": "Antes",
        "later": "Después",
        "fewer": "Menos",
        "more": "Más"
    }
}}
<div class="ayv-cf ayv-ag">
<header class="ayv-cf-cabeza">
    <div class="ayv-cf-cabeza-texto"><h1 class="ayv-cf-titulo">{{heading}}</h1>
        <p class="ayv-cf-entrada">{{intro}}</p></div>
</header>
{{#notice}}<p class="ayv-notice" role="status">{{notice}}</p>{{/notice}}
{{#problem}}<p class="ayv-notice ayv-notice-error" role="alert">{{problem}}</p>{{/problem}}
<div class="ayv-ag-mesa">
<section class="ayv-cs-hoja ayv-ag-hoja" aria-labelledby="ayv-ag-mes-t">
    <div class="ayv-ag-mes-cab">
        <a class="ayv-ag-flecha" href="{{prevurl}}" aria-label="{{prevlabel}}">‹</a>
        <h2 class="ayv-cf-estante-t" id="ayv-ag-mes-t">{{monthname}} <span>{{monthyear}}</span></h2>
        <a class="ayv-ag-flecha" href="{{nexturl}}" aria-label="{{nextlabel}}">›</a>
    </div>
    <div class="ayv-cs-semana ayv-ag-semana" aria-hidden="true">{{#letters}}<span{{#rest}} class="ayv-cs-finde"{{/rest}}>{{letter}}</span>{{/letters}}</div>
    <div class="ayv-ag-dias">{{#cells}}{{#blank}}<span class="ayv-ag-hueco" aria-hidden="true"></span>{{/blank}}{{^blank}}<a class="ayv-ag-dia{{#rest}} ayv-ag-finde{{/rest}}{{#past}} ayv-ag-pasado{{/past}}{{#today}} ayv-ag-hoy{{/today}}{{#touched}} ayv-ag-tocado{{/touched}}" href="{{url}}"{{#today}} aria-current="date"{{/today}}><b aria-hidden="true">{{n}}</b>{{#acts}}<span class="ayv-ag-marca ayv-ag-m-{{colour}}" aria-hidden="true">{{short}}</span>{{/acts}}<span class="ayv-sr">{{aria}}</span></a>{{/blank}}{{/cells}}</div>
</section>
{{#day}}
<aside class="ayv-cs-tarjeta ayv-ag-dia-t" id="ayv-ag-dia" aria-labelledby="ayv-ag-dia-t">
    <span class="ayv-cf-hoja" aria-hidden="true"><small>{{monthshort}}</small><b>{{n}}</b></span>
    <div class="ayv-ag-dia-cuerpo">
        <h2 class="ayv-cs-tocado-t" id="ayv-ag-dia-t">{{long}}</h2>
        {{^acts.0}}<p class="ayv-cf-nota">{{nothing}}</p>{{/acts.0}}
        {{#acts}}
        <article class="ayv-ag-act ayv-ag-a-{{colour}}" id="ayv-activity-{{id}}">
            <form id="ayv-ag-f-{{id}}" method="post" action="{{action}}#ayv-activity-{{id}}"><input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="id" value="{{id}}"><input type="hidden" name="do" value="set"></form>
            <h3 class="ayv-ag-act-t">{{title}}</h3>
            <p class="ayv-ag-act-cuando">{{when}}</p>
            <p class="ayv-field-hint ayv-ag-act-datos">{{#place}}<span>{{place}}</span>{{/place}}{{#audience}}<span>{{audience}}</span>{{/audience}}{{#seats}}<span>{{seats}}</span>{{/seats}}</p>
            {{#text}}<p class="ayv-ag-act-frase">{{text}}</p>{{/text}}
            {{#canedit}}
            <details class="ayv-ag-cambiar"{{#open}} open{{/open}}><summary class="ayv-button ayv-button-quiet">{{agendaedit}}</summary>
                <div class="ayv-ag-gestos">
                    <form class="ayv-sd-escribir" method="post" action="{{action}}" data-ayv-autosave="{{savedword}}"><input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="id" value="{{id}}"><input type="hidden" name="do" value="set">
                        <label><span class="ayv-cf-rotulo">{{agendaactivity}}</span><input type="text" name="title" value="{{title}}" maxlength="160"></label>
                        <label><span class="ayv-cf-rotulo">{{agendatext}}</span><input type="text" name="text" value="{{text}}" maxlength="600" placeholder="{{agendatexthint}}"></label>
                        <span class="ayv-autosaved" role="status" aria-live="polite"></span>
                        <p class="ayv-book-actions ayv-autosave-button"><button type="submit" class="ayv-button ayv-button-quiet">{{agendasave}}</button></p></form>
                    <div class="ayv-cf-numero"><span class="ayv-cf-rotulo">{{agendatime}}</span><span class="ayv-cf-paso" role="group" aria-label="{{agendatime}}"><button class="ayv-cf-menos" type="submit" form="ayv-ag-f-{{id}}" name="time" value="{{timeless}}" aria-label="{{earlier}}">−</button><span class="ayv-cf-cifra"><b>{{timevalue}}</b></span><button class="ayv-cf-mas" type="submit" form="ayv-ag-f-{{id}}" name="time" value="{{timemore}}" aria-label="{{later}}">+</button></span>
                        <button class="ayv-cf-chapa ayv-sd-ninguno" type="submit" form="ayv-ag-f-{{id}}" name="time" value="" aria-pressed="{{#allday}}true{{/allday}}{{^allday}}false{{/allday}}">{{agendaallday}}</button></div>
                    <div class="ayv-cf-fila"><span class="ayv-cf-rotulo">{{agendalasts}}</span><span class="ayv-cf-chapas">{{#lasts}}<button class="ayv-cf-chapa" type="submit" form="ayv-ag-f-{{id}}" name="lasts" value="{{value}}" aria-pressed="{{#pressed}}true{{/pressed}}{{^pressed}}false{{/pressed}}">{{label}}</button>{{/lasts}}</span></div>
                    <div class="ayv-cf-fila"><span class="ayv-cf-rotulo">{{agendaplace}}</span><span class="ayv-cf-chapas">{{#places}}<button class="ayv-cf-chapa" type="submit" form="ayv-ag-f-{{id}}" name="place" value="{{label}}" aria-pressed="{{#pressed}}true{{/pressed}}{{^pressed}}false{{/pressed}}">{{label}}</button>{{/places}}<input class="ayv-ag-otro" form="ayv-ag-f-{{id}}" name="placeother" maxlength="160" placeholder="{{agendaotherplace}}" aria-label="{{agendaotherplace}}"></span></div>
                    <div class="ayv-cf-fila"><span class="ayv-cf-rotulo">{{agendaaudience}}</span><span class="ayv-cf-chapas">{{#audiences}}<button class="ayv-cf-chapa" type="submit" form="ayv-ag-f-{{id}}" name="audience" value="{{label}}" aria-pressed="{{#pressed}}true{{/pressed}}{{^pressed}}false{{/pressed}}">{{label}}</button>{{/audiences}}</span></div>
                    <div class="ayv-cf-numero"><span class="ayv-cf-rotulo">{{agendaseatslabel}}</span><span class="ayv-cf-paso" role="group" aria-label="{{agendaseatslabel}}"><button class="ayv-cf-menos" type="submit" form="ayv-ag-f-{{id}}" name="seats" value="{{seatsless}}" aria-label="{{fewer}}">−</button><span class="ayv-cf-cifra"><b>{{seatsvalue}}</b></span><button class="ayv-cf-mas" type="submit" form="ayv-ag-f-{{id}}" name="seats" value="{{seatsmore}}" aria-label="{{more}}">+</button></span>
                        <button class="ayv-cf-chapa ayv-sd-ninguno" type="submit" form="ayv-ag-f-{{id}}" name="seats" value="0" aria-pressed="{{#unlimited}}true{{/unlimited}}{{^unlimited}}false{{/unlimited}}">{{agendanoseats}}</button></div>
                    <details class="ayv-cf-quitar"><summary>{{agendaremove}}</summary><button class="ayv-button ayv-cf-peligro" type="submit" form="ayv-ag-f-{{id}}" name="do" value="remove">{{agendaremovesure}}</button></details>
                </div>
            </details>
            {{/canedit}}
        </article>
        {{/acts}}
        {{#manage}}
        <form class="ayv-ag-nueva" method="post" action="{{action}}"><input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="day" value="{{dayvalue}}"><input type="hidden" name="do" value="save">
            <span class="ayv-ag-mas" aria-hidden="true">+</span>
            <label class="ayv-sr" for="ayv-ag-nueva">{{agendanewon}}</label><input id="ayv-ag-nueva" name="title" maxlength="160" required placeholder="{{agendanewon}}">
            <button class="ayv-button" type="submit">{{agendaput}}</button></form>
        {{/manage}}
    </div>
    <a class="ayv-cs-soltar" href="{{release}}" aria-label="{{releaselabel}}">×</a>
</aside>
{{/day}}
</div>
<section class="ayv-ag-viene" aria-labelledby="ayv-ag-viene-t">
    <h2 class="ayv-cf-estante-t" id="ayv-ag-viene-t">{{comingheading}}</h2>
    <ul class="ayv-agenda-list ayv-ag-lista">
    {{#activities}}
        <li class="ayv-agenda-item"><a class="ayv-ag-item" href="{{dayurl}}">
            <span class="ayv-agenda-leaf" aria-hidden="true"><b>{{day}}</b><span>{{month}}</span></span>
            <span class="ayv-agenda-words"><b class="ayv-agenda-title">{{title}}</b><span class="ayv-agenda-when">{{when}}</span>
                <span class="ayv-field-hint">{{#place}}<span>{{place}}</span>{{/place}}{{#audience}}<span>{{audience}}</span>{{/audience}}{{#seats}}<span>{{seats}}</span>{{/seats}}</span></span></a></li>
    {{/activities}}
    {{^hasactivities}}<li class="ayv-agenda-item ayv-agenda-none"><p>{{agendanone}}</p></li>{{/hasactivities}}
    </ul>
</section>
</div>
