{{!
    @template local_oksigeniaayvurenda/digital

    The digital forms of a record, as cards: each with its format, licence, who it is for and, when it is only for a
    course, which and until when. Changing one opens it in place, the card across the page (a link, as the day touched
    on the course sheet), with the gestures of «How your library works»: the licence and who sees it as chips, the
    stages and the switches as lights, minutes, pages and order with «−» and «+», the lines that keep themselves, the
    course as chips and its date as a calendar sheet. Each gesture sends only what it changes (do=set, one field). Adding
    one asks only for the file or the link: it comes in with the safest licence and for the staff, and is set on its card.

    Context variables required for this template:
    * heading, eyebrow, authors, hascover, coverurl, colour, intro, notice, action, sesskey, hasitems, recordurl, close
    * items - id, title, rawtitle, format, formatkey, licencelabel, audiencechips, onlyline, readurl, licences,
      audiences, stages, download, courses, pages, until, homeages, homechip, homepublic, homenotpublic
    * licences, audiences, stages, hasstages, hascourses, courses, until, newhomeages
    * digitaladd, digitaladdhint, digitalfile, digitalurl, digitalurlhint, digitaltitlefield, digitallicence,
      digitallicencehint, digitalaudience, digitalstages, digitaldownload, digitalsave, digitaldelete, digitalread,
      digitalchange, digitalnone, fragmentcourse, fragmentnone, fragmentpages, fragmentpageshint, fragmentuntil,
      fragmenthint, digitalhome, digitalhomehint

    Example context (json):
    {
        "heading": "La ladrona del faro", "eyebrow": "En digital", "authors": "Ana Ruiz", "hascover": false, "coverurl": "data:image/gif;base64,R0lGODlhAQABAAAAACw=", "colour": 2,
        "intro": "Manda su licencia.", "notice": "", "action": "https://example.org/digital.php", "sesskey": "abc", "hasitems": true,
        "recordurl": "#", "close": "Cerrar", "hasstages": true, "hascourses": true, "until": "2027-06-30",
        "items": [{"id": 1, "title": "Capítulo 3", "rawtitle": "Capítulo 3", "format": "PDF", "formatkey": "pdf",
            "licencelabel": "Con derechos de otros", "audiencechips": ["Alumnos"], "onlyline": "Solo para Lengua 2.º, hasta el 30 jun",
            "readurl": "#", "licences": [{"value": "rights", "label": "Con derechos de otros", "selected": true}],
            "audiences": [{"value": "students", "label": "Alumnos", "checked": true}],
            "stages": [{"value": "Primaria", "checked": false}], "download": false,
            "courses": [{"id": 3, "name": "Lengua 2.º", "selected": true}], "pages": "pp. 45-60", "until": "2027-06-30",
            "homeages": [{"value": 3, "label": "3 a 5", "checked": true}], "homechip": "En casa: 3 a 5", "homepublic": true,
            "homenotpublic": "Para leer en casa, primero tiene que verlo cualquiera: toca «Cualquiera (la ventana pública)» en «Quién lo ve».",
            "homelines": [{"value": 3, "linelabel": "Por qué es bonito, de 3 a 5", "line": "Corto y tranquilo."}],
            "homeminutes": 4, "homeparts": 12, "homenight": true, "homeorder": ""}],
        "licences": [{"value": "rights", "label": "Con derechos de otros", "selected": true}],
        "audiences": [{"value": "staff", "label": "Personal", "checked": true}],
        "stages": [{"value": "Primaria", "checked": false}],
        "courses": [{"id": 3, "name": "Lengua 2.º", "selected": false}],
        "newhomeages": [{"value": 3, "label": "3 a 5", "checked": false}],
        "newhomelines": [{"value": 3, "linelabel": "Por qué es bonito, de 3 a 5", "line": ""}],
        "digitalhomeminutes": "Minutos", "digitalhomeparts": "Páginas", "digitalhomepartshint": "o capítulos",
        "digitalhomelinehint": "Una línea", "digitalhomenight": "Para antes de dormir", "digitalhomeorder": "Orden",
        "digitalhomeorderhint": "Sin número, los más cortos primero",
        "digitalhome": "Para leer en casa", "digitalhomehint": "Sale en «Cuentos para leer en casa».",
        "digitaladd": "Añadir una forma digital", "digitaladdhint": "EPUB, PDF, audio, vídeo o un enlace",
        "digitalfile": "Un fichero", "digitalurl": "O un enlace", "digitalurlhint": "a donde está",
        "digitaltitlefield": "Título", "digitallicence": "Licencia", "digitallicencehint": "La licencia manda",
        "digitalaudience": "Para quién", "digitalstages": "Solo estas etapas", "digitaldownload": "Se puede descargar",
        "digitalsave": "Guardar", "digitaldelete": "Quitarlo", "digitalread": "Abrirlo", "digitalchange": "Cambiar",
        "digitalnone": "Nada todavía", "fragmentcourse": "Solo para los alumnos de un curso", "fragmentnone": "No",
        "fragmentpages": "Qué parte", "fragmentpageshint": "pp. 45-60", "fragmentuntil": "Hasta", "fragmenthint": "Solo sus matriculados."
    }
}}
<header class="ayv-dig-head">
    <span class="ayv-dig-cover ayv-cover ayv-cover-{{colour}}{{#hascover}} ayv-cover-photo{{/hascover}}" aria-hidden="true">{{#hascover}}<img class="ayv-cover-img" src="{{coverurl}}" alt="">{{/hascover}}</span>
    <div class="ayv-dig-who">
        <p class="ayv-dig-eyebrow">{{eyebrow}}</p>
        <h1 class="ayv-results-title">{{heading}}</h1>
        {{#authors}}<p class="ayv-dig-authors">{{authors}}</p>{{/authors}}
        <p class="ayv-dig-intro">{{intro}}</p>
    </div>
</header>
{{#notice}}<p class="ayv-notice" role="status">{{notice}}</p>{{/notice}}
<ul class="ayv-dig-grid ayv-dg">
    <li class="ayv-dg-nueva-li">
        {{! Adding: the file or the link and nothing else; the rest is set on its card, as any other. }}
        <form class="ayv-dig-new ayv-dg-nueva" method="post" action="{{action}}" enctype="multipart/form-data">
            <input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="do" value="add">
            <span class="ayv-dig-plus" aria-hidden="true">{{> local_oksigeniaayvurenda/icon_plus}}</span>
            <strong>{{digitaladd}}</strong><span>{{digitaladdhint}}</span>
            <label class="ayv-dg-fichero"><input type="file" data-ayv-own name="file" accept=".epub,.pdf,.mp3,.m4a,.m4b,.ogg,.oga,.opus,.wav,.flac,.aac,.mp4,.webm,.ogv,.mov" data-ayv-submit><span>{{digitalfile}}</span></label>
            <span class="ayv-dg-o">{{digitalor}}</span>
            <span class="ayv-dg-enlace"><label class="ayv-sr" for="ayv-dg-url">{{digitalurl}}</label><input id="ayv-dg-url" type="text" name="url" inputmode="url" spellcheck="false" placeholder="{{digitalurlplaceholder}}"><button class="ayv-cf-chapa ayv-cf-chapa-sola" type="submit">{{digitaladdgo}}</button></span>
            <span class="ayv-dg-nota">{{digitaladdafter}}</span>
        </form></li>
    {{#items}}
    <li class="ayv-dig-card{{#open}} ayv-dg-abierta{{/open}}" id="ayv-dg-{{id}}">
        <div class="ayv-dg-cara">
            <span class="ayv-dig-format ayv-dig-format-{{formatkey}}">{{format}}</span>
            <h2 class="ayv-dig-title">{{title}}</h2>
            <p class="ayv-dig-licence">{{licencelabel}}</p>
            <ul class="ayv-dig-chips">{{#accessible}}<li class="ayv-dig-chip-access">{{digitalaccessiblechip}}</li>{{/accessible}}{{#audiencechips}}<li>{{.}}</li>{{/audiencechips}}{{#homechip}}<li class="ayv-dig-chip-home">{{homechip}}</li>{{/homechip}}</ul>
            {{#onlyline}}<p class="ayv-dig-only">{{onlyline}}{{#pages}} · {{pages}}{{/pages}}</p>{{/onlyline}}
            {{#proxied}}<p class="ayv-dig-only">{{digitalsubscribedline}}</p>{{/proxied}}
            <p class="ayv-dig-actions"><a class="ayv-button" href="{{readurl}}">{{digitalread}}</a>
                {{^open}}<a class="ayv-button ayv-button-quiet" href="{{changeurl}}">{{> local_oksigeniaayvurenda/icon_pencil}} {{digitalchange}}</a>{{/open}}
                {{#open}}<a class="ayv-button ayv-button-quiet" href="{{releaseurl}}">{{digitaldone}}</a>{{/open}}</p>
        </div>
        {{#open}}
        <form id="ayv-dg-f-{{id}}" method="post" action="{{action}}#ayv-dg-{{id}}"><input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="item" value="{{id}}"><input type="hidden" name="do" value="set"></form>
        <div class="ayv-dg-gestos">
            {{#justsaved}}<p class="ayv-dg-guardado"><span class="ayv-cf-guardado" role="status">{{savedword}}</span></p>{{/justsaved}}
            <form class="ayv-sd-escribir ayv-dg-titulo" method="post" action="{{action}}#ayv-dg-{{id}}" data-ayv-autosave="{{savedword}}"><input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="item" value="{{id}}"><input type="hidden" name="do" value="set">
                <label><span class="ayv-cf-rotulo">{{digitaltitlefield}}</span><input type="text" name="title" value="{{rawtitle}}" maxlength="255"></label>
                <span class="ayv-autosaved" role="status" aria-live="polite"></span>
                <p class="ayv-book-actions ayv-autosave-button"><button type="submit" class="ayv-button ayv-button-quiet">{{digitalsave}}</button></p></form>
            <section class="ayv-dg-grupo" aria-labelledby="ayv-dg-{{id}}-quien">
                <h3 id="ayv-dg-{{id}}-quien">{{digitalwhosees}}</h3>
                <div class="ayv-cf-fila"><span class="ayv-cf-rotulo">{{digitallicence}}</span><span class="ayv-cf-chapas">{{#licences}}<button class="ayv-cf-chapa" type="submit" form="ayv-dg-f-{{id}}" name="licence" value="{{value}}" aria-pressed="{{#selected}}true{{/selected}}{{^selected}}false{{/selected}}">{{label}}</button>{{/licences}}</span></div>
                <p class="ayv-cf-nota">{{digitallicencehint}}</p>
                <div class="ayv-cf-fila"><span class="ayv-cf-rotulo">{{digitalaudience}}</span><span class="ayv-cf-chapas">{{#audiences}}<button class="ayv-cf-chapa" type="submit" form="ayv-dg-f-{{id}}" name="toggle" value="audience:{{value}}" aria-pressed="{{#checked}}true{{/checked}}{{^checked}}false{{/checked}}">{{label}}</button>{{/audiences}}</span></div>
                {{#hasstages}}<div class="ayv-cf-fila"><span class="ayv-cf-rotulo">{{digitalstages}}</span><span class="ayv-cf-luces">{{#stages}}<button class="ayv-cf-luz" type="submit" form="ayv-dg-f-{{id}}" name="toggle" value="stage:{{value}}" aria-pressed="{{#checked}}true{{/checked}}{{^checked}}false{{/checked}}"><span class="ayv-cf-bombilla" aria-hidden="true"></span><span>{{value}}</span></button>{{/stages}}</span></div>{{/hasstages}}
                <div class="ayv-cf-luces ayv-dg-interruptores">
                    <button class="ayv-cf-luz" type="submit" form="ayv-dg-f-{{id}}" name="download" value="{{#download}}0{{/download}}{{^download}}1{{/download}}" aria-pressed="{{#download}}true{{/download}}{{^download}}false{{/download}}"><span class="ayv-cf-bombilla" aria-hidden="true"></span><span>{{digitaldownload}}</span></button>
                    <button class="ayv-cf-luz" type="submit" form="ayv-dg-f-{{id}}" name="accessible" value="{{#accessible}}0{{/accessible}}{{^accessible}}1{{/accessible}}" aria-pressed="{{#accessible}}true{{/accessible}}{{^accessible}}false{{/accessible}}"><span class="ayv-cf-bombilla" aria-hidden="true"></span><span>{{digitalaccessible}}</span></button>
                    {{#canproxy}}<button class="ayv-cf-luz" type="submit" form="ayv-dg-f-{{id}}" name="subscribed" value="{{#subscribed}}0{{/subscribed}}{{^subscribed}}1{{/subscribed}}" aria-pressed="{{#subscribed}}true{{/subscribed}}{{^subscribed}}false{{/subscribed}}"><span class="ayv-cf-bombilla" aria-hidden="true"></span><span>{{digitalsubscribed}}</span></button>{{/canproxy}}
                </div>
            </section>
            <section class="ayv-dg-grupo" aria-labelledby="ayv-dg-{{id}}-casa">
                <h3 id="ayv-dg-{{id}}-casa">{{digitalhome}}</h3>
                {{^homepublic}}<p class="ayv-cf-nota ayv-dg-falta">{{homenotpublic}}</p>{{/homepublic}}
                {{#homepublic}}
                <p class="ayv-cf-nota">{{digitalhomehint}}</p>
                <div class="ayv-cf-fila"><span class="ayv-cf-rotulo">{{digitalhomeages}}</span><span class="ayv-cf-luces">{{#homeages}}<button class="ayv-cf-luz" type="submit" form="ayv-dg-f-{{id}}" name="toggle" value="homeage:{{value}}" aria-pressed="{{#checked}}true{{/checked}}{{^checked}}false{{/checked}}"><span class="ayv-cf-bombilla" aria-hidden="true"></span><span>{{label}}</span></button>{{/homeages}}</span></div>
                {{#home}}
                <div class="ayv-dg-numeros">
                    <div class="ayv-cf-numero"><span class="ayv-cf-rotulo">{{digitalhomeminutes}}</span><span class="ayv-cf-paso" role="group" aria-label="{{digitalhomeminutes}}"><button class="ayv-cf-menos" type="submit" form="ayv-dg-f-{{id}}" name="homeminutes" value="{{minutesless}}" aria-label="{{lesslabel}}"{{#minutesmin}} disabled{{/minutesmin}}>−</button><span class="ayv-cf-cifra"><b>{{homeminutes}}</b> min</span><button class="ayv-cf-mas" type="submit" form="ayv-dg-f-{{id}}" name="homeminutes" value="{{minutesmore}}" aria-label="{{morelabel}}">+</button></span></div>
                    <div class="ayv-cf-numero"><span class="ayv-cf-rotulo">{{digitalhomeparts}}</span><span class="ayv-cf-paso" role="group" aria-label="{{digitalhomeparts}}"><button class="ayv-cf-menos" type="submit" form="ayv-dg-f-{{id}}" name="homeparts" value="{{partsless}}" aria-label="{{lesslabel}}"{{#partsmin}} disabled{{/partsmin}}>−</button><span class="ayv-cf-cifra"><b>{{homeparts}}</b></span><button class="ayv-cf-mas" type="submit" form="ayv-dg-f-{{id}}" name="homeparts" value="{{partsmore}}" aria-label="{{morelabel}}">+</button></span></div>
                    <div class="ayv-cf-numero"><span class="ayv-cf-rotulo">{{digitalhomeorder}}</span><span class="ayv-cf-paso" role="group" aria-label="{{digitalhomeorder}}"><button class="ayv-cf-menos" type="submit" form="ayv-dg-f-{{id}}" name="homeorder" value="{{orderless}}" aria-label="{{lesslabel}}"{{#ordermin}} disabled{{/ordermin}}>−</button><span class="ayv-cf-cifra">{{#homeorder}}<b>{{homeorder}}.º</b>{{/homeorder}}{{^homeorder}}{{digitalhomeorderauto}}{{/homeorder}}</span><button class="ayv-cf-mas" type="submit" form="ayv-dg-f-{{id}}" name="homeorder" value="{{ordermore}}" aria-label="{{morelabel}}">+</button></span></div>
                </div>
                <div class="ayv-cf-luces"><button class="ayv-cf-luz" type="submit" form="ayv-dg-f-{{id}}" name="homenight" value="{{#homenight}}0{{/homenight}}{{^homenight}}1{{/homenight}}" aria-pressed="{{#homenight}}true{{/homenight}}{{^homenight}}false{{/homenight}}"><span class="ayv-cf-bombilla" aria-hidden="true"></span><span>{{digitalhomenight}}</span></button></div>
                <form class="ayv-sd-escribir" method="post" action="{{action}}#ayv-dg-{{id}}" data-ayv-autosave="{{savedword}}"><input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="item" value="{{id}}"><input type="hidden" name="do" value="set">
                    {{#homelines}}<label><span class="ayv-cf-rotulo">{{linelabel}}</span><input type="text" name="homelines[{{value}}]" value="{{line}}" maxlength="160" placeholder="{{digitalhomelinehint}}"></label>{{/homelines}}
                    <span class="ayv-autosaved" role="status" aria-live="polite"></span>
                    <p class="ayv-book-actions ayv-autosave-button"><button type="submit" class="ayv-button ayv-button-quiet">{{digitalsave}}</button></p></form>
                {{/home}}
                {{/homepublic}}
            </section>
            {{#hascourses}}
            <section class="ayv-dg-grupo" aria-labelledby="ayv-dg-{{id}}-curso">
                <h3 id="ayv-dg-{{id}}-curso">{{fragmentcourse}}</h3>
                <p class="ayv-cf-nota">{{fragmenthint}}</p>
                <div class="ayv-cf-chapas">{{#courses}}<button class="ayv-cf-chapa" type="submit" form="ayv-dg-f-{{id}}" name="forcourse" value="{{id}}" aria-pressed="{{#selected}}true{{/selected}}{{^selected}}false{{/selected}}">{{name}}</button>{{/courses}}<button class="ayv-cf-chapa ayv-sd-ninguno" type="submit" form="ayv-dg-f-{{id}}" name="forcourse" value="0" aria-pressed="{{#nocourse}}true{{/nocourse}}{{^nocourse}}false{{/nocourse}}">{{fragmentnone}}</button></div>
                {{#course}}
                <form class="ayv-sd-escribir" method="post" action="{{action}}#ayv-dg-{{id}}" data-ayv-autosave="{{savedword}}"><input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="item" value="{{id}}"><input type="hidden" name="do" value="set">
                    <label><span class="ayv-cf-rotulo">{{fragmentpages}}</span><input type="text" name="pages" value="{{pages}}" maxlength="100" placeholder="{{fragmentpageshint}}"></label>
                    <span class="ayv-autosaved" role="status" aria-live="polite"></span>
                    <p class="ayv-book-actions ayv-autosave-button"><button type="submit" class="ayv-button ayv-button-quiet">{{digitalsave}}</button></p></form>
                <span class="ayv-ct-fecha ayv-dg-hasta"><span class="ayv-cf-rotulo">{{fragmentuntil}}</span><span class="ayv-ct-fecha-fila"><button class="ayv-cf-menos" type="submit" form="ayv-dg-f-{{id}}" name="until" value="{{untilless}}" aria-label="{{fragmentuntil}}: {{weekless}}">−</button>{{#untilsheet}}<span class="ayv-cf-hoja ayv-ct-hoja"><small>{{month}}</small><b>{{day}}</b><small>{{week}}</small></span>{{/untilsheet}}<button class="ayv-cf-mas" type="submit" form="ayv-dg-f-{{id}}" name="until" value="{{untilmore}}" aria-label="{{fragmentuntil}}: {{weekmore}}">+</button></span></span>
                {{/course}}
            </section>
            {{/hascourses}}
            <details class="ayv-cf-quitar ayv-dg-quitar"><summary>{{digitaldelete}}</summary><button class="ayv-button ayv-cf-peligro" type="submit" form="ayv-dg-f-{{id}}" name="do" value="delete">{{digitaldeletesure}}</button></details>
        </div>
        {{/open}}
    </li>
    {{/items}}
</ul>
