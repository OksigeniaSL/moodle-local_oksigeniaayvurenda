{{!
    @template local_oksigeniaayvurenda/cards

    Cards of records: a drawn cover, the title, the authors and whether it is free in this library.

    Context variables required for this template:
    * cards - list of records with id, title, authors, colour, url, statelabel, stateclass and location

    Example context (json):
    {
        "cards": [
            {"id": 1, "title": "El faro dormido", "authors": "Ana Montes", "colour": 2, "url": "#",
             "statelabel": "Libre", "stateclass": "free", "location": "Estantería infantil"},
            {"id": 2, "title": "La isla de los animales", "authors": "", "colour": 4, "url": "#",
             "statelabel": "Prestado", "stateclass": "out", "location": null}
        ]
    }
}}
<ul class="ayv-cards">
{{#cards}}
    <li class="ayv-card">
        <a class="ayv-card-link" href="{{url}}">
            <span class="ayv-cover ayv-cover-{{colour}}" aria-hidden="true">
                <span class="ayv-cover-title">{{title}}</span>
            </span>
            <span class="ayv-card-title">{{title}}</span>
            {{#authors}}<span class="ayv-card-authors">{{authors}}</span>{{/authors}}
            <span class="ayv-state ayv-state-{{stateclass}}">{{statelabel}}</span>
            {{#location}}<span class="ayv-where">{{location}}</span>{{/location}}
        </a>
    </li>
{{/cards}}
</ul>
