{{!
    @template local_oksigeniaayvurenda/year

    The school year: what its beginning asks, its end, last year in numbers and the day it starts.

    Context variables required for this template:
    * heading, dates, notice - texts
    * ending - text, url and label when the year is ending with books out
    * cards - number, label, url, late
    * left - readers who left with books (name, group, bookslabel)
    * last - last year in numbers: heading, total, groups (group, line, share)
    * days, months - options of the start day

    Example context (json):
    {
        "heading": "Curso 2026-2027",
        "dates": "Del 1 de septiembre de 2026 al 31 de agosto de 2027.",
        "notice": "",
        "ending": null,
        "cards": [{"number": 30, "label": "grupos, 2000 lectores", "url": "#", "late": false}],
        "startintro": "Basta con mover las cohortes en Moodle.",
        "action": "#",
        "sesskey": "abc",
        "sync": "Traer ahora los grupos",
        "hasleft": true,
        "left": [{"name": "Ana Montes", "group": "6º Primaria A", "bookslabel": "1 libro"}],
        "leftheading": "Se fueron con libros",
        "leftintro": "Estaban en un grupo el curso pasado y este no.",
        "last": {"heading": "2025-2026 en cifras", "total": "1200 préstamos.", "groups": [{"group": "3º A", "line": "18 de 25 lectores", "share": 72}]},
        "startheading": "Cuándo empieza el curso",
        "startnote": "Desde el curso que viene.",
        "days": [{"value": 1, "label": 1, "selected": true}],
        "months": [{"value": 9, "label": "septiembre", "selected": true}],
        "daylabel": "Día",
        "monthlabel": "Mes",
        "save": "Guardar",
        "hasclosures": true, "closuresheading": "Días cerrados", "closuresintro": "Nada vence en un día cerrado.",
        "closuresnone": "Ningún día cerrado.", "closuresadd": "Añadir días cerrados", "closuresremove": "Quitar",
        "closuresname": "Nombre", "closuresnamehint": "Navidad, Semana Santa", "closuresfrom": "Desde", "closuresto": "Hasta",
        "closuressave": "Guardar", "closuresclose": "Cerrar", "closurestoday": "2026-11-07",
        "closures": [{"name": "Navidad", "when": "del 23 de diciembre al 7 de enero", "from": "2026-12-23", "to": "2027-01-07", "past": false}]
    }
}}
<h1 class="ayv-results-title">{{heading}}</h1>
<p>{{dates}}</p>
{{#notice}}<p class="ayv-notice" role="status">{{notice}}</p>{{/notice}}
{{#ending}}<p class="ayv-notice">{{text}} <a href="{{url}}">{{label}}</a></p>{{/ending}}
<ul class="ayv-today">
{{#cards}}
    <li><a class="ayv-today-card {{#late}}ayv-today-late{{/late}}" href="{{url}}"><span class="ayv-today-number">{{number}}</span>
        <span class="ayv-today-label">{{label}}</span></a></li>
{{/cards}}
</ul>
<form method="post" action="{{action}}" class="ayv-section">
    <input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="do" value="sync">
    <p>{{startintro}}</p>
    <p><button type="submit" class="ayv-button ayv-button-quiet">{{sync}}</button></p>
</form>
{{#hasleft}}
<section class="ayv-section" id="ayv-left">
    <h2 class="ayv-section-title">{{leftheading}}</h2>
    <p>{{leftintro}}</p>
    <ul class="ayv-people">
    {{#left}}
        <li class="ayv-person"><span class="ayv-person-name">{{name}}</span> <span>{{group}}</span>
            <span class="ayv-person-card ayv-is-late">{{bookslabel}}</span></li>
    {{/left}}
    </ul>
</section>
{{/hasleft}}
{{#last}}
<section class="ayv-section">
    <h2 class="ayv-section-title">{{heading}}</h2>
    <p>{{total}}</p>
    <ul class="ayv-people">
    {{#groups}}
        <li class="ayv-person"><span class="ayv-person-name">{{group}}</span> <span>{{line}}</span>
            <span class="ayv-share" aria-hidden="true"><span style="width: {{share}}%"></span></span></li>
    {{/groups}}
    </ul>
</section>
{{/last}}
<section class="ayv-section" id="ayv-closures">
    <h2 class="ayv-section-title">{{closuresheading}}</h2>
    <p>{{closuresintro}}</p>
    {{#hasclosures}}
    <ul class="ayv-closures">
        {{#closures}}
        <li class="ayv-closure{{#past}} ayv-closure-past{{/past}}">
            <span class="ayv-closure-words"><b>{{name}}</b> <span>{{when}}</span></span>
            <form method="post" action="{{action}}">
                <input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="do" value="closedremove">
                <input type="hidden" name="from" value="{{from}}"><input type="hidden" name="to" value="{{to}}">
                <button type="submit" class="ayv-button ayv-button-quiet">{{closuresremove}}</button>
            </form>
        </li>
        {{/closures}}
    </ul>
    {{/hasclosures}}
    {{^hasclosures}}<p class="ayv-empty">{{closuresnone}}</p>{{/hasclosures}}
    <p class="ayv-book-actions"><button type="button" class="ayv-button" data-ayv-open="ayv-closure-new">{{closuresadd}}</button></p>
    <dialog class="ayv-modal" id="ayv-closure-new" aria-labelledby="ayv-closure-new-title">
        <div class="ayv-modal-head"><h3 id="ayv-closure-new-title" class="ayv-section-title">{{closuresadd}}</h3>
            <form method="dialog"><button class="ayv-modal-close" aria-label="{{closuresclose}}">{{> local_oksigeniaayvurenda/icon_x}}</button></form></div>
        <form method="post" action="{{action}}#ayv-closures">
            <input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="do" value="closedadd">
            <label class="ayv-field">{{closuresname}} <span class="ayv-field-hint">{{closuresnamehint}}</span> <input type="text" name="label" maxlength="60"></label>
            <label class="ayv-field">{{closuresfrom}} <input type="date" name="from" value="{{closurestoday}}" required></label>
            <label class="ayv-field">{{closuresto}} <input type="date" name="to" value="{{closurestoday}}" required></label>
            <p class="ayv-book-actions"><button type="submit" class="ayv-button">{{closuressave}}</button></p>
        </form>
    </dialog>
</section>
<section class="ayv-section">
    <h2 class="ayv-section-title">{{startheading}}</h2>
    <form method="post" action="{{action}}" class="ayv-inline-form">
        <input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="do" value="start">
        <label class="ayv-field">{{daylabel}} <select name="day">{{#days}}<option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>{{/days}}</select></label>
        <label class="ayv-field">{{monthlabel}} <select name="month">{{#months}}<option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>{{/months}}</select></label>
        <button type="submit" class="ayv-button">{{save}}</button>
    </form>
    <p>{{startnote}}</p>
</section>
