{{!
    @template local_oksigeniaayvurenda/reports

    One of the six fixed reports: its filters, its lines with a bar, and the CSV.

    Context variables required for this template:
    * heading, intro, summary, empty - texts
    * figure - the sentence of a period: lead (the figure, in the letter of titles) and rest; or nothing
    * tabs - url, label, current
    * action, library, report - the form; period (from, to) or never (unlent, older)
    * rows - label, value, note, share (bar, 0 to 100), part
    * csv - address of the CSV

    Example context (json):
    {
        "heading": "Préstamos por grupo",
        "intro": "Cuántos préstamos hubo en el periodo, por grupo.",
        "tabs": [{"url": "#", "label": "Préstamos por grupo", "current": true}],
        "action": "#",
        "library": "central",
        "report": "loans",
        "period": {"label": "El periodo", "sheets": [{"name": "Esta semana", "dates": "9 al 15 nov",
            "url": "https://example.org/reports.php?periodo=semana", "current": true, "other": false}],
            "strip": {"prompt": "Desde <b>octubre</b>. Toca el último mes:", "months": [{"label": "oct",
                "url": "https://example.org/reports.php?desde=2026-10", "first": true}],
                "days": "https://example.org/year.php", "dayslabel": "Por días exactos"} },
        "reportsnav": "Informes",
        "never": null,
        "summary": "", "figure": {"lead": "325 préstamos", "rest": "en octubre."},
        "hasrows": true,
        "rows": [{"label": "3º A", "url": "https://example.org/readers.php", "value": 40, "note": "18 de 25 lectores", "share": 100, "part": ""}],
        "empty": "",
        "csv": "#",
        "reportfrom": "Desde", "reportto": "Hasta", "reportunlent": "Sin prestar desde hace (años)",
        "reportolder": "Adquiridos hace más de (años)", "labelsshow": "Ver", "reportcsv": "Descargar en CSV"
    }
}}
{{> local_oksigeniaayvurenda/life }}
<div class="ayv-cf ayv-in">
<h1 class="ayv-results-title">{{heading}}</h1>
<p>{{intro}}</p>
<nav class="ayv-in-fichas" aria-label="{{reportsnav}}">
{{#tabs}}<a class="ayv-in-ficha" href="{{url}}" {{#current}}aria-current="page"{{/current}}>{{label}}</a>{{/tabs}}
</nav>
<section class="ayv-in-hoja">
{{#period}}
<div class="ayv-in-periodo" role="group" aria-labelledby="ayv-in-p">
    <span class="ayv-cf-rotulo" id="ayv-in-p">{{label}}</span>
    <div class="ayv-in-periodos">{{#sheets}}<a class="ayv-in-p{{#other}} ayv-in-p-otro{{/other}}" href="{{url}}"{{#current}} aria-current="true"{{/current}}><b>{{name}}</b><span>{{dates}}</span></a>{{/sheets}}</div>
    {{#strip}}<div class="ayv-in-meses" id="ayv-in-meses"><p class="ayv-cf-nota">{{{prompt}}}</p>
        <div class="ayv-in-tira">{{#months}}{{#url}}<a class="ayv-in-m{{#first}} ayv-in-m-desde{{/first}}" href="{{url}}">{{label}}</a>{{/url}}{{^url}}<span class="ayv-in-m ayv-in-m-no">{{label}}</span>{{/url}}{{/months}}</div>
        <a class="ayv-cf-enlace" href="{{days}}">{{dayslabel}}</a></div>{{/strip}}
</div>
{{/period}}
{{#never}}
<form method="get" action="{{action}}" class="ayv-inline-form">
    <input type="hidden" name="library" value="{{library}}"><input type="hidden" name="report" value="{{report}}">
    <label class="ayv-field">{{reportunlent}} <input type="number" min="0" max="50" name="unlent" value="{{unlent}}"></label>
    <label class="ayv-field">{{reportolder}} <input type="number" min="0" max="80" name="older" value="{{older}}"></label>
    <button type="submit" class="ayv-button ayv-button-quiet">{{labelsshow}}</button>
</form>
{{/never}}
<div class="ayv-report-top">
    {{#summary}}<p class="ayv-report-sum">{{summary}}</p>{{/summary}}
    {{#figure}}<p class="ayv-report-sum ayv-in-cifra"><b>{{lead}}</b> {{rest}}</p>{{/figure}}
    {{#hasrows}}<p class="ayv-more"><a class="ayv-button ayv-button-quiet" href="{{csv}}">{{reportcsv}}</a></p>{{/hasrows}}
</div>
{{#hasrows}}
<ul class="ayv-people ayv-report">
{{#rows}}
    <li class="ayv-person">
        <span class="ayv-person-name">{{#part}}<span class="ayv-report-part">{{part}}</span> {{/part}}{{#url}}<a href="{{url}}">{{label}}</a>{{/url}}{{^url}}{{label}}{{/url}}</span>
        <span class="ayv-report-value">{{value}}</span>
        <span class="ayv-report-note">{{note}}</span>
        {{#share}}<span class="ayv-share" aria-hidden="true"><span style="width: {{share}}%"></span></span>{{/share}}
    </li>
{{/rows}}
</ul>
{{/hasrows}}
{{^hasrows}}<p class="ayv-empty">{{empty}}</p>{{/hasrows}}
</section>
</div>
