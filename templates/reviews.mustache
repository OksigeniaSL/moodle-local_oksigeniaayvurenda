{{!
    @template local_oksigeniaayvurenda/reviews

    The reviews waiting for the library: the book, what the reader says and who, and a touch to publish it or not.

    Example context (json):
    {
        "heading": "Reseñas por revisar", "intro": "Un toque y sale en la ficha.", "notice": "", "empty": "No hay.",
        "action": "#", "sesskey": "abc", "publish": "Publicar", "decline": "No publicar", "hasitems": true,
        "items": [{"id": 1, "title": "El faro dormido", "url": "#", "text": "Me gustó el final.", "who": "Leo, 3.º A",
            "when": "25/10/26", "forlittle": "", "drawing": null, "drawingalt": "Dibujo de Leo", "voice": null,
            "voicelabel": "La voz de Leo"}]
    }
}}
<h1 class="ayv-results-title">{{heading}}</h1>
<p>{{intro}}</p>
{{#notice}}<p class="ayv-notice" role="status">{{notice}}</p>{{/notice}}
{{#hasitems}}
<ul class="ayv-review-queue">
    {{#items}}
    <li class="ayv-review-card">
        <a class="ayv-review-book" href="{{url}}">{{title}}</a>
        {{#drawing}}<img class="ayv-review-drawing" src="{{drawing}}" alt="{{drawingalt}}">{{/drawing}}
        {{#voice}}<audio class="ayv-review-voice" controls preload="none" src="{{voice}}" aria-label="{{voicelabel}}"></audio>{{/voice}}
        {{#text}}<p class="ayv-review-text">«{{text}}»</p>{{/text}}
        <p class="ayv-review-who">{{who}} · {{when}}</p>
        {{#forlittle}}<p class="ayv-field-hint">{{forlittle}}</p>{{/forlittle}}
        <form method="post" action="{{action}}" class="ayv-book-actions">
            <input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="review" value="{{id}}">
            <button type="submit" class="ayv-button" name="do" value="publish">{{publish}}</button>
            <button type="submit" class="ayv-button ayv-button-quiet" name="do" value="decline">{{decline}}</button>
        </form>
    </li>
    {{/items}}
</ul>
{{/hasitems}}
{{^hasitems}}<p class="ayv-empty">{{empty}}</p>{{/hasitems}}
