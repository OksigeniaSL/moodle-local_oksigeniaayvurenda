{{!
    @template local_oksigeniaayvurenda/voice_recorder
    @copyright  2026 Oksigenia SL <dev@oksigenia.cc>
    @license    https://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later

    The recorder: record, pause, stop, listen, say what was read, send. A reading in parts chooses its part first, from
    the book's chapters as chips (the next one ready), and the soft sound under the whole reading, if the site has any.

    Example context (json):
    {
        "voicerecord": "Grabar", "voicestop": "Parar", "voiceagain": "Volver a grabar", "voicewhat": "Qué has leído",
        "voicewhathint": "un capítulo, unas páginas", "voicesend": "Enviar", "consent": false,
        "voiceforwho": "¿Para quién es?", "voiceforlittle": "Lo he leído para los pequeños", "voicefamily": "Que lo oiga mi familia",
        "forwho": {"bud": "https://example.com/capullo.webp", "family": true,
            "off": "Si es para los pequeños, lo escucharán en su portada cuando lo aprueben.",
            "on": "Los más pequeños lo escucharán en su portada cuando lo aprueben.",
            "familyon": "Tu familia recibirá un enlace para escucharlo."},
        "voicesignature": "Firma", "voicesignaturehint": "si quieres", "askemail": true, "voiceemail": "Tu correo",
        "voiceemailhint": "si quieres el enlace para borrarla", "voicepause": "Pausa", "voiceresume": "Seguir",
        "parts": {"partswhich": "Qué vas a leer ahora", "partsprogress": "Llevas la presentación y el capítulo 1.",
            "partschapter": "Capítulo", "partsmore": "Más", "partsother": "Otra cosa", "partsname": "Título de esta parte",
            "partsnamehint": "si quieres", "barpart": "Capítulo 2", "partsopening": {"chipvalue": 0,
                "chiptitle": "Presentación", "chiplabel": "Presentación", "chipdone": true, "chipwaiting": false,
                "chipchecked": false, "chipstate": "ya grabada", "chipsound": "mar"},
            "chips": [{"chipvalue": 1, "chiptitle": "Capítulo 1", "chiplabel": "1", "chipdone": false, "chipwaiting": true,
                "chipchecked": false, "chipstate": "esperando a que la aprueben", "chipsound": "mar"},
                {"chipvalue": 2, "chiptitle": "Capítulo 2", "chiplabel": "2", "chipdone": false, "chipwaiting": false,
                "chipchecked": true, "chipstate": "", "chipsound": ""}]},
        "backdroptitle": "Un fondo bajito, si quieres", "backdropchip": "Fondo: {$a}", "backdropdone": "Listo",
        "aftertitle": "Así ha quedado: {$a}",
        "backdrops": {"backdropwhich": "Suena debajo de tu voz en «Capítulo 2». Quien escucha lo puede quitar.",
            "options": [{"bdkey": "", "bdogg": "", "bdm4a": "", "bdlabel": "Sin fondo", "bdchecked": true},
                {"bdkey": "mar", "bdogg": "https://example.com/mar.ogg", "bdm4a": "https://example.com/mar.m4a",
                "bdlabel": "Mar", "bdchecked": false}]}
    }
}}
<div class="ayv-book ayv-recorder" id="ayv-recorder">
    {{#parts}}
    <div class="ayv-vp" id="ayv-vp" role="radiogroup" aria-labelledby="ayv-vp-t">
        <p class="ayv-vp-title" id="ayv-vp-t"><b>{{partswhich}}</b></p>
        <p class="ayv-field-hint ayv-vp-progress">{{partsprogress}}</p>
        <div class="ayv-vp-chips" id="ayv-vp-chips-parts">
            {{#partsopening}}<label class="ayv-vp-chip{{#chipdone}} is-done{{/chipdone}}{{#chipwaiting}} is-waiting{{/chipwaiting}}"><input type="radio" name="ayv-part" value="{{chipvalue}}" data-title="{{chiptitle}}" data-sound="{{chipsound}}"{{#chipchecked}} checked{{/chipchecked}}><span class="ayv-vp-word">{{chiplabel}}</span>{{#chipstate}}<span class="ayv-sr"> · {{chipstate}}</span>{{/chipstate}}</label>{{/partsopening}}
            <span class="ayv-vp-label" aria-hidden="true">{{partschapter}}</span>
            {{#chips}}<label class="ayv-vp-chip ayv-vp-number{{#chipdone}} is-done{{/chipdone}}{{#chipwaiting}} is-waiting{{/chipwaiting}}"><input type="radio" name="ayv-part" value="{{chipvalue}}" data-title="{{chiptitle}}" data-sound="{{chipsound}}" aria-label="{{chiptitle}}{{#chipstate}} · {{chipstate}}{{/chipstate}}"{{#chipchecked}} checked{{/chipchecked}}><span class="ayv-vp-word" aria-hidden="true">{{chiplabel}}</span></label>{{/chips}}
            <button type="button" class="ayv-vp-more-button" id="ayv-vp-more">{{> local_oksigeniaayvurenda/icon_plus}}<span>{{partsmore}}</span></button>
            <label class="ayv-vp-chip"><input type="radio" name="ayv-part" value="-1" data-title=""><span class="ayv-vp-word">{{partsother}}</span></label>
        </div>
    </div>
    {{/parts}}
    {{#backdrops}}
    <div class="ayv-vp ayv-vp-backdrops" id="ayv-vp-backdrops" role="radiogroup" aria-labelledby="ayv-vp-bt">
        <p class="ayv-vp-title" id="ayv-vp-bt"><b>{{backdroptitle}}</b> <span class="ayv-field-hint" id="ayv-vp-bt-word">{{backdropwhich}}</span></p>
        <div class="ayv-vp-chips">
            {{#options}}<label class="ayv-vp-chip"><input type="radio" name="ayv-backdrop" value="{{bdkey}}" data-ogg="{{bdogg}}" data-m4a="{{bdm4a}}"{{#bdchecked}} checked{{/bdchecked}}><span class="ayv-vp-word">{{bdlabel}}</span></label>{{/options}}
        </div>
    </div>
    {{/backdrops}}
    <div class="ayv-rec-controls">
        <button type="button" class="ayv-rec-big" id="ayv-rec" {{#consent}}disabled{{/consent}}><span class="ayv-rec-dot">{{> local_oksigeniaayvurenda/icon_mic}}</span><span class="ayv-rec-word">{{voicerecord}}</span></button>
        <div class="ayv-rec-row">
            <button type="button" class="ayv-rec-big ayv-rec-stop" id="ayv-stop" hidden><span class="ayv-rec-dot">{{> local_oksigeniaayvurenda/icon_stop}}</span><span class="ayv-rec-word">{{voicestop}}</span></button>
            <button type="button" class="ayv-rec-big ayv-rec-pause" id="ayv-pause" hidden aria-pressed="false" data-pause="{{voicepause}}" data-resume="{{voiceresume}}"><span class="ayv-rec-dot">{{> local_oksigeniaayvurenda/icon_pause}}</span><span class="ayv-rec-word">{{voicepause}}</span></button>
        </div>
        <div class="ayv-meter" aria-hidden="true"><span id="ayv-level"></span></div>
        {{#parts}}<div class="ayv-vp-barra" id="ayv-vp-barra" data-record="{{voicerecord}}" data-stop="{{voicestop}}"><span class="ayv-vp-barra-parte" id="ayv-vp-barra-parte">{{barpart}}</span>{{#backdrops}}<button type="button" class="ayv-vp-barra-fondo" id="ayv-vp-barra-fondo" aria-haspopup="dialog" aria-controls="ayv-vp-hoja" data-says="{{backdropchip}}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M3 12c2-3 4-3 6 0s4 3 6 0 4-3 6 0"/></svg><span class="ayv-vp-barra-sonido"></span></button>{{/backdrops}}<span class="ayv-vp-barra-tiempo" id="ayv-vp-barra-tiempo"></span><button type="button" class="ayv-vp-barra-boton"><span class="ayv-vp-barra-punto" aria-hidden="true"></span><span class="ayv-vp-barra-word">{{voicerecord}}</span></button></div>{{/parts}}
        <span class="ayv-field-hint" id="ayv-time" role="status"></span>
    </div>
    <div class="ayv-rec-after" id="ayv-after" hidden>
        <p class="ayv-rec-titulo" id="ayv-rec-titulo" data-says="{{aftertitle}}"></p>
        <audio id="ayv-preview" class="ayv-media" controls></audio>
        <label class="ayv-field ayv-field-wide ayv-field-quiet" id="ayv-what-field" data-other="{{voicewhat}}" data-otherhint="{{voicewhathint}}"{{#parts}} data-part="{{partsname}}" data-parthint="{{partsnamehint}}"{{/parts}}><span class="ayv-what-word">{{#parts}}{{partsname}}{{/parts}}{{^parts}}{{voicewhat}}{{/parts}}</span> <span class="ayv-field-hint ayv-what-hint">{{#parts}}{{partsnamehint}}{{/parts}}{{^parts}}{{voicewhathint}}{{/parts}}</span>
            <input type="text" id="ayv-what" maxlength="255"></label>
        <label class="ayv-field ayv-field-wide ayv-field-quiet">{{voicesignature}} <span class="ayv-field-hint">{{voicesignaturehint}}</span>
            <input type="text" id="ayv-signature" maxlength="60"></label>
        {{#forwho}}<div class="ayv-cf ayv-lp-para" role="group" aria-labelledby="ayv-lp-para-t" data-off="{{off}}" data-on="{{on}}" data-family="{{familyon}}">
            <p id="ayv-lp-para-t"><b>{{voiceforwho}}</b></p>
            <div class="ayv-cf-luces">
                <button type="button" class="ayv-cf-luz ayv-lp-pequenos" id="ayv-lp-little" aria-pressed="false"><span class="ayv-cf-bombilla" aria-hidden="true"></span><span>{{#bud}}<img class="ayv-lp-quien" src="{{bud}}" alt=""> {{/bud}}{{voiceforlittle}}</span></button>
                {{#family}}<button type="button" class="ayv-cf-luz ayv-lp-familia" id="ayv-lp-family" aria-pressed="false" aria-disabled="true"><span class="ayv-cf-bombilla" aria-hidden="true"></span><span>{{voicefamily}}</span></button>{{/family}}
            </div>
            <p class="ayv-lp-nota" aria-live="polite">{{off}}</p>
        </div>{{/forwho}}
        {{#askemail}}<label class="ayv-field ayv-field-wide ayv-field-quiet">{{voiceemail}} <span class="ayv-field-hint">{{voiceemailhint}}</span>
            <input type="email" id="ayv-email" maxlength="254" autocomplete="email"></label>{{/askemail}}
        <p class="ayv-book-actions">
            <button type="button" class="ayv-button" id="ayv-send" disabled>{{voicesend}}</button>
            <button type="button" class="ayv-button ayv-button-quiet" id="ayv-again">{{voiceagain}}</button>
        </p>
    </div>
    <p class="ayv-field-hint" id="ayv-voice-said" role="status"></p>
    {{#backdrops}}<div class="ayv-vp-velo" id="ayv-vp-velo" hidden></div>
    <div class="ayv-vp-hoja" id="ayv-vp-hoja" role="dialog" aria-modal="true" aria-labelledby="ayv-vp-bt" hidden><button type="button" class="ayv-button ayv-vp-listo" id="ayv-vp-listo">{{backdropdone}}</button></div>{{/backdrops}}
</div>
