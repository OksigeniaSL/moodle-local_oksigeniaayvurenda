{{!
    @template local_oksigeniaayvurenda/voice_recorder

    The recorder: record, stop, listen, say what was read, send.

    Example context (json):
    {
        "voicerecord": "Grabar", "voicestop": "Parar", "voiceagain": "Volver a grabar", "voicewhat": "Qué has leído",
        "voicewhathint": "un capítulo, unas páginas", "voicesend": "Enviar", "consent": false,
        "voiceforwho": "¿Para quién es?", "voiceforlittle": "Lo he leído para los pequeños", "voicefamily": "Que lo oiga mi familia",
        "forwho": {"bud": "https://example.com/capullo.webp", "family": true,
            "off": "Si es para los pequeños, lo escucharán en su portada cuando lo aprueben.",
            "on": "Los más pequeños lo escucharán en su portada cuando lo aprueben.",
            "familyon": "Tu familia recibirá un enlace para escucharlo."},
        "voicesignature": "Firma", "voicesignaturehint": "si quieres", "askemail": true, "voiceemail": "Tu correo",
        "voiceemailhint": "si quieres el enlace para borrarla"
    }
}}
<div class="ayv-book ayv-recorder" id="ayv-recorder">
    <div class="ayv-rec-controls">
        <button type="button" class="ayv-rec-big" id="ayv-rec" {{#consent}}disabled{{/consent}}><span class="ayv-rec-dot">{{> local_oksigeniaayvurenda/icon_mic}}</span><span class="ayv-rec-word">{{voicerecord}}</span></button>
        <button type="button" class="ayv-rec-big ayv-rec-stop" id="ayv-stop" hidden><span class="ayv-rec-dot">{{> local_oksigeniaayvurenda/icon_stop}}</span><span class="ayv-rec-word">{{voicestop}}</span></button>
        <div class="ayv-meter" aria-hidden="true"><span id="ayv-level"></span></div>
        <span class="ayv-field-hint" id="ayv-time" role="status"></span>
    </div>
    <div class="ayv-rec-after" id="ayv-after" hidden>
        <audio id="ayv-preview" class="ayv-media" controls></audio>
        <label class="ayv-field ayv-field-wide ayv-field-quiet">{{voicewhat}} <span class="ayv-field-hint">{{voicewhathint}}</span>
            <input type="text" id="ayv-what" maxlength="255"></label>
        <label class="ayv-field ayv-field-wide ayv-field-quiet">{{voicesignature}} <span class="ayv-field-hint">{{voicesignaturehint}}</span>
            <input type="text" id="ayv-signature" maxlength="60"></label>
        {{#forwho}}<div class="ayv-cf ayv-lp-para" role="group" aria-labelledby="ayv-lp-para-t" data-off="{{off}}" data-on="{{on}}" data-family="{{familyon}}">
            <p id="ayv-lp-para-t"><b>{{voiceforwho}}</b></p>
            <div class="ayv-cf-luces">
                <button type="button" class="ayv-cf-luz ayv-lp-pequenos" id="ayv-lp-little" aria-pressed="false"><span class="ayv-cf-bombilla" aria-hidden="true"></span><span>{{#bud}}<img class="ayv-lp-quien" src="{{bud}}" alt=""> {{/bud}}{{voiceforlittle}}</span></button>
                {{#family}}<button type="button" class="ayv-cf-luz ayv-lp-familia" id="ayv-lp-family" aria-pressed="false" aria-disabled="true"><span class="ayv-cf-bombilla" aria-hidden="true"></span><span>{{voicefamily}}</span></button>{{/family}}
            </div>
            <p class="ayv-lp-nota" aria-live="polite">{{off}}</p>
        </div>{{/forwho}}
        {{#askemail}}<label class="ayv-field ayv-field-wide ayv-field-quiet">{{voiceemail}} <span class="ayv-field-hint">{{voiceemailhint}}</span>
            <input type="email" id="ayv-email" maxlength="254" autocomplete="email"></label>{{/askemail}}
        <p class="ayv-book-actions">
            <button type="button" class="ayv-button" id="ayv-send" disabled>{{voicesend}}</button>
            <button type="button" class="ayv-button ayv-button-quiet" id="ayv-again">{{voiceagain}}</button>
        </p>
    </div>
    <p class="ayv-field-hint" id="ayv-voice-said" role="status"></p>
</div>
