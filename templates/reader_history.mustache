{{!
    @template local_oksigeniaayvurenda/reader_history

    Everything a reader took out, year by year: each book, when it went, when it came back and what the desk noted.

    Example context (json):
    {
        "backurl": "#", "backlabel": "Ana Montes", "backword": "Volver a", "heading": "Historial de préstamos",
        "name": "Ana Montes", "summary": "12 préstamos", "empty": "", "pager": null,
        "years": [{"year": "2025-2026", "rows": [{"title": "El faro dormido", "url": "#", "hascover": true,
            "coverurl": "https://example.com/portada.jpg", "colour": 2, "when": "Del 3 de marzo al 17 de marzo",
            "isout": false, "note": "Le encantó", "library": ""}]}]
    }
}}
<section class="ayv-history">
<p class="ayv-back"><a href="{{backurl}}"><span aria-hidden="true">←</span> <span class="ayv-sr">{{backword}}: </span>{{backlabel}}</a></p>
<h1 class="ayv-results-title">{{heading}}</h1>
<p class="ayv-readers-sum">{{name}} · {{summary}}</p>
{{#empty}}<p class="ayv-empty">{{empty}}</p>{{/empty}}
{{#years}}
<section class="ayv-profile-box ayv-history-year">
    <h2 class="ayv-profile-heading">{{year}}</h2>
    <ul class="ayv-profile-read">
        {{#rows}}
        <li{{#isout}} class="ayv-history-out"{{/isout}}><a href="{{url}}"><span class="ayv-cover ayv-cover-{{colour}}{{#hascover}} ayv-cover-photo{{/hascover}}" aria-hidden="true">{{#hascover}}<img class="ayv-cover-img" src="{{coverurl}}" alt="" loading="lazy">{{/hascover}}</span>
            <span><b>{{title}}</b><span>{{when}}{{#note}} · {{note}}{{/note}}{{#library}} · {{library}}{{/library}}</span></span></a></li>
        {{/rows}}
    </ul>
</section>
{{/years}}
{{#pager}}{{> local_oksigeniaayvurenda/readers_pager}}{{/pager}}
</section>
