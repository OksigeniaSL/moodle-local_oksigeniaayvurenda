{{!
    @template local_oksigeniaayvurenda/purchase_order

    An order, as a sheet to send or to print.

    Example context (json):
    {
        "heading": "Pedido a Librería Sur, 2 de noviembre", "from": "Biblioteca central",
        "rows": [{"title": "El faro", "author": "Laurel", "isbn": "9780000000000", "copies": 2, "price": "12,00 €", "line": "24,00 €"}],
        "totalcopies": 2, "total": "24,00 €", "back": "#",
        "purchasesheetfrom": "De", "purchasefieldtitle": "Título", "purchasefieldisbn": "ISBN", "purchasefieldcopies": "Ejemplares",
        "purchasefieldprice": "Precio", "purchasesheettotal": "Total", "purchasesheetback": "Volver a las compras", "printnow": "Imprimir"
    }
}}
<div class="ayv-print-head ayv-order-head">
    <p><a class="ayv-button ayv-button-quiet" href="{{back}}">{{purchasesheetback}}</a>
        <button type="button" class="ayv-button" onclick="window.print()">{{printnow}}</button></p>
</div>
<section class="ayv-order">
    <h1 class="ayv-results-title">{{heading}}</h1>
    <p>{{purchasesheetfrom}}: {{from}}</p>
    <table class="ayv-order-table">
        <thead><tr><th scope="col">{{purchasefieldtitle}}</th><th scope="col">{{purchasefieldisbn}}</th><th scope="col" class="ayv-order-n">{{purchasefieldcopies}}</th><th scope="col" class="ayv-order-n">{{purchasefieldprice}}</th><th scope="col" class="ayv-order-n">{{purchasesheettotal}}</th></tr></thead>
        <tbody>{{#rows}}<tr><td><strong>{{title}}</strong>{{#author}}<br>{{author}}{{/author}}</td><td>{{isbn}}</td><td class="ayv-order-n">{{copies}}</td><td class="ayv-order-n">{{price}}</td><td class="ayv-order-n">{{line}}</td></tr>{{/rows}}</tbody>
        <tfoot><tr><th scope="row" colspan="2">{{purchasesheettotal}}</th><td class="ayv-order-n"><strong>{{totalcopies}}</strong></td><td></td><td class="ayv-order-n"><strong>{{total}}</strong></td></tr></tfoot>
    </table>
</section>
