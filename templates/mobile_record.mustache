{{!
    @template local_oksigeniaayvurenda/mobile_record

    A book of a library in the Moodle app: its cover, whether it is free and where, its copies here, what the reader
    asked for, the button to ask for it when it is out and the way to its page in the library.

    Example context (json):
    {
        "cannot": false, "notreader": "No eres lector", "libraryname": "Biblioteca de Monte Claro", "library": "demo-1", "recordid": 1,
        "title": "El faro dormido", "subtitle": "", "authors": "Ana Ruiz", "cover": "data:image/gif;base64,R0lGODlhAQABAAAAACw=",
        "coverbg": "#17574c", "coverink": "#ffffff", "statelabel": "Prestado", "stateclass": "out",
        "stamplabel": "Lo tienes hasta", "stampvalue": "", "stamplate": false, "sliptext": "", "where": "", "tejuelo": "",
        "hascopies": true, "copiesheading": "Ejemplares",
        "copies": [{"state": "Prestado", "location": "Estantería juvenil", "tejuelo": "Tejuelo: N RUI fa"}],
        "mine": false, "ahead": "", "holdid": 0, "holdcancelask": "¿Anular el aviso?", "holdcancelled": "Anulado.",
        "holdcancelmine": "Ya no lo quiero", "holdkeepwaiting": "Seguir esperando", "holdletgo": "Dejarlo",
        "loanid": 0, "canrenew": false, "renew": "Ampliar", "renewtoast": "", "canask": true, "holdask": "Avísame cuando vuelva", "holdaskhint": "Te avisamos.",
        "holdadded": "Hecho.", "url": "https://example.org/r", "openweb": "Abrir en la biblioteca"
    }
}}
<div class="local-oksigeniaayvurenda-mobile">
{{#cannot}}<ion-list><ion-item><ion-label class="ion-text-wrap">{{notreader}}</ion-label></ion-item></ion-list>{{/cannot}}
{{^cannot}}
<div class="ayvapp-book">
    <div class="ayvapp-cover">
        {{#cover}}<img src="{{cover}}" alt="">{{/cover}}
        {{^cover}}<div class="ayvapp-drawn" style="background-color: {{coverbg}}; color: {{coverink}};" aria-hidden="true">{{title}}</div>{{/cover}}
    </div>
    <div class="ayvapp-what">
        <p class="ayvapp-library">{{libraryname}}</p>
        <h2 class="ayvapp-title">{{title}}</h2>
        {{#subtitle}}<p class="ayvapp-sub">{{subtitle}}</p>{{/subtitle}}
        {{#authors}}<p class="ayvapp-authors">{{authors}}</p>{{/authors}}
    </div>
</div>
<div class="ayvapp-slip">
    <p class="ayvapp-state ayvapp-state-{{stateclass}}">{{statelabel}}</p>
    {{#where}}<p class="ayvapp-text">{{where}}</p>{{/where}}
    {{#tejuelo}}<p class="ayvapp-call">{{tejuelo}}</p>{{/tejuelo}}
    {{#stampvalue}}
    <div class="ayvapp-stamp{{#stamplate}} ayvapp-late{{/stamplate}}">
        <p class="ayvapp-stamp-label">{{stamplabel}}</p>
        <p class="ayvapp-stamp-value">{{stampvalue}}</p>
    </div>
    {{/stampvalue}}
    {{#sliptext}}<p class="ayvapp-text">{{sliptext}}</p>{{/sliptext}}
    {{#ahead}}<p class="ayvapp-call">{{ahead}}</p>{{/ahead}}
</div>
{{#mine}}
{{#canrenew}}<ion-button expand="block" class="ion-margin" core-site-plugins-call-ws name="local_oksigeniaayvurenda_renew_loan" [params]="{loan: {{loanid}} }" [preSets]="{getFromCache: 0, saveToCache: 0}" successMessage="{{renewtoast}}" refreshOnSuccess="true">{{renew}}</ion-button>{{/canrenew}}
{{#holdid}}
<ion-button expand="block" fill="outline" class="ion-margin" *ngIf="!CONTENT_OTHERDATA.letgo" (click)="CONTENT_OTHERDATA.letgo = 1">{{holdcancelmine}}</ion-button>
<ion-item lines="none" *ngIf="CONTENT_OTHERDATA.letgo"><ion-label class="ion-text-wrap"><p>{{holdcancelask}}</p></ion-label></ion-item>
<ion-grid *ngIf="CONTENT_OTHERDATA.letgo"><ion-row>
    <ion-col><ion-button expand="block" fill="outline" (click)="CONTENT_OTHERDATA.letgo = 0">{{holdkeepwaiting}}</ion-button></ion-col>
    <ion-col><ion-button expand="block" core-site-plugins-call-ws name="local_oksigeniaayvurenda_cancel_hold" [params]="{hold: {{holdid}} }" [preSets]="{getFromCache: 0, saveToCache: 0}" successMessage="{{holdcancelled}}" refreshOnSuccess="true">{{holdletgo}}</ion-button></ion-col>
</ion-row></ion-grid>
{{/holdid}}
{{/mine}}
{{#canask}}
<ion-item lines="none"><ion-label class="ion-text-wrap"><p>{{holdaskhint}}</p></ion-label></ion-item>
<ion-button expand="block" class="ion-margin" core-site-plugins-call-ws name="local_oksigeniaayvurenda_ask_hold" [params]="{library: '{{library}}', record: {{recordid}} }" [preSets]="{getFromCache: 0, saveToCache: 0}" successMessage="{{holdadded}}" refreshOnSuccess="true">{{holdask}}</ion-button>
{{/canask}}
{{#hascopies}}
<div class="ayvapp-copies">
    <p class="ayvapp-copies-title">{{copiesheading}}</p>
    {{#copies}}<div class="ayvapp-copy"><p class="ayvapp-copy-state">{{state}}</p>{{#location}}<p class="ayvapp-call">{{location}}</p>{{/location}}{{#tejuelo}}<p class="ayvapp-call">{{tejuelo}}</p>{{/tejuelo}}</div>{{/copies}}
</div>
{{/hascopies}}
<ion-list><ion-item button detail="true" core-link inApp="true" href="{{url}}"><ion-label>{{openweb}}</ion-label></ion-item></ion-list>
{{/cannot}}
</div>
