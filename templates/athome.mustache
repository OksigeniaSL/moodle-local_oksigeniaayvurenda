{{!
    @template local_oksigeniaayvurenda/athome

    What the reader has at home: each book with the day it comes back, late in red, and «Renew» where they may.

    Example context (json):
    {
        "heading": "Tienes en casa", "action": "#", "sesskey": "abc", "returnurl": "#",
        "books": [{"title": "El faro dormido", "url": "#", "hascover": true, "coverurl": "https://example.com/portada.jpg",
            "colour": 2, "when": "Vuelve el 16/11/26", "late": false, "renew": {"loan": 3, "label": "Ampliar hasta el 23/11/26"} }]
    }
}}
<section class="ayv-section ayv-athome" aria-labelledby="ayv-athome-title">
    <h2 id="ayv-athome-title" class="ayv-section-title">{{heading}}</h2>
    <ul class="ayv-athome-books">
        {{#books}}
        <li class="ayv-athome-book{{#late}} ayv-athome-late{{/late}}">
            <a class="ayv-athome-link" href="{{url}}"><span class="ayv-cover ayv-cover-{{colour}}{{#hascover}} ayv-cover-photo{{/hascover}}" aria-hidden="true">{{#hascover}}<img class="ayv-cover-img" src="{{coverurl}}" alt="" loading="lazy">{{/hascover}}</span>
                <span class="ayv-athome-text"><b>{{title}}</b><span class="ayv-athome-when">{{when}}</span></span></a>
            {{#renew}}<form method="post" action="{{action}}"><input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="loan" value="{{loan}}">
                <input type="hidden" name="returnurl" value="{{returnurl}}"><button type="submit" class="ayv-button ayv-button-quiet">{{label}}</button></form>{{/renew}}
        </li>
        {{/books}}
    </ul>
</section>
