{{!
    @template local_oksigeniaayvurenda/tutors

    The tutor of each group this school year.

    Context variables required for this template:
    * heading, intro, notice, empty, nocandidates - texts
    * action, sesskey, save - the form
    * rows - list of index, group, proposed and options (value, label, selected)

    Example context (json):
    {
        "heading": "Tutores de 2026-2027",
        "intro": "Reciben cada semana quién de su grupo tiene libros con retraso.",
        "notice": "",
        "action": "#",
        "sesskey": "abc",
        "hasrows": true,
        "rows": [{"index": 0, "group": "3º Primaria A", "proposed": true,
                  "options": [{"value": 0, "label": "Sin tutor", "selected": false}, {"value": 5, "label": "Irene Laurel", "selected": true}]}],
        "proposedlabel": "Propuesto: el del curso pasado",
        "save": "Guardar",
        "empty": "",
        "nocandidates": ""
    }
}}
<h1 class="ayv-results-title">{{heading}}</h1>
<p>{{intro}}</p>
{{#notice}}<p class="ayv-notice" role="status">{{notice}}</p>{{/notice}}
{{#nocandidates}}<p class="ayv-empty">{{nocandidates}}</p>{{/nocandidates}}
{{#hasrows}}
<form method="post" action="{{action}}">
    <input type="hidden" name="sesskey" value="{{sesskey}}">
    <ul class="ayv-sources">
    {{#rows}}
        <li class="ayv-source">
            <span class="ayv-source-name">{{group}}</span>
            <input type="hidden" name="group[{{index}}]" value="{{group}}">
            <select name="tutor[{{index}}]" aria-label="{{group}}">{{#options}}<option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>{{/options}}</select>
            {{#proposed}}<span class="ayv-source-count">{{proposedlabel}}</span>{{/proposed}}
        </li>
    {{/rows}}
    </ul>
    <p class="ayv-more"><button type="submit" class="ayv-button">{{save}}</button></p>
</form>
{{/hasrows}}
{{^hasrows}}<p class="ayv-empty">{{empty}}</p>{{/hasrows}}
