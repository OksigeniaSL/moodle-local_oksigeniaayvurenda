{{!
    @template local_oksigeniaayvurenda/visit_board

    The library one visits, as a card of the reader's home (Gaudí's mock-up of 7 November 2026): its words, «Enter» and the
    two other ways in (Ayvu rande and the window) on the left; the hall, 260 px high, on the right.

    Example context (json):
    {
        "url": "#", "label": "Entra en la biblioteca", "hint": "Pasea por sus salas.", "enter": "Entrar",
        "day": "https://example.org/d.webp", "night": "https://example.org/n.webp", "position": 50,
        "spring": {"url": "#", "label": "Ayvu rande"}, "window": null
    }
}}
<section class="ayv-visit-home" aria-labelledby="ayv-visit-home-title">
    <div class="ayv-visit-home-text">
        <h2 class="ayv-visit-home-title" id="ayv-visit-home-title">{{label}}</h2>
        <p>{{hint}}</p>
        <p><a class="ayv-button" href="{{url}}">{{enter}}</a></p>
        <p class="ayv-visit-home-chips">{{#spring}}<a class="ayv-chip" href="{{url}}">{{> local_oksigeniaayvurenda/icon_mic}} {{label}}</a>{{/spring}}
            {{#window}}<a class="ayv-chip" href="{{url}}">{{label}}</a>{{/window}}</p>
    </div>
    <a class="ayv-visit-home-picture" href="{{url}}" tabindex="-1" aria-hidden="true">
        <img class="ayv-visit-card-day" src="{{day}}" alt="" loading="lazy" style="object-position: {{position}}% 70%">
        <img class="ayv-visit-card-night" src="{{night}}" alt="" loading="lazy" style="object-position: {{position}}% 70%">
    </a>
</section>
