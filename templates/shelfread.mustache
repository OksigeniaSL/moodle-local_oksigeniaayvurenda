{{!
    @template local_oksigeniaayvurenda/shelfread

    What each child read from the classroom shelf this year.

    Example context (json):
    {
        "heading": "Qué ha leído cada uno", "group": "4º B", "none": "Nada todavía", "back": "#", "backlabel": "Volver",
        "children": [{"name": "Ana Montes", "books": ["El faro dormido"], "hasbooks": true, "list": "El faro dormido"}]
    }
}}
<h1 class="ayv-results-title">{{heading}} · {{group}}</h1>
<ul class="ayv-holds">
{{#children}}
    <li class="ayv-holds-row"><span class="ayv-holds-title">{{name}}</span>
        <span class="ayv-holds-who">{{#hasbooks}}{{list}}{{/hasbooks}}{{^hasbooks}}{{none}}{{/hasbooks}}</span></li>
{{/children}}
</ul>
<p class="ayv-more"><a class="ayv-button ayv-button-quiet" href="{{back}}">{{backlabel}}</a></p>
