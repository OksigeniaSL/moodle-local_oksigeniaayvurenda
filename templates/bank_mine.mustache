{{!
    @template local_oksigeniaayvurenda/bank_mine

    What a pupil sees of a bank of textbooks: their books for the year.

    Context variables required for this template:
    * heading, name, intro
    * books - title, code, condition, due
    * hasbooks, conditionlabel, duelabel

    Example context (json):
    {
        "heading": "Tus libros de texto", "name": "Banco de libros",
        "intro": "Estos son los libros de texto que tienes este curso. Cuídalos: vuelven al banco el 20 de junio de 2027.",
        "books": [{"title": "Matemáticas 6", "code": "BL0012", "condition": "Bien", "due": "20 de junio de 2027"}],
        "hasbooks": true, "conditionlabel": "Cuando te lo dieron", "duelabel": "Vuelve el"
    }
}}
<h1 class="ayv-results-title">{{heading}}</h1>
<p>{{intro}}</p>
{{#hasbooks}}
<section class="ayv-section" aria-label="{{name}}">
    <ul class="ayv-copies-list">
        {{#books}}
        <li><b>{{title}}</b> <span>{{code}}</span> <span>{{conditionlabel}}: {{condition}}</span> <span>{{duelabel}} {{due}}</span></li>
        {{/books}}
    </ul>
</section>
{{/hasbooks}}
