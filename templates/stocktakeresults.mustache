{{!
    @template local_oksigeniaayvurenda/stocktakeresults

    What a stocktake found: missing, out of place, thought lent, thought lost.

    Example context (json):
    {
        "heading": "Inventario de junio", "scope": "Toda la biblioteca", "notice": "", "progress": "Leídos: 590 de 600",
        "open": true, "readurl": "#", "action": "#", "sesskey": "abc", "downloadurl": "#", "unknown": "",
        "sections": [{"heading": "Faltan: 1", "hint": "Deberían estar.", "byplace": "", "more": "", "hascopies": true, "empty": "Ninguno",
            "lose": true, "recover": false, "download": true,
            "copies": [{"id": 1, "title": "El faro dormido", "barcode": "100000L", "callnumber": "N MON far",
                        "where": "Narrativa", "readat": ""}]}],
        "stocktakeback": "Seguir leyendo", "stocktakelose": "Darlos por perdidos", "stocktakerecover": "Devolverlos a la estantería",
        "stocktakeclose": "Cerrar el inventario", "stocktakedownload": "Descargar la lista", "stocktakecolwhere": "Leído en",
        "callnumber": "Signatura"
    }
}}
<h1 class="ayv-results-title">{{heading}}</h1>
<p>{{scope}} · {{progress}}</p>
{{#notice}}<p class="ayv-notice" role="status">{{notice}}</p>{{/notice}}
{{#open}}<p class="ayv-more"><a class="ayv-button" href="{{readurl}}">{{stocktakeback}}</a></p>{{/open}}
{{#sections}}
<h2 class="ayv-section-title">{{heading}}</h2>
<p class="ayv-field-hint">{{hint}}</p>
{{#byplace}}<p class="ayv-stock-scope">{{byplace}}</p>{{/byplace}}
{{^hascopies}}<p class="ayv-empty">{{empty}}</p>{{/hascopies}}
<ul class="ayv-holds">
{{#copies}}
    <li class="ayv-holds-row"><span class="ayv-holds-title">{{title}}</span>
        <span class="ayv-holds-who">{{where}}{{#callnumber}} · {{callnumber}}{{/callnumber}}</span>
        <span class="ayv-holds-when">{{barcode}}{{#readat}} · {{stocktakecolwhere}}: {{readat}}{{/readat}}</span></li>
{{/copies}}
</ul>
{{#more}}<p class="ayv-field-hint">{{more}}</p>{{/more}}
{{#download}}<p><a href="{{downloadurl}}">{{stocktakedownload}}</a></p>{{/download}}
{{#lose}}
<form method="post" action="{{action}}"><input type="hidden" name="sesskey" value="{{sesskey}}">
    <button type="submit" class="ayv-button ayv-button-quiet" name="do" value="lose">{{stocktakelose}}</button></form>
{{/lose}}
{{#recover}}
<form method="post" action="{{action}}"><input type="hidden" name="sesskey" value="{{sesskey}}">
    <button type="submit" class="ayv-button ayv-button-quiet" name="do" value="recover">{{stocktakerecover}}</button></form>
{{/recover}}
{{/sections}}
{{#unknown}}<p class="ayv-field-hint">{{unknown}}</p>{{/unknown}}
{{#open}}
<form method="post" action="{{action}}"><input type="hidden" name="sesskey" value="{{sesskey}}">
    <p class="ayv-more"><button type="submit" class="ayv-button" name="do" value="close">{{stocktakeclose}}</button></p></form>
{{/open}}
