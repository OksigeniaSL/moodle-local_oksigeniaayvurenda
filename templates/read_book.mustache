{{!
    @template local_oksigeniaayvurenda/read_book

    An EPUB as a page of paper, with page turns at its sides, the size of the letters, marks if wanted, and how far
    the reader is.

    Example context (json):
    {
        "fileurl": "#", "heading": "El faro dormido", "marks": true, "spread": true, "readprev": "Anterior", "readnext": "Siguiente",
        "readsmaller": "Letra más pequeña", "readbigger": "Letra más grande", "readmark": "Marcar aquí",
        "readprogress": "Cuánto llevas", "readloading": "Abriendo el libro…", "readfailed": "Este libro no se ha podido abrir aquí.", "readfullscreen": "Pantalla completa",
        "readfullscreenexit": "Salir de pantalla completa"
    }
}}
<div class="ayv-read-bar" role="group" aria-label="{{heading}}">
    <button type="button" class="ayv-button ayv-button-quiet" id="ayv-smaller" aria-label="A− {{readsmaller}}">A−</button>
    <button type="button" class="ayv-button ayv-button-quiet" id="ayv-bigger" aria-label="A+ {{readbigger}}">A+</button>
    {{#marks}}<button type="button" class="ayv-button ayv-button-quiet" id="ayv-mark">{{readmark}}</button>{{/marks}}
    <button type="button" class="ayv-button ayv-button-quiet" id="ayv-full" aria-pressed="false"><span class="ayv-full-on">{{> local_oksigeniaayvurenda/icon_full}} {{readfullscreen}}</span><span class="ayv-full-off">{{> local_oksigeniaayvurenda/icon_unfull}} {{readfullscreenexit}}</span></button>
</div>
<div class="ayv-read-book">
    <button type="button" class="ayv-page-turn" id="ayv-prev">{{> local_oksigeniaayvurenda/icon_prev}}<span class="ayv-page-turn-word">{{readprev}}</span></button>
    <div id="ayv-epub" class="ayv-epub" data-url="{{fileurl}}" data-title="{{heading}}" data-spread="{{#spread}}auto{{/spread}}{{^spread}}none{{/spread}}" data-failed="{{readfailed}}"><p class="ayv-empty">{{readloading}}</p></div>
    <button type="button" class="ayv-page-turn" id="ayv-next">{{> local_oksigeniaayvurenda/icon_next}}<span class="ayv-page-turn-word">{{readnext}}</span></button>
</div>
<div class="ayv-read-foot">
    <progress id="ayv-progress" max="100" value="0" aria-label="{{readprogress}}" hidden></progress>
    <span class="ayv-field-hint" id="ayv-where" role="status"></span>
</div>
