{{!
    @template local_oksigeniaayvurenda/lot

    One box: filling it by reading codes, sending it, and what came back.

    Example context (json):
    {
        "heading": "Lote «Dinosaurios»", "where": "Para Aula de 4º B, hasta el 20 de diciembre", "notice": "", "bad": false,
        "open": true, "out": false, "back": false, "mine": true, "action": "#", "sesskey": "abc", "count": "Libros: 1",
        "copies": [{"itemid": 1, "title": "El faro dormido", "barcode": "100000L", "status": "available", "home": false, "state": ""}],
        "pending": [], "haspending": false, "q": "", "suggestions": [{"barcode": "100001C", "title": "El faro dormido",
            "authors": "Ana Montes", "callnumber": "N MON far"}], "lotscanhint": "O escribe el título", "lotadd": "Meter en la caja",
        "lotscan": "Pasa los libros", "lotremove": "Quitar", "lotsend": "Enviar el lote", "lotgiveback": "Ha vuelto",
        "lotpendingheading": "Falta por volver", "lotallhome": "Ha vuelto todo"
    }
}}
<h1 class="ayv-results-title">{{heading}}</h1>
<p>{{where}} · {{count}}</p>
{{#notice}}<p class="ayv-notice{{#bad}} ayv-notice-error{{/bad}}" role="status">{{notice}}</p>{{/notice}}
{{#open}}{{#mine}}
<form method="post" action="{{action}}" class="ayv-scan" autocomplete="off">
    <input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="do" value="add">
    <label for="ayv-code" class="ayv-scan-label">{{lotscan}}</label>
    <input id="ayv-code" name="code" type="text" value="{{q}}" autocomplete="off" autocapitalize="off" spellcheck="false" autofocus
        maxlength="200" required aria-describedby="ayv-code-hint" aria-controls="ayv-suggest">
    <p class="ayv-field-hint" id="ayv-code-hint">{{lotscanhint}}</p>
</form>
<ul class="ayv-holds ayv-suggest" id="ayv-suggest" aria-live="polite">
{{#suggestions}}
    <li class="ayv-holds-row"><span class="ayv-holds-title">{{title}}</span>
        <span class="ayv-holds-who">{{authors}}{{#callnumber}} · {{callnumber}}{{/callnumber}}</span>
        <form method="post" action="{{action}}"><input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="do" value="add">
            <input type="hidden" name="code" value="{{barcode}}"><button type="submit" class="ayv-button ayv-button-quiet">{{lotadd}}</button></form></li>
{{/suggestions}}
</ul>
{{/mine}}{{/open}}
<ul class="ayv-holds">
{{#copies}}
    <li class="ayv-holds-row"><span class="ayv-holds-title">{{title}}</span>
        <span class="ayv-holds-when">{{barcode}}{{#state}} · {{state}}{{/state}}</span>
        {{#open}}{{#mine}}<form method="post" action="{{action}}"><input type="hidden" name="sesskey" value="{{sesskey}}">
            <input type="hidden" name="item" value="{{itemid}}">
            <button type="submit" class="ayv-button ayv-button-quiet" name="do" value="remove">{{lotremove}}</button></form>{{/mine}}{{/open}}
    </li>
{{/copies}}
</ul>
{{#back}}
<h2 class="ayv-section-title">{{lotpendingheading}}</h2>
{{^haspending}}<p class="ayv-empty">{{lotallhome}}</p>{{/haspending}}
<ul>{{#pending}}<li>{{line}}</li>{{/pending}}</ul>
{{/back}}
<form method="post" action="{{action}}"><input type="hidden" name="sesskey" value="{{sesskey}}">
    <p class="ayv-more">
    {{#open}}{{#mine}}<button type="submit" class="ayv-button" name="do" value="send">{{lotsend}}</button>{{/mine}}{{/open}}
    {{#out}}<button type="submit" class="ayv-button" name="do" value="back">{{lotgiveback}}</button>{{/out}}
    </p>
</form>
