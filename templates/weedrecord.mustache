{{!
    @template local_oksigeniaayvurenda/weedrecord

    A record of weeding, to print and sign.

    Example context (json):
    {
        "heading": "Acta de expurgo", "library": "Biblioteca central", "date": "24 de octubre de 2026",
        "reason": "Expurgo de fin de curso", "count": "Ejemplares: 1", "action": "#", "sesskey": "abc",
        "copies": [{"id": 1, "title": "El faro dormido", "barcode": "100000L", "callnumber": "N MON far",
                    "whylabel": "Sin prestar", "restored": false}],
        "weedrecordlibrary": "Biblioteca", "weedrecorddate": "Fecha", "weedrecordreason": "Motivo",
        "weedcoltitle": "Título", "callnumber": "Signatura", "weedcolcode": "Código", "weedcolwhy": "Por qué",
        "weedrestore": "Devolverlo a la colección", "weedrestored": "Devuelto a la colección",
        "weedsignlibrarian": "El responsable de la biblioteca", "weedsignhead": "La dirección", "printnow": "Imprimir"
    }
}}
<article class="ayv-weedrecord">
<h1 class="ayv-results-title">{{heading}}</h1>
<dl class="ayv-facts">
    <div><dt>{{weedrecordlibrary}}</dt><dd>{{library}}</dd></div>
    <div><dt>{{weedrecorddate}}</dt><dd>{{date}}</dd></div>
    {{#reason}}<div><dt>{{weedrecordreason}}</dt><dd>{{reason}}</dd></div>{{/reason}}
</dl>
<p><strong>{{count}}</strong></p>
<table class="ayv-weedtable">
    <thead><tr><th scope="col">{{weedcoltitle}}</th><th scope="col">{{callnumber}}</th><th scope="col">{{weedcolcode}}</th>
        <th scope="col">{{weedcolwhy}}</th><th scope="col" class="ayv-print-head"><span class="ayv-sr">{{weedrestore}}</span></th></tr></thead>
    <tbody>
    {{#copies}}
        <tr{{#restored}} class="ayv-weed-restored"{{/restored}}><td>{{title}}</td><td>{{callnumber}}</td><td>{{barcode}}</td><td>{{whylabel}}</td>
            <td class="ayv-print-head">{{#restored}}{{weedrestored}}{{/restored}}{{^restored}}<form method="post" action="{{action}}">
                <input type="hidden" name="sesskey" value="{{sesskey}}"><button type="submit" class="ayv-button ayv-button-quiet" name="restore" value="{{id}}">{{weedrestore}}</button></form>{{/restored}}</td></tr>
    {{/copies}}
    </tbody>
</table>
<div class="ayv-weedsign"><p>{{weedsignlibrarian}}</p><p>{{weedsignhead}}</p></div>
<p class="ayv-print-head"><button type="button" class="ayv-button" onclick="window.print()">{{printnow}}</button></p>
</article>
