{{!
    @template local_oksigeniaayvurenda/voice_text

    What is read while recording: the book's text if there is one to open here, or a word about the paper book.

    Example context (json):
    {
        "hastext": true, "epub": true, "pdf": false, "fileurl": "#", "heading": "El faro dormido", "marks": false,
        "readprev": "Anterior", "readnext": "Siguiente", "readsmaller": "Letra más pequeña", "readbigger": "Letra más grande",
        "readmark": "Marcar aquí", "readprogress": "Cuánto llevas", "readloading": "Abriendo el libro…",
        "voicetextheading": "Lee desde aquí", "voicepaper": "Ten delante el libro de papel.",
        "readfullscreen": "Pantalla completa", "readfullscreenexit": "Salir de pantalla completa"
    }
}}
<section class="ayv-voice-text">
{{#hastext}}
    <h2 class="ayv-section-title">{{voicetextheading}}</h2>
    {{#epub}}{{> local_oksigeniaayvurenda/read_book}}{{/epub}}
    {{#pdf}}<iframe class="ayv-pdf" src="{{fileurl}}" title="{{heading}}"></iframe>{{/pdf}}
{{/hastext}}
{{^hastext}}<p class="ayv-voice-paper">{{voicepaper}}</p>{{/hastext}}
</section>
