{{!
    @template local_oksigeniaayvurenda/lots

    The boxes a library sends and receives, and preparing a new one.

    Example context (json):
    {
        "heading": "Lotes", "intro": "Cajas de libros.", "action": "#", "sesskey": "abc", "hasothers": true,
        "others": [{"id": 2, "name": "Aula de 4º B"}], "hassent": true, "hasreceived": false, "received": [],
        "sent": [{"url": "#", "name": "Dinosaurios", "state": "Fuera hasta el 20 de diciembre", "late": false,
                  "counts": "12 libros", "other": "Aula de 4º B"}],
        "lotssent": "Enviados", "lotsreceived": "Recibidos", "lotsnew": "Preparar un lote", "lotname": "Nombre",
        "lotnamehint": "un tema o una lectura", "lotto": "Para", "lotdue": "Hasta", "lotcreate": "Empezar a llenarlo",
        "lotsnoothers": "Hace falta otra biblioteca", "lotlate": "con retraso"
    }
}}
<h1 class="ayv-results-title">{{heading}}</h1>
<p>{{intro}}</p>
{{#hassent}}
<h2 class="ayv-section-title">{{lotssent}}</h2>
<ul class="ayv-holds">
{{#sent}}<li class="ayv-holds-row"><a class="ayv-holds-title" href="{{url}}">{{name}}</a>
    <span class="ayv-holds-who">{{other}} · {{state}}{{#late}} · <strong class="ayv-is-late">{{lotlate}}</strong>{{/late}}</span>
    <span class="ayv-holds-when">{{counts}}</span></li>{{/sent}}
</ul>
{{/hassent}}
{{#hasreceived}}
<h2 class="ayv-section-title">{{lotsreceived}}</h2>
<ul class="ayv-holds">
{{#received}}<li class="ayv-holds-row"><a class="ayv-holds-title" href="{{url}}">{{name}}</a>
    <span class="ayv-holds-who">{{other}} · {{state}}</span> <span class="ayv-holds-when">{{counts}}</span></li>{{/received}}
</ul>
{{/hasreceived}}
<form method="post" action="{{action}}" class="ayv-book">
    <input type="hidden" name="sesskey" value="{{sesskey}}">
    <h2 class="ayv-section-title">{{lotsnew}}</h2>
    {{^hasothers}}<p class="ayv-empty">{{lotsnoothers}}</p>{{/hasothers}}
    {{#hasothers}}
    <label class="ayv-field">{{lotname}} <span class="ayv-field-hint">{{lotnamehint}}</span> <input type="text" name="name" maxlength="100" required></label>
    <label class="ayv-field">{{lotto}} <select name="to">{{#others}}<option value="{{id}}">{{name}}</option>{{/others}}</select></label>
    <label class="ayv-field">{{lotdue}} <input type="date" name="due"></label>
    <p class="ayv-book-actions"><button type="submit" class="ayv-button" name="do" value="create">{{lotcreate}}</button></p>
    {{/hasothers}}
</form>
