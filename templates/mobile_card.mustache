{{!
    @template local_oksigeniaayvurenda/mobile_card

    The reader's card alone in the Moodle app, to show at the desk: on white in light and in dark, so a reader can read it.

    Example context (json):
    {
        "hascards": true, "notreader": "No eres lector", "hint": "Enséñalo en el mostrador",
        "fullname": "Lucía Garza Marín",
        "cards": [{"where": "Biblioteca", "cardcode": "10000H",
            "barcodeimg": "data:image/gif;base64,R0lGODlhAQABAAAAACw=",
            "qrimg": "data:image/gif;base64,R0lGODlhAQABAAAAACw="}]
    }
}}
<div class="local-oksigeniaayvurenda-mobile ion-padding">
{{^hascards}}<p>{{notreader}}</p>{{/hascards}}
{{#hascards}}<p style="text-align: center;">{{hint}}</p>{{/hascards}}
{{#cards}}
    <div style="margin: 0 0 16px; padding: 20px 16px; border-radius: 16px; background: #fff; color: #1e2b2a; text-align: center;">
        <p style="margin: 0; font-size: 1.25em; font-weight: 700;">{{fullname}}</p>
        <p style="margin: 2px 0 12px;">{{where}}</p>
        {{#qrimg}}<img src="{{qrimg}}" alt="{{cardcode}}" style="display: block; width: 240px; max-width: 100%; height: auto; margin: 0 auto 12px;">{{/qrimg}}
        {{#barcodeimg}}<img src="{{barcodeimg}}" alt="{{cardcode}}" style="display: block; width: 100%; height: 96px; margin: 0 auto 8px;">{{/barcodeimg}}
        <p style="margin: 0; font-size: 1.4em; font-weight: 700; letter-spacing: .12em;">{{cardcode}}</p>
    </div>
{{/cards}}
</div>
