{{!
    @template local_oksigeniaayvurenda/weed

    Weeding as a box (22 November 2026): a card for each reason with its count; «Afinar» in sight, as chips and «−» and
    «+» (links: a view); the copies of the chosen reason on their shelves, by place, each dropped into the box with one
    tap; and the box beside them, with its count, every book in it and «Hacer el acta». The box is kept by the server
    (do=box toggles one copy, do=boxshelf drops a whole shelf of this page), so it fills across pages and visits;
    the record takes what is in it. The records, in their own tab.

    Example context (json):
    {
        "heading": "Expurgo", "intro": "Lo decide la biblioteca.", "action": "#", "sesskey": "abc", "library": "demo-1",
        "tabs": [{"label": "Candidatos", "url": "#", "current": true}, {"label": "Actas (0)", "url": "#", "current": false}],
        "oncandidates": true, "onrecords": false, "why": "worn",
        "reasons": [{"key": "worn", "label": "Rotos o gastados", "count": "12", "hint": "Dañados en el mostrador",
            "url": "#", "current": true, "empty": false}],
        "hasrows": true, "empty": "Ninguno.", "pageline": "", "prev": "", "next": "",
        "groups": [{"name": "Narrativa", "rows": [{"id": 1, "title": "El faro dormido", "why": "worn",
            "cover": null, "colour": 2, "initial": "E", "detail": "2009 · N MON far · 100000L"}]}],
        "records": [], "hasrecords": false,
        "refine": {"unused": [{"value": 5, "label": "5 años", "selected": true}], "before": "", "self": "#", "why": "worn",
            "places": [{"id": 1, "label": "Narrativa", "selected": false}]},
        "weedrefine": "Afinar", "weedunused": "Sin prestar desde hace", "weedbefore": "Publicados antes de",
        "weedplace": "Dónde", "stocktakeall": "Toda la biblioteca", "weedshow": "Ver", "weedallpage": "Marcar los de esta página",
        "weedreason": "Motivo", "weedreasonhint": "para el acta", "weedgo": "Dar de baja…", "weedgoconfirm": "Dar de baja y hacer el acta",
        "weedgohint": "Se puede deshacer", "weedmarkedone": "1 marcado", "weedmarkedmany": "{n} marcados",
        "weedmarkednone": "Marca los que salen", "weedrecords": "Actas", "weednorecords": "Ninguna", "weedprev": "Anteriores",
        "weednext": "Siguientes", "offsiteclose": "Cerrar"
    }
}}
<div class="ayv-cf ayv-ex">
<header class="ayv-cf-cabeza"><div class="ayv-cf-cabeza-texto"><h1 class="ayv-cf-titulo">{{heading}}</h1>
    <p class="ayv-cf-entrada">{{intro}}</p></div></header>
<nav class="ayv-tabs" aria-label="{{heading}}">{{#tabs}}<a class="ayv-tab" href="{{url}}"{{#current}} aria-current="page"{{/current}}>{{label}}</a>{{/tabs}}</nav>
{{#oncandidates}}
{{> local_oksigeniaayvurenda/life }}
<ul class="ayv-weed-reasons">
    {{#reasons}}<li><a class="ayv-weed-reason ayv-weed-reason-{{key}}{{#empty}} ayv-weed-reason-empty{{/empty}}" href="{{url}}"{{#current}} aria-current="true"{{/current}}>
        <span class="ayv-weed-count">{{count}}</span> <span class="ayv-weed-label">{{label}}</span> <span class="ayv-weed-hint">{{hint}}</span></a></li>{{/reasons}}
</ul>
{{#refine}}
{{! «Afinar», in sight: each choice a link that shows (a view), the chosen one aria-current. }}
<section class="ayv-ex-afinar" aria-label="{{weedrefine}}">
    <div class="ayv-cf-fila"><span class="ayv-cf-rotulo">{{weedunused}}</span><span class="ayv-cf-chapas">{{#unused}}<a class="ayv-cf-chapa" href="{{url}}"{{#selected}} aria-current="true"{{/selected}}>{{label}}</a>{{/unused}}</span></div>
    {{#before}}<div class="ayv-cf-numero ayv-ex-antes"><span class="ayv-cf-rotulo">{{weedbefore}}</span><span class="ayv-cf-paso" role="group" aria-label="{{weedbefore}}"><a class="ayv-cf-menos" href="{{lessurl}}" aria-label="{{lesslabel}}">−</a><span class="ayv-cf-cifra">{{#year}}<b>{{year}}</b>{{/year}}{{^year}}{{anyyear}}{{/year}}</span><a class="ayv-cf-mas" href="{{moreurl}}" aria-label="{{morelabel}}">+</a></span>
        {{#year}}<a class="ayv-cf-chapa ayv-sd-ninguno" href="{{anyurl}}">{{anyyear}}</a>{{/year}}</div>{{/before}}
    <div class="ayv-cf-fila"><span class="ayv-cf-rotulo">{{weedplace}}</span><span class="ayv-cf-chapas"><a class="ayv-cf-chapa" href="{{allurl}}"{{#allplaces}} aria-current="true"{{/allplaces}}>{{stocktakeall}}</a>{{#places}}<a class="ayv-cf-chapa" href="{{url}}"{{#selected}} aria-current="true"{{/selected}}>{{label}}</a>{{/places}}</span></div>
</section>
{{/refine}}
{{^hasrows}}<p class="ayv-empty">{{empty}}</p>{{/hasrows}}
<div class="ayv-ex-mesa">
{{#hasrows}}
<form id="ayv-ex-f" method="post" action="{{action}}"><input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="do" value="box"><input type="hidden" name="back" value="{{backvalue}}"></form>
<div class="ayv-ex-baldas">
    {{#groups}}
    <section class="ayv-ex-balda" aria-labelledby="ayv-ex-g-{{key}}">
        <header class="ayv-ex-balda-cab"><h2 class="ayv-weed-place" id="ayv-ex-g-{{key}}">{{name}}</h2>
            <button class="ayv-cf-chapa" type="submit" form="ayv-ex-f" name="boxshelf" value="{{key}}">{{weedallshelf}}</button></header>
        <ul class="ayv-ex-libros">
        {{#rows}}
            <li class="ayv-ex-libro{{#inbox}} ayv-ex-dentro{{/inbox}}" id="ayv-ex-{{id}}">
                <span class="ayv-ex-tapa ayv-cover ayv-cover-{{colour}}" aria-hidden="true">{{#cover}}<img src="{{cover}}" alt="" loading="lazy">{{/cover}}{{^cover}}<span>{{initial}}</span>{{/cover}}</span>
                <span class="ayv-ex-palabras"><b>{{title}}</b><span>{{detail}}</span>{{#lastout}}<span class="ayv-ex-ultima">{{lastout}}</span>{{/lastout}}</span>
                <button class="ayv-ex-tocar" type="submit" form="ayv-ex-f" name="box" value="{{id}}" aria-pressed="{{#inbox}}true{{/inbox}}{{^inbox}}false{{/inbox}}" aria-label="{{#inbox}}{{weedinbox}}{{/inbox}}{{^inbox}}{{weedtobox}}{{/inbox}}: {{title}}"><span aria-hidden="true">{{#inbox}}✓ {{weedinbox}}{{/inbox}}{{^inbox}}{{weedtobox}}{{/inbox}}</span></button>
            </li>
        {{/rows}}
        </ul>
    </section>
    {{/groups}}
    {{#pageline}}<p class="ayv-weed-pages">{{#prev}}<a class="ayv-button ayv-button-quiet" href="{{prev}}">{{weedprev}}</a>{{/prev}} <span>{{pageline}}</span> {{#next}}<a class="ayv-button ayv-button-quiet" href="{{next}}">{{weednext}}</a>{{/next}}</p>{{/pageline}}
</div>
{{/hasrows}}
{{#box}}
<aside class="ayv-ex-caja" id="ayv-ex-caja" aria-labelledby="ayv-ex-caja-t">
    <div class="ayv-ex-carton" aria-hidden="true"><span class="ayv-ex-solapa ayv-ex-solapa-i"></span><span class="ayv-ex-solapa ayv-ex-solapa-d"></span>
        <span class="ayv-ex-frente"><small>{{weedboxword}}</small><b>{{count}}</b></span></div>
    <h2 class="ayv-ex-caja-t" id="ayv-ex-caja-t">{{countlabel}}</h2>
    {{^hasitems}}<p class="ayv-cf-nota">{{weedboxempty}}</p>{{/hasitems}}
    {{#hasitems}}
    <ol class="ayv-ex-dentro-lista">{{#items}}<li><span><b>{{title}}</b> <small>{{detail}}</small></span><button class="ayv-ex-sacar" type="submit" form="ayv-ex-f" name="box" value="{{id}}" aria-label="{{weedtakeout}}: {{title}}">×</button></li>{{/items}}</ol>
    <form class="ayv-ex-acta" method="post" action="{{action}}"><input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="do" value="weed">
        <label class="ayv-ex-motivo" for="ayv-ex-motivo"><span class="ayv-cf-rotulo">{{weedreason}}</span> <small>{{weedreasonhint}}</small></label><input id="ayv-ex-motivo" name="reason" maxlength="255">
        <button type="submit" class="ayv-button">{{weedgoconfirm}}</button>
        <p class="ayv-cf-nota">{{weedgohint}}</p></form>
    <form method="post" action="{{action}}"><input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="do" value="boxempty"><button class="ayv-cf-enlace ayv-ex-vaciar" type="submit">{{weedboxclear}}</button></form>
    {{/hasitems}}
</aside>
{{/box}}
</div>
{{/oncandidates}}
{{#onrecords}}
{{^hasrecords}}<p class="ayv-empty">{{weednorecords}}</p>{{/hasrecords}}
{{#hasrecords}}
<ul class="ayv-weed-records">
{{#records}}
    <li><a class="ayv-weed-record" href="{{url}}"><span class="ayv-weed-record-when">{{when}}</span> <span>{{reason}}</span> <span class="ayv-weed-detail">{{countlabel}}</span></a></li>
{{/records}}
</ul>
{{/hasrecords}}
{{/onrecords}}
</div>
