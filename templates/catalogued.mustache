{{!
    @template local_oksigeniaayvurenda/catalogued

    What was catalogued lately: a card for each span with how many copies, and the copies added, day by day, the latest
    first, with what may have gone in twice.

    Example context (json):
    {
        "heading": "Lo catalogado", "intro": "Los ejemplares dados de alta a mano.", "empty": "", "pager": null,
        "spans": [{"key": "today", "count": "3", "label": "Hoy", "url": "#", "current": true}],
        "twicelabel": "¿Dos veces?", "twinlabel": "Otra ficha con su ISBN", "twinhint": "Otra ficha tiene este ISBN.",
        "addurl": "#", "addlabel": "Altas",
        "days": [{"day": "Hoy", "rows": [{"title": "El faro dormido", "url": "#", "hascover": true, "coverurl": "https://example.com/portada.jpg",
            "colour": 2, "when": "10:42", "copies": "Ejemplar 030012", "call": "N CER cap", "location": "Sala",
            "twice": true, "twin": false}]}]
    }
}}
<section class="ayv-history ayv-cataloged">
<h1 class="ayv-results-title">{{heading}}</h1>
<p class="ayv-readers-sum">{{intro}}</p>
<ul class="ayv-weed-reasons ayv-cataloged-spans">
    {{#spans}}<li><a class="ayv-weed-reason" href="{{url}}"{{#current}} aria-current="true"{{/current}}><span class="ayv-weed-count">{{count}}</span> <span class="ayv-weed-label">{{label}}</span></a></li>{{/spans}}
</ul>
{{> local_oksigeniaayvurenda/life }}
{{#empty}}<p class="ayv-empty">{{empty}} <a class="ayv-button ayv-button-quiet" href="{{addurl}}">{{addlabel}}</a></p>{{/empty}}
{{#days}}
<section class="ayv-profile-box ayv-history-year">
    <h2 class="ayv-profile-heading">{{day}}</h2>
    <ul class="ayv-profile-read">
        {{#rows}}
        <li><a href="{{url}}"><span class="ayv-cover ayv-cover-{{colour}}{{#hascover}} ayv-cover-photo{{/hascover}}" aria-hidden="true">{{#hascover}}<img class="ayv-cover-img" src="{{coverurl}}" alt="" loading="lazy">{{/hascover}}</span>
            <span><b>{{title}}</b><span>{{when}} · {{copies}}{{#call}} · {{call}}{{/call}}{{#location}} · {{location}}{{/location}}</span>
            {{#twice}}<span class="ayv-cataloged-flag">{{twicelabel}}</span>{{/twice}}{{#twin}}<span class="ayv-cataloged-flag" title="{{twinhint}}">{{twinlabel}}</span>{{/twin}}</span></a></li>
        {{/rows}}
    </ul>
</section>
{{/days}}
{{#pager}}{{> local_oksigeniaayvurenda/readers_pager}}{{/pager}}
</section>
