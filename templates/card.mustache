{{!
    @template local_oksigeniaayvurenda/card

    A reader's own card: the flower of the year, its four paths without numbers, the code for the desk and the album.

    Context variables required for this template:
    * heading, none, pathsheading, booksheading, nobooks, pastheading, showcode - texts
    * cards - name, group, library, code, barcode (SVG), qr (image address), flower, stage, paths (label, hint, marks as SVG),
      books (title, cover), past (year, flower, stage, pastclass), yearname, cromos (name, art, won, state, label),
      hascromos, cromosheading, cromoscount

    Example context (json):
    {
        "heading": "Mi carné", "preview": null, "practice": null,
        "hascards": true,
        "cards": [{"name": "Ana Montes", "group": "3º A", "library": "Biblioteca", "code": "10000H", "barcode": "",
                   "qr": "app/emblema.svg", "flower": "flor/bud.svg", "flowersvg": "", "stage": "Casi flor", "yearname": "2026-2027",
                   "paths": [{"label": "Volver", "hint": "Pasar por la biblioteca", "marks": "", "detail": "Última visita: el martes"}],
                   "haspaths": true, "pathsheading": "Cómo crece tu flor", "pastheading": "Tus flores de otros cursos",
                   "sky": false, "haschoices": false, "choices": [], "mine": false,
                   "herald": null, "hasbooks": true, "books": [{"title": "El faro dormido", "cover": null}], "haspast": false, "past": [],
                   "hasclassgarden": false, "classgarden": [], "classgardenheading": "El jardín de la clase", "classgardenhint": "",
                   "hascromos": true, "cromosheading": "Tus cromos", "cromoscount": "1 de 2",
                   "cromos": [{"name": "Ciencias", "art": "app/emblema.svg", "won": true, "state": "3 de octubre",
                               "label": "Ciencias: lo conseguiste el 3 de octubre"},
                              {"name": "Artes", "art": "app/emblema.svg", "won": false, "state": "Todavía no",
                               "label": "Artes: todavía no"}]}],
        "action": "#", "sesskey": "abc", "lookheading": "Cómo ves tu carné", "looksave": "Guardar",
        "none": "",
        "pathsheading": "Cómo crece",
        "booksheading": "Lo que has leído este curso",
        "nobooks": "",
        "pastheading": "Tus flores de otros cursos",
        "showcode": "Enséñalo en el mostrador"
    }
}}
<h1 class="ayv-results-title">{{heading}}</h1>
{{#saved}}<p class="ayv-notice" role="status">{{saved}}</p>{{/saved}}
{{#preview}}<div class="ayv-notice"><p>{{note}}</p>
    <p class="ayv-subjects">{{label}} {{#looks}}<a class="ayv-chip{{#current}} ayv-chip-on{{/current}}" href="{{url}}" {{#current}}aria-current="true"{{/current}}>{{label}}</a> {{/looks}}</p></div>{{/preview}}
{{^hascards}}<p class="ayv-empty">{{none}}</p>
{{#practice}}<p class="ayv-more"><a class="ayv-button ayv-button-quiet" href="{{url}}">{{label}}</a></p>{{/practice}}{{/hascards}}
{{#cards}}
<section class="ayv-mycard">
    <div class="ayv-card-face">
        {{#flowersvg}}<span class="ayv-card-flower{{#sky}} ayv-card-sky{{/sky}}">{{{flowersvg}}}</span>{{/flowersvg}}
        <div class="ayv-card-who">
            <p class="ayv-card-name">{{name}}</p>
            <p>{{group}}{{#group}} · {{/group}}{{library}}</p>
            <p class="ayv-card-stage">{{#stage}}{{stage}} · {{/stage}}{{yearname}}</p>
        </div>
    </div>
    {{#herald}}{{> local_oksigeniaayvurenda/bubble}}{{/herald}}
    <div class="ayv-card-code">
        {{#barcode}}<div class="ayv-card-barcode">{{{barcode}}}</div>{{/barcode}}
        {{#qr}}<img class="ayv-card-qr" src="{{qr}}" alt="{{code}}" width="120" height="120">{{/qr}}
        <p class="ayv-card-hint">{{showcode}}</p>
    </div>
    {{#haspaths}}
    <h2 class="ayv-section-title">{{pathsheading}}</h2>
    {{#listenpaths}}<p class="ayv-listen-row">{{> local_oksigeniaayvurenda/listen}}</p>{{/listenpaths}}
    <ul class="ayv-paths">
    {{#paths}}
        <li class="ayv-path"><span class="ayv-path-name">{{label}}</span>
            {{#marks}}<span class="ayv-path-marks">{{{marks}}}</span>{{/marks}}{{#detail}}<span class="ayv-path-detail">{{detail}}</span>{{/detail}}
            <span class="ayv-path-hint">{{hint}}</span></li>
    {{/paths}}
    </ul>
    {{/haspaths}}
    {{#hascromos}}
    <h2 class="ayv-section-title">{{cromosheading}} <span class="ayv-cromos-count">{{cromoscount}}</span></h2>
    <ul class="ayv-cromos">
    {{#cromos}}
        <li class="ayv-cromo{{^won}} ayv-cromo-missing{{/won}}">
            <img src="{{art}}" alt="" loading="lazy" width="600" height="840">
            <span class="ayv-cromo-band" aria-hidden="true"><span class="ayv-cromo-name">{{name}}</span><span class="ayv-cromo-when">{{state}}</span></span>
            <span class="ayv-sr">{{label}}</span>
        </li>
    {{/cromos}}
    </ul>
    {{/hascromos}}
    <h2 class="ayv-section-title">{{booksheading}}</h2>
    {{#hasbooks}}
    <ul class="ayv-album">
    {{#books}}
        <li class="ayv-album-book">{{#cover}}<img src="{{cover}}" alt="" loading="lazy">{{/cover}}{{^cover}}<span class="ayv-album-spine">{{title}}</span>{{/cover}}
            <span class="ayv-album-title">{{title}}</span></li>
    {{/books}}
    </ul>
    {{/hasbooks}}
    {{^hasbooks}}<div class="ayv-posed">{{#nobooksfigure}}<span class="ayv-figure"><img class="ayv-posed-figure" src="{{nobooksfigure}}" alt="" width="512" height="512"{{#nobookspuppet}} data-puppet="{{nobookspuppet}}"{{/nobookspuppet}}></span>{{/nobooksfigure}}<p class="ayv-empty">{{nobooks}}{{#listennobooks}} {{> local_oksigeniaayvurenda/listen}}{{/listennobooks}}</p></div>{{/hasbooks}}
    {{#hasclassgarden}}
    <h2 class="ayv-section-title">{{classgardenheading}}</h2>
    <p class="ayv-field-hint">{{classgardenhint}}{{#listengarden}} {{> local_oksigeniaayvurenda/listen}}{{/listengarden}}</p>
    <ul class="ayv-garden">
    {{#classgarden}}<li>{{{svg}}}<span>{{label}}</span></li>{{/classgarden}}
    </ul>
    {{/hasclassgarden}}
    {{#haspast}}
    <h2 class="ayv-section-title">{{pastheading}}</h2>
    <ul class="ayv-garden">
    {{#past}}<li>{{{svg}}}<span>{{year}}</span>{{#pastclass}}<span class="ayv-field-hint">{{pastclass}}</span>{{/pastclass}}</li>{{/past}}
    </ul>
    {{/haspast}}
    {{#haschoices}}
    <form method="post" action="{{action}}" class="ayv-book">
        <input type="hidden" name="sesskey" value="{{sesskey}}">
        <fieldset class="ayv-fieldset"><legend>{{lookheading}}</legend>
        {{#choices}}<label class="ayv-field ayv-field-check"><input type="radio" name="look" value="{{value}}" {{#checked}}checked{{/checked}}> {{label}}</label>{{/choices}}
        </fieldset>
        <p class="ayv-book-actions"><button type="submit" class="ayv-button ayv-button-quiet">{{looksave}}</button></p>
    </form>
    {{/haschoices}}
    {{#mine}}
    <div class="ayv-mine">
        <h2 class="ayv-section-title">{{mineheading}}</h2>
        <form method="post" action="{{action}}" class="ayv-mine-goal">
            <input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="do" value="goal">
            <input type="hidden" name="year" value="{{yearid}}">
            <label class="ayv-field">{{goallabel}} <input type="number" name="goal" min="0" max="365" step="1" value="{{goal}}" class="ayv-mine-number"></label>
            {{#hasgoal}}<p class="ayv-mine-progress">{{goaltext}}</p>
            <span class="ayv-memoir-meter ayv-memoir-meter-big" aria-hidden="true"><span style="width: {{goalwidth}}%"></span></span>{{/hasgoal}}
            <p class="ayv-field-hint">{{goalhint}}</p>
            <p class="ayv-book-actions"><button type="submit" class="ayv-button ayv-button-quiet">{{minesave}}</button></p>
        </form>
        <form method="post" action="{{action}}" class="ayv-mine-news">
            <input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="do" value="newbooks">
            <label class="ayv-field ayv-field-check"><input type="checkbox" name="newbooks" value="1" {{#newbookson}}checked{{/newbookson}}> {{newbookslabel}}</label>
            <p class="ayv-field-hint">{{newbookshint}}</p>
            <p class="ayv-book-actions"><button type="submit" class="ayv-button ayv-button-quiet">{{minesave}}</button></p>
        </form>
    </div>
    {{/mine}}
</section>
{{/cards}}
