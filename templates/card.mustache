{{!
    @template local_oksigeniaayvurenda/card

    A reader's own card: the flower of the year, its four paths without numbers, the code for the desk and the album.

    Context variables required for this template:
    * heading, none, pathsheading, booksheading, nobooks, pastheading, showcode - texts
    * cards - name, group, library, code, barcode (SVG), qr (image address), flower, stage, paths (label, hint, marks as SVG),
      books (title, cover), past (year, flower, stage, pastclass), yearname, cromos (name, art, won, state, label),
      hascromos, cromosheading, cromoscount

    Example context (json):
    {
        "heading": "Mi carné", "preview": null, "practice": null,
        "hascards": true,
        "cards": [{"name": "Ana Montes", "group": "3º A", "library": "Biblioteca", "code": "10000H", "barcode": "",
                   "qr": "app/emblema.svg", "flower": "flor/bud.svg", "flowersvg": "", "stage": "Casi flor", "yearname": "2026-2027",
                   "paths": [{"label": "Volver", "hint": "Pasar por la biblioteca", "marks": "", "detail": "Última visita: el martes"}],
                   "haspaths": true, "pathsheading": "Cómo crece tu flor", "pastheading": "Tus flores de otros cursos",
                   "sky": false, "haschoices": false, "choosefirst": false, "choices": [], "mine": false,
                   "herald": null, "hasbooks": true, "albumpremiere": "Lo estrenaste", "books": [{"title": "El faro dormido", "cover": null, "premiere": true}], "haspast": false, "past": [],
                   "hasclassgarden": false, "classisland": null, "classgarden": [], "classgardenheading": "El jardín de la clase", "classgardenhint": "",
                   "hascromos": true, "cromosheading": "Tus cromos", "cromoscount": "1 de 2",
                   "cromos": [{"name": "Ciencias", "art": "app/emblema.svg", "won": true, "state": "3 de octubre",
                               "label": "Ciencias: lo conseguiste el 3 de octubre"},
                              {"name": "Artes", "art": "app/emblema.svg", "won": false, "state": "Todavía no",
                               "label": "Artes: todavía no"}]}],
        "action": "https://example.org/local/oksigeniaayvurenda/card.php", "sesskey": "abc", "lookheading": "Cómo ves tu carné",
        "none": "",
        "pathsheading": "Cómo crece",
        "booksheading": "Lo que has leído este curso",
        "nobooks": "",
        "pastheading": "Tus flores de otros cursos",
        "showcode": "Enséñalo en el mostrador"
    }
}}
<h1 class="ayv-results-title">{{heading}}</h1>
{{#saved}}<p class="ayv-notice" role="status">{{saved}}</p>{{/saved}}
{{#preview}}<div class="ayv-notice"><p>{{note}}</p>
    <p class="ayv-subjects">{{label}} {{#looks}}<a class="ayv-chip{{#current}} ayv-chip-on{{/current}}" href="{{url}}" {{#current}}aria-current="true"{{/current}}>{{label}}</a> {{/looks}}</p></div>{{/preview}}
{{^hascards}}<p class="ayv-empty">{{none}}</p>
{{#practice}}<p class="ayv-more"><a class="ayv-button ayv-button-quiet" href="{{url}}">{{label}}</a></p>{{/practice}}{{/hascards}}
{{#athome}}{{> local_oksigeniaayvurenda/athome}}{{/athome}}
{{#cards}}
{{#sanctionline}}<p class="ayv-notice ayv-sanction-line">{{sanctionline}}</p>{{/sanctionline}}
<section class="ayv-mycard">
    <div class="ayv-card-face">
        {{#flowersvg}}<span class="ayv-card-flower{{#sky}} ayv-card-sky{{/sky}}">{{{flowersvg}}}</span>{{/flowersvg}}
        <div class="ayv-card-who">
            <p class="ayv-card-name">{{name}}</p>
            <p>{{group}}{{#group}} · {{/group}}{{library}}</p>
            <p class="ayv-card-stage">{{#stage}}{{stage}} · {{/stage}}{{yearname}}</p>
        </div>
    </div>
    {{! The code next to the card, before anything else: on a phone it is what the desk asks for. }}
    <div class="ayv-card-code">
        {{#barcode}}<div class="ayv-card-barcode">{{{barcode}}}</div>{{/barcode}}
        {{#qr}}<img class="ayv-card-qr" src="{{qr}}" alt="{{code}}" width="120" height="120">{{/qr}}
        <p class="ayv-card-hint">{{showcode}}</p>
        {{! At the desk, the codes big on the whole screen for half a minute (DIS-KIMI-17). }}
        <p><button type="button" class="ayv-button ayv-button-quiet" data-ayv-cardbig="ayv-card-big-{{code}}">{{showbig}}</button></p>
        <dialog class="ayv-card-big" id="ayv-card-big-{{code}}" aria-label="{{showbig}}">
            <form method="dialog"><button class="ayv-modal-close" aria-label="{{showbigclose}}">{{> local_oksigeniaayvurenda/icon_x}}</button></form>
            <p class="ayv-card-big-name">{{name}}</p>
            {{#barcode}}<div class="ayv-card-big-bars">{{{barcode}}}</div>{{/barcode}}
            {{#qr}}<img class="ayv-card-big-qr" src="{{qr}}" alt="{{code}}" width="320" height="320">{{/qr}}
            <p class="ayv-card-big-code">{{code}}</p>
            <p class="ayv-field-hint">{{showbighint}}</p>
        </dialog>
    </div>
    {{! Who has never chosen sees the choice first: an adult need not go through the whole game to put it aside. }}
    {{#choosefirst}}<div class="ayv-mine-first">{{> local_oksigeniaayvurenda/card_lookchoice}}</div>{{/choosefirst}}
    {{#herald}}{{> local_oksigeniaayvurenda/bubble}}{{/herald}}
    {{#haspaths}}
    <h2 class="ayv-section-title">{{pathsheading}}</h2>
    {{#listenpaths}}<p class="ayv-listen-row">{{> local_oksigeniaayvurenda/listen}}</p>{{/listenpaths}}
    <ul class="ayv-paths">
    {{#paths}}
        <li class="ayv-path"><span class="ayv-path-name">{{label}}</span>
            {{#marks}}<span class="ayv-path-marks">{{{marks}}}</span>{{/marks}}{{#detail}}<span class="ayv-path-detail">{{detail}}</span>{{/detail}}
            <span class="ayv-path-hint">{{hint}}</span></li>
    {{/paths}}
    </ul>
    {{/haspaths}}
    {{#hascromos}}
    <h2 class="ayv-section-title">{{cromosheading}} <span class="ayv-cromos-count">{{cromoscount}}</span></h2>
    <ul class="ayv-cromos">
    {{#cromos}}
        <li class="ayv-cromo{{^won}} ayv-cromo-missing{{/won}}">
            <img src="{{art}}" alt="" loading="lazy" width="600" height="840">
            <span class="ayv-cromo-band" aria-hidden="true"><span class="ayv-cromo-name">{{name}}</span>{{#state}}<span class="ayv-cromo-when">{{state}}</span>{{/state}}</span>
            <span class="ayv-sr">{{label}}</span>
        </li>
    {{/cromos}}
    </ul>
    {{/hascromos}}
    <h2 class="ayv-section-title">{{booksheading}}</h2>
    {{#hasbooks}}
    <ul class="ayv-album">
    {{#books}}
        <li class="ayv-album-book">{{#cover}}<img src="{{cover}}" alt="" loading="lazy">{{/cover}}{{^cover}}<span class="ayv-album-spine">{{title}}</span>{{/cover}}
            {{#premiere}}<span class="ayv-album-estreno">{{albumpremiere}}</span>{{/premiere}}
            <span class="ayv-album-title">{{title}}</span></li>
    {{/books}}
    </ul>
    {{/hasbooks}}
    {{^hasbooks}}<div class="ayv-posed">{{#nobooksfigure}}<span class="ayv-figure"><img class="ayv-posed-figure" src="{{nobooksfigure}}" alt="" width="512" height="512"{{#nobookspuppet}} data-puppet="{{nobookspuppet}}"{{/nobookspuppet}}></span>{{/nobooksfigure}}<p class="ayv-empty">{{nobooks}}{{#listennobooks}} {{> local_oksigeniaayvurenda/listen}}{{/listennobooks}}</p></div>{{/hasbooks}}
    {{#blinddates}}{{> local_oksigeniaayvurenda/blind_card}}{{/blinddates}}
    {{#hasquests}}
    <section class="ayv-card-quests" id="ayv-quests-{{code}}" aria-labelledby="ayv-quests-title-{{code}}">
        <h2 class="ayv-section-title" id="ayv-quests-title-{{code}}">{{questsheading}}</h2>
        <ul class="ayv-quest-plays">
        {{#quests}}
            {{#cartilla}}<li class="ayv-quest-play-cartilla ayv-ct">{{> local_oksigeniaayvurenda/card_cartilla}}</li>{{/cartilla}}
            {{^cartilla}}
            <li class="ayv-quest-play{{#reached}} ayv-quest-play-reached{{/reached}}">
                <h3 class="ayv-quest-card-name">{{name}}</h3>
                <p class="ayv-field-hint">{{when}}</p>
                {{#text}}<p>{{text}}</p>{{/text}}
                {{#joined}}
                <ol class="ayv-stamps" aria-label="{{stampslabel}}">{{#stamps}}<li class="ayv-stamp{{#on}} ayv-stamp-on{{/on}}"></li>{{/stamps}}</ol>
                <p class="ayv-quest-line">{{line}}</p>
                {{/joined}}
                {{#canjoin}}<form method="post" action="{{action}}#ayv-quests-{{code}}"><input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="do" value="quest"><input type="hidden" name="quest" value="{{id}}"><button type="submit" class="ayv-button">{{questjoin}}</button></form>{{/canjoin}}
            </li>
            {{/cartilla}}
        {{/quests}}
        </ul>
    </section>
    {{/hasquests}}
    {{#hasclassgarden}}
    <h2 class="ayv-section-title">{{classgardenheading}}</h2>
    <p class="ayv-field-hint">{{classgardenhint}}{{#listengarden}} {{> local_oksigeniaayvurenda/listen}}{{/listengarden}}</p>
    {{#classisland}}<figure class="ayv-island ayv-card-island" role="img" aria-label="{{islandlabel}}">{{#islandlayers}}<img src="{{layer}}" alt="" loading="lazy">{{/islandlayers}}</figure>{{/classisland}}
    {{^classisland}}<ul class="ayv-garden">
    {{#classgarden}}<li>{{{svg}}}<span>{{label}}</span></li>{{/classgarden}}
    </ul>{{/classisland}}
    {{/hasclassgarden}}
    {{#haspast}}
    <h2 class="ayv-section-title">{{pastheading}}</h2>
    <ul class="ayv-garden">
    {{#past}}<li>{{{svg}}}<span>{{year}}</span>{{#pastclass}}<span class="ayv-field-hint">{{pastclass}}</span>{{/pastclass}}</li>{{/past}}
    </ul>
    {{/haspast}}
    {{#mine}}
    <section class="ayv-mine" id="ayv-mine" aria-labelledby="ayv-mine-title">
        <h2 id="ayv-mine-title" class="ayv-section-title">{{mineheading}}</h2>
        <div class="ayv-mine-grid">
            <div class="ayv-mine-box ayv-mine-goal{{#goalreached}} ayv-mine-goal-met{{/goalreached}}">
                <div class="ayv-mine-ring" aria-hidden="true">
                    <svg viewBox="0 0 120 120"><circle class="ayv-mine-ring-track" cx="60" cy="60" r="52" pathLength="100"/>{{#goalstarted}}<circle class="ayv-mine-ring-done" cx="60" cy="60" r="52" pathLength="100" stroke-dasharray="{{goalwidth}} 100"/>{{/goalstarted}}</svg>
                    <span class="ayv-mine-ring-text"><b>{{done}}</b><span>{{goalunder}}</span></span>
                </div>
                <div class="ayv-mine-goal-text">
                    <h3 class="ayv-mine-title">{{goaltitle}}</h3>
                    <p class="ayv-mine-progress">{{goalline}}</p>
                    <form method="post" action="{{action}}#ayv-mine">
                        <input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="do" value="goal">
                        <input type="hidden" name="year" value="{{yearid}}">
                        <div class="ayv-mine-presets" role="group" aria-label="{{goallabel}}">
                        {{#presets}}<button type="submit" name="goal" value="{{number}}" class="ayv-mine-preset" aria-pressed="{{#on}}true{{/on}}{{^on}}false{{/on}}">{{number}}</button>{{/presets}}
                        <label class="ayv-mine-other"><span class="ayv-sr">{{goalother}}</span>
                            <input type="number" name="goalother" min="1" max="100" step="1" placeholder="{{goalother}}" data-ayv-submit></label>
                        {{#hasgoal}}<button type="submit" name="goal" value="0" class="ayv-mine-off">{{goaloff}}</button>{{/hasgoal}}
                        </div>
                    </form>
                    <p class="ayv-field-hint">{{goalhint}}</p>
                </div>
            </div>
            <form method="post" action="{{action}}#ayv-mine" class="ayv-mine-box ayv-mine-news">
                <input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="do" value="newbooks">
                <span class="ayv-mine-news-icon">{{> local_oksigeniaayvurenda/icon_bell}}</span>
                <h3 class="ayv-mine-title">{{newbookstitle}}</h3>
                <p class="ayv-field-hint">{{newbookshint}}</p>
                <button type="submit" name="newbooks" value="{{#newbookson}}0{{/newbookson}}{{^newbookson}}1{{/newbookson}}" class="ayv-switch" aria-pressed="{{#newbookson}}true{{/newbookson}}{{^newbookson}}false{{/newbookson}}" aria-label="{{newbookslabel}}"><span></span></button>
            </form>
            {{^choosefirst}}{{#haschoices}}{{> local_oksigeniaayvurenda/card_lookchoice}}{{/haschoices}}{{/choosefirst}}
        </div>
    </section>
    {{/mine}}
</section>
{{/cards}}
