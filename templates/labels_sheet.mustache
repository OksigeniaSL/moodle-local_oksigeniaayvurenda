{{!
    @template local_oksigeniaayvurenda/labels_sheet

    A sheet of labels to choose: drawn small with its grid, its name and its size.

    Context variables required for this template:
    * url, current, name, sub, cols, rows, cells

    Example context (json):
    {
        "url": "https://example.com/labels.php?sheet=a", "current": true, "name": "Apli 01273", "sub": "70 × 37 mm · 24 por hoja",
        "cols": 3, "rows": 2, "cells": [{"x": 1}, {"x": 1}, {"x": 1}, {"x": 1}, {"x": 1}, {"x": 1}]
    }
}}
<a class="ayv-et-hoja-b" href="{{url}}"{{#current}} aria-current="true"{{/current}}><span class="ayv-et-mini" style="--c: {{cols}}; --r: {{rows}};" aria-hidden="true">{{#cells}}<i></i>{{/cells}}</span><b>{{name}}</b><span>{{sub}}</span></a>
