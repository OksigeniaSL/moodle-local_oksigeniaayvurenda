{{!
    @template local_oksigeniaayvurenda/corners

    The corners of the room: each its plate standing on a shelf in the order of the room, with «◀» and «▶», «Hide» (it
    turns its back) and its name on its back; the genres of the stories, those the library has, those the catalogue
    suggests as dashed plates, one made by hand, and where they take their books from as lights. Each button sends only
    what it changes (no JavaScript needed).

    Context variables required for this template:
    * title, intro, action, sesskey, savedword - the page's words and where gestures go
    * crier - the herald by the title: figure and puppet, or nothing
    * shelf, shelfsub, hide, show, rename, save - the shelf's words
    * plates - code, label, own, default, says, art or mark and colour, hidden, first, last, leftlabel, rightlabel,
      nameof, blank, justsaved
    * hasplates, none, importurl, importlabel - with no corners yet, how to have them
    * hallurl, halllabel - the hall of the visit
    * genres - heading, intro, mine (code, label, says, chips (value, label, pressed), prefixes, open, dropsure),
      proposals (key, label, says), canadd, many, lights (value, pressed, label), haslights, justsaved and their words;
      or nothing in a bank

    Example context (json):
    {
        "title": "Los rincones de la sala", "intro": "En el orden de la sala.", "action": "https://example.com/corners.php",
        "sesskey": "abc", "savedword": "Guardado", "crier": null, "shelf": "Los rincones", "shelfsub": "Así salen.",
        "hide": "Ocultar", "show": "Mostrar", "rename": "Cambiar el nombre", "save": "Guardar",
        "plates": [
            {"code": "0", "label": "Generalidades", "own": "", "default": "Generalidades", "says": "0 · 12 libros",
                "art": "https://example.com/rincon-0.webp", "mark": "0", "colour": 0, "hidden": false, "first": true,
                "last": false, "leftlabel": "Mover Generalidades a la izquierda", "rightlabel": "Mover Generalidades a la derecha",
                "nameof": "Nombre de Generalidades", "blank": "En blanco, vuelve el de la clasificación.", "justsaved": true},
            {"code": "N", "label": "Novela", "own": "Novela", "default": "N", "says": "N · 3 libros", "art": null,
                "mark": "N", "colour": 2, "hidden": true, "first": false, "last": true,
                "leftlabel": "Mover Novela a la izquierda", "rightlabel": "Mover Novela a la derecha",
                "nameof": "Nombre de Novela", "blank": "En blanco, vuelve el de la clasificación.", "justsaved": false}
        ],
        "hasplates": true, "none": "Aún no hay rincones.", "importurl": "https://example.com/import.php",
        "importlabel": "Importar", "hallurl": "https://example.com/visit.php", "halllabel": "Ver el vestíbulo",
        "genres": {"heading": "Los géneros de la narrativa", "intro": "Rincones propios.",
            "mine": [{"code": "g1", "label": "Misterio", "says": "4 libros", "prefixes": "", "open": true,
                "chips": [{"value": "g1|Misterio", "label": "Misterio", "pressed": true}], "dropsure": "Misterio: toca otra vez."}],
            "proposals": [{"key": "poetry", "label": "Poesía", "says": "9 libros"}],
            "canadd": true, "many": false, "lights": [{"value": "8:0", "pressed": true, "label": "8 · Literatura"}],
            "haslights": true, "justsaved": false, "change": "Cambiar", "drop": "Quitar", "other": "Otro género",
            "othersub": "con sus temas", "name": "Nombre", "topicslead": "Sus temas.", "addtopic": "+ Otro tema",
            "addtopiclabel": "Otro tema", "prefixlead": "El principio del tejuelo", "prefixhint": "si tus lomos ya lo dicen",
            "addit": "Añadirlo",
            "save": "Guardar", "addall": "Añadirlos todos", "fromlead": "De dónde toman los libros:",
            "fromhint": "solo de estos rincones."}
    }
}}
<div class="ayv-cf ayv-ri">
<header class="ayv-cf-cabeza">
    <div class="ayv-cf-cabeza-texto"><h1 class="ayv-cf-titulo">{{title}}</h1>
        <p class="ayv-cf-entrada">{{intro}}</p>
        </div>
    {{#crier}}<span class="ayv-cf-pregonera"><span class="ayv-figure"><img src="{{figure}}" alt="" width="512" height="512"{{#puppet}} data-puppet="{{puppet}}"{{/puppet}}></span></span>{{/crier}}
</header>
<form id="ayv-ri-f" method="post" action="{{action}}"><input type="hidden" name="sesskey" value="{{sesskey}}"></form>
{{#hasplates}}
<section class="ayv-ri-estante" aria-labelledby="ayv-ri-t">
    <h2 class="ayv-cf-estante-t" id="ayv-ri-t">{{shelf}}</h2>
    <p class="ayv-cf-estante-s">{{shelfsub}}</p>
    <ol class="ayv-ri-balda">
        {{#plates}}
        <li class="ayv-ri-rincon{{#hidden}} ayv-ri-oculto{{/hidden}}" id="r{{code}}">
            <figure class="ayv-ri-lamina">{{#art}}<img src="{{art}}" alt="" width="116" height="180" loading="lazy">{{/art}}{{^art}}<span class="ayv-ri-sinlamina ayv-cover-{{colour}}" aria-hidden="true">{{mark}}</span>{{/art}}<figcaption><b>{{label}}</b><span>{{says}}</span>{{#justsaved}}<span class="ayv-cf-guardado" role="status">{{savedword}}</span>{{/justsaved}}</figcaption></figure>
            <div class="ayv-ri-gestos">
                <button class="ayv-ri-mover" type="submit" form="ayv-ri-f" name="move" value="{{code}}:-1" aria-label="{{leftlabel}}"{{#first}} disabled{{/first}}><span aria-hidden="true">◀</span></button>
                {{^hidden}}<button class="ayv-ri-ocultar" type="submit" form="ayv-ri-f" name="hide" value="{{code}}" aria-pressed="false">{{hide}}</button>{{/hidden}}
                {{#hidden}}<button class="ayv-ri-ocultar" type="submit" form="ayv-ri-f" name="show" value="{{code}}" aria-pressed="true">{{show}}</button>{{/hidden}}
                <button class="ayv-ri-mover" type="submit" form="ayv-ri-f" name="move" value="{{code}}:1" aria-label="{{rightlabel}}"{{#last}} disabled{{/last}}><span aria-hidden="true">▶</span></button>
            </div>
            <details class="ayv-ri-dorso"><summary>{{rename}}</summary>
                <form class="ayv-ri-dorso-c" method="post" action="{{action}}"><input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="rename" value="{{code}}">
                    <label class="ayv-sr" for="ayv-ri-n{{code}}">{{nameof}}</label><input id="ayv-ri-n{{code}}" name="label" value="{{own}}" placeholder="{{default}}" maxlength="80" autocomplete="off">
                    <button class="ayv-button" type="submit">{{save}}</button><span class="ayv-cf-nota">{{blank}}</span></form>
            </details>
        </li>
        {{/plates}}
    </ol>
    <p><a href="{{hallurl}}">{{halllabel}}</a></p>
</section>
{{/hasplates}}
{{^hasplates}}
<div class="ayv-nothing"><p>{{none}}</p><p><a class="ayv-button" href="{{importurl}}">{{importlabel}}</a></p></div>
{{/hasplates}}
{{#genres}}
<section class="ayv-ri-estante" id="ayv-ri-generos" aria-labelledby="ayv-ri-g">
    <h2 class="ayv-cf-estante-t" id="ayv-ri-g">{{heading}}</h2>{{#justsaved}}<p class="ayv-cf-guardado-fila"><span class="ayv-cf-guardado" role="status">{{savedword}}</span></p>{{/justsaved}}
    <p class="ayv-cf-estante-s">{{intro}}</p>
    <ul class="ayv-ri-generos">
        {{#mine}}
        <li id="ayv-ri-g{{code}}"><details class="ayv-ri-genero ayv-ri-genero-mio"{{#open}} open{{/open}}><summary><b>{{label}}</b><span>{{says}} · {{change}}</span></summary>
            <div class="ayv-ri-genero-dorso">
                <form class="ayv-ri-genero-nombre" method="post" action="{{action}}"><input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="genre" value="{{code}}">
                    <label class="ayv-sr" for="ayv-ri-gn{{code}}">{{name}}</label><input class="ayv-ri-nombre-in" id="ayv-ri-gn{{code}}" name="label" value="{{label}}" maxlength="60" required autocomplete="off">
                    <span class="ayv-ri-tejuelo"><span class="ayv-cf-tejuelo-m"><label class="ayv-sr" for="ayv-ri-gp{{code}}">{{prefixlead}}</label><input id="ayv-ri-gp{{code}}" name="prefixes" value="{{prefixes}}" maxlength="200" autocomplete="off" placeholder="N MIS"></span><span class="ayv-cf-nota">{{prefixlead}}, {{prefixhint}}</span></span>
                    <span class="ayv-cf-fila"><button class="ayv-button" type="submit">{{save}}</button><button class="ayv-cf-chapa" type="submit" form="ayv-ri-f" name="genredrop" value="{{code}}" data-ayv-twice="{{dropsure}}">{{drop}}</button></span>
                </form>
                <p class="ayv-cf-nota">{{topicslead}}</p>
                <div class="ayv-cf-chapas">{{#chips}}<button class="ayv-cf-chapa" type="submit" form="ayv-ri-f" name="topic" value="{{value}}" aria-pressed="{{#pressed}}true{{/pressed}}{{^pressed}}false{{/pressed}}">{{label}}</button>{{/chips}}</div>
                <form class="ayv-ri-tema" method="post" action="{{action}}"><input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="genretopic" value="{{code}}">
                    <label class="ayv-sr" for="ayv-ri-gt{{code}}">{{addtopiclabel}}</label><input id="ayv-ri-gt{{code}}" name="addtopic" maxlength="80" required autocomplete="off" placeholder="{{addtopic}}">
                    <button class="ayv-cf-chapa" type="submit">{{addit}}</button></form>
            </div></details></li>
        {{/mine}}
        {{#proposals}}
        <li><button class="ayv-ri-genero" type="submit" form="ayv-ri-f" name="propose" value="{{key}}"><b>+ {{label}}</b><span>{{says}}</span></button></li>
        {{/proposals}}
        {{#canadd}}
        <li><details class="ayv-ri-genero ayv-ri-genero-otro"><summary><b>+ {{other}}</b><span>{{othersub}}</span></summary>
            <form class="ayv-ri-genero-dorso" method="post" action="{{action}}"><input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="genre" value="new">
                <label class="ayv-sr" for="ayv-ri-gnnew">{{name}}</label><input class="ayv-ri-nombre-in" id="ayv-ri-gnnew" name="label" maxlength="60" required autocomplete="off" placeholder="{{other}}">
                <span class="ayv-cf-fila"><button class="ayv-button" type="submit">{{addit}}</button></span>
            </form></details></li>
        {{/canadd}}
    </ul>
    {{#many}}<div class="ayv-cf-fila"><button class="ayv-cf-chapa" type="submit" form="ayv-ri-f" name="proposeall" value="1">{{addall}}</button></div>{{/many}}
    {{#haslights}}
    <p class="ayv-ri-de" id="ayv-ri-de"><b>{{fromlead}}</b> {{fromhint}}</p>
    <div class="ayv-cf-luces">{{#lights}}<button class="ayv-cf-luz" type="submit" form="ayv-ri-f" name="from" value="{{value}}" aria-pressed="{{#pressed}}true{{/pressed}}{{^pressed}}false{{/pressed}}"><span class="ayv-cf-bombilla" aria-hidden="true"></span><span>{{label}}</span></button>{{/lights}}</div>
    {{/haslights}}
</section>
{{/genres}}
</div>
