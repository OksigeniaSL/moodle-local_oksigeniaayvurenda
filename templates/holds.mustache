{{!
    @template local_oksigeniaayvurenda/holds

    The reservations of a library: first what waits (copies set aside, the queues) as cards with their cover and reader;
    the herald when nothing waits; for managers, how one reserves as a card with its gestures in sight (settingcard).

    Example context (json):
    {
        "heading": "Reservas", "intro": "Lo que se espera.", "notice": "", "action": "https://example.com/hold.php",
        "self": "https://example.com/holds.php", "sesskey": "abc",
        "library": "demo-1", "readyheading": "Apartados", "waitingheading": "En cola", "cancel": "Anular",
        "ready": [{"id": 1, "title": "El faro dormido", "url": "https://example.com/record.php", "name": "Hugo Lago",
            "group": "5.º A", "barcode": "100000L", "when": "hasta el 30 de octubre", "aheadlabel": "", "cover": null,
            "colour": 2}],
        "waiting": [], "quiet": false, "herald": null, "manage": true, "savedword": "Guardado",
        "settings": [{"id": "ayv-nr-reservas", "set": "holds", "title": "Cómo se reserva", "says": "Solo en el mostrador.",
            "justsaved": false, "notes": [], "dates": null, "presets": null, "currency": null, "link": null, "help": null,
            "text": null, "groups": [{"label": "En línea", "steps": [], "chips": [], "haslights": true, "haschips": false,
                "whole": false, "lights": [{"form": "ayv-nr-reservas-f", "name": "online", "value": 1, "pressed": false,
                "label": "Se reserva desde casa"}]}]}]
    }
}}
<div class="ayv-cf ayv-nr">
<header class="ayv-cf-cabeza">
    <div class="ayv-cf-cabeza-texto"><h1 class="ayv-cf-titulo">{{heading}}</h1>
        <p class="ayv-cf-entrada">{{intro}}</p>
    </div>
</header>
{{#notice}}<p class="ayv-notice" role="status">{{notice}}</p>{{/notice}}
{{#quiet}}{{#herald}}<div class="ayv-holds-quiet">{{> local_oksigeniaayvurenda/bubble}}</div>{{/herald}}{{/quiet}}
{{> local_oksigeniaayvurenda/life }}
{{#ready.0}}
<h2 class="ayv-section-title">{{readyheading}}</h2>
<ul class="ayv-holdcards">
{{#ready}}
    <li class="ayv-holdcard ayv-holdcard-ready">
        <a class="ayv-weed-cover ayv-cover ayv-cover-{{colour}}" href="{{url}}" tabindex="-1" aria-hidden="true">{{#cover}}<img src="{{cover}}" alt="" loading="lazy">{{/cover}}</a>
        <span class="ayv-holdcard-words"><a class="ayv-holdcard-title" href="{{url}}">{{title}}</a>
            <span>{{name}}{{#group}} · {{group}}{{/group}}</span>
            <span class="ayv-weed-detail">{{when}}{{#barcode}} · {{barcode}}{{/barcode}}</span></span>
        <form method="post" action="{{action}}">
            <input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="library" value="{{library}}">
            <input type="hidden" name="hold" value="{{id}}"><input type="hidden" name="back" value="holds">
            <button type="submit" class="ayv-button ayv-button-quiet" name="action" value="cancel">{{cancel}}</button>
        </form>
    </li>
{{/ready}}
</ul>
{{/ready.0}}
{{#waiting.0}}
<h2 class="ayv-section-title">{{waitingheading}}</h2>
<ul class="ayv-holdcards">
{{#waiting}}
    <li class="ayv-holdcard">
        <a class="ayv-weed-cover ayv-cover ayv-cover-{{colour}}" href="{{url}}" tabindex="-1" aria-hidden="true">{{#cover}}<img src="{{cover}}" alt="" loading="lazy">{{/cover}}</a>
        <span class="ayv-holdcard-words"><a class="ayv-holdcard-title" href="{{url}}">{{title}}</a>
            <span>{{name}}{{#group}} · {{group}}{{/group}}</span>
            <span class="ayv-weed-detail">{{when}}{{#aheadlabel}} · {{aheadlabel}}{{/aheadlabel}}</span></span>
        <form method="post" action="{{action}}">
            <input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="library" value="{{library}}">
            <input type="hidden" name="hold" value="{{id}}"><input type="hidden" name="back" value="holds">
            <button type="submit" class="ayv-button ayv-button-quiet" name="action" value="cancel">{{cancel}}</button>
        </form>
    </li>
{{/waiting}}
</ul>
{{/waiting.0}}
{{#manage}}
<ul class="ayv-nr-ajustes">
    {{#settings}}
    <li>{{> local_oksigeniaayvurenda/settingcard}}</li>
    {{/settings}}
</ul>
{{/manage}}
</div>
