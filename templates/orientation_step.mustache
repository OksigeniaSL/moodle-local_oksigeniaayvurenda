{{!
    @template local_oksigeniaayvurenda/orientation_step

    The route in the game of a room, after a book found (Jujol's mock-up of 13 November): with the first and second rooms,
    the small path and the rooms left; with the third, the badge falling like a stamp, and the way to it.

    Example context (json):
    {
        "avance": {"pathlabel": "2 de 3 salas: Artes, Ciencias", "steps": [{"done": true, "room": "Artes"},
            {"done": true, "room": "Ciencias"}, {"done": false, "room": ""}], "meta": null,
            "says": "Te queda una sala para conocer la biblioteca."},
        "insignia": null
    }
}}
{{#avance}}<div class="ayv-or-avance" role="status">{{> local_oksigeniaayvurenda/orientation_path}}<p>{{says}}</p></div>{{/avance}}
{{#insignia}}<div class="ayv-or-insignia" role="status">{{#img}}<img src="{{img}}" alt="" width="104" height="104">{{/img}}
    <p class="ayv-or-insignia-t">{{title}}</p>
    <p>{{text}} <a href="{{link}}">{{linklabel}}</a></p></div>{{/insignia}}
