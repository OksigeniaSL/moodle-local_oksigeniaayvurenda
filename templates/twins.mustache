{{!
    @template local_oksigeniaayvurenda/twins
    Readers that are the same person: the likely ones and any two by their card codes; the librarian chooses which stays.
    Context variables required for this template:
    * heading, intro, notice, error - texts
    * sets - likely groups (setid, members: id, name, cardcode, typelabel, group, loanslabel, accountlabel, checked)
    * pair - two readers found by their codes (members, as above), or nothing
    * action, sesskey, slug, codea, codeb - the forms
    * pager - prev, next, line, prevlabel, nextlabel
    * the words of each section and button
    Example context (json):
    {
        "heading": "Lectores repetidos",
        "intro": "Una misma persona con dos fichas.",
        "notice": "",
        "error": "",
        "action": "https://example.org/t",
        "sesskey": "abc",
        "slug": "demo-1",
        "likelyheading": "Parecen la misma persona: 1",
        "likelyintro": "Mismo nombre y mismo tipo.",
        "hassets": true,
        "sets": [{"setid": 0, "members": [
            {"id": 1, "name": "Jon Mar Prado", "cardcode": "10001A", "typelabel": "Profesor", "group": "",
             "loanslabel": "Préstamos: 12 (fuera: 1)", "accountlabel": "", "checked": true},
            {"id": 2, "name": "Jon Mar Prado", "cardcode": "10520K", "typelabel": "Profesor", "group": "",
             "loanslabel": "Préstamos: 0 (fuera: 0)", "accountlabel": "", "checked": false}]}],
        "nosets": "No hay ninguno.",
        "pager": null, "stayslabel": "Se queda", "closelabel": "Cerrar",
        "query": "",
        "filterlabel": "Solo los que se llaman",
        "filterbutton": "Buscar",
        "keeplabel": "Se queda esta",
        "joinlabel": "Juntarlas",
        "handheading": "Juntar dos a mano",
        "handintro": "Con los códigos de sus carnés.",
        "codealabel": "Un carné",
        "codeblabel": "El otro",
        "codea": "",
        "codeb": "",
        "lookuplabel": "Verlas",
        "lookupnote": "",
        "pair": null,
        "cardlabel": "Carné"
    }
}}
<h1 class="ayv-results-title">{{heading}}</h1>
<p>{{intro}}</p>
{{#notice}}<p class="ayv-notice" role="status">{{notice}}</p>{{/notice}}
{{#error}}<p class="ayv-notice ayv-notice-error" role="alert">{{error}}</p>{{/error}}
<section class="ayv-twins-top" id="ayv-twins-hand">
    <form method="get" action="{{action}}" class="ayv-readers-find" role="search">
        <input type="hidden" name="library" value="{{slug}}">
        <label class="ayv-field">{{filterlabel}} <input type="search" name="q" value="{{query}}" maxlength="100"></label>
        <button type="submit" class="ayv-button ayv-button-quiet">{{filterbutton}}</button>
    </form>
    <button type="button" class="ayv-button ayv-button-quiet" data-ayv-open="ayv-twins-bycode">{{handheading}}</button>
    {{#lookupnote}}<p class="ayv-empty">{{lookupnote}}</p>{{/lookupnote}}
    {{#pair}}
    <form method="post" action="{{action}}" class="ayv-twins ayv-twinset">
        <input type="hidden" name="sesskey" value="{{sesskey}}">
        <fieldset class="ayv-twinset-people"><legend class="ayv-sr">{{keeplabel}}</legend>
        {{#members}}
            <input type="hidden" name="ids[]" value="{{id}}">
            <label class="ayv-twinset-person"><input type="radio" name="keep" value="{{id}}" {{#checked}}checked{{/checked}}>
                <span class="ayv-twinset-who"><span class="ayv-person-name">{{name}}</span> <span class="ayv-twinset-stays">{{stayslabel}}</span></span>
                <span class="ayv-field-hint">{{cardlabel}} {{cardcode}} · {{typelabel}}{{#group}} · {{group}}{{/group}} · {{loanslabel}}{{#accountlabel}} · {{accountlabel}}{{/accountlabel}}</span>
            </label>
        {{/members}}
        </fieldset>
        <button type="submit" class="ayv-button">{{joinlabel}}</button>
    </form>
    {{/pair}}
    <dialog class="ayv-modal" id="ayv-twins-bycode" aria-labelledby="ayv-twins-bycode-title">
        <div class="ayv-modal-head"><h3 id="ayv-twins-bycode-title" class="ayv-section-title">{{handheading}}</h3>
            <form method="dialog"><button class="ayv-modal-close" aria-label="{{closelabel}}">×</button></form></div>
        <p>{{handintro}}</p>
        <form method="get" action="{{action}}">
            <input type="hidden" name="library" value="{{slug}}">
            <label class="ayv-field ayv-dig-field">{{codealabel}} <input type="text" name="a" value="{{codea}}" autocomplete="off" spellcheck="false"></label>
            <label class="ayv-field ayv-dig-field">{{codeblabel}} <input type="text" name="b" value="{{codeb}}" autocomplete="off" spellcheck="false"></label>
            <p class="ayv-dig-sheet-actions"><button type="submit" class="ayv-button">{{lookuplabel}}</button></p>
        </form>
    </dialog>
</section>
<section class="ayv-section" id="ayv-twins-likely">
    <h2 class="ayv-section-title">{{likelyheading}}</h2>
    <p>{{likelyintro}}</p>
    {{^hassets}}<p class="ayv-empty">{{nosets}}</p>{{/hassets}}
    {{#sets}}
    <form method="post" action="{{action}}" class="ayv-twins ayv-twinset">
        <input type="hidden" name="sesskey" value="{{sesskey}}">
        <fieldset class="ayv-twinset-people"><legend class="ayv-sr">{{keeplabel}}</legend>
        {{#members}}
            <input type="hidden" name="ids[]" value="{{id}}">
            <label class="ayv-twinset-person"><input type="radio" name="keep" value="{{id}}" {{#checked}}checked{{/checked}}>
                <span class="ayv-twinset-who"><span class="ayv-person-name">{{name}}</span> <span class="ayv-twinset-stays">{{stayslabel}}</span></span>
                <span class="ayv-field-hint">{{cardlabel}} {{cardcode}} · {{typelabel}}{{#group}} · {{group}}{{/group}} · {{loanslabel}}{{#accountlabel}} · {{accountlabel}}{{/accountlabel}}</span>
            </label>
        {{/members}}
        </fieldset>
        <button type="submit" class="ayv-button ayv-button-quiet">{{joinlabel}}</button>
    </form>
    {{/sets}}
    {{#pager}}{{> local_oksigeniaayvurenda/readers_pager}}{{/pager}}
</section>
