{{!
    @template local_oksigeniaayvurenda/voice

    Recording a reading of a record, with how the voice is handled first.

    Example context (json):
    {
        "heading": "Dale voz a «El faro dormido»", "how": "Tu voz se guarda aquí.", "infourl": "#", "notice": "",
        "action": "#", "sesskey": "abc", "hasmine": true,
        "mine": [{"id": 1, "title": "Capítulo 1", "url": "#", "state": "Pendiente de aprobar"}],
        "voiceinfo": "Cómo se tratan las voces", "voicerecord": "Grabar", "voicestop": "Parar", "voiceagain": "Volver a grabar",
        "voicewhat": "Qué has leído", "voicewhathint": "un capítulo, unas páginas", "voicesend": "Enviar",
        "voicemine": "Tus voces de este libro", "voicedelete": "Borrarla", "voicenomic": "Sin micrófono",
        "backtorecord": "Volver a la ficha"
    }
}}
<section class="ayv-voice">
<h1 class="ayv-results-title">{{heading}}</h1>
<p class="ayv-notice">{{how}} <a href="{{infourl}}">{{voiceinfo}}</a></p>
{{#notice}}<p class="ayv-notice" role="status">{{notice}}</p>{{/notice}}
<div class="ayv-book" id="ayv-recorder">
    <p class="ayv-book-actions">
        <button type="button" class="ayv-button" id="ayv-rec">{{voicerecord}}</button>
        <button type="button" class="ayv-button ayv-button-quiet" id="ayv-stop" hidden>{{voicestop}}</button>
        <span class="ayv-field-hint" id="ayv-time" role="status"></span>
    </p>
    <audio id="ayv-preview" class="ayv-media" controls hidden></audio>
    <label class="ayv-field ayv-field-wide">{{voicewhat}} <span class="ayv-field-hint">{{voicewhathint}}</span>
        <input type="text" id="ayv-what" maxlength="255"></label>
    <p class="ayv-book-actions">
        <button type="button" class="ayv-button" id="ayv-send" disabled>{{voicesend}}</button>
        <button type="button" class="ayv-button ayv-button-quiet" id="ayv-again" hidden>{{voiceagain}}</button>
    </p>
    <p class="ayv-field-hint" id="ayv-voice-said" role="status"></p>
</div>
{{#hasmine}}
<h2 class="ayv-section-title">{{voicemine}}</h2>
<ul class="ayv-holds">
{{#mine}}
    <li class="ayv-holds-row"><span class="ayv-holds-title">{{title}}</span> <span class="ayv-holds-who">{{state}}</span>
        <audio class="ayv-media" controls preload="none" src="{{url}}"></audio>
        <form method="post" action="{{action}}"><input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="item" value="{{id}}">
            <button type="submit" class="ayv-button ayv-button-quiet" name="do" value="delete">{{voicedelete}}</button></form></li>
{{/mine}}
</ul>
{{/hasmine}}
</section>
