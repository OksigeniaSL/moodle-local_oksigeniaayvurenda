{{!
    @template local_oksigeniaayvurenda/forget

    Deleting a voice from the link sent to whoever recorded it.

    Example context (json):
    {
        "heading": "Borrar tu voz de «El faro dormido»", "what": "Capítulo 1", "hint": "Un toque y se borra.",
        "button": "Borrar mi voz", "ask": true, "action": "#", "sesskey": "abc", "deleted": false, "gone": false
    }
}}
<section class="ayv-voice">
<h1 class="ayv-results-title">{{heading}}</h1>
{{#ask}}
{{#what}}<p>{{what}}</p>{{/what}}
<p class="ayv-field-hint">{{hint}}</p>
<form method="post" action="{{action}}"><input type="hidden" name="sesskey" value="{{sesskey}}">
    <button type="submit" class="ayv-button">{{button}}</button></form>
{{/ask}}
</section>
