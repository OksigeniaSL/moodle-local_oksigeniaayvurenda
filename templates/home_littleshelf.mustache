{{!
    @template local_oksigeniaayvurenda/home_littleshelf

    «Te lo leen los mayores» (Jujol, 13 November): on a young reader's home, the books the older readers read for them,
    standing, each with a round «play» on its cover, its title and who reads it.

    Example context (json):
    {
        "heading": "Te lo leen los mayores", "hint": "Los mayores de la biblioteca te los leen en voz alta. Toca y escucha.",
        "figure": "https://example.com/memoria-senala.webp",
        "books": [{"title": "La isla del cometa", "url": "https://example.com/record.php?id=50", "hascover": true,
            "coverurl": "https://example.com/tapa.jpg", "colour": 2, "audio": "https://example.com/voz.webm",
            "by": "Te lo lee Iker, 2.º de ESO", "playlabel": "Escuchar «La isla del cometa», Te lo lee Iker"}]
    }
}}
<section class="ayv-lp-balda" aria-labelledby="ayv-lp-balda-t">
    <div class="ayv-lp-balda-cab">{{#figure}}<img src="{{figure}}" alt="" width="64" height="64">{{/figure}}
        <div><h2 id="ayv-lp-balda-t">{{heading}}</h2><p>{{hint}}</p></div></div>
    <ul class="ayv-lp-libros">{{#books}}<li class="ayv-lp-libro">
        <span class="ayv-lp-tapa">{{#hascover}}<img src="{{coverurl}}" alt="" width="400" height="600" loading="lazy">{{/hascover}}{{^hascover}}<span class="ayv-cover ayv-cover-{{colour}} ayv-lp-sintapa" aria-hidden="true"></span>{{/hascover}}
            {{#audio}}<button type="button" class="ayv-lp-play" data-ayv-say="{{audio}}" aria-pressed="false" aria-label="{{playlabel}}"><svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><path d="M7 4.5v15l13-7.5z"/></svg></button>{{/audio}}</span>
        <a class="ayv-lp-titulo" href="{{url}}">{{title}}</a>
        <span class="ayv-lp-lee">{{by}}</span>
    </li>{{/books}}</ul>
</section>
