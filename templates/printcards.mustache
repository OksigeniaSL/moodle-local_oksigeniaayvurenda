{{!
    @template local_oksigeniaayvurenda/printcards

    Reader cards to print, on one side: ten to an A4 sheet, each card 85.6 x 54 mm, touching, so each line is cut once.

    Context variables required for this template:
    * heading, intro, print, empty - texts
    * sheets - list of sheets: paper (a4 or letter), guides (the cut lines, SVG), title, how, ruler, sample and cards
    * cards - look (art-flower, art-sky or plain), skin, art (address, or empty), label, name, namesize (long, verylong
      or empty), group, library, qr (SVG), barcode (SVG, or empty when it does not fit), barwidth (its width in mm, or empty), code

    Example context (json):
    {
        "heading": "Carnés de 3.º A",
        "intro": "25 carnés.",
        "print": "Imprimir",
        "hassheets": true,
        "sheets": [{"paper": "a4", "guides": "", "title": "Carnés de 3.º A · 1/3", "how": "", "ruler": "", "sample": "",
                    "cards": [{"look": "art-flower", "skin": "school", "art": "semilla.webp", "label": "Carné de biblioteca",
                               "name": "Ana Montes", "namesize": "", "group": "3.º A", "library": "Biblioteca",
                               "qr": "<svg></svg>", "barcode": "", "barwidth": "", "code": "10000H"}]}],
        "empty": ""
    }
}}
<div class="ayv-print-head">
    <h1 class="ayv-results-title">{{heading}}</h1>
    <p>{{intro}}</p>
    {{#hassheets}}<p><button type="button" class="ayv-button" onclick="window.print()">{{print}}</button></p>{{/hassheets}}
    {{#next}}<p><a class="ayv-button ayv-button-quiet" href="{{next}}">{{nextlabel}}</a></p>{{/next}}
</div>
{{^hassheets}}<p class="ayv-empty">{{empty}}</p>{{/hassheets}}
{{#sheets}}
<div class="ayv-sheet ayv-sheet-{{paper}}">
    {{{guides}}}
    <p class="ayv-sheet-note ayv-sheet-note-a">{{title}}</p>
    <p class="ayv-sheet-note ayv-sheet-note-b">{{how}}</p>
    <p class="ayv-sheet-note ayv-sheet-note-c">{{ruler}}</p>
    {{#sample}}<p class="ayv-sheet-note ayv-sheet-note-d">{{sample}}</p>{{/sample}}
    <div class="ayv-sheet-cards">
    {{#cards}}
        <div class="ayv-printcard ayv-printcard-{{look}} ayv-printcard-skin-{{skin}}">
            {{#art}}<img class="ayv-printcard-picture" src="{{art}}" alt="">{{/art}}
            <div class="ayv-printcard-who">
                <p class="ayv-printcard-label">{{label}}</p>
                <p class="ayv-printcard-name ayv-printcard-{{namesize}}">{{name}}</p>
                {{#group}}<p class="ayv-printcard-group">{{group}}</p>{{/group}}
                <p class="ayv-printcard-library">{{library}}</p>
            </div>
            <div class="ayv-printcard-qr">{{{qr}}}</div>
            <div class="ayv-printcard-bars"{{#barwidth}} style="--ayv-print-bars: {{barwidth}}mm"{{/barwidth}}>
                {{{barcode}}}
                <p>{{code}}</p>
            </div>
        </div>
    {{/cards}}
    </div>
</div>
{{/sheets}}
