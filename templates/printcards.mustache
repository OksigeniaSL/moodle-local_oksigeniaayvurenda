{{!
    @template local_oksigeniaayvurenda/printcards

    Reader cards to print: sheets of ten, each card 85.6 × 54 mm.

    Context variables required for this template:
    * heading, intro, print, empty - texts
    * sheets - list of cards (name, group, library, code, barcode as SVG, qr image address, flower)

    Example context (json):
    {
        "heading": "Carnés de 3º A",
        "intro": "25 carnés.",
        "print": "Imprimir",
        "hassheets": true,
        "sheets": [{"cards": [{"name": "Ana Montes", "group": "3º A", "library": "Biblioteca", "code": "10000H",
                               "barcode": "", "qr": "app/emblema.svg", "flower": "emblema.svg"}]}],
        "empty": ""
    }
}}
<div class="ayv-print-head">
    <h1 class="ayv-results-title">{{heading}}</h1>
    <p>{{intro}}</p>
    {{#hassheets}}<p><button type="button" class="ayv-button" onclick="window.print()">{{print}}</button></p>{{/hassheets}}
</div>
{{^hassheets}}<p class="ayv-empty">{{empty}}</p>{{/hassheets}}
{{#sheets}}
<div class="ayv-sheet">
{{#cards}}
    <div class="ayv-printcard">
        <div class="ayv-printcard-top">
            <img src="{{flower}}" alt="" width="40" height="40">
            <div><p class="ayv-printcard-name">{{name}}</p><p>{{group}}{{#group}} · {{/group}}{{library}}</p></div>
            {{#qr}}<img class="ayv-printcard-qr" src="{{qr}}" alt="">{{/qr}}
        </div>
        {{#barcode}}<div class="ayv-printcard-barcode">{{{barcode}}}</div>{{/barcode}}
    </div>
{{/cards}}
</div>
{{/sheets}}
