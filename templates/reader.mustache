{{!
    @template local_oksigeniaayvurenda/reader

    A reader's record, for the library staff: their photo (or initial), who they are this year, their card, their flower
    or sky, what they have now and their reservations, what they took home this year and before, and the staff's notes.

    Context variables required for this template:
    * name, hasphoto, photo, initial, type, facts (fact), tutorof (label, url), cardcode, barcode, since, gone, drawing,
      stagename; backurl, backlabel, profileback: the way back; historyurl, historylabel: everything they took out
    * canedit, hasaccount, formfirst, formlast, formemail, formhastypes, formtypes, formgroups, formlocked, formhasgroups, formcanteach,
      formtutors: what the staff can change; gonenow, stayaccount, canmatch, cantwin: whether they still come
    * loans - title, url, hascover, coverurl, colour, due, library, late; hasloans
    * holds - title, state; hasholds
    * readheading, read (title, url, hascover, coverurl, colour, when, note), hasread, readmore
    * past - year, loans; haspast
    * notes, staffonly, notice, action, sesskey, deskurl, cardurl, appheading
    * app - false, or can, button and hint: the way into the app, by e-mail
    * profiledesk, profilecard, profilenow, profilenothing, profileholds, profilenoread, profilepastheading,
      profilenotes, profilenoteshint, profilesave, profilegone, profilecode

    Example context (json):
    {
        "name": "Lucía Arenas Faro", "hasphoto": true, "photo": "https://example.com/foto.jpg", "initial": "L", "type": "Alumno",
        "facts": [{"fact": "2.º A · Primaria"}], "cardcode": "12018N", "barcode": "", "since": "Lectora desde mayo",
        "gone": false, "drawing": false, "stagename": "Brote",
        "loans": [{"title": "El faro dormido", "url": "#", "hascover": true, "coverurl": "https://example.com/portada.jpg", "colour": 2,
            "due": "Hasta el 14 de noviembre", "library": "Biblioteca", "late": ""}], "hasloans": true,
        "holds": [], "hasholds": false, "readheading": "2026-2027: 3 libros",
        "read": [{"title": "El faro dormido", "url": "#", "hascover": true, "coverurl": "https://example.com/portada.jpg", "colour": 2,
            "when": "14 de octubre", "note": "Le encantó"}], "hasread": true, "readmore": "",
        "past": [{"year": "2025-2026", "loans": "23 libros"}], "haspast": true,
        "backurl": "#", "backlabel": "Lectores", "profileback": "Volver a", "tutorof": [], "historyurl": "#",
        "historylabel": "Ver todo su historial (3)", "canedit": false, "gonenow": false,
        "notes": "", "staffonly": true, "notice": "", "action": "#", "sesskey": "x", "deskurl": "#", "cardurl": "#", "canrecard": true, "profilenewcard": "Carné perdido", "profilenewcardintro": "Dejará de valer.", "profilenewcardgo": "Hacer otro carné", "selfclose": "Cerrar", "appheading": "La app",
        "app": {"can": true, "button": "Mandarle la app", "hint": "Le llega un correo con un enlace."},
        "entry": {"url": "#", "heading": "Entrar por la web", "hint": "Una cuenta con una contraseña provisional.", "button": "Darle entrada"},
        "profiledesk": "Abrir en el mostrador", "profilecard": "Ver su carné", "profilenow": "Ahora tiene",
        "profilenothing": "Nada prestado.", "profileholds": "Reservas", "profilenoread": "Nada este curso todavía.",
        "profilepastheading": "Cursos anteriores", "profilenotes": "Notas del personal",
        "profilenoteshint": "Solo las ve el personal.", "profilesave": "Guardar", "profilegone": "Ya no está en el centro",
        "profilecode": "Carné"
    }
}}
<section class="ayv-profile">
<p class="ayv-back"><a href="{{backurl}}"><span aria-hidden="true">←</span> <span class="ayv-sr">{{profileback}}: </span>{{backlabel}}</a></p>
{{#notice}}<p class="ayv-notice" role="status">{{notice}}</p>{{/notice}}
<header class="ayv-profile-head">
    <div class="ayv-profile-face">
        {{#hasphoto}}<img src="{{photo}}" alt="" width="200" height="200">{{/hasphoto}}
        {{^hasphoto}}<span aria-hidden="true">{{initial}}</span>{{/hasphoto}}
    </div>
    <div class="ayv-profile-who">
        {{#type}}<p class="ayv-profile-type">{{type}}</p>{{/type}}
        <h1 class="ayv-profile-name">{{name}}</h1>
        {{#gone}}<p class="ayv-profile-gone">{{profilegone}}</p>{{/gone}}
        <ul class="ayv-profile-facts">{{#facts}}<li>{{fact}}</li>{{/facts}}{{#tutorof}}<li><a href="{{url}}">{{label}}</a></li>{{/tutorof}}<li>{{since}}</li></ul>
        <p class="ayv-profile-actions">
            <a class="ayv-button" href="{{deskurl}}">{{profiledesk}}</a>
            <a class="ayv-button ayv-button-quiet" href="{{cardurl}}">{{profilecard}}</a>
            {{#printurl}}<a class="ayv-button ayv-button-quiet" href="{{printurl}}">{{profileprint}}</a>{{/printurl}}
            {{#canedit}}<button type="button" class="ayv-button ayv-button-quiet" data-ayv-open="ayv-reader-data">{{profiledata}}</button>{{/canedit}}
        </p>
    </div>
    <div class="ayv-profile-card">
        {{#drawing}}<div class="ayv-profile-drawing">{{{drawing}}}<span>{{stagename}}</span></div>{{/drawing}}
        <div class="ayv-profile-code">
            <span class="ayv-profile-codelabel">{{profilecode}}</span>
            {{#barcode}}<span class="ayv-profile-barcode">{{{barcode}}}</span>{{/barcode}}
            <span class="ayv-profile-codetext">{{cardcode}}</span>
            {{#canrecard}}<button type="button" class="ayv-button ayv-button-quiet ayv-profile-recard" data-ayv-open="ayv-profile-newcard">{{profilenewcard}}</button>{{/canrecard}}
        </div>
    </div>
</header>
{{#canedit}}
<dialog class="ayv-modal" id="ayv-reader-data" aria-labelledby="ayv-reader-data-title">
    <div class="ayv-modal-head"><h3 id="ayv-reader-data-title" class="ayv-section-title">{{profiledata}}</h3>
        <form method="dialog"><button class="ayv-modal-close" aria-label="{{selfclose}}">{{> local_oksigeniaayvurenda/icon_x}}</button></form></div>
    <form method="post" action="{{action}}" class="ayv-dig-form">
        <input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="do" value="data">
        {{^hasaccount}}
        <label class="ayv-field">{{profiledatafirst}} <input type="text" name="firstname" value="{{formfirst}}" maxlength="255"></label>
        <label class="ayv-field">{{profiledatalast}} <input type="text" name="lastname" value="{{formlast}}" maxlength="255"></label>
        <label class="ayv-field">{{profiledataemail}} <input type="email" name="email" value="{{formemail}}" maxlength="254"></label>
        {{/hasaccount}}
        {{#hasaccount}}<p class="ayv-field-hint">{{profiledataaccount}}</p>{{/hasaccount}}
        {{#formhastypes}}<label class="ayv-field">{{profiledatatype}} <select name="newtype">{{#formtypes}}<option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>{{/formtypes}}</select></label>{{/formhastypes}}
        {{#formlocked}}<p class="ayv-field-hint">{{formlocked}}</p>{{/formlocked}}
        {{^formlocked}}{{#formhasgroups}}<label class="ayv-field">{{profiledatagroup}} <select name="newgroup"><option value="">{{profiledatanogroup}}</option>{{#formgroups}}<option value="{{name}}" {{#selected}}selected{{/selected}}>{{name}}</option>{{/formgroups}}</select></label>{{/formhasgroups}}{{/formlocked}}
        {{#formcanteach}}<label class="ayv-field">{{profiledatatutor}} <select name="tutorof"><option value="">{{profiledatatutornone}}</option>{{#formtutors}}<option value="{{name}}" {{#selected}}selected{{/selected}}>{{label}}</option>{{/formtutors}}</select></label>
        <p class="ayv-field-hint">{{profiledatatutorhint}}</p>{{/formcanteach}}
        <p class="ayv-dig-sheet-actions"><button type="submit" class="ayv-button">{{profilesave}}</button></p>
    </form>
</dialog>
{{/canedit}}
{{#canrecard}}
<dialog class="ayv-modal" id="ayv-profile-newcard" aria-labelledby="ayv-profile-newcard-title">
    <div class="ayv-modal-head"><h3 id="ayv-profile-newcard-title" class="ayv-section-title">{{profilenewcard}}</h3>
        <form method="dialog"><button class="ayv-modal-close" aria-label="{{selfclose}}">{{> local_oksigeniaayvurenda/icon_x}}</button></form></div>
    <p>{{profilenewcardintro}}</p>
    <form method="post" action="{{action}}"><input type="hidden" name="sesskey" value="{{sesskey}}">
        <input type="hidden" name="do" value="newcard">
        <p class="ayv-dig-sheet-actions"><button type="submit" class="ayv-button">{{profilenewcardgo}}</button></p></form>
</dialog>
{{/canrecard}}

<div class="ayv-profile-grid">
    <div class="ayv-profile-col">
        {{#lateopen}}{{> local_oksigeniaayvurenda/reader_sanctions}}{{/lateopen}}
        <section class="ayv-profile-box">
            <h2 class="ayv-profile-heading">{{profilenow}}</h2>
            {{^hasloans}}<p class="ayv-profile-empty">{{profilenothing}}</p>{{/hasloans}}
            <ul class="ayv-profile-books">
                {{#loans}}
                <li class="{{#late}}ayv-profile-late{{/late}}">
                    <a class="ayv-profile-book" href="{{url}}">
                        <span class="ayv-cover ayv-cover-{{colour}}{{#hascover}} ayv-cover-photo{{/hascover}}" aria-hidden="true">{{#hascover}}<img class="ayv-cover-img" src="{{coverurl}}" alt="" loading="lazy">{{/hascover}}</span>
                        <span class="ayv-profile-booktext"><b>{{title}}</b><span>{{due}} · {{library}}</span>{{#late}}<span class="ayv-profile-latetag">{{late}}</span>{{/late}}</span>
                    </a>
                    {{#canlose}}<details class="ayv-profile-lost"><summary>{{lostlabel}}</summary>
                        <form method="post" action="{{action}}"><input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="do" value="lost">
                            <input type="hidden" name="loan" value="{{loanid}}"><button type="submit" class="ayv-button ayv-button-quiet">{{lostsure}}</button></form>
                    </details>{{/canlose}}
                </li>
                {{/loans}}
            </ul>
        </section>
        {{#latequiet}}{{> local_oksigeniaayvurenda/reader_sanctions}}{{/latequiet}}
        {{#hasholds}}
        <section class="ayv-profile-box">
            <h2 class="ayv-profile-heading">{{profileholds}}</h2>
            <ul class="ayv-profile-holds">{{#holds}}<li><b>{{title}}</b> <span>{{state}}</span></li>{{/holds}}</ul>
        </section>
        {{/hasholds}}
        {{#staffonly}}
        <section class="ayv-profile-box">
            <h2 class="ayv-profile-heading">{{profileneeds}}</h2>
            <form method="post" action="{{action}}">
                <input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="do" value="needs">
                <label class="ayv-field ayv-field-check"><input type="checkbox" name="needs" value="1" {{#needs}}checked{{/needs}}> {{profileneedslabel}}</label>
                <p class="ayv-field-hint">{{profileneedshint}}</p>
                <p class="ayv-book-actions"><button type="submit" class="ayv-button ayv-button-quiet">{{profilesave}}</button></p>
            </form>
            {{#asks.0}}<h3 class="ayv-profile-sub">{{profileneedsasks}}</h3>
            <ul class="ayv-profile-holds">{{#asks}}<li><b>{{title}}</b> <span>{{format}} · {{state}}</span></li>{{/asks}}</ul>{{/asks.0}}
        </section>
        <section class="ayv-profile-box">
            <h2 class="ayv-profile-heading">{{profilenotes}}</h2>
            <form method="post" action="{{action}}">
                <input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="do" value="notes">
                <label class="ayv-sr" for="ayv-profile-notes">{{profilenotes}}</label>
                <textarea id="ayv-profile-notes" name="notes" rows="4" maxlength="1000">{{notes}}</textarea>
                <p class="ayv-field-hint">{{profilenoteshint}}</p>
                <p class="ayv-book-actions"><button type="submit" class="ayv-button ayv-button-quiet">{{profilesave}}</button></p>
            </form>
        </section>
        {{/staffonly}}
        {{#entry}}
        <section class="ayv-profile-box">
            <h2 class="ayv-profile-heading">{{heading}}</h2>
            <p class="ayv-field-hint">{{hint}}</p>
            <form method="post" action="{{url}}">
                <input type="hidden" name="sesskey" value="{{sesskey}}">
                <p class="ayv-book-actions"><button type="submit" class="ayv-button ayv-button-quiet">{{button}}</button></p>
            </form>
        </section>
        {{/entry}}
        {{#app}}
        <section class="ayv-profile-box">
            <h2 class="ayv-profile-heading">{{appheading}}</h2>
            <p class="ayv-field-hint">{{hint}}</p>
            {{#can}}
            <form method="post" action="{{action}}">
                <input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="do" value="app">
                <p class="ayv-book-actions"><button type="submit" class="ayv-button ayv-button-quiet">{{button}}</button></p>
            </form>
            {{/can}}
            {{#needsemail}}{{#canedit}}<p class="ayv-book-actions"><button type="button" class="ayv-button ayv-button-quiet" data-ayv-open="ayv-reader-data">{{appaddemail}}</button></p>{{/canedit}}{{/needsemail}}
        </section>
        {{/app}}
    </div>
    <div class="ayv-profile-col">
        <section class="ayv-profile-box">
            <h2 class="ayv-profile-heading">{{readheading}}</h2>
            {{^hasread}}<p class="ayv-profile-empty">{{profilenoread}}</p>{{/hasread}}
            <ul class="ayv-profile-read">
                {{#read}}
                <li><a href="{{url}}"><span class="ayv-cover ayv-cover-{{colour}}{{#hascover}} ayv-cover-photo{{/hascover}}" aria-hidden="true">{{#hascover}}<img class="ayv-cover-img" src="{{coverurl}}" alt="" loading="lazy">{{/hascover}}</span>
                    <span><b>{{title}}</b><span>{{when}}{{#note}} · {{note}}{{/note}}</span></span></a></li>
                {{/read}}
            </ul>
            {{#readmore}}<p class="ayv-profile-empty">{{readmore}}</p>{{/readmore}}
            {{#historyurl}}<p class="ayv-book-actions"><a class="ayv-button ayv-button-quiet" href="{{historyurl}}">{{historylabel}}</a></p>{{/historyurl}}
        </section>
        {{#haspast}}
        <section class="ayv-profile-box">
            <h2 class="ayv-profile-heading">{{profilepastheading}}</h2>
            <ul class="ayv-profile-past">{{#past}}<li><span>{{year}}</span><b>{{loans}}</b></li>{{/past}}</ul>
        </section>
        {{/haspast}}
        {{#canedit}}
        <section class="ayv-profile-box">
            {{^gonenow}}<h2 class="ayv-profile-heading">{{profileleaveheading}}</h2>
            <p class="ayv-field-hint">{{profileleavehint}} {{stayaccount}}</p>{{/gonenow}}
            {{#gonenow}}<h2 class="ayv-profile-heading">{{profilebackheading}}</h2>
            <p class="ayv-field-hint">{{profilebackhint}}</p>{{/gonenow}}
            <form method="post" action="{{action}}">
                <input type="hidden" name="sesskey" value="{{sesskey}}">
                <input type="hidden" name="do" value="{{^gonenow}}left{{/gonenow}}{{#gonenow}}back{{/gonenow}}">
                <p class="ayv-book-actions"><button type="submit" class="ayv-button ayv-button-quiet">{{^gonenow}}{{profileleavego}}{{/gonenow}}{{#gonenow}}{{profilebackgo}}{{/gonenow}}</button>
                {{#canmatch}}<a class="ayv-button ayv-button-quiet" href="{{canmatch}}">{{profilematch}}</a>{{/canmatch}}
                {{#cantwin}}<a class="ayv-button ayv-button-quiet" href="{{cantwin}}">{{profiletwin}}</a>{{/cantwin}}</p>
            </form>
        </section>
        {{/canedit}}
        {{#canerase}}
        <section class="ayv-profile-box">
            <h2 class="ayv-profile-heading">{{readererase}}</h2>
            <p class="ayv-field-hint">{{readererasehint}}</p>
            <p class="ayv-book-actions"><button type="button" class="ayv-button ayv-button-danger" data-ayv-open="ayv-reader-erase">{{readererasego}}</button></p>
            <dialog class="ayv-modal" id="ayv-reader-erase" aria-labelledby="ayv-reader-erase-title">
                <div class="ayv-modal-head"><h3 id="ayv-reader-erase-title" class="ayv-section-title">{{erasetitle}}</h3>
                    <form method="dialog"><button class="ayv-modal-close" aria-label="{{selfclose}}">{{> local_oksigeniaayvurenda/icon_x}}</button></form></div>
                <p>{{readererasegoes}}</p>
                <p class="ayv-field-hint">{{readererasestays}}</p>
                <form method="post" action="{{action}}" class="ayv-dig-form">
                    <input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="do" value="erase">
                    {{#eraselost}}<label class="ayv-field ayv-field-check"><input type="checkbox" name="lost" value="1" required> {{eraselost}}</label>{{/eraselost}}
                    <label class="ayv-field ayv-field-check"><input type="checkbox" name="sure" value="1" required> {{readererasecheck}}</label>
                    <p class="ayv-dig-sheet-actions"><button type="submit" class="ayv-button ayv-button-danger">{{erasedo}}</button>
                        <button type="submit" formmethod="dialog" formnovalidate class="ayv-button ayv-button-quiet">{{readererasekeep}}</button></p>
                </form>
            </dialog>
        </section>
        {{/canerase}}
    </div>
</div>
</section>
