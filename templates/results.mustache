{{!
    @template local_oksigeniaayvurenda/results

    Results of a search or the books of a corner, with suggestions when nothing was found.

    Context variables required for this template:
    * heading - what was found
    * cards - cards of records (see local_oksigeniaayvurenda/cards)
    * suggestions - list of text and url, for a search that found nothing
    * more - url and label of the next page, if there is one

    Example context (json):
    {
        "heading": "No hay nada con «bolcan».",
        "hascards": false,
        "cards": [],
        "memory": {"initial": "M", "role": "memory", "name": "Memoria", "text": "No lo tenemos."},
        "hassuggestions": true,
        "didyoumean": "¿Querías decir…?",
        "suggestions": [{"text": "volcan", "url": "#"}],
        "corrected": {"correctedtext": "Has escrito «bolcan»: esto es lo más parecido del catálogo.",
            "asislabel": "Buscar «bolcan» tal cual", "asisurl": "https://example.org/search.php?q=bolcan&asis=1"},
        "tryother": "",
        "more": null,
        "filter": {"url": "#", "label": "Solo los libres", "pressed": "false"},
        "facets": {"hascorners": true, "corners": [{"label": "Cuentos y poemas", "count": 12, "pressed": "false", "url": "#"}],
            "hassubjects": false, "subjects": [], "cornerslabel": "Rincones", "subjectslabel": "Temas",
            "refinelabel": "Afinar", "chips": 1, "chosen": false}
    }
}}
<div class="ayv-results">
    <div class="ayv-results-head">
        <h1 class="ayv-results-title">{{heading}}</h1>
        {{#filter}}<a class="ayv-toggle" href="{{url}}" role="button" aria-pressed="{{pressed}}">{{label}}</a>{{/filter}}
    </div>
    {{#corrected}}<p class="ayv-corrected">{{correctedtext}} <a href="{{asisurl}}">{{asislabel}}</a></p>{{/corrected}}
    {{#facets}}
    <details class="ayv-facets-fold" open data-ayv-fold="{{#chosen}}keep{{/chosen}}">
    <summary class="ayv-chip">{{refinelabel}} · {{chips}}</summary>
    <div class="ayv-facets">
        {{#hascorners}}<p class="ayv-facet"><span class="ayv-facet-label">{{cornerslabel}}</span>
            {{#corners}}<a class="ayv-chip" href="{{url}}" role="button" aria-pressed="{{pressed}}">{{label}} <span class="ayv-chip-count">{{count}}</span></a> {{/corners}}</p>{{/hascorners}}
        {{#hassubjects}}<p class="ayv-facet"><span class="ayv-facet-label">{{subjectslabel}}</span>
            {{#subjects}}<a class="ayv-chip" href="{{url}}" role="button" aria-pressed="{{pressed}}">{{label}} <span class="ayv-chip-count">{{count}}</span></a> {{/subjects}}</p>{{/hassubjects}}
    </div>
    </details>
    {{/facets}}
    {{#memory}}{{> local_oksigeniaayvurenda/bubble}}{{/memory}}
    {{#askforit}}<p class="ayv-more"><a class="ayv-button ayv-button-quiet" href="{{url}}">{{label}}</a></p>{{/askforit}}
    {{#hassuggestions}}
    <p class="ayv-suggest">{{didyoumean}}
        {{#suggestions}}<a class="ayv-chip" href="{{url}}">{{text}}</a> {{/suggestions}}
    </p>
    {{/hassuggestions}}
    {{#tryother}}<p class="ayv-empty">{{tryother}}</p>{{/tryother}}
    {{#hascards}}{{> local_oksigeniaayvurenda/cards}}{{/hascards}}
    {{#more}}<p class="ayv-more"><a class="ayv-button" href="{{url}}">{{label}}</a></p>{{/more}}
</div>
