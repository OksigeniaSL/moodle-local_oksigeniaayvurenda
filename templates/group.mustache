{{!
    @template local_oksigeniaayvurenda/group

    The readers of a group, with the code of their card and what they have out.

    Context variables required for this template:
    * heading - the group
    * readers - list of name, photo, initial, url (their record), cardcode and loans
    * back - url and label to go back; backword, what a screen reader says before it
    * intro, find - what the list is, and the search of all the readers, where the list is long

    Example context (json):
    {
        "heading": "3º Primaria A",
        "hasreaders": true,
        "readers": [{"name": "Ana Montes", "photo": false, "initial": "A", "url": "#", "cardcode": "10000H", "loans": 1}],
        "cardlabel": "Carné",
        "loanslabel": "Tiene prestados:",
        "back": {"url": "#", "label": "Lectores"},
        "backword": "Volver a",
        "print": {"url": "#", "label": "Imprimir carnés"},
        "empty": ""
    }
}}
{{#back}}<p class="ayv-back"><a href="{{url}}"><span aria-hidden="true">←</span> <span class="ayv-sr">{{backword}}: </span>{{label}}</a></p>{{/back}}
<h1 class="ayv-results-title">{{heading}}</h1>
{{#intro}}<p>{{intro}}</p>{{/intro}}
{{#find}}
<form class="ayv-readers-find" role="search" method="get" action="{{action}}">
    <input type="hidden" name="library" value="{{library}}">
    <label for="ayv-readers-q" class="ayv-sr">{{findlabel}}</label>
    <input id="ayv-readers-q" type="search" name="q" placeholder="{{findhint}}" maxlength="100" autocomplete="off">
    <button type="submit" class="ayv-button ayv-button-quiet">{{findgo}}</button>
</form>
{{/find}}
{{#challenge}}
{{#notice}}<p class="ayv-notice" role="status">{{notice}}</p>{{/notice}}
<section class="ayv-classbar">
    <div class="ayv-classbar-box ayv-classbar-now">
        {{#current}}{{> local_oksigeniaayvurenda/challenge}}{{/current}}
        {{#offstage}}<p class="ayv-field-hint">{{offstage}}</p>{{/offstage}}
    </div>
    {{^locked}}<form class="ayv-classbar-box ayv-classbar-choose" method="post" action="{{action}}">
        <input type="hidden" name="sesskey" value="{{sesskey}}">
        <fieldset>
            <legend class="ayv-classbar-label">{{choose}}</legend>
            <div class="ayv-segmented">{{#kinds}}<label><input type="radio" name="challenge" value="{{value}}" {{#checked}}checked{{/checked}}><span>{{label}}</span></label>{{/kinds}}</div>
        </fieldset>
        <p class="ayv-classbar-hint">{{choosehint}}</p>
        <p class="ayv-book-actions"><button type="submit" class="ayv-button ayv-button-quiet">{{save}}</button></p>
    </form>{{/locked}}
    <div class="ayv-classbar-box ayv-classbar-garden">
        <p class="ayv-classbar-label">{{gardenheading}}</p>
        {{#hasgarden}}<ul class="ayv-classbar-plants">{{#garden}}<li>{{label}}</li>{{/garden}}</ul>{{/hasgarden}}
        {{^hasgarden}}<p class="ayv-classbar-hint">{{gardenempty}}</p>{{/hasgarden}}
    </div>
</section>
{{/challenge}}
{{#hasreaders}}
<ul class="ayv-people ayv-people-grid">
{{#readers}}
    <li class="ayv-person">
        <span class="ayv-person-face" aria-hidden="true">{{#photo}}<img src="{{photo}}" alt="">{{/photo}}{{^photo}}{{initial}}{{/photo}}</span>
        <span class="ayv-person-text"><a class="ayv-person-name" href="{{url}}">{{name}}</a>
        <span class="ayv-person-card"><span class="ayv-sr">{{cardlabel}}: </span>{{cardcode}}</span></span>
        {{#loans}}<span class="ayv-person-loans" title="{{loanslabel}}">{{loans}}</span>{{/loans}}
    </li>
{{/readers}}
</ul>
{{/hasreaders}}
{{#pager}}{{> local_oksigeniaayvurenda/readers_pager}}{{/pager}}
{{#empty}}<p class="ayv-empty">{{empty}}</p>{{/empty}}
{{#print}}<p class="ayv-more"><a class="ayv-button" href="{{url}}">{{label}}</a></p>{{/print}}
{{#entry}}<p class="ayv-more"><a class="ayv-button ayv-button-quiet" href="{{url}}">{{label}}</a></p>{{/entry}}
