{{!
    @template local_oksigeniaayvurenda/group

    The readers of a group, with the code of their card and what they have out.

    Context variables required for this template:
    * heading - the group
    * readers - list of name, photo, initial, url (their record), cardcode and loans
    * back - url and label to go back

    Example context (json):
    {
        "heading": "3º Primaria A",
        "hasreaders": true,
        "readers": [{"name": "Ana Montes", "photo": false, "initial": "A", "url": "#", "cardcode": "10000H", "loans": 1}],
        "cardlabel": "Carné",
        "loanslabel": "Tiene prestados:",
        "back": {"url": "#", "label": "Todos los grupos"},
        "print": {"url": "#", "label": "Imprimir carnés"},
        "empty": ""
    }
}}
<h1 class="ayv-results-title">{{heading}}</h1>
{{#challenge}}
<section class="ayv-section ayv-book">
    {{#notice}}<p class="ayv-notice" role="status">{{notice}}</p>{{/notice}}
    {{#offstage}}<p class="ayv-field-hint">{{offstage}}</p>{{/offstage}}
    {{#current}}{{> local_oksigeniaayvurenda/challenge}}{{/current}}
    {{^locked}}<form method="post" action="{{action}}">
        <input type="hidden" name="sesskey" value="{{sesskey}}">
        <fieldset class="ayv-fieldset"><legend>{{choose}}</legend>
            <p class="ayv-field-hint">{{choosehint}}</p>
            {{#kinds}}<label class="ayv-field ayv-field-check"><input type="radio" name="challenge" value="{{value}}" {{#checked}}checked{{/checked}}> {{label}}</label>{{/kinds}}
        </fieldset>
        <p class="ayv-book-actions"><button type="submit" class="ayv-button ayv-button-quiet">{{save}}</button></p>
    </form>{{/locked}}
    <h2 class="ayv-section-title">{{gardenheading}}</h2>
    {{#hasgarden}}<ul class="ayv-sources">{{#garden}}<li>{{label}}</li>{{/garden}}</ul>{{/hasgarden}}
    {{^hasgarden}}<p class="ayv-empty">{{gardenempty}}</p>{{/hasgarden}}
</section>
{{/challenge}}
{{#hasreaders}}
<ul class="ayv-people">
{{#readers}}
    <li class="ayv-person">
        <span class="ayv-person-face" aria-hidden="true">{{#photo}}<img src="{{photo}}" alt="">{{/photo}}{{^photo}}{{initial}}{{/photo}}</span>
        <a class="ayv-person-name" href="{{url}}">{{name}}</a>
        <span class="ayv-person-card"><span class="ayv-sr">{{cardlabel}}: </span>{{cardcode}}</span>
        <span class="ayv-person-loans" title="{{loanslabel}}">{{loans}}</span>
    </li>
{{/readers}}
</ul>
{{/hasreaders}}
{{#empty}}<p class="ayv-empty">{{empty}}</p>{{/empty}}
<p class="ayv-more">
    {{#print}}<a class="ayv-button" href="{{url}}">{{label}}</a>{{/print}}
    {{#back}}<a class="ayv-button ayv-button-quiet" href="{{url}}">{{label}}</a>{{/back}}
</p>
