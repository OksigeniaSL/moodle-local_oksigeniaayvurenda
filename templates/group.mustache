{{!
    @template local_oksigeniaayvurenda/group

    The readers of a group, with the code of their card and what they have out.

    Context variables required for this template:
    * heading - the group
    * readers - list of name, cardcode and loans
    * back - url and label to go back

    Example context (json):
    {
        "heading": "3º Primaria A",
        "hasreaders": true,
        "readers": [{"name": "Ana Montes", "cardcode": "10000H", "loans": 1}],
        "cardlabel": "Carné",
        "loanslabel": "Tiene prestados:",
        "back": {"url": "#", "label": "Todos los grupos"},
        "print": {"url": "#", "label": "Imprimir carnés"},
        "empty": ""
    }
}}
<h1 class="ayv-results-title">{{heading}}</h1>
{{#hasreaders}}
<ul class="ayv-people">
{{#readers}}
    <li class="ayv-person">
        <span class="ayv-person-name">{{name}}</span>
        <span class="ayv-person-card"><span class="ayv-sr">{{cardlabel}}: </span>{{cardcode}}</span>
        <span class="ayv-person-loans" title="{{loanslabel}}">{{loans}}</span>
    </li>
{{/readers}}
</ul>
{{/hasreaders}}
{{#empty}}<p class="ayv-empty">{{empty}}</p>{{/empty}}
<p class="ayv-more">
    {{#print}}<a class="ayv-button" href="{{url}}">{{label}}</a>{{/print}}
    {{#back}}<a class="ayv-button ayv-button-quiet" href="{{url}}">{{label}}</a>{{/back}}
</p>
