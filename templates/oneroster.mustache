{{!
    @template local_oksigeniaayvurenda/oneroster

    Readers from a OneRoster export: upload the zip, see what it brings, load it.

    Context variables required for this template:
    * heading, intro, notice, error, plansummary - texts
    * action, sesskey - the forms
    * upload - whether it is the first step
    * check - mode, counts, schoolchoice (options: value, label; null with one school), hasfamilies

    Example context (json):
    {
        "heading": "Lectores desde OneRoster", "intro": "El zip que exporta el programa de gestión.", "notice": "",
        "error": "", "plansummary": "", "action": "#", "sesskey": "abc", "upload": false,
        "check": {"mode": "Exportación completa", "counts": "Alumnos: 120 · Profesores: 12", "hasfamilies": true,
            "schoolchoice": {"options": [{"value": "", "label": "Todos"}, {"value": "s1", "label": "Colegio Alfa"}]}
        },
        "onerosterfile": "El zip", "onerosternext": "Ver lo que trae", "onerostercheck": "Lo que trae",
        "onerosterschool": "Centro", "onerosterfamilies": "También las familias", "onerosterload": "Cargarlos",
        "onerostercancel": "Otro fichero"
    }
}}
<h1 class="ayv-results-title">{{heading}}</h1>
<p>{{intro}}</p>
{{#plansummary}}<p class="ayv-field-hint">{{plansummary}}</p>{{/plansummary}}
{{#notice}}<p class="ayv-notice" role="status">{{notice}}</p>{{/notice}}
{{#error}}<p class="ayv-notice ayv-notice-error" role="alert">{{error}}</p>{{/error}}
{{#upload}}
<form method="post" action="{{action}}" enctype="multipart/form-data" class="ayv-book">
    <input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="step" value="upload">
    <label class="ayv-field">{{onerosterfile}} <input type="file" name="file" accept=".zip,application/zip" required></label>
    <p class="ayv-book-actions"><button type="submit" class="ayv-button">{{onerosternext}}</button></p>
</form>
{{/upload}}
{{#check}}
<form method="post" action="{{action}}" class="ayv-book">
    <input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="step" value="load">
    <h2 class="ayv-section-title">{{onerostercheck}}</h2>
    <p>{{counts}}</p>
    <p class="ayv-field-hint">{{mode}}</p>
    {{#schoolchoice}}<label class="ayv-field">{{onerosterschool}} <select name="school">{{#options}}<option value="{{value}}">{{label}}</option>{{/options}}</select></label>{{/schoolchoice}}
    {{#hasfamilies}}<label class="ayv-field ayv-field-check"><input type="checkbox" name="families" value="1"> {{onerosterfamilies}}</label>{{/hasfamilies}}
    <p class="ayv-book-actions"><button type="submit" class="ayv-button">{{onerosterload}}</button>
        <button type="submit" class="ayv-button ayv-button-quiet" name="step" value="cancel">{{onerostercancel}}</button></p>
</form>
{{/check}}
