{{!
    @template local_oksigeniaayvurenda/stocktake_shelf

    One shelf of twenty spines on its plank: the ones read lit in the colours of the house; quiet, before counting.

    Context variables required for this template:
    * spines - on, for each spine
    * quiet - not counting yet

    Example context (json):
    {"quiet": false, "spines": [{"on": true}, {"on": false}]}
}}
<span class="ayv-st-balda{{#quiet}} ayv-st-quieta{{/quiet}}" aria-hidden="true">{{#spines}}<i{{#on}} class="si"{{/on}}></i>{{/spines}}</span>
