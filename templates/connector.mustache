{{!
    @template local_oksigeniaayvurenda/connector

    The centre's management program as the source of readers.

    Context variables required for this template:
    * heading, intro, notice, error - texts
    * action, sesskey - the form
    * enabled, url, modekey, modeoauth, example, clientid, keyhint, secrethint - the settings
    * the words of the fields and buttons

    Example context (json):
    {
        "heading": "El programa de gestión",
        "intro": "Los lectores, desde Cifra.",
        "notice": "",
        "error": "",
        "action": "#",
        "sesskey": "abc",
        "enabled": false,
        "url": "",
        "modekey": true,
        "modeoauth": false,
        "example": false,
        "clientid": "",
        "keyhint": "guardada; escríbela solo para cambiarla",
        "secrethint": "",
        "cifraenabled": "Traer los lectores de Cifra cada noche", "cifraurl": "Dirección", "cifraurlhint": "La del puente o la de Cifra", "cifrahow": "Cómo se conecta",
        "ciframodekey": "Con la llave del puente", "ciframodeoauth": "Directamente con Cifra", "cifrakey": "Llave",
        "cifraclientid": "Identificador", "cifrasecret": "Secreto", "cifraexample": "Usar los datos de ejemplo del puente",
        "cifratest": "Probar la conexión", "cifrasync": "Traer los lectores ahora", "sourcessave": "Guardar"
    }
}}
<h1 class="ayv-results-title">{{heading}}</h1>
<p>{{intro}}</p>
{{#notice}}<p class="ayv-notice" role="status">{{notice}}</p>{{/notice}}
{{#error}}<p class="ayv-notice ayv-notice-error" role="alert">{{error}}</p>{{/error}}
<form method="post" action="{{action}}" class="ayv-book" autocomplete="off">
    <input type="hidden" name="sesskey" value="{{sesskey}}">
    <label class="ayv-field ayv-field-check"><input type="checkbox" name="enabled" value="1" {{#enabled}}checked{{/enabled}}> {{cifraenabled}}</label>
    <label class="ayv-field ayv-field-wide">{{cifraurl}} <span class="ayv-field-hint">{{cifraurlhint}}</span>
        <input type="text" name="url" value="{{url}}" inputmode="url" spellcheck="false"></label>
    <fieldset class="ayv-fieldset">
        <legend>{{cifrahow}}</legend>
        <label class="ayv-field ayv-field-check"><input type="radio" name="mode" value="key" {{#modekey}}checked{{/modekey}}> {{ciframodekey}}</label>
        <label class="ayv-field ayv-field-check"><input type="radio" name="mode" value="oauth" {{#modeoauth}}checked{{/modeoauth}}> {{ciframodeoauth}}</label>
    </fieldset>
    <div class="ayv-connect ayv-connect-key">
        <label class="ayv-field ayv-field-wide">{{cifrakey}} {{#keyhint}}<span class="ayv-field-hint">{{keyhint}}</span>{{/keyhint}}
            <input type="password" name="key" autocomplete="new-password"></label>
        <label class="ayv-field ayv-field-check"><input type="checkbox" name="example" value="1" {{#example}}checked{{/example}}> {{cifraexample}}</label>
    </div>
    <div class="ayv-connect ayv-connect-oauth">
        <label class="ayv-field ayv-field-wide">{{cifraclientid}} <input type="text" name="clientid" value="{{clientid}}" spellcheck="false"></label>
        <label class="ayv-field ayv-field-wide">{{cifrasecret}} {{#secrethint}}<span class="ayv-field-hint">{{secrethint}}</span>{{/secrethint}}
            <input type="password" name="secret" autocomplete="new-password"></label>
    </div>
    <p class="ayv-book-actions">
        <button type="submit" class="ayv-button ayv-button-quiet" name="do" value="test">{{cifratest}}</button>
        <button type="submit" class="ayv-button" name="do" value="sync">{{cifrasync}}</button>
        <button type="submit" class="ayv-button ayv-button-quiet" name="do" value="save">{{sourcessave}}</button>
    </p>
</form>
