{{!
    @template local_oksigeniaayvurenda/roll

    A textbook bank by classes: without a class, a card for each one with its pupils, who is waiting for books and who
    still has them; with a class, each pupil with the books they hold and the titles of their set still to give them,
    filtered, and to print.

    Context variables required for this template:
    * heading, intro, isclass, hasclasses, group, back, haspupils
    * classes - group, url, pupils, waiting, holding
    * filters - url, label, current, count
    * pupils - name, card, gone, gonetext, held (title, barcode, condition), hasheld, missing (title), hasmissing, complete
    * bankrollnone, bankrollhas, bankrollmissing, bankrollgone, bankrollcomplete, bankrollempty, bankrollback, bankrollprint

    Example context (json):
    {
        "notice": "", "sesskey": "x", "action": "#", "bankrolllost": "No lo trae: perdido", "bankrolllostsure": "¿no lo trae? Toca otra vez", "canlose": true,
        "heading": "Por clases en el Banco de libros", "intro": "En septiembre, en junio.", "isclass": true,
        "hasclasses": false, "classes": [], "group": "1º ESO A", "back": "#", "haspupils": true,
        "filters": [{"url": "#", "label": "Todos", "current": true, "count": 2}],
        "pupils": [{"name": "Ana Inventada", "card": "Carné 10000H", "gone": false, "gonetext": "",
            "held": [{"loanid": 1, "title": "Matemáticas 1", "barcode": "500001K", "condition": ""}], "hasheld": true,
            "missing": [{"title": "Lengua 1"}], "hasmissing": true, "complete": false}],
        "bankrollnone": "Sin clases.", "bankrollhas": "Tiene", "bankrollmissing": "Le falta",
        "bankrollgone": "Ya no está en esta clase", "bankrollcomplete": "Tiene todo su lote", "bankrollempty": "Nadie.",
        "bankrollback": "Todas las clases", "bankrollprint": "Imprimir"
    }
}}
<section class="ayv-roll">
{{#notice}}<p class="ayv-notice" role="status">{{notice}}</p>{{/notice}}
{{^isclass}}
    <h1 class="ayv-results-title">{{heading}}</h1>
    <p>{{intro}}</p>
    {{^hasclasses}}<p class="ayv-roll-empty">{{bankrollnone}}</p>{{/hasclasses}}
    <ul class="ayv-roll-classes">
        {{#classes}}
        <li><a class="ayv-roll-class" href="{{url}}">
            <span class="ayv-roll-class-name">{{group}}</span>
            <span class="ayv-roll-class-line">{{pupils}}</span>
            {{#waiting}}<span class="ayv-roll-class-line ayv-roll-waiting">{{waiting}}</span>{{/waiting}}
            {{#holding}}<span class="ayv-roll-class-line">{{holding}}</span>{{/holding}}
        </a></li>
        {{/classes}}
    </ul>
{{/isclass}}
{{#isclass}}
    <p class="ayv-roll-backline"><a href="{{back}}">{{bankrollback}}</a></p>
    <div class="ayv-roll-head">
        <h1 class="ayv-results-title">{{group}}</h1>
        <button type="button" class="ayv-button ayv-button-quiet ayv-roll-print" data-ayv-print>{{bankrollprint}}</button>
    </div>
    <p class="ayv-roll-filters">
        {{#filters}}<a class="ayv-chip{{#current}} ayv-chip-on{{/current}}" href="{{url}}"{{#current}} aria-current="page"{{/current}}>{{label}}<span class="ayv-chip-count">{{count}}</span></a> {{/filters}}
    </p>
    {{^haspupils}}<p class="ayv-roll-empty">{{bankrollempty}}</p>{{/haspupils}}
    <ul class="ayv-roll-pupils">
        {{#pupils}}
        <li class="ayv-roll-pupil">
            <p class="ayv-roll-name">{{name}} {{#card}}<span class="ayv-roll-card">{{card}}</span>{{/card}}</p>
            {{#gone}}<p class="ayv-roll-gone">{{gonetext}}</p>{{/gone}}
            {{#complete}}<p class="ayv-roll-complete">{{bankrollcomplete}}</p>{{/complete}}
            {{#hasheld}}
            <p class="ayv-roll-label">{{bankrollhas}}</p>
            <ul class="ayv-roll-books">{{#held}}<li class="ayv-roll-book">{{title}} <span class="ayv-roll-code">{{barcode}}</span>{{#condition}} · {{condition}}{{/condition}} {{#canlose}}<form class="ayv-roll-lost" method="post" action="{{action}}"><input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="do" value="lost"><input type="hidden" name="loan" value="{{loanid}}"><button type="submit" data-ayv-twice="{{name}}: {{bankrolllostsure}}">{{bankrolllost}}</button></form>{{/canlose}}</li>{{/held}}</ul>
            {{/hasheld}}
            {{#hasmissing}}
            <p class="ayv-roll-label">{{bankrollmissing}}</p>
            <ul class="ayv-roll-books">{{#missing}}<li class="ayv-roll-book ayv-roll-book-missing">{{title}}</li>{{/missing}}</ul>
            {{/hasmissing}}
        </li>
        {{/pupils}}
    </ul>
{{/isclass}}
</section>
