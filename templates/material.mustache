{{!
    @template local_oksigeniaayvurenda/material

    Material: what there is as tiles (a line drawing on its plank, its name, where it lives, its units with − and +,
    each kept at once, and how many are lent; on its back, its data), and a dashed tile per kind to add another, which
    opens with its name already written, how many (− and +, radios, no script) and where it lives.

    Context variables required for this template:
    * heading, intro, crier, notice, error, action, sesskey, savedword - the head and where gestures go
    * tiles (id, title, drawing, lives, units, unitsword, lent, nonelent, canless, lesslabel, morelabel, data (term,
      value), labelsurl, recordurl, justsaved), hastiles - what there is
    * new (kind, drawing, label, open, counts (n, id, checked, prev, next, word), places (value, label, id, checked)) - to add
    * materialhave, materialnone, materialother, materialotherhint, materialdata, materiallabelsprint, materialrecord,
      materialname, materialhowmany, materialwhere, materialmorefolded, materialbrand, materialmodel, materialserials,
      materiallabels, materialsave, materialcountlabel - words

    Example context (json):
    {
        "heading": "Material", "intro": "Portátiles y más.", "crier": null, "notice": "", "error": "",
        "action": "https://example.com/material.php", "sesskey": "abc", "savedword": "Guardado", "hastiles": true,
        "tiles": [{"id": 1, "title": "Chromebook", "drawing": "<svg viewBox='0 0 24 24'><rect x='4' y='5' width='16' height='11'/></svg>",
            "lives": "Vive en: Carro", "units": "24", "unitsword": "unidades", "lent": "5 prestadas", "nonelent": "Ninguna prestada",
            "canless": true, "lesslabel": "Una unidad menos de Chromebook", "morelabel": "Una unidad más de Chromebook",
            "data": [{"term": "Marca", "value": "Acer"}], "labelsurl": "https://example.com/labels.php",
            "recordurl": "https://example.com/record.php?id=1", "justsaved": true}],
        "new": [{"kind": "portatil", "drawing": "<svg viewBox='0 0 24 24'><rect x='4' y='5' width='16' height='11'/></svg>",
            "label": "Portátil", "open": true,
            "counts": [{"n": 1, "id": "ayv-mt-portatil-1", "checked": true, "prev": "ayv-mt-portatil-1", "next": "ayv-mt-portatil-2",
                "word": "unidad"}],
            "places": [{"value": 0, "label": "Sin lugar", "id": "ayv-mt-portatil-s0", "checked": true}]}],
        "materialhave": "Lo que hay", "materialnone": "Aún no hay material.", "materialother": "Dar de alta otro",
        "materialotherhint": "Toca lo que es.", "materialdata": "Sus datos", "materiallabelsprint": "Imprimir sus etiquetas",
        "materialrecord": "Su ficha", "materialname": "Su nombre", "materialhowmany": "Cuántas", "materialwhere": "Dónde vive",
        "materialmorefolded": "La marca y lo demás", "materialbrand": "Marca", "materialmodel": "Modelo",
        "materialserials": "Números de serie", "materiallabels": "Etiquetas que ya llevan", "materialsave": "Dar de alta",
        "materialcountlabel": "Unidades"
    }
}}
<div class="ayv-cf ayv-mt">
<header class="ayv-cf-cabeza">
    <div class="ayv-cf-cabeza-texto"><h1 class="ayv-cf-titulo">{{heading}}</h1>
        <p class="ayv-cf-entrada">{{intro}}</p>
        </div>
    {{#crier}}<span class="ayv-cf-pregonera"><span class="ayv-figure"><img src="{{figure}}" alt="" width="512" height="512"{{#puppet}} data-puppet="{{puppet}}"{{/puppet}}></span></span>{{/crier}}
</header>
{{#notice}}<p class="ayv-notice" role="status">{{notice}}</p>{{/notice}}
{{#error}}<p class="ayv-notice ayv-notice-error" role="alert">{{error}}</p>{{/error}}
<form id="ayv-mt-gestos" method="post" action="{{action}}"><input type="hidden" name="sesskey" value="{{sesskey}}"></form>
<section aria-labelledby="ayv-mt-hay">
    <h2 id="ayv-mt-hay" class="ayv-cf-estante-t">{{materialhave}}</h2>
    {{^hastiles}}<p class="ayv-cf-nota">{{materialnone}}</p>{{/hastiles}}
    {{#hastiles}}
    <ul class="ayv-mt-losetas">
        {{#tiles}}
        <li><article class="ayv-mt-loseta" id="m{{id}}">
            <div class="ayv-mt-dibujo">{{{drawing}}}</div>
            <h3 class="ayv-mt-nombre">{{title}}</h3>
            {{#lives}}<p class="ayv-mt-vive">{{lives}}</p>{{/lives}}
            <div class="ayv-mt-unidades">
                <button class="ayv-mt-signo" type="submit" form="ayv-mt-gestos" name="less" value="{{id}}" aria-label="{{lesslabel}}"{{^canless}} disabled{{/canless}}><span aria-hidden="true">−</span></button>
                <span class="ayv-mt-cifra"><b>{{units}}</b><span>{{unitsword}}</span></span>
                <button class="ayv-mt-signo" type="submit" form="ayv-mt-gestos" name="more" value="{{id}}" aria-label="{{morelabel}}"><span aria-hidden="true">+</span></button>
            </div>
            {{#justsaved}}<p><span class="ayv-cf-guardado" role="status">{{savedword}}</span></p>{{/justsaved}}
            <p class="ayv-mt-fuera">{{#lent}}<b>{{lent}}</b>{{/lent}}{{^lent}}{{nonelent}}{{/lent}}</p>
            <details class="ayv-mt-dorso"><summary>{{materialdata}}</summary>
                {{#data.0}}<dl>{{#data}}<dt>{{term}}</dt><dd>{{value}}</dd>{{/data}}</dl>{{/data.0}}
                <p><a class="ayv-cf-enlace" href="{{labelsurl}}">{{materiallabelsprint}}</a> · <a class="ayv-cf-enlace" href="{{recordurl}}">{{materialrecord}}</a></p>
            </details>
        </article></li>
        {{/tiles}}
    </ul>
    {{/hastiles}}
</section>
<section aria-labelledby="ayv-mt-otro">
    <h2 id="ayv-mt-otro" class="ayv-cf-estante-t">{{materialother}}</h2>
    <p class="ayv-cf-estante-s">{{materialotherhint}}</p>
    <ul class="ayv-mt-nuevas">
        {{#new}}
        <li class="ayv-mt-nueva"><details{{#open}} open{{/open}}><summary>{{{drawing}}}<span>+ {{label}}</span></summary>
            <form class="ayv-mt-alta" method="post" action="{{action}}"><input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="kind" value="{{kind}}">
                <label class="ayv-mt-escrito">{{materialname}}<input type="text" name="name" maxlength="255" value="{{label}}" autocomplete="off" required></label>
                <div class="ayv-mt-paso"><span>{{materialhowmany}}</span><div class="ayv-mt-contador" role="radiogroup" aria-label="{{materialcountlabel}}">{{#counts}}<input type="radio" name="count" value="{{n}}" id="{{id}}"{{#checked}} checked{{/checked}} aria-label="{{n}} {{word}}"><span class="ayv-mt-unidades"><label class="ayv-mt-signo" for="{{prev}}" aria-hidden="true">−</label><span class="ayv-mt-cifra"><b>{{n}}</b><span>{{word}}</span></span><label class="ayv-mt-signo" for="{{next}}" aria-hidden="true">+</label></span>{{/counts}}</div></div>
                <div class="ayv-mt-paso"><span>{{materialwhere}}</span><div class="ayv-cf-chapas ayv-mt-sitios" role="radiogroup" aria-label="{{materialwhere}}">{{#places}}<input type="radio" name="locationid" value="{{value}}" id="{{id}}"{{#checked}} checked{{/checked}}><label class="ayv-cf-chapa" for="{{id}}">{{label}}</label>{{/places}}</div></div>
                <details class="ayv-mt-mas"><summary>{{materialmorefolded}}</summary>
                    <label class="ayv-mt-escrito">{{materialbrand}}<input type="text" name="brand" maxlength="100" autocomplete="off"></label>
                    <label class="ayv-mt-escrito">{{materialmodel}}<input type="text" name="model" maxlength="100" autocomplete="off"></label>
                    <label class="ayv-mt-escrito">{{materialserials}}<textarea name="serials" rows="3" spellcheck="false"></textarea></label>
                    <label class="ayv-mt-escrito">{{materiallabels}}<textarea name="labels" rows="3" spellcheck="false"></textarea></label>
                </details>
                <p class="ayv-cf-fila"><button class="ayv-button" type="submit">{{materialsave}}</button></p>
            </form></details></li>
        {{/new}}
    </ul>
</section>
</div>
