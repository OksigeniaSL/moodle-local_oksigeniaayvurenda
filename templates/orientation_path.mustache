{{!
    @template local_oksigeniaayvurenda/orientation_path

    The path of the welcome route (Jujol's mock-up of 13 November): a stone for each of three rooms, lit with the name of
    the room where the hidden book was found, and the badge waiting at the end, grey until the third.

    Example context (json):
    {
        "pathlabel": "2 de 3 salas: Lengua y literatura, Ciencias",
        "steps": [{"done": true, "room": "Lengua y literatura"}, {"done": true, "room": "Ciencias"},
            {"done": false, "room": "La que elijas"}],
        "meta": {"img": "https://example.com/insignia.webp", "label": "Conoce la biblioteca"}
    }
}}
<ol class="ayv-or-camino" aria-label="{{pathlabel}}">{{#steps}}<li class="ayv-or-paso{{#done}} ayv-or-hecha{{/done}}"><span class="ayv-or-piedra" aria-hidden="true"></span><span class="ayv-or-sala">{{room}}</span></li>{{/steps}}{{#meta}}<li class="ayv-or-meta">{{#img}}<img src="{{img}}" alt="" width="64" height="64">{{/img}}<span>{{label}}</span></li>{{/meta}}</ol>
