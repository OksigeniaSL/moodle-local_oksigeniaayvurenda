{{!
    @template local_oksigeniaayvurenda/blind_shelf

    The shelf of blind dates on the home of a library (Jujol's mock-up of 13 November): each date wrapped, with its number,
    and the memory giving its three clues; it is asked for at the desk by its number.

    Example context (json):
    {
        "heading": "Citas a ciegas", "hint": "Tres pistas y ningún título. Elige la que te llame.",
        "who": "Memoria te da sus pistas", "memoryfigure": "https://example.com/memoria-senala.webp",
        "blindask": "Pídela en el mostrador por su número:", "blindnumberabbr": "n.º",
        "dates": [{"number": 4, "art": null, "wrappedlabel": "Un libro envuelto en papel, la cita n.º 4", "small": false,
            "clues": ["Hay un faro y alguien que espera.", "Se lee en una tarde de lluvia."], "numbertext": "la n.º 4"}]
    }
}}
<section class="ayv-cc ayv-cc-estante" id="ayv-citas" aria-labelledby="ayv-cc-t">
    <div class="ayv-cc-estante-cab"><h2 id="ayv-cc-t">{{heading}}</h2><p>{{hint}}</p></div>
    <ul class="ayv-cc-citas">
    {{#dates}}
        <li class="ayv-cc-cita">
            <div class="ayv-cc-balda">{{> local_oksigeniaayvurenda/blind_wrapped}}</div>
            <div class="ayv-cc-memoria">{{#memoryfigure}}<img src="{{memoryfigure}}" alt="" width="84" height="84" loading="lazy">{{/memoryfigure}}
                <div class="ayv-cc-bocadillo"><p class="ayv-cc-quien">{{who}}</p><ol class="ayv-cc-pistas">{{#clues}}<li>{{.}}</li>{{/clues}}</ol>
                <p class="ayv-cc-pide">{{blindask}} <b>{{numbertext}}</b>.</p></div></div>
        </li>
    {{/dates}}
    </ul>
</section>
