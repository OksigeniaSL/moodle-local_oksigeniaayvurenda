{{!
    @template local_oksigeniaayvurenda/characters

    The characters, each big on its stage (its wall in its colour, the floorboards), saying one of its lines in a bubble,
    with its name on a brass plate where it is written. The gestures in sight, each kept at once: the curtain (out of or
    onto the stage), how it speaks («I'm sure» in each form), the herald's signature; folded, another portrait or the
    whole character, and back to Ayvurenda's.

    Context variables required for this template:
    * heading, intro, notice, action, sesskey, savedword - the head and where gestures go
    * roles - role, title, job, enabled, name, figure, framed, alt, bubble, female, herald, signs, own, justsaved
    * charactername, charactersigns, characterdrop, characterdropor, characterdrophint, characterstageout,
      characterstagein, charactertalks, charactersayf, charactersaym, characternamehint, characternamesave,
      characterother, characterreset, sourcessave - words

    Example context (json):
    {
        "heading": "Los personajes", "intro": "Cámbiales el nombre.", "notice": "", "action": "https://example.com/characters.php",
        "sesskey": "abc", "savedword": "Guardado",
        "roles": [{"role": "herald", "title": "El pregonero", "job": "Cuenta lo que pasa.", "enabled": true, "name": "Mainumby",
            "figure": "https://example.com/mainumby.webp", "framed": false, "alt": "Mainumby, El pregonero", "bubble": "Acaban de llegar.",
            "female": false, "herald": true, "signs": false, "own": false, "justsaved": true}],
        "charactername": "Su nombre", "charactersigns": "Firma los avisos", "characterdrop": "Suelta aquí",
        "characterdropor": "o elígelo", "characterdrophint": "Una imagen o un zip.", "characterstageout": "Que salga de escena",
        "characterstagein": "Que entre en escena", "charactertalks": "Habla así", "charactersayf": "«Estoy segura»",
        "charactersaym": "«Estoy seguro»", "characternamehint": "Su nombre se escribe en la placa.",
        "characternamesave": "Guardar el nombre", "characterother": "Otro retrato", "characterreset": "Volver al de Ayvurenda",
        "sourcessave": "Guardar"
    }
}}
<div class="ayv-cf ayv-pj">
<header class="ayv-cf-cabeza">
    <div class="ayv-cf-cabeza-texto"><h1 class="ayv-cf-titulo">{{heading}}</h1>
        <p class="ayv-cf-entrada">{{intro}}</p>
        </div>
</header>
{{#notice}}<p class="ayv-notice" role="status">{{notice}}</p>{{/notice}}
<ul class="ayv-pj-escenas">
    {{#roles}}
    <li><article class="ayv-pj-ficha ayv-pj-{{role}}{{^enabled}} ayv-pj-fuera{{/enabled}}" id="ayv-pj-{{role}}" aria-labelledby="ayv-pj-{{role}}-t">
        <form id="ayv-pj-{{role}}-f" method="post" action="{{action}}"><input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="character" value="{{role}}"><button class="ayv-sr" type="submit" name="do" value="name" tabindex="-1" aria-hidden="true">{{characternamesave}}</button></form>
        <div class="ayv-pj-escena">{{#figure}}<img{{#framed}} class="ayv-pj-cuadro"{{/framed}} src="{{figure}}" alt="{{alt}}" width="250" height="250">{{/figure}}
            {{#enabled}}{{#bubble}}<p class="ayv-pj-bocadillo">{{bubble}}</p>{{/bubble}}{{/enabled}}</div>
        <label class="ayv-pj-placa"><small id="ayv-pj-{{role}}-t">{{title}}</small><input form="ayv-pj-{{role}}-f" name="name" value="{{name}}" aria-label="{{charactername}}" maxlength="40" autocomplete="off"></label>
        <div class="ayv-pj-cuerpo">
            {{#justsaved}}<p><span class="ayv-cf-guardado" role="status">{{savedword}}</span></p>{{/justsaved}}
            <p class="ayv-pj-que">{{job}}</p>
            <div class="ayv-pj-gestos">
                {{#enabled}}<button class="ayv-pj-telon" type="submit" form="ayv-pj-{{role}}-f" name="show" value="0">{{characterstageout}}</button>{{/enabled}}
                {{^enabled}}<button class="ayv-pj-telon" type="submit" form="ayv-pj-{{role}}-f" name="show" value="1">{{characterstagein}}</button>{{/enabled}}
                <span class="ayv-pj-habla"><span class="ayv-cf-rotulo">{{charactertalks}}</span><span class="ayv-cf-chapas"><button class="ayv-cf-chapa" type="submit" form="ayv-pj-{{role}}-f" name="gender" value="f" aria-pressed="{{#female}}true{{/female}}{{^female}}false{{/female}}">{{charactersayf}}</button><button class="ayv-cf-chapa" type="submit" form="ayv-pj-{{role}}-f" name="gender" value="m" aria-pressed="{{#female}}false{{/female}}{{^female}}true{{/female}}">{{charactersaym}}</button></span></span>
                {{#herald}}<span class="ayv-cf-luces"><button class="ayv-cf-luz" type="submit" form="ayv-pj-{{role}}-f" name="signs" value="{{#signs}}0{{/signs}}{{^signs}}1{{/signs}}" aria-pressed="{{#signs}}true{{/signs}}{{^signs}}false{{/signs}}"><span class="ayv-cf-bombilla" aria-hidden="true"></span><span>{{charactersigns}}</span></button></span>{{/herald}}
            </div>
            <p class="ayv-cf-nota">{{characternamehint}}</p>
            <p class="ayv-cf-fila"><button class="ayv-button ayv-button-quiet" type="submit" form="ayv-pj-{{role}}-f" name="do" value="name">{{characternamesave}}</button></p>
            <details class="ayv-pj-otra"><summary>{{characterother}}</summary>
                <form method="post" action="{{action}}#ayv-pj-{{role}}" enctype="multipart/form-data" class="ayv-pj-suelta">
                    <input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="only" value="{{role}}"><input type="hidden" name="do" value="upload">
                    <label class="ayv-imp-drop ayv-character-drop" data-ayv-drop>
                        <span class="ayv-imp-droptitle">{{characterdrop}}</span>
                        <span class="ayv-imp-dropor">{{characterdropor}}</span>
                        <input type="file" name="{{role}}file" required accept="image/png,image/jpeg,image/webp,image/gif,.zip,application/zip">
                        <span class="ayv-imp-dropformats">{{characterdrophint}}</span>
                    </label>
                    <noscript><p><button type="submit" class="ayv-button ayv-button-quiet">{{sourcessave}}</button></p></noscript>
                </form>
                {{#own}}<button class="ayv-pj-volver" type="submit" form="ayv-pj-{{role}}-f" name="do" value="reset">{{characterreset}}</button>{{/own}}
            </details>
        </div>
    </article></li>
    {{/roles}}
</ul>
</div>
