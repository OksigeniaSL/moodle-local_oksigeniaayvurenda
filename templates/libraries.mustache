{{!
    @template local_oksigeniaayvurenda/libraries

    The centres of the site and their libraries.

    Example context (json):
    {
        "heading": "Las bibliotecas", "intro": "Cada centro, con las suyas.", "notice": "", "action": "#", "sesskey": "abc",
        "none": false, "sitewide": true, "newclassifications": [{"value": "udc", "label": "CDU", "selected": true}],
        "entities": [{"id": 1, "name": "Colegio inventado", "rawname": "Colegio inventado", "yearstart": "09-01",
            "classifications": [{"value": "udc", "label": "CDU", "selected": true}], "controlletter": true, "demo": false,
            "hasgroups": true, "groups": [{"value": "4º B", "label": "4º B", "selected": false}],
            "cardlooks": [{"stage": "Primaria", "options": [{"value": "", "label": "Automático (la flor)", "selected": true}]}],
            "challengestages": [{"stage": "Primaria", "on": true}],
            "plansummary": "Plan Gratis: 812 de 1.000 ejemplares · 140 de 150 lectores",
            "planform": {"readersopen": true, "plannamenow": "Gratis", "plancopiesnow": 1000, "planreadersnow": 150,
                "planfeatures": [{"feature": "lti", "featurelabel": "LTI", "featureon": false}]},
            "staffpart": {"staffparthint": "Da el rol de bibliotecario en la categoría del centro.", "staffentity": 1,
                "staffassign": "#"},
            "reviewsigns": [{"value": "name", "label": "Nombre y grupo", "selected": true}],
            "kinds": [{"value": "classroom", "label": "De aula", "selected": true}],
            "parents": [{"value": 1, "label": "Biblioteca central", "selected": false}],
            "libraries": [{"id": 1, "name": "Biblioteca central", "rawname": "Biblioteca central", "url": "#",
                "address": "/central", "kindlabel": "Central", "copies": "Ejemplares: 600", "group": "",
                "colour": 2, "hascardimage": false, "featured": true, "count": "600", "countword": "ejemplares",
                "hasgroupchips": true, "groupchips": [{"chip": "4º B"}],
                "kinds": [{"value": "central", "label": "Central", "selected": true}], "parents": [], "groups": [], "hasgroups": false,
                "canremove": false}]}],
        "librariesfirst": "Tu centro", "librariesfirsthint": "Para empezar", "librariesentityname": "Nombre del centro",
        "librarieslibraryname": "Nombre de la biblioteca", "librariesyearstart": "Empieza el curso",
        "librariesyearstarthint": "MM-DD", "librariesclassification": "Clasificación", "librariescontrolletter": "Letra de control",
        "librariescreate": "Crear", "librariesadd": "Añadir una biblioteca", "librariesname": "Nombre", "librarieskind": "Tipo",
        "librariesparent": "Cuelga de", "librariesnoparent": "De ninguna", "librariesslug": "Dirección",
        "librariesslughint": "Se hace sola", "librariesgroup": "Grupos",
        "librariessave": "Guardar", "librariesremove": "Quitarla", "librariesanother": "Otro centro en este sitio",
        "librariesdemo": "Inventada", "librariesedit": "Cambiar", "librariesentity": "El centro",
        "librariescardlooks": "El carné por etapas", "librariescardlookshint": "Automático, según la etapa",
        "librariesenter": "Entrar", "librariesseat": "Sede principal", "librariesclose": "Cerrar",
        "librariesdata": "Nombre, tipo y grupos", "librariescentre": "Centro",
        "librarieschallenges": "Retos de la clase", "librarieschallengeshint": "Las etapas que juegan",
        "librariesreviewsign": "Cómo se firman las reseñas", "librariesplan": "Plan",
        "librariesplanhint": "Solo lo ven y lo cambian quienes administran el sitio.", "planname": "Nombre del plan",
        "plancopies": "Ejemplares", "planreaders": "Lectores", "planlimithint": "Con 0, sin tope",
        "librariesstaff": "Personal del centro", "librariesstaffassign": "Dar roles en el centro",
        "librariesstaffseparate": "Darle al centro su categoría"
    }
}}
<h1 class="ayv-results-title">{{heading}}</h1>
<p>{{intro}}</p>
{{#notice}}<p class="ayv-notice" role="status">{{notice}}</p>{{/notice}}
{{#entities}}
<section class="ayv-entity" aria-labelledby="ayv-entity-{{id}}-name">
    <div class="ayv-entity-head">
        <p class="ayv-entity-kicker">{{librariescentre}}</p>
        <h2 id="ayv-entity-{{id}}-name" class="ayv-section-title">{{name}}{{#demo}} <span class="ayv-entity-demo">{{librariesdemo}}</span>{{/demo}}</h2>
        <button type="button" class="ayv-button ayv-button-quiet" data-ayv-open="ayv-entity-{{id}}">{{> local_oksigeniaayvurenda/icon_settings}} {{librariesentity}}</button>
        {{#plansummary}}<p class="ayv-entity-plan">{{plansummary}}</p>{{/plansummary}}
    </div>
    <ul class="ayv-libcards">
    {{#libraries}}
        <li class="ayv-libcard">
            <div class="ayv-libcard-top ayv-cover-{{colour}}">{{#hascardimage}}<img src="{{cardimage}}" alt="" loading="lazy">{{/hascardimage}}</div>
            <div class="ayv-libcard-body">
                {{#featured}}<span class="ayv-libcard-seat">{{librariesseat}}</span>{{/featured}}
                <h3 class="ayv-libcard-name"><a href="{{url}}">{{name}}</a></h3>
                <p class="ayv-libcard-kind">{{kindlabel}} <span class="ayv-libcard-address">{{address}}</span></p>
                {{#hasgroupchips}}<ul class="ayv-libcard-groups">{{#groupchips}}<li>{{chip}}</li>{{/groupchips}}</ul>{{/hasgroupchips}}
                <p class="ayv-libcard-count"><strong>{{count}}</strong> {{countword}}</p>
            </div>
            <div class="ayv-libcard-actions">
                <a class="ayv-button" href="{{url}}">{{librariesenter}}</a>
                <button type="button" class="ayv-button ayv-button-quiet" data-ayv-open="ayv-library-{{id}}">{{> local_oksigeniaayvurenda/icon_pencil}} {{librariesedit}}</button>
            </div>
            <dialog class="ayv-modal ayv-entity-edit" id="ayv-library-{{id}}" aria-labelledby="ayv-library-{{id}}-title">
                <div class="ayv-modal-head"><h3 id="ayv-library-{{id}}-title" class="ayv-section-title">{{name}}</h3>
                    <form method="dialog"><button class="ayv-modal-close" aria-label="{{librariesclose}}">{{> local_oksigeniaayvurenda/icon_x}}</button></form></div>
                <h4 class="ayv-modal-part">{{librariesdata}}</h4>
                <form method="post" action="{{action}}">
                    <input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="library" value="{{id}}">
                    <label class="ayv-field">{{librariesname}} <input type="text" name="name" value="{{rawname}}" maxlength="255" required></label>
                    <label class="ayv-field">{{librarieskind}} <select name="kind">{{#kinds}}<option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>{{/kinds}}</select></label>
                    <label class="ayv-field">{{librariesparent}} <select name="parentid"><option value="0">{{librariesnoparent}}</option>{{#parents}}<option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>{{/parents}}</select></label>
                    {{#hasgroups}}<fieldset class="ayv-fieldset"><legend>{{librariesgroup}}</legend><div class="ayv-choices">{{#groups}}<label class="ayv-field ayv-field-check"><input type="checkbox" name="groups[]" value="{{value}}" {{#selected}}checked{{/selected}}> {{label}}</label>{{/groups}}</div></fieldset>{{/hasgroups}}
                    <p class="ayv-book-actions"><button type="submit" class="ayv-button" name="do" value="library">{{librariessave}}</button>
                    {{#canremove}}<button type="submit" class="ayv-button ayv-button-quiet" name="do" value="delete">{{librariesremove}}</button>{{/canremove}}</p>
                </form>
                {{#look}}
                <form method="post" action="{{action}}" enctype="multipart/form-data" class="ayv-library-look">
                    <input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="library" value="{{id}}">
                    <fieldset class="ayv-fieldset"><legend>{{librarieslook}}</legend>
                        <p class="ayv-field-hint">{{librarieslookhint}}</p>
                        <div class="ayv-swatches">{{#colours}}<label class="ayv-swatch ayv-cover-{{value}}"><input type="radio" name="colour" value="{{value}}" {{#selected}}checked{{/selected}}><span class="ayv-sr">{{librariescolour}} {{value}}</span></label>{{/colours}}</div>
                        <label class="ayv-field ayv-field-wide">{{librariesmotto}} <span class="ayv-field-hint">{{librariesmottohint}}</span>
                            <input type="text" name="motto" value="{{motto}}" maxlength="120"></label>
                        {{#hasscenes}}<fieldset class="ayv-fieldset"><legend>{{librariesscenes}}</legend>
                            <div class="ayv-scenes">
                                <label class="ayv-scene ayv-scene-none"><input type="radio" name="scene" value="" {{#noscene}}checked{{/noscene}}><span>{{librariesnoscene}}</span></label>
                                {{#scenes}}<label class="ayv-scene"><input type="radio" name="scene" value="{{value}}" {{#selected}}checked{{/selected}}><img src="{{url}}" alt="{{label}}" title="{{label}}" loading="lazy"></label>{{/scenes}}
                            </div></fieldset>{{/hasscenes}}
                        <label class="ayv-field ayv-field-wide">{{librariesimage}} <span class="ayv-field-hint">{{librariesimagehint}}</span>
                            <input type="file" name="image" accept="image/png,image/jpeg,image/webp,image/gif"></label>
                        {{#own}}<p class="ayv-library-thumb"><img src="{{image}}" alt=""> <label class="ayv-field ayv-field-check"><input type="checkbox" name="noimage" value="1"> {{librariesnoimage}}</label></p>{{/own}}
                        {{#sitewide}}<label class="ayv-field ayv-field-check"><input type="checkbox" name="featured" value="1" {{#featured}}checked{{/featured}}> {{librariesfeatured}}</label>{{/sitewide}}
                    </fieldset>
                    <p class="ayv-book-actions"><button type="submit" class="ayv-button" name="do" value="look">{{librariessave}}</button></p>
                </form>
                {{/look}}
            </dialog>
        </li>
    {{/libraries}}
        <li class="ayv-libcard ayv-libcard-new"><button type="button" data-ayv-open="ayv-add-{{id}}">{{> local_oksigeniaayvurenda/icon_plus}} <span>{{librariesadd}}</span></button></li>
    </ul>
    <dialog class="ayv-modal ayv-entity-edit" id="ayv-add-{{id}}" aria-labelledby="ayv-add-{{id}}-title">
        <div class="ayv-modal-head"><h3 id="ayv-add-{{id}}-title" class="ayv-section-title">{{librariesadd}}</h3>
            <form method="dialog"><button class="ayv-modal-close" aria-label="{{librariesclose}}">{{> local_oksigeniaayvurenda/icon_x}}</button></form></div>
        <form method="post" action="{{action}}">
            <input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="entity" value="{{id}}">
            <label class="ayv-field">{{librariesname}} <input type="text" name="name" maxlength="255" required></label>
            <label class="ayv-field">{{librarieskind}} <select name="kind">{{#kinds}}<option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>{{/kinds}}</select></label>
            <label class="ayv-field">{{librariesparent}} <select name="parentid"><option value="0">{{librariesnoparent}}</option>{{#parents}}<option value="{{value}}">{{label}}</option>{{/parents}}</select></label>
            {{#hasgroups}}<fieldset class="ayv-fieldset"><legend>{{librariesgroup}}</legend><div class="ayv-choices">{{#groups}}<label class="ayv-field ayv-field-check"><input type="checkbox" name="groups[]" value="{{value}}"> {{label}}</label>{{/groups}}</div></fieldset>{{/hasgroups}}
            <label class="ayv-field">{{librariesslug}} <span class="ayv-field-hint">{{librariesslughint}}</span> <input type="text" name="slug" maxlength="64" pattern="[a-z0-9-]*"></label>
            <p class="ayv-book-actions"><button type="submit" class="ayv-button" name="do" value="newlibrary">{{librariescreate}}</button></p>
        </form>
    </dialog>
    <dialog class="ayv-modal ayv-entity-edit" id="ayv-entity-{{id}}" aria-labelledby="ayv-entity-{{id}}-title">
        <div class="ayv-modal-head"><h3 id="ayv-entity-{{id}}-title" class="ayv-section-title">{{librariesentity}}: {{name}}</h3>
            <form method="dialog"><button class="ayv-modal-close" aria-label="{{librariesclose}}">{{> local_oksigeniaayvurenda/icon_x}}</button></form></div>
        <form method="post" action="{{action}}">
            <input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="entity" value="{{id}}">
            <label class="ayv-field">{{librariesentityname}} <input type="text" name="name" value="{{rawname}}" maxlength="255" required></label>
            <label class="ayv-field">{{librariesyearstart}} <span class="ayv-field-hint">{{librariesyearstarthint}}</span> <input type="text" name="yearstart" value="{{yearstart}}" maxlength="5" pattern="[0-9]{2}-[0-9]{2}"></label>
            <label class="ayv-field">{{librariesclassification}} <select name="classification">{{#classifications}}<option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>{{/classifications}}</select></label>
            <label class="ayv-field ayv-field-check"><input type="checkbox" name="controlletter" value="1" {{#controlletter}}checked{{/controlletter}}> {{librariescontrolletter}}</label>
            <fieldset class="ayv-fieldset"><legend>{{librariescardlooks}}</legend>
                <p class="ayv-field-hint">{{librariescardlookshint}}</p>
                {{#cardlooks}}<label class="ayv-field">{{stage}} <input type="hidden" name="cardstage[]" value="{{stage}}">
                    <select name="cardlook[]">{{#options}}<option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>{{/options}}</select></label>{{/cardlooks}}
            </fieldset>
            <label class="ayv-field">{{librariesreviewsign}} <select name="reviewsign">{{#reviewsigns}}<option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>{{/reviewsigns}}</select></label>
            <fieldset class="ayv-fieldset"><legend>{{librarieschallenges}}</legend>
                <p class="ayv-field-hint">{{librarieschallengeshint}}</p>
                <div class="ayv-choices">{{#challengestages}}<label class="ayv-field ayv-field-check"><input type="hidden" name="challengestage[]" value="{{stage}}"><input type="checkbox" name="challengeon[]" value="{{stage}}" {{#on}}checked{{/on}}> {{stage}}</label>{{/challengestages}}</div>
            </fieldset>
            {{#planform}}
            <fieldset class="ayv-fieldset"><legend>{{librariesplan}}</legend>
                <p class="ayv-field-hint">{{librariesplanhint}}</p>
                <input type="hidden" name="planform" value="1">
                <label class="ayv-field ayv-field-check"><input type="checkbox" name="readersopen" value="1" {{#readersopen}}checked{{/readersopen}}> {{librariesreadersopen}}</label>
                <p class="ayv-field-hint">{{librariesreadersopenhint}}</p>
                <label class="ayv-field">{{planname}} <input type="text" name="planname" value="{{plannamenow}}" maxlength="60"></label>
                <label class="ayv-field">{{plancopies}} <span class="ayv-field-hint">{{planlimithint}}</span> <input type="number" name="plancopies" value="{{plancopiesnow}}" min="0" step="1" class="ayv-plan-limit"></label>
                <label class="ayv-field">{{planreaders}} <span class="ayv-field-hint">{{planlimithint}}</span> <input type="number" name="planreaders" value="{{planreadersnow}}" min="0" step="1" class="ayv-plan-limit"></label>
                <div class="ayv-choices">{{#planfeatures}}<label class="ayv-field ayv-field-check"><input type="checkbox" name="plan{{feature}}" value="1" {{#featureon}}checked{{/featureon}}> {{featurelabel}}</label>{{/planfeatures}}</div>
            </fieldset>
            {{/planform}}
            <p class="ayv-book-actions"><button type="submit" class="ayv-button" name="do" value="entity">{{librariessave}}</button></p>
        </form>
        {{#staffpart}}
        <h4 class="ayv-modal-part">{{librariesstaff}}</h4>
        <p class="ayv-field-hint">{{staffparthint}}</p>
        {{#staffassign}}<p><a class="ayv-button ayv-button-quiet" href="{{staffassign}}">{{librariesstaffassign}}</a></p>{{/staffassign}}
        {{^staffassign}}<form method="post" action="{{action}}"><input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="entity" value="{{staffentity}}">
            <p><button type="submit" class="ayv-button ayv-button-quiet" name="do" value="category">{{librariesstaffseparate}}</button></p></form>{{/staffassign}}
        {{/staffpart}}
    </dialog>
</section>
{{/entities}}
{{#sitewide}}
{{#none}}{{> local_oksigeniaayvurenda/libraries_newentity}}{{/none}}
{{^none}}
<p class="ayv-libraries-more"><button type="button" class="ayv-button ayv-button-quiet" data-ayv-open="ayv-newentity">{{> local_oksigeniaayvurenda/icon_plus}} {{librariesanother}}</button></p>
<dialog class="ayv-modal ayv-entity-edit" id="ayv-newentity" aria-labelledby="ayv-newentity-title">
    <div class="ayv-modal-head"><h2 id="ayv-newentity-title" class="ayv-section-title">{{librariesanother}}</h2>
        <form method="dialog"><button class="ayv-modal-close" aria-label="{{librariesclose}}">{{> local_oksigeniaayvurenda/icon_x}}</button></form></div>
    {{> local_oksigeniaayvurenda/libraries_newentity}}
</dialog>
{{/none}}
{{/sitewide}}
