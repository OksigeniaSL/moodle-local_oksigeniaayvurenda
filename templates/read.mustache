{{!
    @template local_oksigeniaayvurenda/read

    Reading or listening to a digital form of a record. A reading in parts is one player with its parts in the book's order:
    one goes on into the next, the listener comes back where they were, and the soft sound its reader chose plays under it.

    Example context (json):
    {
        "heading": "El faro dormido", "subtitle": "EPUB", "licence": "Dominio público",
        "epub": false, "pdf": false, "audio": true, "video": false, "link": "", "other": false,
        "fileurl": "#", "downloadurl": "#", "recordurl": "#",
        "readprev": "Anterior", "readnext": "Siguiente", "readsmaller": "Letra más pequeña", "readbigger": "Letra más grande",
        "readmark": "Marcar aquí", "readmarks": "Tus marcas", "readdownload": "Descargar", "readopenlink": "Abrirlo",
        "readnodownload": "Se lee aquí", "backtorecord": "Volver a la ficha", "readloading": "Abriendo el libro…",
        "readprogress": "Cuánto llevas", "marks": true, "readfullscreen": "Pantalla completa",
        "readfullscreenexit": "Salir de pantalla completa",
        "reading": {"starturl": "https://example.com/capitulo-3.webm", "resume": "Sigues por el capítulo 3.",
            "cover": "https://example.com/tapa.jpg", "nowplaying": "Ahora: Capítulo 1.",
            "partsheading": "Las partes",
            "parts": [{"partid": 11, "parturl": "https://example.com/presentacion.webm", "parttitle": "Presentación", "partcurrent": false},
                {"partid": 12, "parturl": "https://example.com/capitulo-1.webm", "parttitle": "Capítulo 1", "partcurrent": true}],
            "backdrop": {"ogg": "https://example.com/mar.ogg", "m4a": "https://example.com/mar.m4a",
                "bdon": "Poner el fondo", "bdoff": "Quitar el fondo", "bdname": "Fondo: lluvia"} }
    }
}}
<section class="ayv-read">
<h1 class="ayv-results-title">{{heading}}</h1>
<p class="ayv-field-hint">{{subtitle}} · {{licence}}</p>
{{#epub}}<div class="ayv-read-stage">{{> local_oksigeniaayvurenda/read_book}}</div>{{/epub}}
{{#pdf}}<iframe class="ayv-pdf" src="{{fileurl}}" title="{{heading}}"></iframe>{{/pdf}}
{{#audio}}<audio id="ayv-media" class="ayv-media" controls preload="metadata" src="{{fileurl}}"></audio>{{/audio}}
{{#reading}}
<div class="ayv-lectura" id="ayv-lectura">
    <div class="ayv-lectura-cabeza">
        {{#cover}}<img class="ayv-lectura-tapa" src="{{cover}}" alt="">{{/cover}}
        <div class="ayv-lectura-dice">
            <p class="ayv-lectura-suena" id="ayv-lectura-ahora" role="status">{{nowplaying}}</p>
            {{#resume}}<p class="ayv-field-hint">{{resume}}</p>{{/resume}}
        </div>
    </div>
    <audio id="ayv-lectura-voz" class="ayv-media" controls preload="metadata" src="{{starturl}}"></audio>
    {{#backdrop}}<audio id="ayv-lectura-fondo" loop preload="none"><source src="{{ogg}}" type="audio/ogg; codecs=opus"><source src="{{m4a}}" type="audio/mp4"></audio>
    <p class="ayv-lectura-fondo-linea"><button type="button" class="ayv-button ayv-button-quiet" id="ayv-lectura-quitar" aria-pressed="true" data-on="{{bdon}}" data-off="{{bdoff}}">{{> local_oksigeniaayvurenda/icon_volume}}<span>{{bdoff}}</span></button> <span class="ayv-field-hint">{{bdname}}</span></p>{{/backdrop}}
    <h2 class="ayv-section-title">{{partsheading}}</h2>
    <ol class="ayv-lectura-partes">
        {{#parts}}<li><button type="button" class="ayv-lectura-parte" data-id="{{partid}}" data-url="{{parturl}}"{{#partcurrent}} aria-current="true"{{/partcurrent}}>{{parttitle}}</button></li>{{/parts}}
    </ol>
</div>
{{/reading}}
{{#video}}<video id="ayv-media" class="ayv-media" controls preload="metadata" src="{{fileurl}}"></video>{{/video}}
{{#link}}<p class="ayv-more"><a class="ayv-button" href="{{link}}" target="_blank" rel="noopener">{{readopenlink}}</a></p>{{/link}}
{{#throughproxy}}<p class="ayv-field-hint">{{readthroughproxy}}</p>{{/throughproxy}}
<div id="ayv-marks" class="ayv-read-marks" hidden><h2 class="ayv-section-title">{{readmarks}}</h2><ul class="ayv-holds"></ul></div>
{{#downloadurl}}<p class="ayv-more"><a class="ayv-button ayv-button-quiet" href="{{downloadurl}}">{{readdownload}}</a></p>{{/downloadurl}}
{{^downloadurl}}{{^link}}<p class="ayv-field-hint">{{readnodownload}}</p>{{/link}}{{/downloadurl}}
</section>
