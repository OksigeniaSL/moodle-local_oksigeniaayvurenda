{{!
    @template local_oksigeniaayvurenda/read

    Reading or listening to a digital form of a record.

    Example context (json):
    {
        "heading": "El faro dormido", "subtitle": "EPUB", "licence": "Dominio público",
        "epub": false, "pdf": false, "audio": true, "video": false, "link": "", "other": false,
        "fileurl": "#", "downloadurl": "#", "recordurl": "#",
        "readprev": "Anterior", "readnext": "Siguiente", "readsmaller": "Letra más pequeña", "readbigger": "Letra más grande",
        "readmark": "Marcar aquí", "readmarks": "Tus marcas", "readdownload": "Descargar", "readopenlink": "Abrirlo",
        "readnodownload": "Se lee aquí", "backtorecord": "Volver a la ficha", "readloading": "Abriendo el libro…",
        "readprogress": "Cuánto llevas", "marks": true
    }
}}
<section class="ayv-read">
<h1 class="ayv-results-title">{{heading}}</h1>
<p class="ayv-field-hint">{{subtitle}} · {{licence}}</p>
{{#epub}}{{> local_oksigeniaayvurenda/read_book}}{{/epub}}
{{#pdf}}<iframe class="ayv-pdf" src="{{fileurl}}" title="{{heading}}"></iframe>{{/pdf}}
{{#audio}}<audio id="ayv-media" class="ayv-media" controls preload="metadata" src="{{fileurl}}"></audio>{{/audio}}
{{#video}}<video id="ayv-media" class="ayv-media" controls preload="metadata" src="{{fileurl}}"></video>{{/video}}
{{#link}}<p class="ayv-more"><a class="ayv-button" href="{{link}}" target="_blank" rel="noopener">{{readopenlink}}</a></p>{{/link}}
<div id="ayv-marks" class="ayv-read-marks" hidden><h2 class="ayv-section-title">{{readmarks}}</h2><ul class="ayv-holds"></ul></div>
{{#downloadurl}}<p class="ayv-more"><a class="ayv-button ayv-button-quiet" href="{{downloadurl}}">{{readdownload}}</a></p>{{/downloadurl}}
{{^downloadurl}}{{^link}}<p class="ayv-field-hint">{{readnodownload}}</p>{{/link}}{{/downloadurl}}
</section>
