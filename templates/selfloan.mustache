{{!
    @template local_oksigeniaayvurenda/selfloan

    The self-loan posts of a library, from Jujol's mock-up: each post drawn as a stand with its name, when it was last
    used and, for whoever manages, reopening it, undoing its last day and taking it away, folded; a dashed post to make
    another, with where it is and what it is. Then who may use them and whether they take books back, as a card with its
    gestures in sight (settingcard), and what was done at them.

    Example context (json):
    {
        "heading": "Autopréstamo", "intro": "Una tableta donde cada lector se presta solo.", "notice": "", "error": "",
        "action": "https://example.com/selfloan.php", "sesskey": "abc", "manage": true,
        "address": "https://example.org/self.php?key=abc", "qr": "data:image/gif;base64,R0lGODlhAQABAAAAACw=",
        "hasposts": true, "posts": [{"id": 1, "name": "Sala de lectura", "last": "Usado el 2 de noviembre", "stopped": true,
            "machine": false}],
        "manyrows": false, "selfstoppedhint": "Se ha parado.", "selfreopen": "Volver a abrirlo",
        "selfundoday": "Deshacer el último día", "selfundodayintro": "Todo lo de las últimas 24 horas.",
        "selfmanyrows": "Se enseñan cien.", "selfmachinetag": "Máquina", "selfmachinehint": "Con su puente.",
        "selfsiplink": "El puente", "ismachine": false, "savedword": "Guardado",
        "settings": [{"id": "ayv-nr-quien", "set": "self", "title": "Quién puede usarlo", "says": "Todos los lectores.",
            "justsaved": false, "notes": [], "dates": null, "presets": null, "currency": null, "link": null, "help": null,
            "text": null, "bar": null, "groups": [{"label": "", "steps": [], "chips": [], "haslights": true,
                "haschips": false, "whole": false, "lights": [{"form": "ayv-nr-quien-f", "name": "returns", "value": 0,
                "pressed": true, "label": "También devuelven"}]}]}],
        "hasrows": true, "rows": [{"loanid": 1, "what": "lent", "when": "2/11/26, 10:42", "verb": "Se llevó",
            "title": "El faro dormido", "reader": "Ana Montes", "post": "Sala de lectura", "undo": true}],
        "selfnewtile": "+ Otro puesto", "selfnewintro": "Un nombre.", "selfnamelabel": "Dónde está",
        "selfnewname": "Sala de lectura", "selfcreate": "Crear el puesto", "selfpostsheading": "Los puestos",
        "selfpostssub": "Cada uno, con su último uso.", "selfremovepost": "Quitar este puesto", "selfremoveyes": "Sí, quitarlo",
        "selfkindlabel": "Qué es", "selfkindscreen": "Una tableta o un ordenador", "selfkindmachine": "Una máquina (SIP2)",
        "selfcreatedheading": "Ya está el puesto", "selfcreatedhint": "Ábrela allí.", "selfaddress": "Dirección",
        "selfcopy": "Copiar", "selfrecentheading": "Lo que se ha hecho", "selfrecentintro": "Los últimos siete días.",
        "selfnothing": "Nada todavía.", "selfundo": "Deshacer"
    }
}}
<div class="ayv-cf ayv-nr">
<header class="ayv-cf-cabeza">
    <div class="ayv-cf-cabeza-texto"><h1 class="ayv-cf-titulo">{{heading}}</h1>
        <p class="ayv-cf-entrada">{{intro}}</p>
    </div>
</header>
{{#notice}}<p class="ayv-notice" role="status">{{notice}}</p>{{/notice}}
{{#error}}<p class="ayv-notice ayv-notice-error" role="alert">{{error}}</p>{{/error}}
{{#address}}
<section class="ayv-settingcard ayv-self-created">
    <div class="ayv-self-created-text">
        <h2 class="ayv-section-title">{{selfcreatedheading}}</h2>
        {{^ismachine}}<p>{{selfcreatedhint}}</p>{{/ismachine}}
        {{#ismachine}}<p>{{selfmachinehint}} <a href="https://github.com/OksigeniaSL/moodle-local_oksigeniaayvurenda/tree/main/sip2-bridge" target="_blank" rel="noopener">{{selfsiplink}}</a></p>{{/ismachine}}
        <p class="ayv-lti-url"><input type="text" readonly value="{{address}}" aria-label="{{selfaddress}}">
            <button type="button" class="ayv-button" data-copy="{{address}}">{{selfcopy}}</button></p>
    </div>
    {{^ismachine}}<img class="ayv-self-qr" src="{{qr}}" alt="" width="148" height="148">{{/ismachine}}
</section>
{{/address}}
<section class="ayv-self-posts" aria-labelledby="ayv-nr-puestos-t">
    <h2 class="ayv-cf-estante-t" id="ayv-nr-puestos-t">{{selfpostsheading}}</h2>
    <p class="ayv-cf-estante-s">{{selfpostssub}}</p>
    <ul class="ayv-nr-puestos">
    {{#posts}}
        <li class="ayv-nr-puesto{{#stopped}} ayv-nr-puesto-parado{{/stopped}}" id="ayv-nr-puesto-{{id}}"><svg class="ayv-nr-puesto-dibujo" viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="2.5" width="14" height="11" rx="1.5"/><path d="M12 13.5v5M8 21.5h8M9.5 18.5h5"/><path d="M8.5 6.5h3M8.5 9h7"/></svg>
            <b>{{name}}</b>{{#machine}}<span class="ayv-nr-puesto-tipo">{{selfmachinetag}}</span>{{/machine}}
            <span class="ayv-nr-puesto-uso">{{last}}</span>
            {{#stopped}}<span class="ayv-nr-puesto-parado-t" role="status">{{selfstoppedhint}}</span>{{/stopped}}
            {{#manage}}
            {{#stopped}}<form method="post" action="{{action}}"><input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="do" value="reopen"><input type="hidden" name="post" value="{{id}}">
                <button type="submit" class="ayv-button">{{selfreopen}}</button></form>{{/stopped}}
            <details class="ayv-nr-plegado"><summary>{{selfundoday}}</summary>
                <p class="ayv-cf-nota">{{selfundodayintro}}</p>
                <form method="post" action="{{action}}"><input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="do" value="undoday"><input type="hidden" name="post" value="{{id}}">
                    <button type="submit" class="ayv-button ayv-cf-peligro">{{selfundoday}}</button></form>
            </details>
            <details class="ayv-nr-plegado"><summary>{{selfremovepost}}</summary>
                <form method="post" action="{{action}}"><input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="do" value="removepost"><input type="hidden" name="post" value="{{id}}">
                    <button type="submit" class="ayv-button ayv-cf-peligro">{{selfremoveyes}}</button></form>
            </details>
            {{/manage}}
        </li>
    {{/posts}}
    {{#manage}}
        <li class="ayv-nr-puesto-nuevo"><details id="ayv-nr-puesto-nuevo"><summary><svg class="ayv-nr-puesto-dibujo" viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="2.5" width="14" height="11" rx="1.5"/><path d="M12 13.5v5M8 21.5h8M9.5 18.5h5"/><path d="M8.5 6.5h3M8.5 9h7"/></svg><span>{{selfnewtile}}</span></summary>
            <form method="post" action="{{action}}"><input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="do" value="newpost">
                <p class="ayv-cf-nota">{{selfnewintro}}</p>
                <label class="ayv-field ayv-dig-field">{{selfnamelabel}} <input type="text" name="name" maxlength="100" placeholder="{{selfnewname}}"></label>
                <div class="ayv-nr-grupo"><span class="ayv-cf-rotulo" id="ayv-nr-puesto-que">{{selfkindlabel}}</span><div class="ayv-cf-chapas ayv-nr-radios" role="radiogroup" aria-labelledby="ayv-nr-puesto-que"><input type="radio" name="machine" value="0" id="ayv-nr-puesto-pantalla" checked><label class="ayv-cf-chapa" for="ayv-nr-puesto-pantalla">{{selfkindscreen}}</label><input type="radio" name="machine" value="1" id="ayv-nr-puesto-maquina"><label class="ayv-cf-chapa" for="ayv-nr-puesto-maquina">{{selfkindmachine}}</label></div></div>
                <p class="ayv-cf-fila"><button type="submit" class="ayv-button">{{selfcreate}}</button></p>
            </form>
        </details></li>
    {{/manage}}
    </ul>
</section>
{{#manage}}
<ul class="ayv-nr-ajustes">
    {{#settings}}
    <li>{{> local_oksigeniaayvurenda/settingcard}}</li>
    {{/settings}}
</ul>
{{/manage}}
{{#hasposts}}
<section class="ayv-section ayv-self-recent">
    <h2 class="ayv-section-title">{{selfrecentheading}}</h2>
    {{#hasrows}}
    <p>{{selfrecentintro}}{{#manyrows}} {{selfmanyrows}}{{/manyrows}}</p>
    <ul class="ayv-self-rows">
    {{#rows}}
        <li class="ayv-self-row">
            <span class="ayv-self-row-when">{{when}}</span>
            <span class="ayv-self-row-what"><strong>{{title}}</strong> · {{verb}} {{reader}}{{#post}} · {{post}}{{/post}}</span>
            {{#undo}}<form method="post" action="{{action}}"><input type="hidden" name="sesskey" value="{{sesskey}}">
                <input type="hidden" name="do" value="undo"><input type="hidden" name="loan" value="{{loanid}}"><input type="hidden" name="what" value="{{what}}">
                <button type="submit" class="ayv-button ayv-button-quiet">{{selfundo}}</button></form>{{/undo}}
        </li>
    {{/rows}}
    </ul>
    {{/hasrows}}
    {{^hasrows}}<div class="ayv-nothing"><p>{{selfnothing}}</p></div>{{/hasrows}}
</section>
{{/hasposts}}
</div>
