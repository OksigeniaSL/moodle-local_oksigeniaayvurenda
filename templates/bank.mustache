{{!
    @template local_oksigeniaayvurenda/bank

    The sets of a textbook bank: each one with its groups, its titles and what is short, a search to add a title, and a
    form to change it; and a form for a new set.

    Context variables required for this template:
    * heading, intro, notice, action, slug, sesskey, hassets, hasgroups
    * sets - id, name, pupils, chips, haschips, titles (recordid, title, counts, isshort, mend), hastitles, groupoptions,
      searching, query, found (recordid, title, authors)
    * groupoptions - value, label, checked
    * banknone, banknewset, bankname, bankgroups, banknogroups, banksave, bankremove, bankaddtitle, bankfind,
      bankfindbutton, bankadd, banknotitles, bankremovetitle, bankedit, banknothing

    Example context (json):
    {
        "heading": "Banco de libros", "intro": "Un lote por curso.", "notice": "", "action": "#", "slug": "banco",
        "sesskey": "x", "hassets": true, "hasgroups": true,
        "sets": [{"id": 1, "name": "1.º de ESO", "pupils": "52 alumnos", "chips": [{"chip": "1.º ESO A"}], "haschips": true,
            "titles": [{"recordid": 7, "title": "Matemáticas 1", "counts": "48 prestados · 2 libres", "isshort": true, "mend": "Para reponer: 1 roto"}],
            "hastitles": true, "groupoptions": [{"value": "1.º ESO A", "label": "1.º ESO A", "checked": true}],
            "searching": false, "query": "", "found": []}],
        "groupoptions": [{"value": "1.º ESO A", "label": "1.º ESO A", "checked": false}],
        "banknone": "Todavía no hay ningún lote.", "banknewset": "Un lote nuevo", "bankname": "Nombre",
        "bankgroups": "Para qué grupos", "banknogroups": "No hay grupos este curso.", "banksave": "Guardar",
        "bankremove": "Quitar el lote", "bankaddtitle": "Añadir un título", "bankfind": "Título o ISBN",
        "bankfindbutton": "Buscar", "bankadd": "Añadir", "banknotitles": "Sin títulos todavía.",
        "bankremovetitle": "Quitar", "bankedit": "Cambiar el lote", "banknothing": "No hay nada con esas palabras."
    }
}}
<section class="ayv-bank">
<h1 class="ayv-results-title">{{heading}}</h1>
<p>{{intro}}</p>
{{#notice}}<p class="ayv-notice" role="status">{{notice}}</p>{{/notice}}
{{^hassets}}<p class="ayv-empty">{{banknone}}</p>{{/hassets}}
{{#sets}}
<article class="ayv-bankset" aria-labelledby="ayv-bankset-{{id}}">
    <h2 id="ayv-bankset-{{id}}" class="ayv-section-title">{{name}}</h2>
    <p class="ayv-field-hint">{{pupils}}</p>
    {{#haschips}}<ul class="ayv-libcard-groups">{{#chips}}<li>{{chip}}</li>{{/chips}}</ul>{{/haschips}}
    {{#hastitles}}
    <ul class="ayv-holds">
    {{#titles}}
        <li class="ayv-holds-row{{#isshort}} ayv-bank-short{{/isshort}}">
            <span class="ayv-holds-title">{{title}}</span>
            <span class="ayv-holds-when">{{counts}}</span>
            {{#mend}}<span class="ayv-bank-mend">{{mend}}</span>{{/mend}}
            <form method="post" action="{{action}}">
                <input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="set" value="{{id}}">
                <input type="hidden" name="record" value="{{recordid}}">
                <button type="submit" class="ayv-button ayv-button-quiet" name="do" value="removetitle">{{bankremovetitle}}</button>
            </form>
        </li>
    {{/titles}}
    </ul>
    {{/hastitles}}
    {{^hastitles}}<p class="ayv-empty">{{banknotitles}}</p>{{/hastitles}}
    <form class="ayv-window-search" role="search" method="get" action="{{action}}">
        <input type="hidden" name="library" value="{{slug}}"><input type="hidden" name="set" value="{{id}}">
        <label class="ayv-field ayv-field-wide">{{bankaddtitle}} <input type="search" name="q" value="{{query}}" maxlength="200" placeholder="{{bankfind}}"></label>
        <button type="submit" class="ayv-button">{{bankfindbutton}}</button>
    </form>
    {{#searching}}
    <ul class="ayv-holds">
    {{#found}}
        <li class="ayv-holds-row">
            <span class="ayv-holds-title">{{title}}</span><span class="ayv-holds-who">{{authors}}</span>
            <form method="post" action="{{action}}">
                <input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="set" value="{{id}}">
                <input type="hidden" name="record" value="{{recordid}}">
                <button type="submit" class="ayv-button" name="do" value="addtitle">{{bankadd}}</button>
            </form>
        </li>
    {{/found}}
    {{^found}}<li class="ayv-empty">{{banknothing}}</li>{{/found}}
    </ul>
    {{/searching}}
    <details class="ayv-bank-edit">
        <summary>{{bankedit}}</summary>
        <form method="post" action="{{action}}">
            <input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="set" value="{{id}}">
            <label class="ayv-field">{{bankname}} <input type="text" name="name" value="{{name}}" maxlength="100" required></label>
            <fieldset class="ayv-fieldset"><legend>{{bankgroups}}</legend><div class="ayv-choices">{{#groupoptions}}<label class="ayv-field ayv-field-check"><input type="checkbox" name="groups[]" value="{{value}}" {{#checked}}checked{{/checked}}> {{label}}</label>{{/groupoptions}}</div></fieldset>
            <p class="ayv-book-actions"><button type="submit" class="ayv-button" name="do" value="saveset">{{banksave}}</button>
                <button type="submit" class="ayv-button ayv-button-quiet" name="do" value="removeset">{{bankremove}}</button></p>
        </form>
    </details>
</article>
{{/sets}}
<form class="ayv-book" method="post" action="{{action}}">
    <input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="set" value="0">
    <h2 class="ayv-section-title">{{banknewset}}</h2>
    <label class="ayv-field">{{bankname}} <input type="text" name="name" maxlength="100" required></label>
    <fieldset class="ayv-fieldset"><legend>{{bankgroups}}</legend>
        {{#hasgroups}}<div class="ayv-choices">{{#groupoptions}}<label class="ayv-field ayv-field-check"><input type="checkbox" name="groups[]" value="{{value}}"> {{label}}</label>{{/groupoptions}}</div>{{/hasgroups}}
        {{^hasgroups}}<p class="ayv-empty">{{banknogroups}}</p>{{/hasgroups}}
    </fieldset>
    <p class="ayv-book-actions"><button type="submit" class="ayv-button" name="do" value="saveset">{{banksave}}</button></p>
</form>
</section>
