{{!
    @template local_oksigeniaayvurenda/readers

    The readers of a library: who there is, by stage and group, how to find one, and what asks for attention.

    Example context (json):
    {
        "heading": "Lectores", "summary": "24 lectores · 1 grupo", "hasreadersatall": true, "action": "#", "library": "demo-1",
        "query": "", "findlabel": "Busca a un lector", "findhint": "Nombre o carné", "findgo": "Buscar", "cardlabel": "Carné", "loanslabel": "Préstamos",
        "bring": {"url": "#", "label": "Traer lectores"},
        "match": {"url": "#", "go": "Revisarlos", "line": "12 lectores sin cuenta en este sitio.", "hint": "Con cuenta ven su carné."},
        "stages": [{"name": "Primaria", "named": true, "groups": [{"name": "3º A", "url": "#", "count": "24", "countlabel": "24 lectores"}]}],
        "found": null, "people": null, "pager": null, "said": null,
        "tools": [{"url": "#", "label": "Tutores"}]
    }
}}
<header class="ayv-readers-top">
    <div class="ayv-readers-head">
        <h1 class="ayv-results-title">{{heading}}</h1>
        {{#notice}}<p class="ayv-notice" role="status">{{notice}}</p>{{/notice}}
        <p class="ayv-readers-sum">{{summary}}</p>
    </div>
    {{#bring}}<a class="ayv-button ayv-button-quiet" href="{{url}}">{{label}}</a>{{/bring}}
</header>
{{! Finding a reader is what is done every day: first, and the strong button; bringing them is once in a while. }}
{{#hasreadersatall}}
<form class="ayv-readers-find" role="search" method="get" action="{{action}}">
    <input type="hidden" name="library" value="{{library}}">
    <label for="ayv-readers-q" class="ayv-sr">{{findlabel}}</label>
    <input id="ayv-readers-q" type="search" name="q" value="{{query}}" placeholder="{{findhint}}" maxlength="100" autocomplete="off">
    <button type="submit" class="ayv-button">{{findgo}}</button>
</form>
{{/hasreadersatall}}
{{#match}}
<p class="ayv-readers-band"><span class="ayv-readers-bandtext"><b>{{line}}</b> {{hint}}</span>
    <a class="ayv-button ayv-button-quiet" href="{{url}}">{{go}}</a></p>
{{/match}}
{{! Under the search, which is what the page is for, before the groups. }}
{{^found}}{{> local_oksigeniaayvurenda/life }}{{/found}}
{{#said}}<div class="ayv-holds-quiet">{{> local_oksigeniaayvurenda/bubble}}</div>{{/said}}
{{#found}}
<section class="ayv-readers-found">
    <div class="ayv-readers-foundhead"><h2 class="ayv-section-title">{{heading}}</h2> <a href="{{clear}}">{{clearlabel}}</a></div>
    {{#none}}<p class="ayv-empty">{{none}}</p>{{/none}}
    <ul class="ayv-people ayv-people-grid">
    {{#people}}
        <li class="ayv-person">
            <span class="ayv-person-face" aria-hidden="true">{{#photo}}<img src="{{photo}}" alt="">{{/photo}}{{^photo}}{{initial}}{{/photo}}</span>
            <span class="ayv-person-text"><a class="ayv-person-name" href="{{url}}">{{name}}</a>
            <span class="ayv-person-card">{{group}}</span></span>
        </li>
    {{/people}}
    </ul>
</section>
{{/found}}
{{^found}}
{{#stages}}
<section class="ayv-readers-stage">
    {{#named}}<h2 class="ayv-section-title">{{name}}</h2>{{/named}}
    <ul class="ayv-readers-groups">
    {{#groups}}
        <li><a class="ayv-readers-group" href="{{url}}"><span class="ayv-readers-groupname">{{name}}</span>
            <span class="ayv-readers-groupcount"><span aria-hidden="true">{{count}}</span><span class="ayv-sr">{{countlabel}}</span></span></a></li>
    {{/groups}}
    </ul>
</section>
{{/stages}}
{{#people.0}}
<ul class="ayv-people ayv-people-grid">
{{#people}}
    <li class="ayv-person">
        <span class="ayv-person-face" aria-hidden="true">{{#photo}}<img src="{{photo}}" alt="">{{/photo}}{{^photo}}{{initial}}{{/photo}}</span>
        <span class="ayv-person-text"><a class="ayv-person-name" href="{{url}}">{{name}}</a>
        <span class="ayv-person-card"><span class="ayv-sr">{{cardlabel}}: </span>{{cardcode}}</span></span>
        {{#loans}}<span class="ayv-person-loans" title="{{loanslabel}}">{{loans}}</span>{{/loans}}
    </li>
{{/people}}
</ul>
{{/people.0}}
{{#pager}}{{> local_oksigeniaayvurenda/readers_pager}}{{/pager}}
{{/found}}
{{#tools.0}}
<p class="ayv-readers-tools">{{#tools}}<a class="ayv-button ayv-button-quiet" href="{{url}}">{{label}}</a> {{/tools}}</p>
{{/tools.0}}
