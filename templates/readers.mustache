{{!
    @template local_oksigeniaayvurenda/readers

    The groups of this school year, for the staff.

    Context variables required for this template:
    * heading - title of the screen
    * groups - list of name, stage, countlabel and url
    * nogroup - url and label of readers without a group
    * manage - url and label to choose where readers come from, for those who may
    * match - url and label to match readers without an account, when there are
    * tutors - url and label to choose the tutor of each group, for those who may
    * rules - url and label of the loan rules, for those who may
    * year - url and label of the school year, for those who may

    Example context (json):
    {
        "heading": "Lectores",
        "hasgroups": true,
        "groups": [{"name": "3º Primaria A", "stage": "Primaria", "countlabel": "24 lectores", "url": "#"}],
        "nogroup": {"url": "#", "label": "Sin grupo"},
        "empty": "",
        "manage": {"url": "#", "label": "De dónde salen los lectores"},
        "match": {"url": "#", "label": "Casar lectores sin cuenta (12)"},
        "tutors": {"url": "#", "label": "Tutores"},
        "rules": {"url": "#", "label": "Normas"},
        "year": {"url": "#", "label": "Curso escolar"}
    }
}}
<div class="ayv-results-head">
    <h1 class="ayv-results-title">{{heading}}</h1>
    {{#manage}}<a class="ayv-toggle" href="{{url}}">{{label}}</a>{{/manage}}
    {{#tutors}}<a class="ayv-toggle" href="{{url}}">{{label}}</a>{{/tutors}}
    {{#rules}}<a class="ayv-toggle" href="{{url}}">{{label}}</a>{{/rules}}
    {{#year}}<a class="ayv-toggle" href="{{url}}">{{label}}</a>{{/year}}
</div>
{{#hasgroups}}
<ul class="ayv-corners">
{{#groups}}
    <li><a class="ayv-corner ayv-cover-5" href="{{url}}">
        <span class="ayv-corner-label">{{name}}</span>
        <span class="ayv-corner-count">{{stage}} · {{countlabel}}</span>
    </a></li>
{{/groups}}
</ul>
{{/hasgroups}}
{{#empty}}<p class="ayv-empty">{{empty}}</p>{{/empty}}
<p class="ayv-more">
    {{#nogroup}}<a class="ayv-button ayv-button-quiet" href="{{url}}">{{label}}</a>{{/nogroup}}
    {{#match}}<a class="ayv-button" href="{{url}}">{{label}}</a>{{/match}}
</p>
