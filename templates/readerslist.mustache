{{!
    @template local_oksigeniaayvurenda/readerslist

    Readers from a list: paste or upload it, check what each column is, and load it.

    Context variables required for this template:
    * heading, intro, notice, error - texts
    * action, sesskey - the form
    * paste - whether it is the first step
    * check - columns (index, heading, options), preview (cells), types, csv (the text), count

    Example context (json):
    {
        "heading": "Lectores desde una lista",
        "intro": "Un CSV del programa del centro.",
        "notice": "",
        "error": "",
        "action": "#",
        "sesskey": "abc",
        "paste": true,
        "check": null,
        "readerslistpaste": "Pega aquí la lista", "readerslistfile": "o sube el fichero", "readerslistnext": "Seguir",
        "readerslistcolumns": "Qué es cada columna", "readerslisttype": "Tipo de lector si la lista no lo dice",
        "readerslistload": "Cargar", "readerslistpreview": "Las primeras filas"
    }
}}
<h1 class="ayv-results-title">{{heading}}</h1>
<p>{{intro}}</p>
{{#notice}}<p class="ayv-notice" role="status">{{notice}}</p>{{/notice}}
{{#error}}<p class="ayv-notice ayv-notice-error" role="alert">{{error}}</p>{{/error}}
{{#paste}}
<form method="post" action="{{action}}" enctype="multipart/form-data" class="ayv-book">
    <input type="hidden" name="sesskey" value="{{sesskey}}">
    <label class="ayv-field ayv-field-wide">{{readerslistpaste}} <textarea name="csv" rows="8" spellcheck="false"></textarea></label>
    <label class="ayv-field">{{readerslistfile}} <input type="file" name="file" accept=".csv,.txt,text/csv"></label>
    <p class="ayv-book-actions"><button type="submit" class="ayv-button">{{readerslistnext}}</button></p>
</form>
{{/paste}}
{{#check}}
<form method="post" action="{{action}}" class="ayv-book">
    <input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="load" value="1">
    <textarea name="csv" hidden>{{csv}}</textarea>
    <h2 class="ayv-section-title">{{readerslistcolumns}}</h2>
    <div class="ayv-book-copy">
    {{#columns}}
        <label class="ayv-field">{{heading}} <select name="column[{{index}}]">{{#options}}<option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>{{/options}}</select></label>
    {{/columns}}
    </div>
    <h2 class="ayv-section-title">{{readerslistpreview}}</h2>
    <ul class="ayv-people">
    {{#preview}}<li class="ayv-person">{{#cells}}<span>{{value}}</span>{{/cells}}</li>{{/preview}}
    </ul>
    <label class="ayv-field">{{readerslisttype}} <select name="type">{{#types}}<option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>{{/types}}</select></label>
    <p>{{count}}</p>
    <p class="ayv-book-actions"><button type="submit" class="ayv-button">{{readerslistload}}</button></p>
</form>
{{/check}}
