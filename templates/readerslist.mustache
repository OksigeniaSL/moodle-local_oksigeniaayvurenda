{{!
    @template local_oksigeniaayvurenda/readerslist

    Readers from a list: dropped or pasted, seen as the people it brings, and only then brought.

    Example context (json):
    {
        "heading": "Lectores desde una lista", "intro": "El CSV de tu programa.", "error": "", "plansummary": "", "action": "#", "sesskey": "abc",
        "urlself": "#", "paste": false, "done": null, "said": null,
        "check": {"csv": "Nombre;Grupo", "filename": "lista.csv", "kind": "Hoja de cálculo", "cannot": "", "noname": false,
            "figures": [{"count": "3", "label": "lectores"}],
            "people": [{"name": "Ana Montes", "group": "3º A", "initial": "A"}], "more": "y 2 más",
            "columns": [{"index": 0, "heading": "Nombre", "sample": "Ana", "isknown": true,
                "options": [{"value": "firstname", "label": "Nombre", "selected": true}]}],
            "allknown": true, "line": "Reconocidas las 2 columnas.", "gowords": "Dar de alta a 3 lectores",
            "types": [{"value": "student", "label": "Alumnos", "selected": true}]},
        "readerslistdrop": "Suelta aquí tu lista", "readerslistformats": "CSV o TXT", "readerslistpastetoggle": "O pégala aquí",
        "readerslistpastego": "Ver cómo queda", "readerslistsample": "Nombre;Apellidos;Grupo", "readerslistsamplehint": "Por ejemplo:",
        "readerslistcolumns": "Qué es cada columna", "readerslisttype": "Si la lista no lo dice, son",
        "readerslistchecktitle": "Estos lectores llegarán", "readerslistchecklead": "Míralo con calma.", "readerslistpeople": "Los primeros",
        "readerslistsafe": "Si la vuelves a cargar, no se repiten.", "readerslistdonetitle": "Ya están", "readerslistgoreaders": "Míralos",
        "readerslistgoreadershint": "Por grupos.", "importdropor": "o búscalo", "importnextheading": "Y ahora", "importnextdesk": "Mostrador",
        "importnextdeskhint": "Presta.", "importcolumnsreview": "Revisar", "importcolumnsintro": "Cada columna.",
        "importcolumnsapply": "Ver cómo queda", "importcolumnssaysnothing": "Vacía", "importcancel": "Dejarlo", "importreading": "Leyendo…",
        "importbusy": "Dando de alta…", "importbusyhint": "Tarda un poco.", "offsiteclose": "Cerrar"
    }
}}
<div class="ayv-imp">
{{#error}}<p class="ayv-notice ayv-notice-error" role="alert">{{error}}</p>{{/error}}
{{#paste}}
<header class="ayv-imp-top">
    <h1 class="ayv-imp-title">{{heading}}</h1>
    <p class="ayv-imp-lead">{{intro}}</p>
</header>
<form method="post" action="{{action}}" enctype="multipart/form-data" class="ayv-imp-upload" data-busy="{{importreading}}">
    <input type="hidden" name="sesskey" value="{{sesskey}}">
    <label class="ayv-imp-drop" data-ayv-drop>
        <span class="ayv-imp-droptitle">{{readerslistdrop}}</span>
        <span class="ayv-imp-dropor">{{importdropor}}</span>
        <input type="file" name="file" accept=".csv,.txt,text/csv">
        <span class="ayv-imp-dropformats">{{readerslistformats}}</span>
    </label>
    <details class="ayv-readers-paste">
        <summary>{{readerslistpastetoggle}}</summary>
        <label for="ayv-readers-csv" class="ayv-field-hint">{{readerslistsamplehint}} <code>{{readerslistsample}}</code></label>
        <textarea id="ayv-readers-csv" name="csv" rows="7" spellcheck="false"></textarea>
        <p class="ayv-dig-sheet-actions"><button type="submit" class="ayv-button ayv-button-quiet">{{readerslistpastego}}</button></p>
    </details>
</form>
{{#plansummary}}<p class="ayv-field-hint ayv-imp-plan">{{plansummary}}</p>{{/plansummary}}
{{/paste}}
{{#check}}
<form method="post" action="{{action}}" class="ayv-imp-review" data-busy="{{importbusy}}" data-busyhint="{{importbusyhint}}">
    <input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="filename" value="{{filename}}">
    <textarea name="csv" hidden>{{csv}}</textarea>
    <header class="ayv-imp-head">
        <div class="ayv-imp-headtext">
            <p class="ayv-imp-file">{{#filename}}<span class="ayv-imp-filename">{{filename}}</span>{{/filename}} <span class="ayv-imp-kind">{{kind}}</span></p>
            <h1 class="ayv-imp-title">{{readerslistchecktitle}}</h1>
            <p class="ayv-imp-lead">{{readerslistchecklead}}</p>
        </div>
        <ul class="ayv-imp-figures">
            {{#figures}}<li><span class="ayv-imp-num">{{count}}</span> <span class="ayv-imp-figlabel">{{label}}</span></li>{{/figures}}
        </ul>
    </header>
    {{#cannot}}<p class="ayv-notice ayv-notice-error" role="alert">{{cannot}}</p>{{/cannot}}
    {{#people.0}}
    <section class="ayv-imp-stack" aria-labelledby="ayv-list-people">
        <div class="ayv-imp-stackhead">
            <h2 class="ayv-section-title" id="ayv-list-people">{{readerslistpeople}}</h2>
            {{#more}}<p class="ayv-imp-more">{{more}}</p>{{/more}}
        </div>
        <ul class="ayv-people ayv-people-grid">
            {{#people}}
            <li class="ayv-person">
                <span class="ayv-person-face" aria-hidden="true">{{initial}}</span>
                <span class="ayv-person-text"><span class="ayv-person-name">{{name}}</span>
                <span class="ayv-person-card">{{group}}</span></span>
            </li>
            {{/people}}
        </ul>
    </section>
    {{/people.0}}
    <div class="ayv-imp-panel ayv-imp-columns">
        <div class="ayv-imp-columnshead">
            <span class="ayv-imp-tick{{^allknown}} ayv-imp-tick-warn{{/allknown}}" aria-hidden="true">{{#allknown}}{{> local_oksigeniaayvurenda/icon_check}}{{/allknown}}{{^allknown}}{{> local_oksigeniaayvurenda/icon_circle_alert}}{{/allknown}}</span>
            <p class="ayv-imp-columnsline">{{line}}</p>
            <button type="button" class="ayv-button ayv-button-quiet" data-ayv-open="ayv-imp-map">{{importcolumnsreview}}</button>
        </div>
        <ul class="ayv-imp-chips">
            {{#columns}}<li class="ayv-imp-chip{{^isknown}} ayv-imp-chip-off{{/isknown}}">{{heading}}</li>{{/columns}}
        </ul>
    </div>
    <dialog class="ayv-modal" id="ayv-imp-map" aria-labelledby="ayv-imp-maptitle"{{#noname}} data-ayv-show{{/noname}}>
        <div class="ayv-modal-head">
            <h2 class="ayv-section-title" id="ayv-imp-maptitle">{{readerslistcolumns}}</h2>
            <button type="button" class="ayv-modal-close" data-ayv-close aria-label="{{offsiteclose}}">{{> local_oksigeniaayvurenda/icon_x}}</button>
        </div>
        <p>{{importcolumnsintro}}</p>
        <ul class="ayv-imp-map">
            {{#columns}}
            <li class="ayv-imp-mapline">
                <label class="ayv-imp-mapname" for="ayv-imp-col-{{index}}">{{heading}}</label>
                <span class="ayv-imp-mapsample">{{sample}}{{^sample}}{{importcolumnssaysnothing}}{{/sample}}</span>
                <span class="ayv-field ayv-imp-mapfield"><select id="ayv-imp-col-{{index}}" name="column[{{index}}]">{{#options}}<option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>{{/options}}</select></span>
            </li>
            {{/columns}}
        </ul>
        <p class="ayv-book-actions"><button type="submit" class="ayv-button" name="remap" value="1" data-nobusy>{{importcolumnsapply}}</button></p>
    </dialog>
    {{^noname}}
    <fieldset class="ayv-imp-panel ayv-readers-kind">
        <legend class="ayv-classbar-label">{{readerslisttype}}</legend>
        <div class="ayv-segmented">{{#types}}<label><input type="radio" name="type" value="{{value}}" {{#selected}}checked{{/selected}}><span>{{label}}</span></label>{{/types}}</div>
    </fieldset>
    <div class="ayv-imp-go">
        <button type="submit" class="ayv-button ayv-imp-gobutton" name="load" value="1">{{gowords}}</button>
        <a class="ayv-button ayv-button-quiet" href="{{urlself}}">{{importcancel}}</a>
        <p class="ayv-imp-safe">{{readerslistsafe}}</p>
    </div>
    {{/noname}}
</form>
{{/check}}
{{#done}}
<section class="ayv-imp-done">
    <header class="ayv-imp-head">
        <div class="ayv-imp-headtext">
            <h1 class="ayv-imp-title">{{readerslistdonetitle}}</h1>
            {{#said}}{{> local_oksigeniaayvurenda/bubble}}{{/said}}
        </div>
        <ul class="ayv-imp-figures">
            {{#figures}}<li><span class="ayv-imp-num">{{count}}</span> <span class="ayv-imp-figlabel">{{label}}</span></li>{{/figures}}
        </ul>
    </header>
    <h2 class="ayv-section-title">{{importnextheading}}</h2>
    <ul class="ayv-imp-next">
        <li><a href="{{urlreaders}}">{{> local_oksigeniaayvurenda/icon_users}}<b>{{readerslistgoreaders}}</b><span>{{readerslistgoreadershint}}</span></a></li>
        <li><a href="{{urldesk}}">{{> local_oksigeniaayvurenda/icon_scan_line}}<b>{{importnextdesk}}</b><span>{{importnextdeskhint}}</span></a></li>
    </ul>
</section>
{{/done}}
</div>
