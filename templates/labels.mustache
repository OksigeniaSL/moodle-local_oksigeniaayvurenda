{{!
    @template local_oksigeniaayvurenda/labels

    Labels with the barcode, or spine labels, laid out on the chosen A4 sheet.

    Context variables required for this template:
    * heading, count, empty - texts
    * action, library - the form; kinds, whiches, sheets (value, label, selected); since, codes, start
    * cols, cells - the map of the sheet (n, used, first, label); istoday, issince, iscodes; toomany
    * pages - sheets of labels (blank, barcode, title, callnumber lines, library, svg)
    * spines - whether they are spine labels; style - the measures of the sheet

    Example context (json):
    {
        "heading": "Etiquetas",
        "action": "#",
        "library": "central",
        "kinds": [{"value": "labels", "label": "Etiquetas", "selected": true, "isspine": false}],
        "cols": 3, "cells": [{"n": 1, "used": false, "first": true, "label": "Empezar en la etiqueta 1"}],
        "istoday": true, "issince": false, "iscodes": false, "toomany": "", "labelsmaphint": "Toca la primera libre.",
        "whiches": [{"value": "today", "label": "Lo dado de alta hoy", "selected": true}],
        "since": "",
        "codes": "",
        "sheets": [{"value": "3x8", "label": "3 × 8", "selected": true}],
        "start": 1,
        "count": "2 ejemplares",
        "haspages": true,
        "pages": [{"labels": [{"blank": false, "barcode": "100000L", "title": "El faro dormido", "callnumber": ["N", "LAU", "far"], "library": "Central", "svg": ""}]}],
        "empty": "",
        "spines": false,
        "style": "",
        "labelskind": "Qué", "labelswhich": "De qué ejemplares", "labelssince": "Desde", "labelscodes": "Códigos",
        "labelssheetlabel": "Hoja", "labelsstart": "Empezar en la etiqueta", "labelsshow": "Ver", "printnow": "Imprimir"
    }
}}
<div class="ayv-print-head">
    <h1 class="ayv-results-title">{{heading}}</h1>
    <form method="get" action="{{action}}" class="ayv-lab" data-ayv-lab>
        <input type="hidden" name="library" value="{{library}}">
        <input type="hidden" name="start" value="{{start}}">
        <div class="ayv-lab-main">
            <fieldset class="ayv-lab-kinds"><legend class="ayv-sr">{{labelskind}}</legend>
                {{#kinds}}
                <label class="ayv-lab-kind"><input type="radio" name="kind" value="{{value}}" {{#selected}}checked{{/selected}}>
                    <span class="ayv-lab-sample" aria-hidden="true">
                        {{#isspine}}<span class="ayv-lab-spine"><b>N</b><b>LAU</b><b>far</b></span>{{/isspine}}
                        {{^isspine}}<span class="ayv-lab-code"><i></i><i></i><i></i></span>{{/isspine}}
                    </span>
                    <span class="ayv-lab-kindname">{{label}}</span></label>
                {{/kinds}}
            </fieldset>
            <fieldset class="ayv-lab-which"><legend>{{labelswhich}}</legend>
                {{#whiches}}<label class="ayv-lab-pill"><input type="radio" name="which" value="{{value}}" {{#selected}}checked{{/selected}}> <span>{{label}}</span></label>{{/whiches}}
            </fieldset>
            <label class="ayv-field ayv-dig-field ayv-lab-since"{{^issince}} hidden{{/issince}}>{{labelssince}} <input type="date" name="since" value="{{since}}"></label>
            <label class="ayv-field ayv-dig-field ayv-lab-codes"{{^iscodes}} hidden{{/iscodes}}>{{labelscodes}} <textarea name="codes" rows="3" spellcheck="false">{{codes}}</textarea></label>
            <p class="ayv-lab-go"{{#istoday}} hidden{{/istoday}}><button type="submit" class="ayv-button ayv-button-quiet">{{labelsshow}}</button></p>
        </div>
        <div class="ayv-lab-side">
            <label class="ayv-field ayv-dig-field">{{labelssheetlabel}} <select name="sheet">{{#sheets}}<option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>{{/sheets}}</select></label>
            <p class="ayv-field-hint">{{labelsmaphint}}</p>
            <div class="ayv-lab-map" style="--cols: {{cols}}" role="group" aria-label="{{labelsstart}}">{{#cells}}<button type="button" class="ayv-lab-cell{{#used}} ayv-lab-cell-used{{/used}}{{#first}} ayv-lab-cell-first{{/first}}" data-start="{{n}}" aria-label="{{label}}"{{#first}} aria-current="true"{{/first}}></button>{{/cells}}</div>
        </div>
    </form>
    <p class="ayv-lab-count"><span>{{count}}</span>{{#haspages}} <button type="button" class="ayv-button" onclick="window.print()">{{printnow}}</button>{{/haspages}}</p>
</div>
{{#toomany}}<p class="ayv-notice" role="status">{{toomany}}</p>{{/toomany}}
{{^haspages}}<p class="ayv-empty">{{empty}}</p>{{/haspages}}
{{#pages}}
<div class="ayv-labelsheet{{#spines}} ayv-labelsheet-spines{{/spines}}" style="{{style}}">
{{#labels}}
    <div class="ayv-label{{#blank}} ayv-label-empty{{/blank}}">
        {{^blank}}
        {{#spines}}<div class="ayv-spine-lines">{{#callnumber}}<span>{{.}}</span>{{/callnumber}}</div>{{/spines}}
        {{^spines}}
        <p class="ayv-label-library">{{library}}</p>
        <p class="ayv-label-title">{{title}}</p>
        {{#svg}}<div class="ayv-label-barcode">{{{svg}}}</div>{{/svg}}
        {{/spines}}
        {{/blank}}
    </div>
{{/labels}}
</div>
{{/pages}}
