{{!
    @template local_oksigeniaayvurenda/labels

    The labels as one sample sheet: on the left, what is printed (two cards with a sample label), of which copies (chips,
    the last days things came in, a list of codes) and the sheet (each drawn small, the favourites first); on the right,
    the first sheet as it will come out, where the first free label is touched, and the way to print them all. Every
    choice is a link; the favourite and the moved print are kept with a button each.

    Context variables required for this template:
    * title, intro, savedword, crier - the head
    * kindtitle, kinds (url, current, iscode, name, sub, library, code, svg, booktitle, lines) - what is printed
    * whichtitle, whiches (url, current, label), days (lead, list, otherurl, otherlabel), codes (action, hidden, label,
      value, show) - of which copies
    * sheettitle, sheets (top, others, hasothers; each url, current, name, sub, cols, rows, cells), otherslabel, othersnote
    * firstsheet, says, haslabels, empty, toomany, paper (cols, rows, letter, cells: url, aria, used, first, blank,
      spine, code), note, printurl, printlabel, favaction, sesskey, fav (pressed, label, justsaved), adjusturl,
      adjustlabel, adjust (title, hint, now, justsaved, moves, reset, testhint, testurl, testlabel, close, closelabel)

    Example context (json):
    {
        "title": "Etiquetas", "intro": "Elige qué.", "savedword": "Guardado", "crier": null, "kindtitle": "Qué",
        "kinds": [
            {"url": "https://example.com/labels.php", "current": false, "iscode": true, "name": "El código", "sub": "Para el mostrador",
                "library": "Biblioteca", "code": "AY-1", "booktitle": "La isla",
                "svg": "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 10 4'><rect width='1' height='4'/></svg>"},
            {"url": "https://example.com/labels.php?kind=spines", "current": true, "iscode": false, "name": "El tejuelo",
                "sub": "Para el lomo", "lines": [{"line": "82-3", "top": true}, {"line": "ROW", "top": false}]}
        ],
        "whichtitle": "De qué ejemplares",
        "whiches": [{"url": "https://example.com/labels.php?which=today", "current": true, "label": "Los dados de alta hoy · 2"}],
        "days": {"lead": "Desde el día que se toca:", "otherurl": "https://example.com/year.php", "otherlabel": "Otro día",
            "list": [{"url": "https://example.com/labels.php?since=2026-10-02", "label": "vie 2 oct", "current": true}]},
        "codes": {"action": "https://example.com/labels.php", "hidden": [{"name": "which", "value": "codes"}],
            "label": "Códigos", "value": "AY-1", "show": "Ver"},
        "sheettitle": "La hoja", "otherslabel": "Otras hojas", "othersnote": "Arriba, tus favoritas.",
        "sheets": {"hasothers": true,
            "top": [{"url": "https://example.com/labels.php?sheet=a", "current": true, "name": "Apli 01273", "sub": "70 × 37 mm",
                "cols": 3, "rows": 2, "cells": [{"x": 1}, {"x": 1}]}],
            "others": [{"url": "https://example.com/labels.php?sheet=b", "current": false, "name": "Avery L7160", "sub": "63,5 × 38,1 mm",
                "cols": 3, "rows": 7, "cells": [{"x": 1}]}]},
        "firstsheet": "La primera hoja", "says": "<b>2 tejuelos</b> en <b>1 hoja</b>.", "haslabels": true,
        "empty": "Nada.", "toomany": "",
        "paper": {"cols": 3, "rows": 8, "letter": false, "cells": [
            {"url": "https://example.com/labels.php?start=1", "aria": "Empezar en la 1", "used": true, "first": false,
                "blank": false, "spine": null, "code": null},
            {"url": "https://example.com/labels.php?start=2", "aria": "Empezar en la 2", "used": false, "first": true,
                "blank": false, "spine": {"lines": [{"line": "82-3", "top": true}]}, "code": null},
            {"url": "https://example.com/labels.php?start=3", "aria": "Empezar en la 3", "used": false, "first": false,
                "blank": false, "spine": null, "code": {"library": "Biblioteca", "barcode": "AY-1", "title": "La isla",
                "svg": "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 10 4'><rect width='1' height='4'/></svg>"} },
            {"url": "https://example.com/labels.php?start=4", "aria": "Empezar en la 4", "used": false, "first": false,
                "blank": true, "spine": null, "code": null}
        ]},
        "note": "Toca la primera libre.", "printurl": "https://example.com/labels.php?print=1", "printlabel": "Imprimir la hoja",
        "favaction": "https://example.com/labels.php", "sesskey": "abc",
        "fav": {"pressed": true, "label": "Una de tus favoritas", "justsaved": false},
        "adjusturl": "https://example.com/labels.php?adjust=1", "adjustlabel": "Ajustar la impresión",
        "adjust": {"title": "Ajustar", "hint": "Medio milímetro.", "now": "En su sitio.", "justsaved": true,
            "moves": [{"value": "left", "label": "A la izquierda", "arrow": "←"}], "reset": "Volver a su sitio",
            "testhint": "En papel normal.", "testurl": "https://example.com/labels.php?print=1&test=1", "testlabel": "Hoja de prueba",
            "close": "https://example.com/labels.php", "closelabel": "Cerrar"}
    }
}}
<div class="ayv-cf ayv-et">
<header class="ayv-cf-cabeza">
    <div class="ayv-cf-cabeza-texto"><h1 class="ayv-cf-titulo">{{title}}</h1>
        <p class="ayv-cf-entrada">{{intro}}</p>
        </div>
    {{#crier}}<span class="ayv-cf-pregonera"><span class="ayv-figure"><img src="{{figure}}" alt="" width="512" height="512"{{#puppet}} data-puppet="{{puppet}}"{{/puppet}}></span></span>{{/crier}}
</header>
<div class="ayv-et-mesa">
<div class="ayv-et-elige">
    <section class="ayv-et-paso" aria-labelledby="ayv-et-que">
        <h2 id="ayv-et-que">{{kindtitle}}</h2>
        <div class="ayv-et-tipos">
            {{#kinds}}<a class="ayv-et-tipo" href="{{url}}"{{#current}} aria-current="true"{{/current}}><span class="ayv-et-muestra{{^iscode}} ayv-et-muestra-tej{{/iscode}}" aria-hidden="true">{{#iscode}}<span class="ayv-et-e ayv-et-cod"><small>{{library}}</small><span class="ayv-et-codigo">{{{svg}}}</span><b>{{code}}</b><small>{{booktitle}}</small></span>{{/iscode}}{{^iscode}}<span class="ayv-et-e ayv-et-tej">{{#lines}}{{#top}}<b>{{line}}</b>{{/top}}{{^top}}<span>{{line}}</span>{{/top}}{{/lines}}</span>{{/iscode}}</span><b>{{name}}</b><span>{{sub}}</span></a>{{/kinds}}
        </div>
    </section>
    <section class="ayv-et-paso" aria-labelledby="ayv-et-de" id="ayv-et-dias">
        <h2 id="ayv-et-de">{{whichtitle}}</h2>
        <div class="ayv-cf-chapas">{{#whiches}}{{#url}}<a class="ayv-cf-chapa" href="{{url}}"{{#current}} aria-current="true"{{/current}}>{{label}}</a>{{/url}}{{^url}}<span class="ayv-et-callada">{{label}}</span>{{/url}}{{/whiches}}</div>
        {{#days}}
        <div class="ayv-et-dias"><span class="ayv-cf-nota">{{lead}}</span>{{#list}}<a class="ayv-et-dia" href="{{url}}"{{#current}} aria-current="true"{{/current}}>{{label}}</a>{{/list}}
            <a class="ayv-cf-enlace" href="{{otherurl}}">{{otherlabel}}</a></div>
        {{/days}}
        {{#codes}}
        <form class="ayv-et-lista" id="ayv-et-lista" method="get" action="{{action}}">{{#hidden}}<input type="hidden" name="{{name}}" value="{{value}}">{{/hidden}}
            <label for="ayv-et-codigos">{{label}}</label>
            <textarea id="ayv-et-codigos" name="codes" rows="5" spellcheck="false" autocomplete="off">{{value}}</textarea>
            <span class="ayv-cf-fila"><button type="submit" class="ayv-button">{{show}}</button></span>
        </form>
        {{/codes}}
    </section>
    <section class="ayv-et-paso" aria-labelledby="ayv-et-hojas">
        <h2 id="ayv-et-hojas">{{sheettitle}}</h2>
        {{#sheets}}
        <div class="ayv-et-hojas">{{#top}}{{> local_oksigeniaayvurenda/labels_sheet}}{{/top}}</div>
        {{#hasothers}}
        <details class="ayv-et-mas"><summary>{{otherslabel}}</summary>
            <div class="ayv-et-hojas">{{#others}}{{> local_oksigeniaayvurenda/labels_sheet}}{{/others}}</div>
            <p class="ayv-cf-nota">{{othersnote}}</p></details>
        {{/hasothers}}
        {{/sheets}}
    </section>
</div>
<section class="ayv-et-muestra-hoja" id="ayv-et-hoja" aria-labelledby="ayv-et-hoja-t">
    <h2 id="ayv-et-hoja-t" class="ayv-sr">{{firstsheet}}</h2>
    {{#haslabels}}
    <p class="ayv-et-dice">{{{says}}}</p>
    {{#toomany}}<p class="ayv-notice" role="status">{{toomany}}</p>{{/toomany}}
    {{#paper}}
    <div class="ayv-et-papel{{#letter}} ayv-et-papel-carta{{/letter}}" style="--c: {{cols}}; --r: {{rows}};">{{#cells}}<a class="ayv-et-celda{{#first}} ayv-et-primera{{/first}}" href="{{url}}"{{#first}} aria-current="true"{{/first}}><span class="ayv-sr">{{aria}}</span><span class="ayv-et-e{{#used}} ayv-et-usada{{/used}}{{#spine}} ayv-et-tej{{/spine}}{{#code}} ayv-et-cod{{/code}}" aria-hidden="true">{{#spine}}{{#lines}}{{#top}}<b>{{line}}</b>{{/top}}{{^top}}<span>{{line}}</span>{{/top}}{{/lines}}{{/spine}}{{#code}}<small>{{library}}</small><span class="ayv-et-codigo">{{{svg}}}</span><b>{{barcode}}</b><small>{{title}}</small>{{/code}}</span></a>{{/cells}}</div>
    {{/paper}}
    <p class="ayv-cf-nota">{{note}}</p>
    <div class="ayv-cf-fila">
        <a class="ayv-button" href="{{printurl}}">{{printlabel}}</a>
        <form method="post" action="{{favaction}}"><input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="do" value="fav">
            {{#fav}}<button class="ayv-cf-chapa" type="submit" aria-pressed="{{#pressed}}true{{/pressed}}{{^pressed}}false{{/pressed}}"><span aria-hidden="true">{{#pressed}}★{{/pressed}}{{^pressed}}☆{{/pressed}}</span> {{label}}</button>{{#justsaved}} <span class="ayv-cf-guardado" role="status">{{savedword}}</span>{{/justsaved}}{{/fav}}</form>
        <a class="ayv-cf-enlace" href="{{adjusturl}}">{{adjustlabel}}</a>
    </div>
    {{/haslabels}}
    {{^haslabels}}<p class="ayv-et-dice">{{empty}}</p>{{/haslabels}}
    {{#adjust}}
    <div class="ayv-et-ajuste" id="ayv-et-ajuste">
        <h3>{{title}}</h3>{{#justsaved}}<p><span class="ayv-cf-guardado" role="status">{{savedword}}</span></p>{{/justsaved}}
        <p>{{now}}</p>
        <p class="ayv-cf-nota">{{hint}}</p>
        <form class="ayv-et-flechas" method="post" action="{{favaction}}"><input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="do" value="nudge">
            {{#moves}}<button class="ayv-cf-chapa" type="submit" name="move" value="{{value}}"><span aria-hidden="true">{{arrow}}</span> {{label}}</button>{{/moves}}
            {{#reset}}<button class="ayv-cf-chapa" type="submit" name="move" value="reset">{{reset}}</button>{{/reset}}
        </form>
        <p class="ayv-cf-nota">{{testhint}}</p>
        <p class="ayv-cf-fila"><a class="ayv-button ayv-button-quiet" href="{{testurl}}">{{testlabel}}</a> <a class="ayv-cf-enlace" href="{{close}}">{{closelabel}}</a></p>
    </div>
    {{/adjust}}
</section>
</div>
</div>
