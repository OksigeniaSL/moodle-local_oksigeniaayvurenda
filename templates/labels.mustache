{{!
    @template local_oksigeniaayvurenda/labels

    Labels with the barcode, or spine labels, laid out on the chosen A4 sheet.

    Context variables required for this template:
    * heading, count, empty - texts
    * action, library - the form; kinds, whiches, sheets (value, label, selected); since, codes, start
    * cols, cells - the map of the sheet (n, used, first, label); istoday, issince, iscodes; toomany
    * pages - sheets of labels (blank, barcode, title, callnumber lines, library, svg)
    * spines - whether they are spine labels; style - the measures of the sheet

    Example context (json):
    {
        "heading": "Etiquetas",
        "action": "#",
        "library": "central",
        "kinds": [{"value": "labels", "label": "Etiquetas", "selected": true, "isspine": false}],
        "cols": 3, "cells": [{"n": 1, "used": false, "first": true, "label": "Empezar en la etiqueta 1"}],
        "istoday": true, "issince": false, "iscodes": false, "toomany": "", "labelsmaphint": "Toca la primera libre.",
        "whiches": [{"value": "today", "label": "Lo dado de alta hoy", "selected": true}],
        "since": "",
        "codes": "",
        "sheetgroups": [{"label": "Apli", "options": [{"value": "apli-01286", "label": "Apli 01286 · 52,5 × 29,7 mm · 40 por hoja", "selected": true}]}],
        "sheet": "apli-01286", "sesskey": "abc", "which": "today", "isfav": false, "favbutton": "Marcar como favorita",
        "nudgex": 0, "nudgey": 0, "nudged": "", "testurl": "#", "test": false, "letter": false,
        "labelsnudge": "Ajustar la impresión", "labelsnudgetitle": "Ajustar la impresión", "labelsnudgehint": "Mueve la impresión.",
        "labelsnudgex": "A la derecha (mm)", "labelsnudgey": "Hacia abajo (mm)", "labelstest": "Hoja de prueba",
        "labelstesthint": "Imprímela en papel normal.", "sourcessave": "Guardar", "offsiteclose": "Cerrar",
        "start": 1,
        "count": "2 ejemplares",
        "haspages": true,
        "pages": [{"labels": [{"blank": false, "barcode": "100000L", "title": "El faro dormido", "callnumber": ["N", "LAU", "far"], "library": "Central", "svg": ""}]}],
        "empty": "",
        "spines": false,
        "style": "",
        "labelskind": "Qué", "labelswhich": "De qué ejemplares", "labelssince": "Desde", "labelscodes": "Códigos",
        "labelssheetlabel": "Hoja", "labelsstart": "Empezar en la etiqueta", "labelsshow": "Ver", "printnow": "Imprimir"
    }
}}
<div class="ayv-print-head">
    <h1 class="ayv-results-title">{{heading}}</h1>
    <form method="get" action="{{action}}" class="ayv-lab" data-ayv-lab>
        <input type="hidden" name="library" value="{{library}}">
        <input type="hidden" name="start" value="{{start}}">
        <div class="ayv-lab-main">
            <fieldset class="ayv-lab-kinds"><legend class="ayv-sr">{{labelskind}}</legend>
                {{#kinds}}
                <label class="ayv-lab-kind"><input type="radio" name="kind" value="{{value}}" {{#selected}}checked{{/selected}}>
                    <span class="ayv-lab-sample" aria-hidden="true">
                        {{#isspine}}<span class="ayv-lab-spine"><b>N</b><b>LAU</b><b>far</b></span>{{/isspine}}
                        {{^isspine}}<span class="ayv-lab-code"><i></i><i></i><i></i></span>{{/isspine}}
                    </span>
                    <span class="ayv-lab-kindname">{{label}}</span></label>
                {{/kinds}}
            </fieldset>
            <fieldset class="ayv-lab-which"><legend>{{labelswhich}}</legend>
                {{#whiches}}<label class="ayv-lab-pill"><input type="radio" name="which" value="{{value}}" {{#selected}}checked{{/selected}}> <span>{{label}}</span></label>{{/whiches}}
            </fieldset>
            <label class="ayv-field ayv-dig-field ayv-lab-since"{{^issince}} hidden{{/issince}}>{{labelssince}} <input type="date" name="since" value="{{since}}"></label>
            <label class="ayv-field ayv-dig-field ayv-lab-codes"{{^iscodes}} hidden{{/iscodes}}>{{labelscodes}} <textarea name="codes" rows="3" spellcheck="false">{{codes}}</textarea></label>
            <p class="ayv-lab-go"{{#istoday}} hidden{{/istoday}}><button type="submit" class="ayv-button ayv-button-quiet">{{labelsshow}}</button></p>
        </div>
        <div class="ayv-lab-side">
            <label class="ayv-field ayv-dig-field">{{labelssheetlabel}} <select name="sheet">{{#sheetgroups}}<optgroup label="{{label}}">{{#options}}<option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>{{/options}}</optgroup>{{/sheetgroups}}</select></label>
            <p class="ayv-lab-sheettools">
                <button type="submit" form="ayv-lab-fav" class="ayv-button ayv-button-quiet ayv-lab-fav{{#isfav}} ayv-lab-fav-on{{/isfav}}" aria-pressed="{{#isfav}}true{{/isfav}}{{^isfav}}false{{/isfav}}"><span aria-hidden="true">{{#isfav}}★{{/isfav}}{{^isfav}}☆{{/isfav}}</span> {{favbutton}}</button>
                <button type="button" class="ayv-button ayv-button-quiet" data-ayv-open="ayv-lab-nudge">{{labelsnudge}}</button></p>
            {{#nudged}}<p class="ayv-field-hint">{{nudged}}</p>{{/nudged}}
            <p class="ayv-field-hint">{{labelsmaphint}}</p>
            <div class="ayv-lab-map" style="--cols: {{cols}}" role="group" aria-label="{{labelsstart}}">{{#cells}}<button type="button" class="ayv-lab-cell{{#used}} ayv-lab-cell-used{{/used}}{{#first}} ayv-lab-cell-first{{/first}}" data-start="{{n}}" aria-label="{{label}}"{{#first}} aria-current="true"{{/first}}></button>{{/cells}}</div>
        </div>
    </form>
    <form id="ayv-lab-fav" method="post" action="{{action}}" hidden><input type="hidden" name="sesskey" value="{{sesskey}}">
        <input type="hidden" name="do" value="fav"><input type="hidden" name="library" value="{{library}}"><input type="hidden" name="kind" value="{{kind}}">
        <input type="hidden" name="sheet" value="{{sheet}}"><input type="hidden" name="which" value="{{which}}"><input type="hidden" name="since" value="{{since}}">
        <input type="hidden" name="codes" value="{{codes}}"></form>
    <dialog class="ayv-modal" id="ayv-lab-nudge" aria-labelledby="ayv-lab-nudge-title">
        <div class="ayv-modal-head"><h3 id="ayv-lab-nudge-title" class="ayv-section-title">{{labelsnudgetitle}}</h3>
            <form method="dialog"><button class="ayv-modal-close" aria-label="{{offsiteclose}}">{{> local_oksigeniaayvurenda/icon_x}}</button></form></div>
        <p class="ayv-field-hint">{{labelstesthint}}</p>
        <p><a class="ayv-button ayv-button-quiet" href="{{testurl}}">{{labelstest}}</a></p>
        <form method="post" action="{{action}}" class="ayv-rule-form"><input type="hidden" name="sesskey" value="{{sesskey}}">
            <input type="hidden" name="do" value="nudge"><input type="hidden" name="library" value="{{library}}"><input type="hidden" name="kind" value="{{kind}}">
            <input type="hidden" name="sheet" value="{{sheet}}"><input type="hidden" name="which" value="{{which}}"><input type="hidden" name="since" value="{{since}}">
            <input type="hidden" name="codes" value="{{codes}}">
            <p class="ayv-field-hint">{{labelsnudgehint}}</p>
            <div class="ayv-rule-numbers">
                <label class="ayv-field ayv-dig-field">{{labelsnudgex}} <input type="number" name="x" min="-10" max="10" step="0.5" value="{{nudgex}}"></label>
                <label class="ayv-field ayv-dig-field">{{labelsnudgey}} <input type="number" name="y" min="-10" max="10" step="0.5" value="{{nudgey}}"></label>
            </div>
            <p class="ayv-dig-sheet-actions"><button type="submit" class="ayv-button">{{sourcessave}}</button></p>
        </form>
    </dialog>
    <p class="ayv-lab-count"><span>{{count}}</span>{{#haspages}} <button type="button" class="ayv-button" data-ayv-print>{{printnow}}</button>{{/haspages}}</p>
    {{#toomany}}<p class="ayv-notice" role="status">{{toomany}}</p>{{/toomany}}
    {{^haspages}}<div class="ayv-nothing"><p>{{empty}}</p></div>{{/haspages}}
</div>
{{#pages}}
<div class="ayv-labelsheet{{#spines}} ayv-labelsheet-spines{{/spines}}{{#letter}} ayv-labelsheet-letter{{/letter}}{{#test}} ayv-labelsheet-test{{/test}}" style="{{style}}">
{{#labels}}
    <div class="ayv-label{{#blank}} ayv-label-empty{{/blank}}">{{#testnumber}}<span class="ayv-label-number">{{testnumber}}</span>{{/testnumber}}
        {{^blank}}
        {{#spines}}<div class="ayv-spine-lines">{{#callnumber}}<span>{{.}}</span>{{/callnumber}}</div>{{/spines}}
        {{^spines}}
        <p class="ayv-label-library">{{library}}</p>
        <p class="ayv-label-title">{{title}}</p>
        {{#svg}}<div class="ayv-label-barcode">{{{svg}}}</div>{{/svg}}
        {{/spines}}
        {{/blank}}
    </div>
{{/labels}}
</div>
{{/pages}}
