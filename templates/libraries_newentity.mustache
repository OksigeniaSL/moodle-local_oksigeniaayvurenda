{{!
    @template local_oksigeniaayvurenda/libraries_newentity

    The form for a new centre. The first one asks only the library's name (the centre takes it too): the rest comes
    afterwards, inside the library. Another centre on the same site asks the centre's name and its first library's.

    Example context (json):
    {
        "action": "#", "sesskey": "abc", "none": true,
        "librariesfirst": "Tu biblioteca", "librariesfirsthint": "Para empezar, solo su nombre.",
        "librariesfirstname": "Nombre de la biblioteca", "librariesentityname": "Nombre del centro",
        "librarieslibraryname": "Nombre de su primera biblioteca", "librariescreate": "Crear"
    }
}}
<form method="post" action="{{action}}"{{#none}} class="ayv-book"{{/none}}>
    <input type="hidden" name="sesskey" value="{{sesskey}}">
    {{#none}}<input type="hidden" name="first" value="1">
    <h2 class="ayv-section-title">{{librariesfirst}}</h2>
    <p>{{librariesfirsthint}}</p>
    <label class="ayv-field">{{librariesfirstname}} <input type="text" name="name" maxlength="255" required></label>{{/none}}
    {{^none}}<label class="ayv-field">{{librariesentityname}} <input type="text" name="name" maxlength="255" required></label>
    <label class="ayv-field">{{librarieslibraryname}} <input type="text" name="library" maxlength="255"></label>{{/none}}
    <p class="ayv-book-actions"><button type="submit" class="ayv-button" name="do" value="newentity">{{librariescreate}}</button></p>
</form>
