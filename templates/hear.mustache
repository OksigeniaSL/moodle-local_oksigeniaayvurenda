{{!
    @template local_oksigeniaayvurenda/hear

    «Leyó para los pequeños» (Jujol, 13 November): the page a family opens from their link, without an account and
    without Moodle around it. The cover like a present just opened, who read it and for whom, a big «play», and a way to
    send it on; the Open Graph tags make the message that brings it show the cover and the sentence before it is opened.

    Example context (json):
    {
        "lang": "es", "title": "Iker ha leído «La isla del cometa» para los pequeños",
        "ogdescription": "Biblioteca de ejemplo · escúchalo y mándaselo a quien quieras",
        "ogimage": "https://example.com/mailimage.php?a=cover", "url": "https://example.com/hear.php?i=1&s=x",
        "css": "https://example.com/app/escuchar.css", "js": "https://example.com/app/escuchar.js",
        "emblem": "https://example.com/app/emblema.svg", "library": "Biblioteca de ejemplo",
        "cover": "https://example.com/mailimage.php?a=cover", "coveralt": "La portada de «La isla del cometa»",
        "coverbg": "#17574c", "coverink": "#ffffff", "booktitle": "La isla del cometa",
        "kicker": "Leído para los pequeños", "name": "Iker",
        "sentence": "ha leído «La isla del cometa» para los lectores más pequeños de su biblioteca.",
        "audio": "https://example.com/hear.php?i=1&s=x&play=1", "play": "Escuchar", "pause": "Pausa",
        "seek": "Por dónde va", "share": "Mandárselo a alguien", "sharetitle": "Iker ha leído «La isla del cometa»",
        "sharetext": "Escúchalo: Iker lo ha leído para los pequeños de su biblioteca.",
        "copied": "Copiado: ya puedes pegarlo donde quieras.",
        "foot": "Lo escuchan los lectores más pequeños en la portada de su biblioteca.",
        "footlink": "El enlace no pide cuenta: sirve para quien lo reciba."
    }
}}
<!DOCTYPE html>
<html lang="{{lang}}" class="lp-sin-js">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{title}}</title>
<meta name="description" content="{{library}}">
<meta name="robots" content="noindex, nofollow">
<meta property="og:type" content="music.song">
<meta property="og:title" content="{{title}}">
<meta property="og:description" content="{{ogdescription}}">
<meta property="og:url" content="{{url}}">
{{#ogimage}}<meta property="og:image" content="{{ogimage}}">{{/ogimage}}
<link rel="stylesheet" href="{{css}}">
</head>
<body>
<main class="lp"><div class="lp-contenido">
    <p class="lp-biblio"><img src="{{emblem}}" alt="" width="32" height="32">{{library}}</p>
    <div class="lp-libro">{{#cover}}<img src="{{cover}}" alt="{{coveralt}}" width="400" height="600">{{/cover}}{{^cover}}<span class="lp-tapa-sin" style="background: {{coverbg}}; color: {{coverink}};">{{booktitle}}</span>{{/cover}}</div>
    <p class="lp-etiqueta">{{kicker}}</p>
    <h1 class="lp-frase"><b>{{name}}</b> {{sentence}}</h1>
    <audio class="lp-audio-sin-js" controls preload="metadata" src="{{audio}}"></audio>
    <div class="lp-reproductor">
        <button type="button" class="lp-play" aria-pressed="false" aria-label="{{play}}" data-escuchar="{{play}}" data-pausar="{{pause}}">
            <svg class="lp-icono lp-icono-play" viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><path d="M7 4.5v15l13-7.5z"/></svg>
            <svg class="lp-icono lp-icono-pausa" viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><path d="M6.5 4.5h4v15h-4zM13.5 4.5h4v15h-4z"/></svg>
        </button>
        <div class="lp-pista"><input class="lp-barra" type="range" min="0" max="1" value="0" step="any" aria-label="{{seek}}">
            <span class="lp-tiempo"><span class="lp-ya">0:00</span><span class="lp-total"></span></span></div>
    </div>
    <button type="button" class="lp-pasar" data-titulo="{{sharetitle}}" data-texto="{{sharetext}}" data-copiado="{{copied}}">
        <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 4 9.5 14.5M20 4l-6.5 16-4-5.5L4 10.5z"/></svg>{{share}}</button>
    <p class="lp-pasado" aria-live="polite"></p>
    <p class="lp-pie">{{foot}}<br>{{footlink}}</p>
</div></main>
<script src="{{js}}"></script>
</body>
</html>
