{{!
    @template local_oksigeniaayvurenda/voicesinfo

    How the library handles voices.

    Example context (json):
    {
        "heading": "Cómo se tratan las voces", "points": [{"text": "Tu voz se guarda en el sitio del centro."}],
        "centre": "", "centreheading": "Lo que añade el centro"
    }
}}
<h1 class="ayv-results-title">{{heading}}</h1>
<ul class="ayv-voiceinfo">{{#points}}<li>{{text}}</li>{{/points}}</ul>
{{#centre}}<h2 class="ayv-section-title">{{centreheading}}</h2><p>{{centre}}</p>{{/centre}}
