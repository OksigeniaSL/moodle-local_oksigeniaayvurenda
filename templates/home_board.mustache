{{!
    @template local_oksigeniaayvurenda/home_board

    The reader's home as one board (Gaudí's mock-up of 7 November 2026, dis-pase-04): on the left, what the herald tells,
    once and whole (what just arrived, the book of the week); on the right, what the memory recommends and the reader's
    flower with their class's challenge inside. One «Listen» per card, by its title. The characters stand still.

    Example context (json):
    {
        "board": {"heraldtitle": "Lo que cuenta Mainumby", "memorytitle": "La memoria te recomienda", "allnew": "Verlos todos",
            "covers": [{"url": "#", "cover": "https://example.org/c.jpg", "title": "El faro"}],
            "moments": {"heading": "Para celebrar", "text": "Este curso ya van 1.000 libros prestados. El número 1.000 fue «El faro».",
                "figure": "https://example.org/m-celebra.webp", "portrait": null, "initial": "M", "role": "herald",
                "cover": "https://example.org/c.jpg", "url": "https://example.org/record.php?id=1", "label": "Ver el libro",
                "more": {"items": [{"text": "«Matilda» ha salido ya 100 veces de la biblioteca.", "url": "https://example.org/r.php"},
                    {"text": "La clase 3.º B ha cumplido su reto.", "url": "https://example.org/reports.php"} ]
                } },
        "herald": {"name": "Mainumby", "text": "Acaban de llegar doce libros.", "figure": "https://example.org/m.webp",
            "initial": "M", "role": "herald", "portrait": "https://example.org/p.webp", "listen": null},
        "hasrecent": true,
        "weekbook": {"text": "El libro de la semana es «Una abuela en la barca».", "cover": "https://example.org/a.jpg",
            "url": "#", "label": "Ver el libro"},
        "hero": {"remembers": null, "you": null, "challenge": null, "wishherald": null}
    }
}}
<div class="ayv-board">
    {{#board.moments}}
    <section class="ayv-board-card ayv-board-moments" aria-labelledby="ayv-board-moments">
        <span class="ayv-board-who" aria-hidden="true">{{#figure}}<img src="{{figure}}" alt="" width="112" height="112">{{/figure}}{{^figure}}<span class="ayv-bubble-portrait ayv-bubble-{{role}}">{{#portrait}}<img class="ayv-bubble-img" src="{{portrait}}" alt="">{{/portrait}}{{^portrait}}{{initial}}{{/portrait}}</span>{{/figure}}</span>
        <div class="ayv-board-words">
            <h2 class="ayv-board-title" id="ayv-board-moments">{{heading}}</h2>
            <p class="ayv-board-moment">{{text}}</p>
            {{#more}}<ul class="ayv-board-moments-more">{{#items}}<li>{{#url}}<a href="{{url}}">{{text}}</a>{{/url}}{{^url}}{{text}}{{/url}}</li>{{/items}}</ul>{{/more}}
        </div>
        {{#url}}<p class="ayv-board-book">{{#cover}}<img src="{{cover}}" alt="" loading="lazy" width="72" height="108">{{/cover}}<a class="ayv-button ayv-button-quiet" href="{{url}}">{{label}}</a></p>{{/url}}
    </section>
    {{/board.moments}}
    <div class="ayv-board-col">
    {{#herald}}{{#hasrecent}}
    <section class="ayv-board-card ayv-board-herald" aria-labelledby="ayv-board-herald">
        <span class="ayv-board-who" aria-hidden="true">{{#figure}}<img src="{{figure}}" alt="" width="200" height="200">{{/figure}}{{^figure}}<span class="ayv-bubble-portrait ayv-bubble-{{role}}">{{#portrait}}<img class="ayv-bubble-img" src="{{portrait}}" alt="">{{/portrait}}{{^portrait}}{{initial}}{{/portrait}}</span>{{/figure}}</span>
        <div class="ayv-board-words">
            <h2 class="ayv-board-title" id="ayv-board-herald">{{board.heraldtitle}}</h2>{{#listen}}<span class="ayv-board-listen">{{> local_oksigeniaayvurenda/listen}}</span>{{/listen}}
            <p>{{text}}</p>
            <p class="ayv-board-covers">{{#board.covers}}<a href="{{url}}"><img src="{{cover}}" alt="{{title}}" loading="lazy" width="56" height="84"></a>{{/board.covers}}
                <a class="ayv-board-all" href="#ayv-recent">{{board.allnew}}</a></p>
        </div>
        {{#weekbook}}
        <div class="ayv-board-week">
            {{#cover}}<img src="{{cover}}" alt="" loading="lazy" width="120" height="180">{{/cover}}
            <div><p>{{text}}</p><p><a class="ayv-button" href="{{url}}">{{label}}</a></p></div>
        </div>
        {{/weekbook}}
    </section>
    {{/hasrecent}}{{/herald}}
    {{^hasrecent}}{{#weekbook}}<div class="ayv-board-card">{{> local_oksigeniaayvurenda/bubble}}
        <p class="ayv-duo-memory-go">{{#cover}}<img class="ayv-duo-memory-cover" src="{{cover}}" alt="" loading="lazy">{{/cover}}<a class="ayv-button ayv-button-quiet" href="{{url}}">{{label}}</a></p></div>{{/weekbook}}{{/hasrecent}}
    {{#hero.wishherald}}<div class="ayv-board-card">{{> local_oksigeniaayvurenda/bubble}}</div>{{/hero.wishherald}}
    {{#board.agenda}}
    <section class="ayv-board-card ayv-board-agenda" aria-labelledby="ayv-board-agenda">
        <h2 class="ayv-board-title" id="ayv-board-agenda">{{title}}</h2>
        <ul class="ayv-board-agenda-list">{{#items}}<li><span class="ayv-field-hint">{{when}}</span> <b>{{title}}</b></li>{{/items}}</ul>
        <p><a class="ayv-button ayv-button-quiet" href="{{url}}">{{label}}</a></p>
    </section>
    {{/board.agenda}}
    </div>
    <div class="ayv-board-col">
    {{#hero.remembers}}
    <section class="ayv-board-card ayv-board-memory" aria-labelledby="ayv-board-memory">
        <div class="ayv-board-words">
            <h2 class="ayv-board-title" id="ayv-board-memory">{{board.memorytitle}}</h2>{{#listen}}<span class="ayv-board-listen">{{> local_oksigeniaayvurenda/listen}}</span>{{/listen}}
            <p>{{text}}</p>
            <p class="ayv-board-book">{{#cover}}<img src="{{cover}}" alt="" loading="lazy" width="72" height="108">{{/cover}}<a class="ayv-button" href="{{url}}">{{label}}</a></p>
        </div>
        <span class="ayv-board-who" aria-hidden="true">{{#figure}}<img src="{{figure}}" alt="" width="112" height="112">{{/figure}}{{^figure}}<span class="ayv-bubble-portrait ayv-bubble-{{role}}">{{#portrait}}<img class="ayv-bubble-img" src="{{portrait}}" alt="">{{/portrait}}{{^portrait}}{{initial}}{{/portrait}}</span>{{/figure}}</span>
    </section>
    {{/hero.remembers}}
    {{#hero.you}}
    <section class="ayv-board-card ayv-board-you" aria-labelledby="ayv-board-you">
        {{#drawing}}<span class="ayv-board-flower">{{{drawing}}}</span>{{/drawing}}
        <div class="ayv-board-words">
            <h2 class="ayv-board-title" id="ayv-board-you">{{title}}</h2>{{#listen}}<span class="ayv-board-listen">{{> local_oksigeniaayvurenda/listen}}</span>{{/listen}}
            <p>{{text}}</p>
            <p><a class="ayv-button" href="{{url}}">{{label}}</a></p>
        </div>
        {{#hero.challenge}}<div class="ayv-board-challenge">{{> local_oksigeniaayvurenda/challenge}}
            {{#complete}}<p class="ayv-board-done">{{board.challengedone}}</p>{{/complete}}</div>{{/hero.challenge}}
    </section>
    {{/hero.you}}
    {{^hero.you}}{{#hero.challenge}}<div class="ayv-board-card ayv-challenge-card">{{> local_oksigeniaayvurenda/challenge}}</div>{{/hero.challenge}}{{/hero.you}}
    </div>
</div>
