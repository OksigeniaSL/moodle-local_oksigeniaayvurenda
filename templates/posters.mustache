{{!
    @template local_oksigeniaayvurenda/posters
    Posters for the shelves of the room, two to an A4 sheet: each place with its colour, its name big and a QR code that
    opens that shelf online.
    Context variables required for this template:
    * heading, hint, printnow, empty - texts
    * library, scan, emblem - what every poster carries
    * hassheets, sheets - the sheets, each with its posters (name, colour, ink, qr as SVG, url)
    Example context (json):
    {
        "heading": "Carteles de la estantería", "hint": "Dos por hoja", "printnow": "Imprimir", "empty": "Sin sitios",
        "library": "Biblioteca", "scan": "Escanea", "emblem": "app/emblema.svg", "hassheets": true,
        "sheets": [{"posters": [{"name": "Rojo", "colour": "#d63a2f", "ink": "#fbf6ec", "qr": "<svg viewBox=\"0 0 10 10\"></svg>",
            "url": "#"}]}]
    }
}}
<div class="ayv-print-head">
    <h1 class="ayv-results-title">{{heading}}</h1>
    <p>{{hint}}</p>
    {{#hassheets}}<p><button type="button" class="ayv-button" onclick="window.print()">{{printnow}}</button></p>{{/hassheets}}
    {{^hassheets}}<p class="ayv-empty">{{empty}}</p>{{/hassheets}}
</div>
{{#sheets}}
<div class="ayv-postersheet">
    {{#posters}}
    <section class="ayv-poster" style="--place: {{colour}}; --place-ink: {{ink}}" aria-label="{{name}}">
        <div class="ayv-poster-band">
            <p class="ayv-poster-library">{{library}}</p>
            <h2 class="ayv-poster-name">{{name}}</h2>
        </div>
        <div class="ayv-poster-body">
            {{{qr}}}
            <div class="ayv-poster-text">
                <p class="ayv-poster-scan">{{scan}}</p>
                <p class="ayv-poster-brand"><img src="{{emblem}}" alt="" width="28" height="28"> Ayvurenda</p>
            </div>
        </div>
    </section>
    {{/posters}}
</div>
{{/sheets}}
