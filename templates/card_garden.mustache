{{!
    @template local_oksigeniaayvurenda/card_garden

    The class's garden on a reader's card: its island, or its plants without the art package. Below the books, or
    beside them on a young reader's card in wide.

    Example context (json):
    {
        "hasclassgarden": true, "classgardenheading": "El jardín de la clase", "classgardenhint": "Cada reto cumplido planta algo.",
        "classisland": false, "classgarden": [{"svg": "<svg viewBox=\"0 0 10 10\" width=\"10\" height=\"10\"></svg>", "label": "Trimestre 1"}]
    }
}}
{{#hasclassgarden}}
<h2 class="ayv-section-title">{{classgardenheading}}</h2>
<p class="ayv-field-hint">{{classgardenhint}}{{#listengarden}} {{> local_oksigeniaayvurenda/listen}}{{/listengarden}}</p>
{{#classisland}}<figure class="ayv-island ayv-card-island" role="img" aria-label="{{islandlabel}}">{{#islandlayers}}<img src="{{layer}}" alt="" loading="lazy">{{/islandlayers}}</figure>{{/classisland}}
{{^classisland}}<ul class="ayv-garden">
{{#classgarden}}<li>{{{svg}}}<span>{{label}}</span></li>{{/classgarden}}
</ul>{{/classisland}}
{{/hasclassgarden}}
