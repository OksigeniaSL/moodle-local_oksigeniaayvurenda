{{!
    @template local_oksigeniaayvurenda/record

    A record: its cover, who wrote it, what it is about and where its copies are.

    Context variables required for this template:
    * card - the card of the record (colour, title, authors, statelabel, stateclass, location)
    * title, subtitle, authors, facts, subjects, summary, copies - the record
    * back - url and label to go back
    * hold - the reservation box, or nothing
    * where - how to find it on the shelf (heading, lines, placecolour, placeline, whys, order), or nothing
    * beside - the books beside it on its shelf (heading, spines, walk, walkurl, bird, bookend), or nothing

    Example context (json):
    {
        "card": {"colour": 1, "title": "El faro dormido", "authors": "Ana Montes", "statelabel": "Libre",
                 "stateclass": "free", "location": "Estantería infantil"},
        "title": "El faro dormido",
        "subtitle": "una aventura en la costa",
        "authors": [{"name": "Ana Montes", "role": ""}, {"name": "Leo Prado", "role": "ilustraciones"}],
        "hasfacts": true,
        "facts": [{"label": "Año", "value": "2019"}],
        "hassubjects": true,
        "subjectsheading": "Temas",
        "subjects": [{"label": "Aventuras", "url": "#"}],
        "summary": "Un faro que se duerme y una niña que lo despierta.",
        "summaryheading": "De qué va",
        "hascopies": true,
        "copiesheading": "Ejemplares",
        "callnumberlabel": "Tejuelo",
        "copies": [{"where": "Aquí", "statelabel": "Libre", "state": "free", "location": "Estantería infantil",
                    "callnumber": "821 MON far", "barcode": "100000L"}],
        "back": {"url": "#", "label": "Volver a la biblioteca"},
        "digital": {"heading": "En digital", "items": [{"label": "EPUB", "action": "Leer", "url": "#", "book": true}],
                    "manage": null, "readbook": "Leer el libro", "spring": null,
                    "voice": {"url": "#", "question": "¿Quieres darle voz a este libro?", "label": "Darle voz"}
        },
        "hold": {"action": "https://example.org/local/oksigeniaayvurenda/hold.php", "sesskey": "abc", "library": "demo-1", "recordid": 1, "holdid": 0, "notice": "",
                 "mine": "", "ahead": "", "canask": true, "staff": false, "holdsurl": "#",
                 "holdask": "Avísame cuando vuelva", "holdaskhint": "Ahora están todos prestados.",
                 "holdcancelmine": "Ya no lo quiero", "holdfor": "Reservar para un lector",
                 "holdforhint": "El carné o el nombre", "holdforgo": "Reservar", "holdslink": "Todas las reservas"}
    }
}}
<article class="ayv-record">
    <div class="ayv-record-cover">
        {{#card}}
        <span class="ayv-cover ayv-cover-big ayv-cover-{{colour}}{{#cover}} ayv-cover-photo{{/cover}}" aria-hidden="true">
            {{#cover}}<img class="ayv-cover-img" src="{{cover}}" alt="">{{/cover}}
            {{^cover}}<span class="ayv-cover-title">{{title}}</span>{{/cover}}
        </span>
        <p class="ayv-state ayv-state-{{stateclass}}">{{statelabel}}</p>
        {{#location}}<p class="ayv-where">{{location}}</p>{{/location}}
        {{/card}}
    </div>
    <div class="ayv-record-body">
        <h1 class="ayv-record-title">{{title}}</h1>
        {{#subtitle}}<p class="ayv-record-subtitle">{{subtitle}}</p>{{/subtitle}}
        <p class="ayv-record-authors">
            {{#authors}}<span class="ayv-author">{{name}}{{#role}} <span class="ayv-role">({{role}})</span>{{/role}}</span>{{/authors}}
        </p>
        {{#lend}}<p class="ayv-record-lend"><a class="ayv-button" href="{{url}}">{{label}}</a></p>{{/lend}}
        {{#hold}}
        <section class="ayv-hold" aria-label="{{holdask}}">
            {{#notice}}<p class="ayv-notice" role="status">{{notice}}</p>{{/notice}}
            {{#mine}}
            <p class="ayv-hold-mine">{{mine}}{{#ahead}} {{ahead}}{{/ahead}}</p>
            {{#holdid}}
            <form method="post" action="{{action}}">
                <input type="hidden" name="sesskey" value="{{sesskey}}">
                <input type="hidden" name="library" value="{{library}}">
                <input type="hidden" name="record" value="{{recordid}}">
                <input type="hidden" name="hold" value="{{holdid}}">
                <button type="submit" class="ayv-button ayv-button-quiet" name="action" value="cancel">{{holdcancelmine}}</button>
            </form>
            {{/holdid}}
            {{/mine}}
            {{#canask}}
            <p>{{holdaskhint}}</p>
            <form method="post" action="{{action}}">
                <input type="hidden" name="sesskey" value="{{sesskey}}">
                <input type="hidden" name="library" value="{{library}}">
                <input type="hidden" name="record" value="{{recordid}}">
                <button type="submit" class="ayv-button" name="action" value="ask">{{holdask}}</button>
            </form>
            {{/canask}}
            {{#staff}}
            <form method="post" action="{{action}}" autocomplete="off">
                <input type="hidden" name="sesskey" value="{{sesskey}}">
                <input type="hidden" name="library" value="{{library}}">
                <input type="hidden" name="record" value="{{recordid}}">
                <label class="ayv-field">{{holdfor}} <span class="ayv-field-hint">{{holdforhint}}</span>
                    <input type="text" name="reader" required maxlength="100"></label>
                <button type="submit" class="ayv-button ayv-button-quiet" name="action" value="for">{{holdforgo}}</button>
                <a href="{{holdsurl}}">{{holdslink}}</a>
            </form>
            {{/staff}}
        </section>
        {{/hold}}
        {{#digital}}
        <section class="ayv-hold" aria-label="{{heading}}">
            <h2 class="ayv-section-title">{{heading}}</h2>
            {{#items}}<p>{{#book}}<a class="ayv-button" href="{{url}}">{{> local_oksigeniaayvurenda/icon_book}} {{readbook}}</a> <span class="ayv-field-hint">{{label}}</span>{{/book}}{{^book}}<a class="ayv-button" href="{{url}}">{{action}}: {{label}}</a>{{/book}}</p>{{/items}}
            {{#voice}}<p class="ayv-voice-ask">{{question}}</p><p><a class="ayv-button ayv-button-quiet ayv-button-voice" href="{{url}}">{{> local_oksigeniaayvurenda/icon_mic}} {{label}}</a></p>{{/voice}}
            {{#spring}}<p><a href="{{url}}">{{label}}</a></p>{{/spring}}
            {{#manage}}<p><a href="{{url}}">{{label}}</a></p>{{/manage}}
        </section>
        {{/digital}}
        {{#summary}}
        <h2 class="ayv-section-title">{{summaryheading}}</h2>
        <p class="ayv-summary">{{summary}}</p>
        {{/summary}}
        {{#hassubjects}}
        <h2 class="ayv-section-title">{{subjectsheading}}</h2>
        <p class="ayv-subjects">{{#subjects}}<a class="ayv-chip" href="{{url}}">{{label}}</a> {{/subjects}}</p>
        {{/hassubjects}}
        {{#reviews}}{{#show}}
        <section class="ayv-reviews" id="ayv-reviews" aria-labelledby="ayv-reviews-title">
            <h2 id="ayv-reviews-title" class="ayv-section-title">{{heading}}</h2>
            {{#done}}<p class="ayv-notice" role="status">{{done}}</p>{{/done}}
            {{#haslist}}<ul class="ayv-review-list">{{#list}}<li class="ayv-review">{{#drawing}}<img class="ayv-review-drawing" src="{{drawing}}" alt="{{drawingalt}}" loading="lazy">{{/drawing}}
                {{#voice}}<audio class="ayv-review-voice" controls preload="none" src="{{voice}}" aria-label="{{voicelabel}}"></audio>{{/voice}}
                {{#text}}<p class="ayv-review-text">«{{text}}»</p>{{/text}}
                <p class="ayv-review-who">{{who}}</p></li>{{/list}}</ul>{{/haslist}}
            {{^haslist}}<p class="ayv-empty">{{none}}</p>{{/haslist}}
            {{#write}}<form class="ayv-review-form" method="post" action="{{action}}#ayv-reviews" enctype="multipart/form-data">
                <input type="hidden" name="sesskey" value="{{sesskey}}">
                <label class="ayv-field ayv-field-wide"><span class="ayv-review-ask">{{label}}</span> <span class="ayv-field-hint">{{hint}}</span>
                    <textarea name="text" maxlength="{{max}}" rows="3" required>{{text}}</textarea></label>
                {{#mydrawing}}<img class="ayv-review-drawing" src="{{mydrawing}}" alt="{{mydrawingalt}}">{{/mydrawing}}
                {{#myvoice}}<audio class="ayv-review-voice" controls preload="none" src="{{myvoice}}" aria-label="{{myvoicelabel}}"></audio>{{/myvoice}}
                {{! The other ways of saying it, side by side under the words, not one under another. }}
                <p class="ayv-review-ways"><button type="button" class="ayv-chip" data-ayv-draw-open>{{drawopen}}</button>
                    {{#canspeak}}<button type="button" class="ayv-chip" data-ayv-speak-open>{{> local_oksigeniaayvurenda/icon_mic}} {{speakopen}}</button>{{/canspeak}}</p>
                {{#canspeak}}
                <div class="ayv-speak" data-ayv-speak hidden data-nomic="{{speaknomic}}" data-stop="{{speakstop}}" data-record="{{speakrecord}}">
                    <p class="ayv-field-hint">{{speakhint}}</p>
                    <p class="ayv-book-actions"><button type="button" class="ayv-button" data-speak-record>{{> local_oksigeniaayvurenda/icon_mic}} <span>{{speakrecord}}</span></button>
                        <span class="ayv-speak-time" aria-live="polite"></span>
                        <button type="button" class="ayv-button ayv-button-quiet" data-speak-again hidden>{{speakagain}}</button></p>
                    <audio class="ayv-review-voice" controls hidden></audio>
                    <input type="file" name="voice" accept="audio/*" hidden>
                </div>
                {{/canspeak}}
                <div class="ayv-draw" data-ayv-draw hidden>
                    <canvas class="ayv-draw-canvas" width="800" height="500" role="img" aria-label="{{drawcanvas}}"></canvas>
                    <div class="ayv-draw-tools" role="group" aria-label="{{drawtools}}">
                        {{#drawcolours}}<button type="button" class="ayv-draw-colour" data-colour="{{value}}" style="--ayv-pencil: {{value}}" aria-label="{{label}}" aria-pressed="{{pressed}}"></button>{{/drawcolours}}
                        <button type="button" class="ayv-toggle" data-size="6" aria-pressed="true">{{drawthin}}</button>
                        <button type="button" class="ayv-toggle" data-size="18" aria-pressed="false">{{drawthick}}</button>
                        <button type="button" class="ayv-toggle" data-erase aria-pressed="false">{{draweraser}}</button>
                        <button type="button" class="ayv-button ayv-button-quiet" data-undo>{{drawundo}}</button>
                        <button type="button" class="ayv-button ayv-button-quiet" data-clear>{{drawclear}}</button>
                    </div>
                    <input type="hidden" name="drawing" value="">
                </div>
                {{#canrecommend}}<label class="ayv-field ayv-field-check"><input type="checkbox" name="forlittle" value="1" {{#recommended}}checked{{/recommended}}> {{recommend}}</label>{{/canrecommend}}
                {{#hasmine}}<p class="ayv-field-hint">{{state}}</p>{{/hasmine}}
                <p class="ayv-book-actions ayv-review-send">{{#hasmine}}<button type="submit" class="ayv-button ayv-button-quiet" name="review" value="remove" formnovalidate>{{remove}}</button>{{/hasmine}}
                    <button type="submit" class="ayv-button" name="review" value="send">{{send}}</button></p>
            </form>{{/write}}
        </section>
        {{/show}}{{/reviews}}
        {{#hasfacts}}
        <dl class="ayv-facts">
            {{#facts}}<div><dt>{{label}}</dt><dd>{{value}}</dd></div>{{/facts}}
        </dl>
        {{/hasfacts}}
        {{#coins}}<span class="Z3988" title="{{coins}}"></span>{{/coins}}
        <div class="ayv-record-tools">
            {{#fulltext}}<a class="ayv-button ayv-button-quiet" href="{{url}}" target="_blank" rel="noopener">{{label}}</a>{{/fulltext}}
            {{#cite}}<a class="ayv-button ayv-button-quiet" href="{{citeurl}}" download>{{citelabel}}</a>{{/cite}}
            {{#formatask}}{{^open}}<button type="button" class="ayv-button ayv-button-quiet" data-ayv-open="ayv-format-sheet">{{button}}</button>{{/open}}{{/formatask}}
            {{#passon}}<span class="ayv-passon"><span>{{heading}}</span> <a class="ayv-button ayv-button-quiet" href="{{classroom}}" target="_blank" rel="noopener">{{classroomlabel}}</a>
                <a class="ayv-button ayv-button-quiet" href="{{teams}}" target="_blank" rel="noopener">{{teamslabel}}</a>
                {{#moodle}}<button type="button" class="ayv-button ayv-button-quiet" data-ayv-open="ayv-passon-moodle">{{label}}</button>{{/moodle}}</span>{{/passon}}
        </div>
        {{#passon}}{{#moodle}}
        <dialog class="ayv-modal" id="ayv-passon-moodle" aria-labelledby="ayv-passon-moodle-title">
            <div class="ayv-modal-head"><h3 id="ayv-passon-moodle-title" class="ayv-section-title">{{title}}</h3>
                <form method="dialog"><button class="ayv-modal-close" aria-label="{{close}}">{{> local_oksigeniaayvurenda/icon_x}}</button></form></div>
            <p class="ayv-field-hint">{{hint}}</p>
            <ul class="ayv-passon-courses">
                {{#courses}}<li class="ayv-passon-course"><span class="ayv-passon-name">{{name}}</span>
                    {{#listed}}<a class="ayv-button ayv-button-quiet" href="{{url}}">{{listedlabel}}</a>{{/listed}}
                    {{^listed}}<form method="post" action="{{action}}" class="ayv-passon-form"><input type="hidden" name="sesskey" value="{{sesskey}}">
                        <input type="hidden" name="course" value="{{id}}"><input type="hidden" name="do" value="add"><input type="hidden" name="record" value="{{recordid}}">
                        <label class="ayv-field-check"><input type="checkbox" name="required" value="1"> {{required}}</label>
                        <button type="submit" class="ayv-button">{{addlabel}}</button></form>{{/listed}}</li>{{/courses}}
            </ul>
        </dialog>
        {{/moodle}}{{/passon}}
        {{#formatask}}
        {{#line}}<p class="ayv-notice" id="ayv-format" role="status">{{line}}</p>{{/line}}
        {{^open}}
        <dialog class="ayv-modal" id="ayv-format-sheet" aria-labelledby="ayv-format-title">
            <div class="ayv-modal-head"><h2 id="ayv-format-title" class="ayv-section-title">{{heading}}</h2>
                <form method="dialog"><button class="ayv-modal-close" aria-label="{{close}}">{{> local_oksigeniaayvurenda/icon_x}}</button></form></div>
            <p>{{intro}}</p>
            <form method="post" action="{{action}}" class="ayv-dig-form">
                <input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="library" value="{{library}}">
                <input type="hidden" name="record" value="{{recordid}}">
                <fieldset class="ayv-dig-set"><legend class="ayv-sr">{{heading}}</legend><div class="ayv-segmented">
                    {{#choices}}<label><input type="radio" name="format" value="{{value}}" {{#first}}checked{{/first}}><span>{{label}}</span></label>{{/choices}}
                </div></fieldset>
                <p class="ayv-dig-sheet-actions"><button type="submit" class="ayv-button">{{go}}</button></p>
            </form>
        </dialog>
        {{/open}}
        {{/formatask}}
        {{#correct}}
        {{#notice}}<p class="ayv-notice" role="status">{{notice}}</p>{{/notice}}
        {{#error}}<p class="ayv-notice ayv-notice-error" role="alert">{{error}}</p>{{/error}}
        <p><button type="button" class="ayv-button ayv-button-quiet" data-ayv-open="ayv-fix-record">{{correctrecord}}</button></p>
        <dialog class="ayv-modal" id="ayv-fix-record" aria-labelledby="ayv-fix-record-title">
            <div class="ayv-modal-head"><h3 id="ayv-fix-record-title" class="ayv-section-title">{{correctrecord}}</h3>
                <form method="dialog"><button class="ayv-modal-close" aria-label="{{correctclose}}">{{> local_oksigeniaayvurenda/icon_x}}</button></form></div>
            <form method="post" action="{{action}}" class="ayv-fix-form">
                <input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="fix" value="record">
                {{#form}}
                <label class="ayv-field ayv-dig-field">{{correcttitle}} <input type="text" name="title" value="{{title}}" required></label>
                <label class="ayv-field ayv-dig-field">{{correctsubtitle}} <input type="text" name="subtitle" value="{{subtitle}}"></label>
                <label class="ayv-field ayv-dig-field">{{correctauthors}} <textarea name="authors" rows="3">{{authors}}</textarea></label>
                <p class="ayv-field-hint">{{correctlines}}</p>
                <label class="ayv-field ayv-dig-field">{{correctsubjects}} <textarea name="subjects" rows="3" data-ayv-subjects="{{subjectsurl}}" data-add="{{subjectsadd}}" data-remove="{{subjectsremove}}">{{subjects}}</textarea></label>
                <p class="ayv-field-hint">{{subjectshint}}</p>
                <div class="ayv-fix-two">
                <label class="ayv-field ayv-dig-field">{{correctisbn}} <input type="text" name="isbn" value="{{isbn}}"></label>
                <label class="ayv-field ayv-dig-field">{{correctedition}} <input type="text" name="edition" value="{{edition}}"></label>
                <label class="ayv-field ayv-dig-field">{{correctplace}} <input type="text" name="pubplace" value="{{pubplace}}"></label>
                <label class="ayv-field ayv-dig-field">{{correctyear}} <input type="text" name="pubyear" value="{{pubyear}}"></label>
                </div>
                <label class="ayv-field ayv-dig-field">{{correctsummary}} <textarea name="summary" rows="4">{{summary}}</textarea></label>
                <label class="ayv-field ayv-dig-field">{{correctnotes}} <textarea name="notes" rows="2">{{notes}}</textarea></label>
                {{/form}}
                <button type="submit" class="ayv-button">{{correctsave}}</button>
            </form>
            <form method="post" action="{{action}}">
                <input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="fix" value="droprecord">
                <p class="ayv-field-hint">{{correctremovehint}}</p>
                <button type="submit" class="ayv-button ayv-button-quiet">{{correctremoverecord}}</button>
            </form>
        </dialog>
        {{/correct}}
        {{#hascopies}}
        <h2 class="ayv-section-title">{{copiesheading}}</h2>
        <ul class="ayv-copies">
            {{#copies}}
            <li class="ayv-copy">
                <span class="ayv-state ayv-state-{{state}}">{{statelabel}}</span>
                <span class="ayv-copy-where">{{where}}{{#location}} · <strong>{{location}}</strong>{{/location}}</span>
                {{#fix}}<button type="button" class="ayv-button ayv-button-quiet" data-ayv-open="ayv-fix-copy-{{id}}">{{correctcopy}}</button>
                <dialog class="ayv-modal" id="ayv-fix-copy-{{id}}" aria-labelledby="ayv-fix-copy-title-{{id}}">
                    <div class="ayv-modal-head"><h3 id="ayv-fix-copy-title-{{id}}" class="ayv-section-title">{{correctcopytitle}}</h3>
                        <form method="dialog"><button class="ayv-modal-close" aria-label="{{correctclose}}">{{> local_oksigeniaayvurenda/icon_x}}</button></form></div>
                    <form method="post" action="{{action}}" class="ayv-fix-form">
                        <input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="fix" value="copy"><input type="hidden" name="item" value="{{id}}"><input type="hidden" name="itemtype" value="{{itemtype}}">
                        <label class="ayv-field ayv-dig-field">{{correctcode}} <input type="text" name="barcode" value="{{barcode}}" required></label>
                        <div class="ayv-fix-three">
                        <label class="ayv-field ayv-dig-field">{{correctcall1}} <input type="text" name="callnumber1" value="{{call1}}" data-ayv-classes="{{classesurl}}"></label>
                        <label class="ayv-field ayv-dig-field">{{correctcall2}} <input type="text" name="callnumber2" value="{{call2}}"></label>
                        <label class="ayv-field ayv-dig-field">{{correctcall3}} <input type="text" name="callnumber3" value="{{call3}}"></label>
                        </div>
                        <label class="ayv-field ayv-dig-field">{{correctlocation}} <select name="locationid"><option value="0"></option>{{#places}}<option value="{{id}}"{{#selected}} selected{{/selected}}>{{label}}</option>{{/places}}</select></label>
                        <label class="ayv-field ayv-dig-field">{{correctnotes}} <textarea name="notes" rows="2">{{notes}}</textarea></label>
                        <button type="submit" class="ayv-button">{{correctsave}}</button>
                    </form>
                    <form method="post" action="{{action}}">
                        <input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="fix" value="dropcopy"><input type="hidden" name="item" value="{{id}}">
                        <p class="ayv-field-hint">{{correctremovehint}}</p>
                        <button type="submit" class="ayv-button ayv-button-quiet">{{correctremovecopy}}</button>
                    </form>
                </dialog>{{/fix}}
                {{#callnumber}}<span class="ayv-copy-call" title="{{callnumberlabel}}"><span class="ayv-sr">{{callnumberlabel}}: </span>{{callnumber}}</span>{{/callnumber}}
            </li>
            {{/copies}}
        </ul>
        {{/hascopies}}
        {{#where}}
        <section class="ayv-where-box" aria-labelledby="ayv-where-title">
            <h2 id="ayv-where-title" class="ayv-section-title">{{heading}}</h2>
            <div class="ayv-where-in">
                <span class="ayv-where-label{{#placecolour}} ayv-spine-label-place{{/placecolour}}"{{#placecolour}} style="--place: {{placecolour}}"{{/placecolour}} aria-hidden="true">{{#lines}}<span>{{line}}</span>{{/lines}}</span>
                <div>
                    {{#placeline}}<p class="ayv-where-place">{{placeline}}</p>{{/placeline}}
                    <ul class="ayv-why-list">{{#whys}}<li>{{text}}</li>{{/whys}}</ul>
                    <p class="ayv-field-hint">{{order}}</p>
                </div>
            </div>
        </section>
        {{/where}}
        {{#beside}}
        <section class="ayv-beside" aria-labelledby="ayv-beside-title">
            <h2 id="ayv-beside-title" class="ayv-section-title">{{heading}}</h2>
            <div class="ayv-bookcase-wrap ayv-bookcase-mini"{{#bird}} style="--ayv-bird: url('{{bird}}')"{{/bird}}>
                <ul class="ayv-bookcase{{#bookend}} ayv-bookcase-art{{/bookend}}"{{#bookend}} style="--ayv-bookend: url('{{bookend}}')"{{/bookend}} aria-label="{{heading}}">{{#spines}}<li class="ayv-spine-slot{{#out}} ayv-spine-gap{{/out}}{{#here}} ayv-spine-here{{/here}}" style="--cm: {{cm}}; --w: {{width}}px">{{> local_oksigeniaayvurenda/spine}}</li>{{/spines}}</ul>
            </div>
            <p class="ayv-more"><a class="ayv-button ayv-button-quiet" href="{{walkurl}}">{{> local_oksigeniaayvurenda/icon_shelf}} {{walk}}</a></p>
        </section>
        {{/beside}}
        {{#memoryalso}}
        <section class="ayv-section ayv-shelf-section ayv-also" aria-labelledby="ayv-also-title">
            <h2 id="ayv-also-title" class="ayv-section-title">{{heading}}</h2>
            {{#said}}{{> local_oksigeniaayvurenda/bubble}}{{/said}}
            <div class="ayv-wood">{{> local_oksigeniaayvurenda/cards}}{{> local_oksigeniaayvurenda/shelf_arrows}}</div>
        </section>
        {{/memoryalso}}
        {{#back}}<p class="ayv-more"><a class="ayv-button ayv-button-quiet" href="{{url}}">{{label}}</a></p>{{/back}}
    </div>
</article>
