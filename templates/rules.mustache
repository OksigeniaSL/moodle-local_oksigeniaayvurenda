{{!
    @template local_oksigeniaayvurenda/rules

    The loan rules of a library: each one a card read as a sentence, changed in its own sheet; a new one from the top.

    Example context (json):
    {
        "heading": "Normas de préstamo", "intro": "Manda la más precisa.", "inherited": "", "notice": "",
        "action": "#", "sesskey": "abc", "hascards": true,
        "cards": [{"who": "Alumnos", "what": "Cualquier ejemplar", "sentence": "Se llevan hasta 1, durante 7 días.",
            "form": {"index": "0", "readertypes": [{"value": "student", "label": "Alumnos", "selected": true}],
                "itemtypes": [{"value": "*", "label": "Cualquier ejemplar", "selected": true}], "roomonly": false,
                "loandays": 7, "nolimit": false, "maxloans": 1, "renewals": 1, "renewdays": 7, "removable": true} }],
        "newform": {"index": "new", "readertypes": [{"value": "*", "label": "Cualquier lector", "selected": true}],
            "itemtypes": [{"value": "*", "label": "Cualquier ejemplar", "selected": true}], "roomonly": false,
            "loandays": 14, "nolimit": false, "maxloans": 1, "renewals": 1, "renewdays": 7, "removable": false},
        "rulesreader": "Lectores", "rulesitem": "Ejemplares", "rulesdaysplain": "Días", "rulesmaxplain": "A la vez",
        "rulesrenewals": "Ampliaciones", "rulesrenewdays": "Días de cada ampliación", "rulesremoveone": "Quitar esta norma",
        "rulesnew": "Nueva norma", "sourcessave": "Guardar", "rulesroomonlyfield": "No se presta: se lee aquí",
        "rulesnolimit": "Sin límite", "ruleschange": "Cambiar", "rulesprecedence": "Manda la más precisa.",
        "offsiteclose": "Cerrar"
    }
}}
<h1 class="ayv-results-title">{{heading}}</h1>
<p>{{intro}}</p>
{{#notice}}<p class="ayv-notice" role="status">{{notice}}</p>{{/notice}}
<p class="ayv-rules-top"><button type="button" class="ayv-button" data-ayv-open="ayv-rule-new">{{rulesnew}}</button></p>
{{#inherited}}<p class="ayv-empty">{{inherited}}</p>{{/inherited}}
{{#hascards}}
<ul class="ayv-rules">
{{#cards}}
    <li class="ayv-rule">
        <p class="ayv-rule-head"><span class="ayv-rule-who">{{who}}</span> <span class="ayv-chip">{{what}}</span></p>
        <p class="ayv-rule-sentence">{{sentence}}</p>
        <p class="ayv-rule-actions"><button type="button" class="ayv-button ayv-button-quiet" data-ayv-open="ayv-rule-{{form.index}}">{{ruleschange}}</button></p>
        {{#form}}{{> local_oksigeniaayvurenda/rules_form}}{{/form}}
    </li>
{{/cards}}
</ul>
{{/hascards}}
<p class="ayv-field-hint">{{rulesprecedence}}</p>
{{#newform}}{{> local_oksigeniaayvurenda/rules_form}}{{/newform}}
