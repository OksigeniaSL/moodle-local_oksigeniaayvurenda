{{!
    @template local_oksigeniaayvurenda/rules

    The loan rules of a library: one card for each kind of reader and kind of copy.

    Context variables required for this template:
    * heading, intro, inherited, notice - texts
    * action, sesskey - the form
    * rows - index, readertypes and itemtypes (value, label, selected), loandays, maxloans, renewals, renewdays,
      removable, isnew
    * the words of the fields

    Example context (json):
    {
        "heading": "Normas de préstamo",
        "intro": "Para cada tipo de lector y de ejemplar.",
        "inherited": "",
        "notice": "",
        "action": "#",
        "sesskey": "abc",
        "rows": [{"index": 0, "readertypes": [{"value": "student", "label": "Alumnos", "selected": true}],
                  "itemtypes": [{"value": "normal", "label": "Se presta", "selected": true}],
                  "loandays": 14, "maxloans": 2, "renewals": 1, "renewdays": 7, "removable": true}],
        "rulesreader": "Lectores", "rulesitem": "Ejemplares", "rulesdays": "Días", "rulesmax": "A la vez",
        "rulesrenewals": "Ampliaciones", "rulesrenewdays": "Días de cada ampliación", "rulesremove": "Quitar",
        "rulesnew": "Norma nueva", "sourcessave": "Guardar"
    }
}}
<h1 class="ayv-results-title">{{heading}}</h1>
<p>{{intro}}</p>
{{#inherited}}<p class="ayv-notice">{{inherited}}</p>{{/inherited}}
{{#notice}}<p class="ayv-notice" role="status">{{notice}}</p>{{/notice}}
<form method="post" action="{{action}}">
    <input type="hidden" name="sesskey" value="{{sesskey}}">
    <ul class="ayv-sources">
    {{#rows}}
        <li class="ayv-source ayv-rule{{#isnew}} ayv-rule-new{{/isnew}}">
            {{#isnew}}<span class="ayv-source-name">{{rulesnew}}</span>{{/isnew}}
            <label class="ayv-field">{{rulesreader}} <select name="readertype[{{index}}]">{{#readertypes}}<option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>{{/readertypes}}</select></label>
            <label class="ayv-field">{{rulesitem}} <select name="itemtype[{{index}}]">{{#itemtypes}}<option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>{{/itemtypes}}</select></label>
            <label class="ayv-field">{{rulesdays}} <input type="number" min="0" max="9999" name="loandays[{{index}}]" value="{{loandays}}"></label>
            <label class="ayv-field">{{rulesmax}} <input type="number" min="0" max="9999" name="maxloans[{{index}}]" value="{{maxloans}}"></label>
            <label class="ayv-field">{{rulesrenewals}} <input type="number" min="0" max="99" name="renewals[{{index}}]" value="{{renewals}}"></label>
            <label class="ayv-field">{{rulesrenewdays}} <input type="number" min="0" max="9999" name="renewdays[{{index}}]" value="{{renewdays}}"></label>
            {{#removable}}<label class="ayv-field ayv-field-check"><input type="checkbox" name="remove{{index}}" value="1"> {{rulesremove}}</label>{{/removable}}
        </li>
    {{/rows}}
    </ul>
    <p class="ayv-more"><button type="submit" class="ayv-button">{{sourcessave}}</button></p>
</form>
