{{!
    @template local_oksigeniaayvurenda/rules

    The loan rules of a library, each a library loan card with its counters in sight («−» and «+»), its lights and, at
    its foot, who and what it is for and taking it away; a dashed card for another one. Under them, a card for each
    setting of the centre (renewals, notices of late books, what a late book leaves), its sentence on top and its
    gestures under it. Each gesture is a button of an empty form that sends only what it changes (no JavaScript needed).

    Context variables required for this template:
    * title, intro, action, sesskey, savedword - the page's words and where gestures go
    * crier - the herald by the title: figure and puppet, or nothing
    * shelf, shelfsub, inherited - the shelf of the rules, and what lends while there is none
    * cards - index, form, colour, who, what, says, steps, hassteps, lights, justsaved, retarget, whochips, whatchips,
      removelabel, removeyes
    * newcard - summary, who, what (value, label, checked), wholabel, whatlabel, create, note
    * settings - id, set, title, says, justsaved, groups (label, steps, lights, chips, haslights, haschips, whole), notes, dates,
      presets, currency, link, help

    Example context (json):
    {
        "title": "Normas de préstamo", "intro": "Cada número se cambia con «−» y «+».",
        "action": "https://example.com/rules.php", "sesskey": "abc", "savedword": "Guardado", "crier": null,
        "shelf": "Las normas", "shelfsub": "Manda la más precisa.", "inherited": "",
        "cards": [{"index": "0", "form": "ayv-nr-norma-0-f", "colour": "coral", "who": "Alumnos", "what": "cualquier ejemplar",
            "says": "Se llevan uno cada vez, durante 7 días.", "hassteps": true, "justsaved": true,
            "steps": [{"form": "ayv-nr-norma-0-f", "field": "loandays", "label": "Durante", "shown": "7", "unit": "días",
                "less": 6, "more": 8, "atmin": false, "atmax": false, "lesslabel": "Uno menos", "morelabel": "Uno más",
                "still": false}],
            "lights": [{"form": "ayv-nr-norma-0-f", "name": "loandays", "value": 0, "pressed": false,
                "label": "Solo en la biblioteca"}],
            "retarget": "Para quién y qué",
            "whochips": [{"value": "student", "label": "Alumnos", "pressed": true}],
            "whatchips": [{"value": "any", "label": "Cualquier ejemplar", "pressed": true}],
            "removelabel": "Quitar esta norma", "removeyes": "Sí, quitarla"}],
        "newcard": {"summary": "+ Otra norma", "wholabel": "Para", "whatlabel": "Qué", "create": "Crear la norma",
            "note": "Nace como la general.", "who": [{"value": "any", "label": "Cualquier lector", "checked": true}],
            "what": [{"value": "any", "label": "Cualquier ejemplar", "checked": true}]},
        "settings": [{"id": "ayv-nr-tarde", "set": "late", "title": "Si un libro vuelve tarde", "says": "Se avisa y nada más.",
            "justsaved": false, "groups": [{"label": "", "steps": [], "lights": [], "haslights": false, "haschips": true, "whole": true,
                "chips": [{"form": "ayv-nr-tarde-f", "name": "mode", "value": "none", "label": "Solo el aviso", "pressed": true}]}],
            "notes": [{"text": "Vale para todo el centro."}],
            "dates": {"legend": "Las fechas", "hint": "Cada año.", "save": "Guardar los días",
                "fields": [{"value": "2026-12-18", "label": "Fecha 1"}]},
            "presets": {"summary": "Empezar como", "hint": "Un toque.", "list": [{"form": "ayv-nr-tarde-f", "name": "preset",
                "value": "school", "label": "Un colegio", "pressed": false}]},
            "currency": {"summary": "Moneda: EUR", "label": "Moneda", "save": "Guardar",
                "list": [{"code": "EUR", "name": "Euro"}]},
            "link": {"lead": "Lo que deben:", "url": "https://example.com/sanctions.php", "label": "Sanciones y multas"},
            "help": {"url": "https://example.com/help.php", "label": "¿Cómo funciona?"} }]
    }
}}
<div class="ayv-cf ayv-nr">
<header class="ayv-cf-cabeza">
    <div class="ayv-cf-cabeza-texto"><h1 class="ayv-cf-titulo">{{title}}</h1>
        <p class="ayv-cf-entrada">{{intro}}</p>
    </div>
    {{#crier}}<span class="ayv-cf-pregonera"><span class="ayv-figure"><img src="{{figure}}" alt="" width="512" height="512"{{#puppet}} data-puppet="{{puppet}}"{{/puppet}}></span></span>{{/crier}}
</header>
<section class="ayv-nr-las" id="ayv-nr-las" aria-labelledby="ayv-nr-las-t">
    <h2 class="ayv-cf-estante-t" id="ayv-nr-las-t">{{shelf}}</h2>
    <p class="ayv-cf-estante-s">{{shelfsub}}</p>
    {{#inherited}}<p class="ayv-nr-frase">{{inherited}}</p>{{/inherited}}
    <ul class="ayv-nr-fichas">
        {{#cards}}
        <li><article class="ayv-nr-ficha ayv-nr-ficha-{{colour}}" id="ayv-nr-norma-{{index}}" aria-labelledby="ayv-nr-norma-{{index}}-t">
            <form id="{{form}}" method="post" action="{{action}}"><input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="rule" value="{{index}}"></form>
            <header class="ayv-nr-ficha-cab"><h3 id="ayv-nr-norma-{{index}}-t">{{who}}</h3><span>{{what}}</span></header>
            {{#justsaved}}<p class="ayv-cf-guardado-fila"><span class="ayv-cf-guardado" role="status">{{savedword}}</span></p>{{/justsaved}}
            <p class="ayv-nr-dice">{{says}}</p>
            {{#hassteps}}<div class="ayv-cf-numeros">
                {{#steps}}<div class="ayv-nr-grupo"><span class="ayv-cf-rotulo">{{label}}</span>{{#still}}<span class="ayv-cf-cifra ayv-nr-sin"><b>{{shown}}</b></span>{{/still}}{{^still}}<span class="ayv-cf-paso" role="group" aria-label="{{label}}"><button class="ayv-cf-menos" type="submit" form="{{form}}" name="{{field}}" value="{{less}}" aria-label="{{lesslabel}}"{{#atmin}} disabled{{/atmin}}>−</button><span class="ayv-cf-cifra"><b>{{shown}}</b> {{unit}}</span><button class="ayv-cf-mas" type="submit" form="{{form}}" name="{{field}}" value="{{more}}" aria-label="{{morelabel}}"{{#atmax}} disabled{{/atmax}}>+</button></span>{{/still}}</div>{{/steps}}
            </div>{{/hassteps}}
            <div class="ayv-cf-luces">{{#lights}}<button class="ayv-cf-luz" type="submit" form="{{form}}" name="{{name}}" value="{{value}}" aria-pressed="{{#pressed}}true{{/pressed}}{{^pressed}}false{{/pressed}}"><span class="ayv-cf-bombilla" aria-hidden="true"></span><span>{{label}}</span></button>{{/lights}}</div>
            <div class="ayv-nr-ficha-pie">
                <details class="ayv-nr-plegado"><summary>{{retarget}}</summary>
                    <div class="ayv-cf-chapas">{{#whochips}}<button class="ayv-cf-chapa" type="submit" form="{{form}}" name="readertype" value="{{value}}" aria-pressed="{{#pressed}}true{{/pressed}}{{^pressed}}false{{/pressed}}">{{label}}</button>{{/whochips}}</div>
                    <div class="ayv-cf-chapas">{{#whatchips}}<button class="ayv-cf-chapa" type="submit" form="{{form}}" name="itemtype" value="{{value}}" aria-pressed="{{#pressed}}true{{/pressed}}{{^pressed}}false{{/pressed}}">{{label}}</button>{{/whatchips}}</div>
                </details>
                <details class="ayv-nr-plegado"><summary>{{removelabel}}</summary><button class="ayv-button ayv-cf-peligro" type="submit" form="{{form}}" name="remove" value="1">{{removeyes}}</button></details>
            </div>
        </article></li>
        {{/cards}}
        {{#newcard}}
        <li class="ayv-nr-nueva"><details><summary>{{summary}}</summary>
            <form method="post" action="{{action}}"><input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="rule" value="new">
                <div class="ayv-nr-grupo"><span class="ayv-cf-rotulo" id="ayv-nr-nueva-quien">{{wholabel}}</span><div class="ayv-cf-chapas ayv-nr-radios" role="radiogroup" aria-labelledby="ayv-nr-nueva-quien">{{#who}}<input type="radio" name="readertype" value="{{value}}" id="ayv-nr-quien-{{value}}"{{#checked}} checked{{/checked}}><label class="ayv-cf-chapa" for="ayv-nr-quien-{{value}}">{{label}}</label>{{/who}}</div></div>
                <div class="ayv-nr-grupo"><span class="ayv-cf-rotulo" id="ayv-nr-nueva-que">{{whatlabel}}</span><div class="ayv-cf-chapas ayv-nr-radios" role="radiogroup" aria-labelledby="ayv-nr-nueva-que">{{#what}}<input type="radio" name="itemtype" value="{{value}}" id="ayv-nr-que-{{value}}"{{#checked}} checked{{/checked}}><label class="ayv-cf-chapa" for="ayv-nr-que-{{value}}">{{label}}</label>{{/what}}</div></div>
                <p class="ayv-cf-nota">{{note}}</p>
                <p class="ayv-cf-fila"><button class="ayv-button" type="submit">{{create}}</button></p>
            </form>
        </details></li>
        {{/newcard}}
    </ul>
</section>
<ul class="ayv-nr-ajustes">
    {{#settings}}
    <li>{{> local_oksigeniaayvurenda/settingcard}}</li>
    {{/settings}}
</ul>
</div>
