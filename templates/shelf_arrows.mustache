{{!
    @template local_oksigeniaayvurenda/shelf_arrows
    The two arrows of a shelf that slides: the script shows each one when there is more that way.
    Context variables required for this template:
    * shelfprev, shelfnext - what they say to a screen reader
    Example context (json):
    {
        "shelfprev": "Anteriores",
        "shelfnext": "Siguientes"
    }
}}
<button type="button" class="ayv-shelf-go ayv-shelf-prev" aria-label="{{shelfprev}}" hidden>{{> local_oksigeniaayvurenda/icon_prev}}</button>
<button type="button" class="ayv-shelf-go ayv-shelf-next" aria-label="{{shelfnext}}" hidden>{{> local_oksigeniaayvurenda/icon_next}}</button>
