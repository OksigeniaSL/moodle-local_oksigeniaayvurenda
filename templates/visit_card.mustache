{{!
    @template local_oksigeniaayvurenda/visit_card
    The way into the library one visits, on the home and at the door: its hall, by day or by night as the page is.
    Context variables required for this template:
    * url, label, hint, day, night, position - the hall's painting and where to crop it
    Example context (json):
    {
        "url": "#", "label": "Entra en la biblioteca", "hint": "Pasea por sus salas como si estuvieras allí.",
        "day": "https://example.com/vestibulo-fondo.webp", "night": "https://example.com/vestibulo-fondo-noche.webp",
        "position": 50
    }
}}
<a class="ayv-visit-card" href="{{url}}">
    <span class="ayv-visit-card-picture" aria-hidden="true">
        <img class="ayv-visit-card-day" src="{{day}}" alt="" loading="lazy" style="object-position: {{position}}% 50%">
        <img class="ayv-visit-card-night" src="{{night}}" alt="" loading="lazy" style="object-position: {{position}}% 50%">
    </span>
    <span class="ayv-visit-card-text">
        <span class="ayv-visit-card-label">{{label}}</span>
        <span class="ayv-visit-card-hint">{{hint}}</span>
    </span>
    {{> local_oksigeniaayvurenda/icon_next}}
</a>
